                    s_act_b[(p0 + 16u) * 8u + outCol4] = q1;
                }
            }
        }
        barrier();

        // 5d. d0 = lrelu(u0 + dec0_pw2(m5)) (32 -> 32) -> s_act_a[0..1023]
        [[dont_unroll]] for (uint ob = 0u; ob < 2u; ++ob) {
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0, acc1;
            wmmaDualFromActB(sg, 0u, 8u, DEC0_PW2_W_FP8_OFFSET, 2u, ob, acc0, acc1);

            uint c = ob * 16u + col;
            float sc = w_f32[DEC0_PW2_S_F32_OFFSET + c];
            float bc = w_f32[DEC0_PW2_B_F32_OFFSET + c];
            uint outCol4 = ob * 4u + col4;

            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                uint p0 = sg * 32u + mBase + i;
                uint p1 = p0 + 16u;
                float sk0 = fp8Comp(s_act_a[1024u + p0 * 8u + outCol4], comp);
                float sk1 = fp8Comp(s_act_a[1024u + p1 * 8u + outCol4], comp);
                uint q0 = quadPackClusterFp8(leakyRelu01(sk0 + acc0[i] * sc + bc), lane);
                uint q1 = quadPackClusterFp8(leakyRelu01(sk1 + acc1[i] * sc + bc), lane);
                if (comp == 0u) {
                    s_act_a[p0 * 8u + outCol4] = q0;
                    s_act_a[p1 * 8u + outCol4] = q1;
                }
            }
        }
        barrier();

        uint cBase = lane & ~3u;

        // 5e. head_out (32 -> 16) -> uSubpixelParams[pixIdx * 4 + 0..3] via register quad-shuffle
        {
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0, acc1;
            wmmaDualFromActA(sg, 0u, 8u, HEAD_OUT_W_FP8_OFFSET, 2u, 0u, acc0, acc1);
            float sc = w_f32[HEAD_OUT_S_F32_OFFSET + col];
            float bc = w_f32[HEAD_OUT_B_F32_OFFSET + col];

            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                uint p0 = sg * 32u + mBase + i;
                uint p1 = p0 + 16u;
                float v0 = clampHeadOut(acc0[i] * sc + bc);
                float v1 = clampHeadOut(acc1[i] * sc + bc);

                float v0x = subgroupShuffle(v0, cBase + 0u);
                float v0y = subgroupShuffle(v0, cBase + 1u);
                float v0z = subgroupShuffle(v0, cBase + 2u);
                float v0w = subgroupShuffle(v0, cBase + 3u);

                float v1x = subgroupShuffle(v1, cBase + 0u);
                float v1y = subgroupShuffle(v1, cBase + 1u);
                float v1z = subgroupShuffle(v1, cBase + 2u);
                float v1w = subgroupShuffle(v1, cBase + 3u);

                if (comp == 0u) {
                    ivec2 gp0 = tileOrigin + pixelOffset16x8(p0);
                    if (gp0.x < int(pl.w0) && gp0.y < int(pl.h0)) {
                        uSubpixelParams[(uint(gp0.y) * pl.w0 + uint(gp0.x)) * 4u + col4] =
                            f16vec4(float16_t(v0x), float16_t(v0y), float16_t(v0z), float16_t(v0w));
                    }
                    ivec2 gp1 = tileOrigin + pixelOffset16x8(p1);
                    if (gp1.x < int(pl.w0) && gp1.y < int(pl.h0)) {
                        uSubpixelParams[(uint(gp1.y) * pl.w0 + uint(gp1.x)) * 4u + col4] =
                            f16vec4(float16_t(v1x), float16_t(v1y), float16_t(v1z), float16_t(v1w));
                    }
                }
            }
        }

        // 5f. head_recurrent (32 -> 32): ob=0 -> cand = tanh, ob=1 -> gate = sigmoid -> uNextNeuralHidden
        {
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> accC0, accC1;
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> accG0, accG1;
            wmmaDualFromActA(sg, 0u, 8u, HEAD_REC_W_FP8_OFFSET, 2u, 0u, accC0, accC1);
            wmmaDualFromActA(sg, 0u, 8u, HEAD_REC_W_FP8_OFFSET, 2u, 1u, accG0, accG1);

            float sC = w_f32[HEAD_REC_S_F32_OFFSET + col];
            float bC = w_f32[HEAD_REC_B_F32_OFFSET + col];
            float sG = w_f32[HEAD_REC_S_F32_OFFSET + 16u + col];
            float bG = w_f32[HEAD_REC_B_F32_OFFSET + 16u + col];

            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                uint p0 = sg * 32u + mBase + i;
                uint p1 = p0 + 16u;
                ivec2 gp0 = tileOrigin + pixelOffset16x8(p0);
                ivec2 gp1 = tileOrigin + pixelOffset16x8(p1);
                bool ok0 = (gp0.x < int(pl.w0) && gp0.y < int(pl.h0));
                bool ok1 = (gp1.x < int(pl.w0) && gp1.y < int(pl.h0));

                float hw0Val = ok0
                    ? (fp8Comp(pyr4[hw0Off4 + (uint(gp0.y) * pl.w0 + uint(gp0.x)) * 4u + col4], comp) * FP8_ACT_INV_SCALE)
                    : 0.0;
                float hw1Val = ok1
                    ? (fp8Comp(pyr4[hw0Off4 + (uint(gp1.y) * pl.w0 + uint(gp1.x)) * 4u + col4], comp) * FP8_ACT_INV_SCALE)
                    : 0.0;

                float cand0 = safeTanh(clampHeadRec(accC0[i] * sC + bC));
                float gate0 = safeSigmoid(clampHeadRec(accG0[i] * sG + bG));
                float nh0 = float(float16_t(clamp((1.0 - gate0) * hw0Val + gate0 * cand0, -1.0, 1.0)));

                float cand1 = safeTanh(clampHeadRec(accC1[i] * sC + bC));
                float gate1 = safeSigmoid(clampHeadRec(accG1[i] * sG + bG));
                float nh1 = float(float16_t(clamp((1.0 - gate1) * hw1Val + gate1 * cand1, -1.0, 1.0)));

                float h0x = subgroupShuffle(nh0, cBase + 0u);
                float h0y = subgroupShuffle(nh0, cBase + 1u);
                float h0z = subgroupShuffle(nh0, cBase + 2u);
                float h0w = subgroupShuffle(nh0, cBase + 3u);

                float h1x = subgroupShuffle(nh1, cBase + 0u);
                float h1y = subgroupShuffle(nh1, cBase + 1u);
                float h1z = subgroupShuffle(nh1, cBase + 2u);
                float h1w = subgroupShuffle(nh1, cBase + 3u);

                if (comp == 0u) {
                    if (ok0) {
                        imageStore(uNextNeuralHidden, ivec3(gp0.x, gp0.y, int(col4)), vec4(h0x, h0y, h0z, h0w));
                    }
                    if (ok1) {
                        imageStore(uNextNeuralHidden, ivec3(gp1.x, gp1.y, int(col4)), vec4(h1x, h1y, h1z, h1w));
                    }
                }
            }
        }
    }
}
