        // Stage 5: L0 Full-Res Decoder & Dual Heads (W0 x H0, 32 -> 32 -> 16 & 32 -> 32)
        // =========================================================================
        ivec2 max0 = ivec2(int(pl.w0) - 1, int(pl.h0) - 1);
        uint s0Off4  = pl.offS0  >> 2u;
        uint d1Off4  = pl.offD1  >> 2u;
        uint hw0Off4 = pl.offHw0 >> 2u;

        // 5a. Pipelined constant-trip packed-fp8x4 load of 18x10 halo of u0 (1,440 = 11*128 + 32)
        [[dont_unroll]] for (uint iter = 0u; iter < 11u; ++iter) {
            uint idx4 = tid + iter * 128u;
            uint pix = idx4 >> 3u;
            uint cg = idx4 & 7u;
            int hy = int(pix / 18u);
            int hx = int(pix - uint(hy) * 18u);
            ivec2 np = clamp(tileOrigin + ivec2(hx - 1, hy - 1), ivec2(0), max0);
            vec4 vs = unpackFp8Vec4(pyr4[s0Off4 + (uint(np.y) * pl.w0 + uint(np.x)) * 8u + cg]);
            vec4 vd = unpackFp8Vec4(pyr4[d1Off4 + (uint(np.y >> 1) * pl.w1 + uint(np.x >> 1)) * 8u + cg]);
            vec4 u0 = 0.5 * (vs + vd);
            s_act_b[idx4] = packFp8Vec4(u0.x, u0.y, u0.z, u0.w);
        }
        if (tid < 32u) {
            uint idx4 = tid + 1408u;
            uint pix = idx4 >> 3u;
            uint cg = idx4 & 7u;
            int hy = int(pix / 18u);
            int hx = int(pix - uint(hy) * 18u);
            ivec2 np = clamp(tileOrigin + ivec2(hx - 1, hy - 1), ivec2(0), max0);
            vec4 vs = unpackFp8Vec4(pyr4[s0Off4 + (uint(np.y) * pl.w0 + uint(np.x)) * 8u + cg]);
            vec4 vd = unpackFp8Vec4(pyr4[d1Off4 + (uint(np.y >> 1) * pl.w1 + uint(np.x >> 1)) * 8u + cg]);
            vec4 u0 = 0.5 * (vs + vd);
            s_act_b[idx4] = packFp8Vec4(u0.x, u0.y, u0.z, u0.w);
        }
        barrier();

        // 5b. Vectorized z5 = dec0_dw(u0) -> s_act_a[0..1023], center u0 -> s_act_a[1024..2047]
        {
            uint cg = tid & 7u;
            uint c4 = cg << 2u;
            [[dont_unroll]] for (uint iter = 0u; iter < 8u; ++iter) {
                uint idx4 = tid + iter * 128u;
                uint p = idx4 >> 3u;
                uint lx = p & 15u;
                uint ly = p >> 4u;
                vec4 sum = vec4(0.0);
                [[unroll]] for (uint dy = 0u; dy < 3u; ++dy) {
                    uint rowOff = (ly + dy) * 18u + lx;
                    [[unroll]] for (uint dx = 0u; dx < 3u; ++dx) {
                        uint wBase = DEC0_DW_W_F32_OFFSET + (dy * 3u + dx) * 32u + c4;
                        vec4 dwTap = vec4(w_f32[wBase + 0u], w_f32[wBase + 1u], w_f32[wBase + 2u], w_f32[wBase + 3u]);
                        sum += unpackFp8Vec4(s_act_b[(rowOff + dx) * 8u + cg]) * dwTap;
                    }
                }
                s_act_a[idx4] = packFp8Vec4(sum.x, sum.y, sum.z, sum.w);
                s_act_a[1024u + idx4] = s_act_b[((ly + 1u) * 18u + (lx + 1u)) * 8u + cg];
            }
        }
        barrier();

        // 5c. m5 = lrelu(dec0_pw1(z5)) (32 -> 32) -> s_act_b[0..1023]
        [[dont_unroll]] for (uint ob = 0u; ob < 2u; ++ob) {
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc0, acc1;
            wmmaDualFromActA(sg, 0u, 8u, DEC0_PW1_W_FP8_OFFSET, 2u, ob, acc0, acc1);

            uint c = ob * 16u + col;
            float sc = w_f32[DEC0_PW1_S_F32_OFFSET + c];
            float bc = w_f32[DEC0_PW1_B_F32_OFFSET + c];
            uint outCol4 = ob * 4u + col4;

            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                uint p0 = sg * 32u + mBase + i;
                uint q0 = quadPackClusterFp8(leakyRelu01(acc0[i] * sc + bc), lane);
                uint q1 = quadPackClusterFp8(leakyRelu01(acc1[i] * sc + bc), lane);
                if (comp == 0u) {
