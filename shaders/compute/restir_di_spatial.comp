#version 460

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#include "wavefront_common.glsl"
#include "restir_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 2) readonly buffer InRayGeomQueue {
    RayGeometry inGeoms[];
};

layout(std430, binding = 3) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 4) readonly buffer LightsBuffer {
    Light lights[];
};

layout(std430, binding = 5) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(binding = 6) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(binding = 8, rgba16f) uniform readonly image2D uNormalDepthImage;
layout(binding = 14, r16f) uniform readonly image2D uConfidenceImage;

layout(std430, binding = 11) readonly buffer InTemporalBuffer {
    UnifiedReservoirPT inTemporalReservoirs[];
};

layout(std430, binding = 12) writeonly buffer OutSpatialBuffer {
    UnifiedReservoirPT outSpatialReservoirs[];
};

layout(std430, binding = 13) readonly buffer PixelToRayBuffer {
    uint pixelToRay[];
};

layout(push_constant) uniform ReSTIRPushConstants {
    uint width;
    uint height;
    uint numLights;
    uint frameIndex;
    uint mCap;
    uint numTriangles;
    uint hasLightTree;
    uint passIndex;
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= pc.width || pixelCoord.y >= pc.height) return;

    uint pixelIdx = pixelCoord.y * pc.width + pixelCoord.x;
    uint seed = pixelIdx ^ (pc.frameIndex * 314159265u + 13u);

    UnifiedReservoirPT rCenter = inTemporalReservoirs[pixelIdx];
    vec4 centerNormDepth = imageLoad(uNormalDepthImage, pixelCoord);
    vec3 centerNormal = centerNormDepth.xyz;
    float centerDepth = centerNormDepth.w;

    if (centerDepth <= 0.0) {
        outSpatialReservoirs[pixelIdx] = rCenter;
        return;
    }

    uint rayIdx = pixelToRay[pixelIdx];
    if (rayIdx == 0xFFFFFFFFu) {
        outSpatialReservoirs[pixelIdx] = rCenter;
        return;
    }

    RayGeometry geom = inGeoms[rayIdx];
    RayHit hit = inHits[rayIdx];
    float hitT;
    uint matId, hitType;
    vec3 hitNormal, geomTan;
    vec2 hitUv;
    float tanSign;
    unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

    if (hitType == 2u || hitT <= 0.0) {
        outSpatialReservoirs[pixelIdx] = rCenter;
        return;
    }

    Material mat = materials[matId];
    if ((mat.type & 0xFFu) == 2u /* MATERIAL_DIELECTRIC */ || mat.transmission > 0.001) {
        outSpatialReservoirs[pixelIdx] = rCenter;
        return;
    }

    vec3 origin = geom.originPackedDir.xyz;
    vec3 dir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
    vec3 hitPoint = origin + dir * hitT;
    f16vec3 diffuseAlbedo = f16vec3(mat.albedo.rgb);
    float roughness = mat.roughness;

    // --- PHASE 1: Wave32 Subgroup-Intrinsic Spatial Reuse (Zero VRAM Traffic) ---
    // In a 16x16 workgroup, each 32-thread wave spans a contiguous 16x2 tile.
    // We exchange 4 adjacent orthogonal & diagonal neighbors using zero-latency register shuffles.
    uint lane = gl_SubgroupInvocationID;
    uint partnerLanes[4] = uint[](lane ^ 1u, lane ^ 16u, lane ^ 17u, lane ^ 2u);
    ivec2 partnerOffsets[4] = ivec2[](
        ivec2(((lane & 1u) == 0u) ? 1 : -1, 0),
        ivec2(0, (lane < 16u) ? 1 : -1),
        ivec2(((lane & 1u) == 0u) ? 1 : -1, (lane < 16u) ? 1 : -1),
        ivec2(((lane & 2u) == 0u) ? 2 : -2, 0)
    );

    uint validSubgroupNeighbors = 0u;
    for (int k = 0; k < 4; ++k) {
        uint pLane = partnerLanes[k];
        ivec2 pCoord = pixelCoord + partnerOffsets[k];
        if (pCoord.x >= 0 && pCoord.x < int(pc.width) && pCoord.y >= 0 && pCoord.y < int(pc.height)) {
            vec3 pNorm;
            pNorm.x = subgroupShuffle(centerNormal.x, pLane);
            pNorm.y = subgroupShuffle(centerNormal.y, pLane);
            pNorm.z = subgroupShuffle(centerNormal.z, pLane);
            float pDepth = subgroupShuffle(centerDepth, pLane);

            float pNormDot = dot(centerNormal, pNorm);
            float pDepthDiff = abs(centerDepth - pDepth) / max(centerDepth, 1e-3);

            if (pNormDot >= 0.80 && pDepthDiff <= 0.10) {
                UnifiedReservoirPT rPartner;
                rPartner.lightIndex_M = subgroupShuffle(rCenter.lightIndex_M, pLane);
                rPartner.wSum         = subgroupShuffle(rCenter.wSum, pLane);
                rPartner.flags_uv_age = subgroupShuffle(rCenter.flags_uv_age, pLane);
                rPartner.targetPdf    = subgroupShuffle(rCenter.targetPdf, pLane);

                if (isValidReservoir(rPartner.flags_uv_age)) {
                    uint pPathLen = getPathLength(rPartner.flags_uv_age);
                    if (pPathLen == 1u /* DI */) {
                        uint pLightIdx = getLightIndex(rPartner.lightIndex_M);
                        if (pLightIdx < pc.numLights) {
                            Light light = lights[pLightIdx];
                            vec2 pUV = unpackUV(rPartner.flags_uv_age);
                            float p_hat_partner = evalUnshadowedTargetDI(hitPoint, hitNormal, diffuseAlbedo, light, pUV);
                            combineReservoirsDI(rCenter, rPartner, p_hat_partner, seed);
                            validSubgroupNeighbors++;
                        }
                    }
                }
            }
        }
    }

    // --- PHASE 2: Local Fallback Spatial Sampling (Boundary & Edge Discontinuity) ---
    // Only fetch from VRAM if fewer than 2 subgroup neighbors passed bilateral edge testing.
    if (validSubgroupNeighbors < 2u) {
        float angle = randFloat(seed) * 6.2831853;
        float radius = 1.5 + randFloat(seed) * 2.0; // tight radius <= 3.5px for cache-line locality
        ivec2 offset = ivec2(round(vec2(cos(angle), sin(angle)) * radius));
        ivec2 nCoord = clamp(pixelCoord + offset, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));

        uint nPixelIdx = uint(nCoord.y * int(pc.width) + nCoord.x);
        UnifiedReservoirPT rNeighbor = inTemporalReservoirs[nPixelIdx];
        if (isValidReservoir(rNeighbor.flags_uv_age)) {
            vec4 nNormDepth = imageLoad(uNormalDepthImage, nCoord);
            float normDot = dot(centerNormal, nNormDepth.xyz);
            float depthDiff = abs(centerDepth - nNormDepth.w) / max(centerDepth, 1e-3);
            if (normDot >= 0.80 && depthDiff <= 0.10) {
                uint nPathLen = getPathLength(rNeighbor.flags_uv_age);
                if (nPathLen == 1u /* DI */) {
                    uint neighborLightIdx = getLightIndex(rNeighbor.lightIndex_M);
                    if (neighborLightIdx < pc.numLights) {
                        Light light = lights[neighborLightIdx];
                        vec2 nLuv = unpackUV(rNeighbor.flags_uv_age);
                        float p_hat_at_center = evalUnshadowedTargetDI(hitPoint, hitNormal, diffuseAlbedo, light, nLuv);
                        combineReservoirsDI(rCenter, rNeighbor, p_hat_at_center, seed);
                    }
                }
            }
        }
    }

    // Write completed spatial reservoir (wSum, M, and targetPdf are preserved for shading and next-frame temporal reuse)
    outSpatialReservoirs[pixelIdx] = rCenter;
}
