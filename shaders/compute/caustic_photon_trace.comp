#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
DECLARE_SCENE_TEXTURES_BINDING(8)

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

struct CausticPhotonHit {
    vec4 positionRoughness; // xyz: hit position, w: roughness
    vec4 normalDist;        // xyz: surface normal, w: distance from light
    vec4 flux;              // rgb: radiant flux, w: flags (1.0 = valid, 0.0 = inactive)
    vec4 incidentDir;       // xyz: incoming photon direction, w: material type
};

layout(std430, binding = 20) writeonly buffer CausticPhotonsBuffer {
    CausticPhotonHit outPhotons[];
};

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint photonCount;
    uint frameIndex;
    uint numOpaqueTriangles;
    uint maxBounces;
    vec4 targetBBoxMin; // xyz: min, w: hasTarget
    vec4 targetBBoxMax; // xyz: max, w: pad
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.photonCount) return;

    // Initialize output slot as inactive (only flux.w = 0.0 marks inactive; splat checks flux.w)
    outPhotons[idx].flux = vec4(0.0);

    if (pc.numLights == 0u) return;

    uint seed = uint(idx * 1973u + pc.frameIndex * 9277u) | 1u;

    // 1. Select light source uniformly
    uint lightIdx = uint(randFloat(seed) * float(pc.numLights)) % pc.numLights;
    Light light = lights[lightIdx];
    float lightPickPdf = 1.0 / float(pc.numLights);

    vec3 lightPos;
    vec3 lightNormal = light.normal.xyz;
    float lightArea = light.emission.w;
    vec3 emission = light.emission.rgb;

    if (light.position.w == 0.0 /* Area Quad Light */) {
        vec2 uv = randVec2(seed);
        lightPos = light.position.xyz + uv.x * light.u.xyz + uv.y * light.v.xyz;
        if (lightArea <= 0.0) {
            lightArea = length(cross(light.u.xyz, light.v.xyz));
        }
    } else if (uint(light.position.w) == 1u /* Spot Light */) {
        lightPos = light.position.xyz;
        lightArea = 1.0;
    } else {
        // Point / Directional fallback
        lightPos = light.position.xyz;
        lightArea = 1.0;
    }

    // 2. Sample photon emission direction targeted toward dielectric geometry
    vec3 dir;
    float dirFluxWeight;

    if (pc.targetBBoxMin.w > 0.5) {
        vec3 bMin = pc.targetBBoxMin.xyz;
        vec3 bMax = pc.targetBBoxMax.xyz;
        vec3 bCenter = 0.5 * (bMin + bMax);
        float bRadius = length(bMax - bMin) * 0.55; // 10% safety margin

        vec3 toCenter = bCenter - lightPos;
        float distToCenter = length(toCenter);
        vec3 coneAxis = (distToCenter > 1e-4) ? (toCenter / distToCenter) : lightNormal;

        float sinThetaMax = clamp(bRadius / max(distToCenter, bRadius * 1.01), 0.05, 0.999);
        float cosThetaMax = sqrt(max(0.0, 1.0 - sinThetaMax * sinThetaMax));

        // Sample uniform cone: pdf(omega) = 1 / coneSolidAngle
        float u1 = randFloat(seed);
        float u2 = randFloat(seed);
        float cosTheta = mix(cosThetaMax, 1.0, u1);
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
        float phi = TWO_PI * u2;

        vec3 up = abs(coneAxis.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        vec3 right = normalize(cross(up, coneAxis));
        vec3 forward = cross(coneAxis, right);

        dir = normalize(right * (cos(phi) * sinTheta) + forward * (sin(phi) * sinTheta) + coneAxis * cosTheta);
        float coneSolidAngle = TWO_PI * (1.0 - cosThetaMax);
        float cosLight = (light.position.w == 0.0) ? max(0.0, dot(lightNormal, dir)) : 1.0;
        if (cosLight <= 0.0 && light.position.w == 0.0) {
            return; // Emitted away from area light forward face
        }
        dirFluxWeight = cosLight * coneSolidAngle;
    } else {
        // Cosine hemisphere emission from area light: pdf(omega) = cosLight / PI, so cosLight cancels!
        dir = sampleCosineHemisphere(lightNormal, seed);
        float cosLight = (light.position.w == 0.0) ? max(0.0, dot(lightNormal, dir)) : 1.0;
        if (cosLight <= 0.0 && light.position.w == 0.0) {
            return;
        }
        dirFluxWeight = PI;
    }

    // Initial photon radiant flux: dPhi = (Le * cosLight * dA * dOmega) / pdf
    vec3 photonFlux = (emission * lightArea * dirFluxWeight) / (float(pc.photonCount) * lightPickPdf);

    vec3 rayOrigin = lightPos + lightNormal * EPSILON;
    vec3 rayDir = dir;
    vec3 throughput = vec3(1.0);
    bool hasHitDielectric = false;
    uint dispersionChannel = 0u;
    uint maxBounces = pc.maxBounces > 0u ? pc.maxBounces : 4u;

    // 3. Trace photon forward through specular/dielectric refractive boundaries
    for (uint bounce = 0; bounce < maxBounces; ++bounce) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, rayOrigin, EPSILON, rayDir, 10000.0);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint cInstIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false);
                uint cGeomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, false);
                uint cPrimIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
                InstanceGPU cInst = instances[cInstIdx];
                uint cTriIdx = cInst.firstTriangle + ((cGeomIdx == 0u) ? cPrimIdx : (cPrimIdx + cInst.numOpaqueTriangles));
                Triangle cTri = triangles[cTriIdx];
                Material cMat = materials[cTri.materialId + cInst.materialOffset];
                if (cMat.alphaMode == 1u) {
                    vec2 cBary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                    vec2 cUv = getTriangleUV(cTri, cBary);
                    float cAlpha = cMat.albedo.a;
                    if (cMat.albedoTex > 0u && cMat.albedoTex <= 512u) {
                        cAlpha *= SAMPLE_SCENE_TEXTURE(cMat.albedoTex, cUv).a;
                    }
                    if (cAlpha < cMat.alphaCutoff) {
                        continue;
                    }
                }
                rayQueryConfirmIntersectionEXT(rq);
            }
        }

        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            break; // Flew into empty sky
        }

        float hitT = rayQueryGetIntersectionTEXT(rq, true);
        uint instIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
        uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        InstanceGPU inst = instances[instIdx];
        uint triIdx = inst.firstTriangle + ((geomIdx == 0u) ? primIdx : (primIdx + inst.numOpaqueTriangles));
        uint matId = triangles[triIdx].materialId + inst.materialOffset;
        Material mat = materials[matId];

        bool isDielectric = ((mat.type & 0xFFu) == 2u /* MATERIAL_DIELECTRIC */ || mat.transmission > 0.05f);
        if (!isDielectric && !hasHitDielectric) {
            break; // Direct hit on non-dielectric receiver without passing through caster; handled by direct light
        }

        mat4x3 hitW2o = rayQueryGetIntersectionWorldToObjectEXT(rq, true);
        vec3 hitPoint = rayOrigin + rayDir * hitT;

        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        Triangle tri = triangles[triIdx];
        vec3 localNormal = getTriangleNormal(tri, bary);
        vec3 hitNormal = normalize(transpose(mat3(hitW2o)) * localNormal);

        if (isDielectric) {
            hasHitDielectric = true;
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            vec3 geomN = frontFace ? hitNormal : -hitNormal;

            float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
            if (mat.dispersion > 0.001 && dispersionChannel != 0u) {
                iorVal += (float(dispersionChannel - 1u) - 1.0) * (mat.dispersion * 0.03 * iorVal);
            }
            float eta = frontFace ? (1.0 / iorVal) : iorVal;

            float cosTheta = min(dot(-rayDir, geomN), 1.0);
            float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

            bool cannotRefract = eta * sinTheta > 1.0;
            float reflectProb = fresnelDielectric(cosTheta, eta);

            // Volumetric Beer-Lambert absorption for interior segment before interface scattering
            if (!frontFace && mat.attenuationColor.w > 0.0 && hitT > 0.0) {
                vec3 sigma_a = -log(max(mat.attenuationColor.rgb, vec3(0.0001))) / mat.attenuationColor.w;
                throughput *= exp(-sigma_a * hitT);
            }

            // Refract vs Reflect
            if (cannotRefract || randFloat(seed) < reflectProb) {
                // Fresnel reflection
                rayDir = reflect(rayDir, geomN);
                rayOrigin = hitPoint + geomN * EPSILON;
            } else {
                // Snell's Law refraction (with spectral dispersion support & TIR NaN guard)
                if (mat.dispersion > 0.001 && dispersionChannel == 0u) {
                    uint channel = min(uint(randFloat(seed) * 3.0), 2u);
                    dispersionChannel = channel + 1u;
                    vec3 mask = vec3(channel == 0u ? 3.0 : 0.0, channel == 1u ? 3.0 : 0.0, channel == 2u ? 3.0 : 0.0);
                    throughput *= mask;
                    iorVal += (float(channel) - 1.0) * (mat.dispersion * 0.03 * iorVal);
                    eta = frontFace ? (1.0 / iorVal) : iorVal;
                }
                vec3 refrVec = refract(rayDir, geomN, eta);
                if (dot(refrVec, refrVec) > 1e-6) {
                    rayDir = normalize(refrVec);
                    rayOrigin = hitPoint - geomN * EPSILON;
                    throughput *= mat.albedo.rgb;
                } else {
                    rayDir = reflect(rayDir, geomN);
                    rayOrigin = hitPoint + geomN * EPSILON;
                }
            }
        } else {
            // Hit a non-dielectric (receiver surface!)
            if (hasHitDielectric && (mat.type & 0xFFu) != 3u /* Not emissive light */) {
                bool frontFace = dot(rayDir, hitNormal) < 0.0;
                vec3 receiverNormal = frontFace ? hitNormal : -hitNormal;

                // Successfully formed a caustic path (L -> S+ -> D)!
                vec3 finalFlux = photonFlux * throughput;
                float fluxLum = dot(finalFlux, vec3(0.2126, 0.7152, 0.0722));

                if (fluxLum > 1e-7) {
                    outPhotons[idx].positionRoughness = vec4(hitPoint, mat.roughness);
                    outPhotons[idx].normalDist = vec4(receiverNormal, length(hitPoint - lightPos));
                    outPhotons[idx].flux = vec4(finalFlux, 1.0); // 1.0 = valid active hit
                    outPhotons[idx].incidentDir = vec4(rayDir, float(mat.type));
                }
            }
            break;
        }
    }
}
