#version 450
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 8, local_size_y = 8) in;

// Bindings
layout(binding = 0) uniform image2D uCurrentRadiance;
layout(binding = 1, rg16f) uniform image2D uMotionVectors;
layout(binding = 2, rgba16f) uniform image2D uNormalDepth;
layout(binding = 3) uniform sampler2D uHistoryRadiance;
layout(binding = 4) uniform image2D uResolvedOutput;

layout(push_constant) uniform PushConstants {
    int imageWidth;
    int imageHeight;
    float invImageWidth;
    float invImageHeight;
    uint tileOffsetX;       // 0 = full frame, 1 = primary white tiles, 2 = secondary black tiles
    uint tileOffsetY;       // tile size in Y
    uint tileSize;          // tile size (e.g. 64)
    float blendAlpha;       // default: 0.10 (0.10 current, 0.90 history)
    float clippingGamma;    // default: 1.25 (variance bounding box multiplier)
    uint resetHistory;      // 1 = discard history (scene reload / dynamic switch)
    uint isSampleParallel;  // 1 = sample parallel mode
    uint screenWidth;       // full screen width (e.g. 3840)
} pc;

vec3 rgbToYCoCg(vec3 rgb) {
    float Y  = dot(rgb, vec3( 0.25,  0.50,  0.25));
    float Co = dot(rgb, vec3( 0.50,  0.00, -0.50));
    float Cg = dot(rgb, vec3(-0.25,  0.50, -0.25));
    return vec3(Y, Co, Cg);
}

vec3 yCoCgToRgb(vec3 ycocg) {
    float Y  = ycocg.x;
    float Co = ycocg.y;
    float Cg = ycocg.z;
    return vec3(Y + Co - Cg, Y + Cg, Y - Co - Cg);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.imageWidth || coord.y >= pc.imageHeight) {
        return;
    }

    uint tileSize = (pc.tileSize == 0u) ? 64u : pc.tileSize;
    int tileMinX = 0;
    int tileMaxX = pc.imageWidth - 1;
    int tileMinY = 0;
    int tileMaxY = pc.imageHeight - 1;

    // Checkerboard Tile Parity Check (Symmetric Distributed Tile TAA)
    if (pc.tileOffsetX == 1u) {
        // GPU 0 (Primary): full-screen space, only processes even (white) tiles
        uint tx = uint(coord.x) / tileSize;
        uint ty = uint(coord.y) / tileSize;
        uint parity = (tx + ty) & 1u;
        if (parity != 0u) return;

        tileMinX = int(tx * tileSize);
        tileMaxX = int(min(uint(tileMinX + int(tileSize) - 1), uint(pc.imageWidth - 1)));
        tileMinY = int(ty * tileSize);
        tileMaxY = int(min(uint(tileMinY + int(tileSize) - 1), uint(pc.imageHeight - 1)));
    } else if (pc.tileOffsetX == 2u) {
        // GPU 1 (Secondary): compact half-width space [0, (width+1)/2) x [0, height)
        // Every invocation coord is a valid pixel in an odd tile!
        uint tx = uint(coord.x) / tileSize;
        uint ty = uint(coord.y) / tileSize;

        tileMinX = int(tx * tileSize);
        tileMaxX = int(min(uint(tileMinX + int(tileSize) - 1), uint(pc.imageWidth - 1)));
        tileMinY = int(ty * tileSize);
        tileMaxY = int(min(uint(tileMinY + int(tileSize) - 1), uint(pc.imageHeight - 1)));
    }

    // 1. Gather 3x3 neighborhood in local tile space & evaluate velocity dilation
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 currCenter = imageLoad(uCurrentRadiance, coord).rgb;
    float closestDepth = 1e30;
    ivec2 bestMvCoord = coord;

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 c = coord + ivec2(dx, dy);
            if (pc.tileOffsetX > 0u) {
                c.x = clamp(c.x, tileMinX, tileMaxX);
                c.y = clamp(c.y, tileMinY, tileMaxY);
            } else {
                c.x = clamp(c.x, 0, pc.imageWidth - 1);
                c.y = clamp(c.y, 0, pc.imageHeight - 1);
            }

            vec3 sampleColor = imageLoad(uCurrentRadiance, c).rgb;
            vec3 ycocg = rgbToYCoCg(sampleColor);
            m1 += ycocg;
            m2 += ycocg * ycocg;

            // Closest depth heuristic for foreground velocity dilation
            float d = imageLoad(uNormalDepth, c).w;
            if (d > 0.0 && d < closestDepth) {
                closestDepth = d;
                bestMvCoord = c;
            }
        }
    }

    vec3 mu = m1 * (1.0 / 9.0);
    vec3 sigma = sqrt(max(m2 * (1.0 / 9.0) - mu * mu, vec3(0.0)));
    vec3 boxMin = mu - pc.clippingGamma * sigma;
    vec3 boxMax = mu + pc.clippingGamma * sigma;

    // 2. Fetch screen UV motion vector and convert to pixel offset
    vec2 mv = imageLoad(uMotionVectors, bestMvCoord).xy;
    float fullWidth = (pc.screenWidth > 0u) ? float(pc.screenWidth) : float(pc.imageWidth);
    vec2 pixelOffset = mv * vec2(fullWidth, float(pc.imageHeight));
    vec2 prevCoord = vec2(coord) + vec2(0.5) - pixelOffset;

    // 3. Disocclusion & Tile Boundary Testing
    bool disoccluded = (pc.resetHistory != 0u);
    if (pc.tileOffsetX > 0u) {
        if (prevCoord.x < float(tileMinX) || prevCoord.x > float(tileMaxX) ||
            prevCoord.y < float(tileMinY) || prevCoord.y > float(tileMaxY)) {
            // Motion reprojected across tile boundary into other GPU's domain:
            // Gracefully disocclude and refresh sample without ghosting
            disoccluded = true;
        }
    } else {
        if (prevCoord.x < 0.0 || prevCoord.x > float(pc.imageWidth) ||
            prevCoord.y < 0.0 || prevCoord.y > float(pc.imageHeight)) {
            disoccluded = true;
        }
    }

    // 4. Sample and Variance-Clip History
    vec3 histColor;
    if (disoccluded) {
        histColor = currCenter;
    } else {
        vec2 histTexSize = vec2(textureSize(uHistoryRadiance, 0));
        vec2 prevUv = prevCoord / histTexSize;
        vec4 rawHist = texture(uHistoryRadiance, prevUv);
        vec3 histYCoCg = rgbToYCoCg(rawHist.rgb);
        // Clip history color towards neighborhood mean to prevent ghosting
        vec3 clippedYCoCg = clamp(histYCoCg, boxMin, boxMax);
        histColor = max(yCoCgToRgb(clippedYCoCg), vec3(0.0));
    }

    // 5. Karis High-Dynamic-Range Luminance Weighting
    float lumCurr = dot(currCenter, vec3(0.2126, 0.7152, 0.0722));
    float lumHist = dot(histColor, vec3(0.2126, 0.7152, 0.0722));
    float wCurr = 1.0 / max(1.0 + lumCurr, 1e-4);
    float wHist = 1.0 / max(1.0 + lumHist, 1e-4);

    float alpha = disoccluded ? 1.0 : pc.blendAlpha;
    vec3 resolved = ((1.0 - alpha) * wHist * histColor + alpha * wCurr * currCenter) /
                    max((1.0 - alpha) * wHist + alpha * wCurr, 1e-4);

    resolved = clamp(resolved, vec3(0.0), vec3(65000.0));

    imageStore(uResolvedOutput, coord, vec4(resolved, 1.0));
}
