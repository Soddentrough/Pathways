#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "wavefront_common.glsl"
#include "procedural_noise.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[512];

layout(std430, binding = 9) readonly buffer InRayStateQueue {
    RayState inStates[];
};

layout(std430, binding = 10) writeonly buffer OutRayStateQueue {
    RayState outStates[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint diffuseCount; // Standard count
    uint complexCount;
    uint dielectricCount;
    uint emissiveCount;
    uint conductorCount; // Reserved
    uint alphamaskCount; // Reserved
    uint nextDiffuseCount;
    uint nextComplexCount;
    uint nextDielectricCount;
    uint nextEmissiveCount;
    uint nextConductorCount; // Reserved
    uint nextAlphamaskCount; // Reserved
    uint currentMaterialCounts[4];
    uint padMat[2];
    uint totalShadeWorkgroups;
    uint octantCounts[8];
    uint currentOctantCounts[8];
    uint totalIntersectWorkgroups;
    uint secondaryRayCount;
    uint activeMaterialSequenceCount;
    uint pad[20];
} queueCounters;

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 15) readonly buffer InRayGeomQueue {
    RayGeometry inGeoms[];
};

layout(std430, binding = 16) writeonly buffer OutRayGeomQueue {
    RayGeometry outGeoms[];
};

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 18) readonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(std430, binding = 19) writeonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
    uint useHardwareRT;
    uint secondarySortMode;
    uint enableNrc;
    uint nrcBounce;
    float nrcTrainRatio;
    uint frameIndex;
    uint numOpaqueTriangles;
    uint captureMlData;
    float indirectClamp;
    uint deltaUnroll;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint activeCount = queueCounters.currentMaterialCounts[2]; // Dielectric queue
    bool inRange = (idx < activeCount);
    bool survivesToNext = false;
    vec3 nextDirection = vec3(0.0);
    RayGeometry nextGeom;
    RayState nextState;

    if (inRange) {
        uint rayIdx = materialIndices[2u * pc.maxQueueCapacity + idx];
        RayGeometry geom = inGeoms[rayIdx];
        RayHit hit = inHits[rayIdx];
        RayState state = inStates[rayIdx];

        vec3 origin = geom.originPackedDir.xyz;
        vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        float hitT;
        uint matId, hitType;
        vec3 hitNormal, geomTan;
        vec2 hitUv;
        float tanSign;
        unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

        f16vec3 throughputHalf;
        uint seed, pixelIndex;
        bool isSpecularPath, causticApplied;
        uint dispersionChannel = 0u;
        unpackRayState(state, throughputHalf, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
        vec3 throughput = vec3(throughputHalf);
        uint bounce = pc.currentBounce;

        if (hitType == 2u) {
            // Environment sky miss
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            vec3 skyContrib = throughput * skyColor;
            if (bounce > 0u) {
                skyContrib = clampIndirectRadiance(skyContrib, pc.indirectClamp);
            }
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), 0.0));
            if (pc.captureMlData != 0u) {
                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), 0.0));
            }
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            hitNormal = frontFace ? hitNormal : -hitNormal;
            vec2 effHitUv = hitUv;
            if (!frontFace) {
                effHitUv.x = 1.0 - effHitUv.x;
            }

            Material mat = materials[matId];
            bool isWater = ((mat.type & MATERIAL_FLAG_PROCEDURAL_WATER) != 0u) || (mat.normalTex == 0xFFFFFF03u);
            if (isWater && frontFace) {
                float time = float(pc.frameIndex) * 0.01666667;
                vec3 waveOffset;
                vec3 waveN = evaluateWaterWaves(hitPoint, time, waveOffset);
                hitNormal = normalize(mix(hitNormal, waveN, clamp(mat.normalScale, 0.0, 1.0)));
            } else if (bounce == 0u && hitType == 0u && mat.normalTex > 0u && mat.normalTex <= 512u) {
                vec3 normalMap = SAMPLE_SCENE_TEXTURE(mat.normalTex, hitUv).rgb * 2.0 - 1.0;
                normalMap.xy *= mat.normalScale;
                normalMap = normalize(normalMap);

                vec3 orthoTan = geomTan - dot(geomTan, hitNormal) * hitNormal;
                float tanLenSq = dot(orthoTan, orthoTan);
                if (tanLenSq > 1e-6) {
                    geomTan = orthoTan * inversesqrt(tanLenSq);
                } else {
                    vec3 up = abs(hitNormal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
                    geomTan = normalize(cross(up, hitNormal));
                }
                vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                hitNormal = normalize(tbn * normalMap);
            }
            vec4 baseColor = mat.albedo;
            if (mat.albedoTex > 0u && mat.albedoTex <= 512u) {
                baseColor *= SAMPLE_SCENE_TEXTURE(mat.albedoTex, hitUv);
            }

            vec3 emissive = mat.emissive.rgb;
            if (mat.emissiveTex > 0u && mat.emissiveTex <= 512u) {
                emissive *= SAMPLE_SCENE_TEXTURE(mat.emissiveTex, hitUv).rgb;
            }
            if (length(emissive) > 1e-3) {
                vec3 emissiveContrib = throughput * emissive;
                if (bounce > 0u) {
                    emissiveContrib = clampIndirectRadiance(emissiveContrib, pc.indirectClamp);
                }
                ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, emissiveContrib, seed), prev.a));
                if (pc.captureMlData != 0u) {
                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, emissiveContrib, seed), 0.0));
                }
            }

            bool pathTerminated = false;
            if ((mat.type & MATERIAL_TYPE_MASK) == 3u /* MATERIAL_EMISSIVE */) {
                pathTerminated = true;
            }

            if (!pathTerminated) {
                float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;

                // KHR_materials_dispersion: Spectral wavelength sampling
                if (mat.dispersion > 0.001) {
                    bool alreadyDispersed = (throughput.r > 0.0 && throughput.g == 0.0 && throughput.b == 0.0) ||
                                            (throughput.g > 0.0 && throughput.r == 0.0 && throughput.b == 0.0) ||
                                            (throughput.b > 0.0 && throughput.r == 0.0 && throughput.g == 0.0);
                    uint channel;
                    if (alreadyDispersed) {
                        channel = (throughput.r > 0.0) ? 0u : ((throughput.g > 0.0) ? 1u : 2u);
                    } else {
                        channel = min(uint(randFloat(seed) * 3.0), 2u);
                        vec3 mask = vec3(channel == 0u ? 3.0 : 0.0, channel == 1u ? 3.0 : 0.0, channel == 2u ? 3.0 : 0.0);
                        throughput *= mask;
                    }
                    float dispDelta = (float(channel) - 1.0) * (mat.dispersion * 0.03 * iorVal);
                    iorVal += dispDelta;
                }

                float eta = frontFace ? (1.0 / iorVal) : iorVal;
                vec3 V = -rayDir;
                float cosTheta = min(dot(V, hitNormal), 1.0);
                float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                bool cannotRefract = eta * sinTheta > 1.0;
                float reflectProb = fresnelDielectric(cosTheta, eta);

                // KHR_materials_iridescence
                if (mat.iridescence > 0.001) {
                    vec3 iridColor = evalThinFilmIridescence(cosTheta, mat.iridescenceIor, mat.iridescenceThickness > 0.0 ? mat.iridescenceThickness : 350.0);
                    reflectProb = mix(reflectProb, clamp(dot(iridColor, vec3(0.333)), 0.0, 1.0), mat.iridescence);
                }

                bool isThinWalled = (mat.thickness <= 0.001) && !isWater;
                if (isThinWalled) {
                    if (!frontFace) {
                        // Exiting thin-walled slab (e.g. 4mm double-walled car glass): passthrough with 0 reflection to avoid TIR trapping
                        reflectProb = 0.0;
                        cannotRefract = false;
                    } else {
                        reflectProb = (2.0 * reflectProb) / (1.0 + reflectProb);
                    }
                }

                nextDirection = vec3(0.0);
                vec3 nextOrigin;

                float rFlip = (pc.secondarySortMode >= 2u)
                    ? randFloatCoherent(seed, (pc.secondarySortMode == 3u) ? 8u : 4u, pc.frameIndex + pc.currentBounce * 3u)
                    : randFloat(seed);

                if (cannotRefract || rFlip < reflectProb) {
                    // Specular reflection: achromatic Fresnel reflection (preserves white highlights)
                    nextDirection = reflect(rayDir, hitNormal);
                    nextOrigin = hitPoint + hitNormal * EPSILON;
                } else {
                    if (isThinWalled) {
                        // Thin-walled transmission: direct ray passthrough without refraction deviation
                        nextDirection = rayDir;
                        nextOrigin = hitPoint + rayDir * (EPSILON * 2.0);
                    } else {
                        // Snell's law refraction: entering dispersive medium for the first time
                        if (mat.dispersion > 0.001 && dispersionChannel == 0u) {
                            uint channel = min(uint(randFloat(seed) * 3.0), 2u);
                            dispersionChannel = channel + 1u;
                            vec3 mask = vec3(channel == 0u ? 3.0 : 0.0, channel == 1u ? 3.0 : 0.0, channel == 2u ? 3.0 : 0.0);
                            throughput *= mask;
                            float dispDelta = (float(channel) - 1.0) * (mat.dispersion * 0.03 * iorVal);
                            iorVal += dispDelta;
                            eta = frontFace ? (1.0 / iorVal) : iorVal;
                        }
                        nextDirection = normalize(refract(rayDir, hitNormal, eta));
                        nextOrigin = hitPoint - hitNormal * EPSILON;
                    }
                    throughput *= baseColor.rgb;
                }

                // Volumetric Beer-Lambert absorption (physical ray traversal distance)
                if (!isThinWalled) {
                    float mediumDist = !frontFace ? hitT : 0.0;
                    vec4 atten = mat.attenuationColor;
                    if (isWater && atten.w <= 0.0) {
                        atten = vec4(0.3, 0.7, 0.9, 4.0);
                    }
                    if (atten.w > 0.0 && mediumDist > 0.0) {
                        vec3 sigma_a = -log(max(atten.rgb, vec3(0.0001))) / atten.w;
                        throughput *= exp(-sigma_a * mediumDist);
                    }
                }

                bool entersMedium = frontFace && !isThinWalled && (!cannotRefract && rFlip >= reflectProb);

                // Delta-Chain Unrolling: Collapse internal volume transmission and exit interface
                // Strictly restricted to primary camera rays (bounce == 0u) where Wave32 lanes maintain
                // maximal spatial and directional coherence, avoiding divergent inline BVH thrashing.
                if (bounce == 0u && entersMedium && (ubo.flags & (1u << 11)) != 0u && bounce + 1u < pc.maxBounces) {
                    vec3 curOrigin = nextOrigin;
                    vec3 curDir = nextDirection;

                    rayQueryEXT rq;
                    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, curOrigin, EPSILON, curDir, 10000.0);
                    rayQueryProceedEXT(rq);

                    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
                        // Escaped mesh boundary directly to sky/environment
                        vec3 skyColor;
                        if (pc.hasEnvMap == 1u) {
                            vec2 envUv = directionToEquirectangular(curDir);
                            skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
                        } else {
                            float t = 0.5 * (curDir.y + 1.0);
                            skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
                        }
                        vec3 skyContrib = throughput * skyColor;
                        if (bounce > 0u) {
                            skyContrib = clampIndirectRadiance(skyContrib, pc.indirectClamp);
                        }
                        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                        vec4 prev = imageLoad(uAccumImage, pixelCoord);
                        imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), 0.0));
                        if (pc.captureMlData != 0u) {
                            vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                            imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), 0.0));
                        }
                        pathTerminated = true;
                    } else {
                        // Committed hit on internal mesh boundary
                        float intHitT = rayQueryGetIntersectionTEXT(rq, true);
                        uint instIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
                        uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
                        uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
                        InstanceGPU inst = instances[instIdx];
                        uint triIdx = inst.firstTriangle + ((geomIdx == 0u) ? primIdx : (primIdx + inst.numOpaqueTriangles));
                        uint hitMatId = triangles[triIdx].materialId + inst.materialOffset;
                        uint arch = (hitMatId < pc.numMaterials) ? materialArchetypes[hitMatId] : 2u;

                        // Only unroll delta chain if ray hits the backface of the SAME dielectric material (clean exit back to exterior/air).
                        // If it strikes a nested dielectric (e.g. glass-to-water) or an opaque interior object, abort unroll and let
                        // wavefront bounce queue handle the interface transition with accurate relative IOR and BRDF evaluation.
                        if (hitMatId == matId && arch == 2u) {
                            // Volumetric Beer-Lambert absorption for internal segment
                            vec4 atten = mat.attenuationColor;
                            if (isWater && atten.w <= 0.0) {
                                atten = vec4(0.3, 0.7, 0.9, 4.0);
                            }
                            if (atten.w > 0.0 && intHitT > 0.0) {
                                vec3 sigma_a = -log(max(atten.rgb, vec3(0.0001))) / atten.w;
                                throughput *= exp(-sigma_a * intHitT);
                            }

                            Triangle exitTri = triangles[triIdx];
                            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
                            mat4x3 w2o = rayQueryGetIntersectionWorldToObjectEXT(rq, true);
                            vec3 localNorm = getTriangleNormal(exitTri, bary);
                            vec3 intNormal = normalize(transpose(mat3(w2o)) * localNorm);

                            // Ray is inside medium hitting back face: orient normal to oppose ray direction
                            if (dot(curDir, intNormal) > 0.0) {
                                intNormal = -intNormal;
                            }

                            vec3 intHitPoint = curOrigin + intHitT * curDir;
                            float exitEta = iorVal; // glass -> air: eta = n_glass / n_air = iorVal
                            float exitCosTheta = clamp(dot(-curDir, intNormal), 0.0, 1.0);
                            float exitReflectProb = fresnelDielectric(exitCosTheta, exitEta);

                            float rExit = randFloat(seed);
                            if (exitReflectProb >= 1.0 || rExit < exitReflectProb) {
                                // Total Internal Reflection (TIR) inside medium: reflect and emit for next bounce
                                nextDirection = reflect(curDir, intNormal);
                                nextOrigin = intHitPoint + intNormal * 0.0005;
                                bounce += 1u;
                            } else {
                                // Refract OUT of the glass into air!
                                vec3 exitDir = normalize(refract(curDir, intNormal, exitEta));
                                nextDirection = exitDir;
                                nextOrigin = intHitPoint - intNormal * 0.0005;
                                bounce += 1u;
                            }
                        }
                    }
                }

                if (bounce + 1u >= pc.maxBounces) {
                    pathTerminated = true;
                } else {
                    float maxThresh = max(throughput.r, max(throughput.g, throughput.b)) * float(max(ubo.spp, 1u));
                    if (maxThresh < 0.001) {
                        pathTerminated = true;
                    } else if (bounce >= 2u) {
                        pathTerminated = applyRussianRoulette(throughput, maxThresh, bounce, seed);
                    }

                    if (!pathTerminated) {
                        survivesToNext = true;
                        nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                        nextState = packRayState(f16vec3(throughput), seed, pixelIndex, true, causticApplied, dispersionChannel);

                        // Delta-Chain Unrolling: Unroll consecutive smooth dielectric events on-chip
                        if (pc.deltaUnroll > 0u && pc.useHardwareRT == 1u && (bounce + 1u < pc.maxBounces)) {
                            uint maxDelta = pc.deltaUnroll;
                            vec3 currOrigin = nextOrigin;
                            vec3 currDirection = nextDirection;
                            uint currBounce = bounce + 1u;
                            uint deltaEvents = 1u;

                            while (survivesToNext && deltaEvents < maxDelta && currBounce < pc.maxBounces) {
                                float closestT = 10000.0;
                                int closestTri = -1;
                                vec2 closestBary = vec2(0.0);
                                int closestSphere = -1;
                                mat4x3 hitW2o = mat4x3(1.0);
                                mat4x3 hitO2w = mat4x3(1.0);
                                uint hitInstMatOffset = 0u;

                                rayQueryEXT rq;
                                rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, currOrigin, EPSILON, currDirection, closestT);
                                rayQueryProceedEXT(rq);

                                if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                                    closestT = rayQueryGetIntersectionTEXT(rq, true);
                                    uint instIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
                                    uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
                                    uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
                                    InstanceGPU inst = instances[instIdx];
                                    closestTri = int(inst.firstTriangle + ((geomIdx == 0u) ? primIdx : (primIdx + inst.numOpaqueTriangles)));
                                    closestBary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
                                    hitW2o = rayQueryGetIntersectionWorldToObjectEXT(rq, true);
                                    hitO2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
                                    hitInstMatOffset = inst.materialOffset;
                                }

                                if (pc.numSpheres > 0u) {
                                    for (uint s = 0u; s < pc.numSpheres; ++s) {
                                        float spT;
                                        vec3 spNorm;
                                        if (intersectSphere(currOrigin, currDirection, spheres[s], EPSILON, closestT, spT, spNorm)) {
                                            closestT = spT;
                                            closestSphere = int(s);
                                            closestTri = -1;
                                        }
                                    }
                                }

                                // Miss: ray escaped out of glass into sky / environment
                                if (closestTri < 0 && closestSphere < 0) {
                                    vec3 skyColor;
                                    if (pc.hasEnvMap == 1u) {
                                        vec2 envUv = directionToEquirectangular(currDirection);
                                        skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
                                    } else {
                                        float t = 0.5 * (currDirection.y + 1.0);
                                        skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
                                    }
                                    vec3 skyContrib = clampIndirectRadiance(throughput * skyColor, pc.indirectClamp);
                                    ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                    imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), prev.a));
                                    if (pc.captureMlData != 0u) {
                                        vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                        imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), 0.0));
                                    }
                                    survivesToNext = false;
                                    break;
                                }

                                // Hit surface: examine material
                                vec3 dHitNormal;
                                vec2 dHitUv = vec2(0.0);
                                uint dMatId = 0u;

                                if (closestTri >= 0) {
                                    Triangle tri = triangles[closestTri];
                                    vec3 localNormal = getTriangleNormal(tri, closestBary);
                                    dHitNormal = normalize(transpose(mat3(hitW2o)) * localNormal);
                                    dHitUv = getTriangleUV(tri, closestBary);
                                    dMatId = tri.materialId + hitInstMatOffset;
                                } else {
                                    dHitNormal = (currOrigin + closestT * currDirection - spheres[closestSphere].centerRadius.xyz) / spheres[closestSphere].centerRadius.w;
                                    dMatId = spheres[closestSphere].materialId;
                                }

                                uint dArchetype = (dMatId < pc.numMaterials) ? materialArchetypes[dMatId] : MATERIAL_ARCHETYPE_DIFFUSE;
                                if (dArchetype != MATERIAL_ARCHETYPE_DIELECTRIC) {
                                    nextGeom.originPackedDir = vec4(currOrigin, uintBitsToFloat(packOct32(currDirection)));
                                    nextState = packRayState(f16vec3(throughput), seed, pixelIndex, true, causticApplied, dispersionChannel);
                                    nextDirection = currDirection;
                                    survivesToNext = true;
                                    break;
                                }

                                Material dMat = materials[dMatId];
                                bool isWaterD = ((dMat.type & MATERIAL_FLAG_PROCEDURAL_WATER) != 0u) || (dMat.normalTex == 0xFFFFFF03u);

                                // If non-dielectric, rough, textured, or emissive, emit ray for specialized downstream microkernels
                                if (dMat.roughness > 0.05 || 
                                    dMat.albedoTex > 0u || dMat.normalTex > 0u || dMat.emissiveTex > 0u ||
                                    length(dMat.emissive.rgb) > 1e-3 || dMat.iridescence > 0.001 || isWaterD) {
                                    nextGeom.originPackedDir = vec4(currOrigin, uintBitsToFloat(packOct32(currDirection)));
                                    nextState = packRayState(f16vec3(throughput), seed, pixelIndex, true, causticApplied, dispersionChannel);
                                    nextDirection = currDirection;
                                    survivesToNext = true;
                                    break;
                                }

                                // Pure Smooth Dielectric: evaluate interface in fast registers
                                deltaEvents++;
                                vec3 dHitPoint = currOrigin + closestT * currDirection;
                                bool dFrontFace = dot(currDirection, dHitNormal) < 0.0;
                                dHitNormal = dFrontFace ? dHitNormal : -dHitNormal;

                                float dIor = dMat.ior > 0.0 ? dMat.ior : 1.5;
                                if (dMat.dispersion > 0.001 && dispersionChannel != 0u) {
                                    uint channel = dispersionChannel - 1u;
                                    float dispDelta = (float(channel) - 1.0) * (dMat.dispersion * 0.03 * dIor);
                                    dIor += dispDelta;
                                }

                                float dEta = dFrontFace ? (1.0 / dIor) : dIor;
                                vec3 dV = -currDirection;
                                float dCosTheta = min(dot(dV, dHitNormal), 1.0);
                                float dSinTheta = sqrt(max(0.0, 1.0 - dCosTheta * dCosTheta));

                                bool dCannotRefract = dEta * dSinTheta > 1.0;
                                float dReflectProb = fresnelDielectric(dCosTheta, dEta);

                                bool isThinWalledD = (dMat.thickness <= 0.001);
                                if (isThinWalledD) {
                                    if (!dFrontFace) {
                                        dReflectProb = 0.0;
                                        dCannotRefract = false;
                                    } else {
                                        dReflectProb = (2.0 * dReflectProb) / (1.0 + dReflectProb);
                                    }
                                }

                                float rFlipD = randFloat(seed);
                                if (dCannotRefract || rFlipD < dReflectProb) {
                                    currDirection = reflect(currDirection, dHitNormal);
                                    currOrigin = dHitPoint + dHitNormal * EPSILON;
                                } else {
                                    if (isThinWalledD) {
                                        currOrigin = dHitPoint + currDirection * (EPSILON * 2.0);
                                    } else {
                                        if (dMat.dispersion > 0.001 && dispersionChannel == 0u) {
                                            uint channel = min(uint(randFloat(seed) * 3.0), 2u);
                                            dispersionChannel = channel + 1u;
                                            vec3 mask = vec3(channel == 0u ? 3.0 : 0.0, channel == 1u ? 3.0 : 0.0, channel == 2u ? 3.0 : 0.0);
                                            throughput *= mask;
                                            float dispDelta = (float(channel) - 1.0) * (dMat.dispersion * 0.03 * dIor);
                                            dIor += dispDelta;
                                            dEta = dFrontFace ? (1.0 / dIor) : dIor;
                                        }
                                        currDirection = normalize(refract(currDirection, dHitNormal, dEta));
                                        currOrigin = dHitPoint - dHitNormal * EPSILON;
                                    }
                                    throughput *= dMat.albedo.rgb;
                                }

                                // Volumetric Beer-Lambert absorption
                                if (!isThinWalledD) {
                                    float mediumDist = !dFrontFace ? closestT : 0.0;
                                    vec4 atten = dMat.attenuationColor;
                                    if (atten.w > 0.0 && mediumDist > 0.0) {
                                        vec3 sigma_a = -log(max(atten.rgb, vec3(0.0001))) / atten.w;
                                        throughput *= exp(-sigma_a * mediumDist);
                                    }
                                }

                                currBounce++;
                                if (currBounce >= pc.maxBounces) {
                                    survivesToNext = false;
                                    break;
                                }

                                float maxThresh = max(throughput.r, max(throughput.g, throughput.b)) * float(max(ubo.spp, 1u));
                                if (maxThresh < 0.001) {
                                    survivesToNext = false;
                                    break;
                                }
                                if (currBounce >= 2u && applyRussianRoulette(throughput, maxThresh, currBounce, seed)) {
                                    survivesToNext = false;
                                    break;
                                }

                                nextGeom.originPackedDir = vec4(currOrigin, uintBitsToFloat(packOct32(currDirection)));
                                nextState = packRayState(f16vec3(throughput), seed, pixelIndex, true, causticApplied, dispersionChannel);
                                nextDirection = currDirection;
                                survivesToNext = true;
                            }
                        }
                    }
                }
            }
        }
    }

    // Standard single-queue linear compaction for ray geometry and state
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (waveActiveCount > 0u) {
        if (subgroupElect()) {
            waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);
    }

    uint targetIdx = waveGlobalOffset + laneSlot;
    if (survivesToNext) {
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    if (pc.secondarySortMode == 1u && waveActiveCount > 0u) {
        // Producer-Side Binning: Record compacted ray indices into 8 directional octant queues
        uint oct = survivesToNext ? getDirectionalOctant(nextDirection) : 0u;
        uvec4 activeBallot = subgroupBallot(survivesToNext);
        while (subgroupBallotBitCount(activeBallot) > 0u) {
            uint leaderLane = subgroupBallotFindLSB(activeBallot);
            uint k = subgroupBroadcast(oct, leaderLane);
            bool isOct = survivesToNext && (oct == k);
            uvec4 octBallot = subgroupBallot(isOct);
            uint octCount = subgroupBallotBitCount(octBallot);
            uint octSlot = subgroupBallotExclusiveBitCount(octBallot);
            uint octBase = 0u;
            if (gl_SubgroupInvocationID == leaderLane) {
                octBase = atomicAdd(queueCounters.octantCounts[k], octCount);
            }
            octBase = subgroupBroadcast(octBase, leaderLane);
            if (isOct) {
                uint dest = k * pc.maxQueueCapacity + (octBase + octSlot);
                if (octBase + octSlot < pc.maxQueueCapacity) {
                    secondaryIndices[dest] = targetIdx;
                }
            }
            activeBallot.x &= ~octBallot.x;
            activeBallot.y &= ~octBallot.y;
            activeBallot.z &= ~octBallot.z;
            activeBallot.w &= ~octBallot.w;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == queueCounters.totalShadeWorkgroups - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.commands[b * 16u + 6u].x = shadowGroups;
            indirect.commands[b * 16u + 6u].y = 1u;
            indirect.commands[b * 16u + 6u].z = 1u;
            indirect.commands[b * 16u + 6u].pad = shadowCount;

            dgcStream.commands[b * 16u + 6u].pipelineIndex = 3u; // Shadow pipeline
            dgcStream.commands[b * 16u + 6u].x = shadowGroups;
            dgcStream.commands[b * 16u + 6u].y = 1u;
            dgcStream.commands[b * 16u + 6u].z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            uint intersectGroups = (nextCount + 31u) / 32u;

            // Slot 7: Standard monolithic / Option 2 intersect dispatch
            indirect.commands[b * 16u + 7u].x = intersectGroups;
            indirect.commands[b * 16u + 7u].y = 1u;
            indirect.commands[b * 16u + 7u].z = 1u;
            indirect.commands[b * 16u + 7u].pad = nextCount;

            dgcStream.commands[b * 16u + 7u].pipelineIndex = 1u; // Intersect pipeline
            dgcStream.commands[b * 16u + 7u].x = intersectGroups;
            dgcStream.commands[b * 16u + 7u].y = 1u;
            dgcStream.commands[b * 16u + 7u].z = 1u;

            // Slots 8..15: Producer-Side Binning Directional DGC intersect dispatches
            uint totalIntersectWgs = 0u;
            uint totalOctantRays = 0u;
            if (pc.secondarySortMode == 1u) {
                for (uint k = 0u; k < 8u; ++k) {
                    uint octCnt = queueCounters.octantCounts[k];
                    queueCounters.currentOctantCounts[k] = octCnt;
                    uint octGroups = (octCnt + 31u) / 32u;
                    totalIntersectWgs += octGroups;
                    totalOctantRays += octCnt;

                    indirect.commands[b * 16u + 8u + k].x = octGroups;
                    indirect.commands[b * 16u + 8u + k].y = 1u;
                    indirect.commands[b * 16u + 8u + k].z = 1u;
                    indirect.commands[b * 16u + 8u + k].pad = octCnt;

                    dgcStream.commands[b * 16u + 8u + k].pipelineIndex = 1u;
                    dgcStream.commands[b * 16u + 8u + k].x = octGroups;
                    dgcStream.commands[b * 16u + 8u + k].y = 1u;
                    dgcStream.commands[b * 16u + 8u + k].z = 1u;

                    queueCounters.octantCounts[k] = 0u;
                }
            } else {
                totalIntersectWgs = intersectGroups;
                totalOctantRays = nextCount;
            }
            queueCounters.totalIntersectWorkgroups = totalIntersectWgs;
            queueCounters.secondaryRayCount = totalOctantRays;

            if (pc.secondarySortMode == 2u) {
                indirect.commands[b * 16u + 8u].x = intersectGroups;
                indirect.commands[b * 16u + 8u].y = 1u;
                indirect.commands[b * 16u + 8u].z = 1u;
                indirect.commands[b * 16u + 8u].pad = nextCount;
            }

            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces) ? totalOctantRays : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
