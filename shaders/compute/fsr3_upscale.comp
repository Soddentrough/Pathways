#version 450
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

// Binding 0: Render-resolution linear HDR radiance
layout(binding = 0) uniform image2D uRenderColor;

// Binding 1: Screen-space motion vectors (RG16F, containing surface delta UV = currUV - prevUV)
layout(binding = 1) uniform image2D uMotionVectors;

// Binding 2: Primary hit Normal & Linear Depth (RGBA16F, RGB: normal, A: depth)
layout(binding = 2) uniform image2D uNormalDepth;

// Binding 3: Previous frame 4K history (RGBA16F)
layout(binding = 3) uniform image2D uHistoryInput;

// Binding 4: Output new 4K history (RGBA16F, writeonly)
layout(binding = 4, rgba16f) uniform writeonly image2D uHistoryOutput;

// Binding 5: Output display-resolution upscaled linear radiance for RCAS (RGBA16F, writeonly)
layout(binding = 5, rgba16f) uniform writeonly image2D uUpscaledOutput;

layout(push_constant) uniform PushConstants {
    uint renderWidth;
    uint renderHeight;
    uint displayWidth;
    uint displayHeight;
    float invRenderWidth;
    float invRenderHeight;
    float invDisplayWidth;
    float invDisplayHeight;
    float invTotalSamples;
    float temporalWeight;
    float jitterX;
    float jitterY;
    uint frameIndex;
    uint resetHistory;
    uint cameraMoved;
    uint isInputNormalized;
} pc;

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 tonemapKaris(vec3 c) {
    return c / (1.0 + luma(c));
}

vec3 invTonemapKaris(vec3 c) {
    float l = luma(c);
    // Bounded inverse tone curve: guarantees maximum amplification factor is strictly <= 20.0
    return c / max(1.0 - min(l, 0.95), 0.05);
}

vec3 RGBToYCoCg(vec3 rgb) {
    float y  =  0.25 * rgb.r + 0.5 * rgb.g + 0.25 * rgb.b;
    float co =  0.5  * rgb.r               - 0.5  * rgb.b;
    float cg = -0.25 * rgb.r + 0.5 * rgb.g - 0.25 * rgb.b;
    return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
    float y  = ycocg.r;
    float co = ycocg.g;
    float cg = ycocg.b;
    float r = y + co - cg;
    float g = y + cg;
    float b = y - co - cg;
    return max(vec3(r, g, b), vec3(0.0));
}

float lanczos2(float d) {
    float d_abs = abs(d);
    if (d_abs < 1e-6) return 1.0;
    if (d_abs >= 2.0) return 0.0;
    float pi_d = 3.14159265359 * d_abs;
    return (sin(pi_d) / pi_d) * (sin(pi_d * 0.5) / (pi_d * 0.5));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.displayWidth) || pixelCoord.y >= int(pc.displayHeight)) {
        return;
    }

    vec2 scale = vec2(float(pc.renderWidth), float(pc.renderHeight)) / vec2(float(pc.displayWidth), float(pc.displayHeight));
    // Offset srcPos by subpixel projection jitter so Lanczos kernel is centered exactly on the jittered sample
    // When stationary accumulating, uRenderColor is already the unjittered accumulated average centered at (0, 0)
    vec2 jitterOffset = (pc.cameraMoved == 0u && pc.invTotalSamples < 0.99) ? vec2(0.0) : vec2(pc.jitterX, pc.jitterY);
    vec2 srcPos = (vec2(pixelCoord) + vec2(0.5)) * scale - vec2(0.5) - jitterOffset;
    ivec2 baseCoord = ivec2(floor(srcPos));
    vec2 frac = srcPos - vec2(baseCoord);
    ivec2 maxCoord = ivec2(int(pc.renderWidth) - 1, int(pc.renderHeight) - 1);

    // 1. Direct 4x4 Lanczos-2 accumulation and Karis-space statistics
    // Streaming tap reads directly from image cache eliminates 784-byte scratch allocations.
    vec3 sumColor = vec3(0.0);
    float sumW = 0.0;
    vec3 m1_ycocg = vec3(0.0);
    vec3 m2_ycocg = vec3(0.0);
    vec3 boxMin = vec3(1e9);
    vec3 boxMax = vec3(-1e9);
    float centerDepth = 0.0;
    vec3 centerTapRgb = vec3(0.0);
    vec3 centerNorm = vec3(0.0);

    int startX = (frac.x < 0.5) ? 0 : 1;
    int startY = (frac.y < 0.5) ? 0 : 1;

    for (int ky = 0; ky < 4; ++ky) {
        int sy = clamp(baseCoord.y + (ky - 1), 0, maxCoord.y);
        float wy = lanczos2(float(ky - 1) - frac.y);
        for (int kx = 0; kx < 4; ++kx) {
            int sx = clamp(baseCoord.x + (kx - 1), 0, maxCoord.x);
            float wx = lanczos2(float(kx - 1) - frac.x);
            float w = wx * wy;

            ivec2 c = ivec2(sx, sy);
            float sampleScale = (pc.isInputNormalized == 1u) ? 1.0 : pc.invTotalSamples;
            vec3 sRgb = imageLoad(uRenderColor, c).rgb * sampleScale;
            sRgb = max(sRgb, vec3(0.0));
            if (isnan(sRgb.r) || isinf(sRgb.r) || isnan(sRgb.g) || isinf(sRgb.g) || isnan(sRgb.b) || isinf(sRgb.b)) {
                sRgb = vec3(0.0);
            }

            vec3 sKaris = tonemapKaris(sRgb);
            sumColor += sKaris * w;
            sumW += w;

            if (ky == 1 && kx == 1) {
                centerTapRgb = sRgb;
                vec4 nd = imageLoad(uNormalDepth, c);
                centerNorm = nd.xyz;
                centerDepth = nd.w;
            }

            // 2x2 local neighborhood for strict deringing bounds
            if (ky >= 1 && ky <= 2 && kx >= 1 && kx <= 2) {
                boxMin = min(boxMin, sKaris);
                boxMax = max(boxMax, sKaris);
            }
            // Symmetric 3x3 local neighborhood centered on nearest tap for history variance clamping
            if (ky >= startY && ky <= startY + 2 && kx >= startX && kx <= startX + 2) {
                vec3 ycocg = RGBToYCoCg(sKaris);
                m1_ycocg += ycocg;
                m2_ycocg += ycocg * ycocg;
            }
        }
    }

    vec3 currentUpsampled = sumColor / max(sumW, 1e-6);
    currentUpsampled = clamp(currentUpsampled, boxMin, boxMax);
    vec3 currentUpsampledLinear = invTonemapKaris(currentUpsampled);

    // 2. Depth-Based Motion Vector Dilation (3x3 Nearest-Depth Filter)
    float minDepth = 1e9;
    ivec2 bestMvCoord = baseCoord;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 c = clamp(baseCoord + ivec2(dx, dy), ivec2(0), maxCoord);
            float d = imageLoad(uNormalDepth, c).w;
            if (d < minDepth && d > 1e-3) {
                minDepth = d;
                bestMvCoord = c;
            }
        }
    }

    vec2 mv = imageLoad(uMotionVectors, bestMvCoord).xy;
    if (dot(mv, mv) < 1e-8 && pc.cameraMoved != 0u) {
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                ivec2 c = clamp(baseCoord + ivec2(dx, dy), ivec2(0), maxCoord);
                vec2 nbrMv = imageLoad(uMotionVectors, c).xy;
                if (dot(nbrMv, nbrMv) >= 1e-8) {
                    mv = nbrMv;
                    break;
                }
            }
            if (dot(mv, mv) >= 1e-8) break;
        }
    }

    vec2 displayUV = (vec2(pixelCoord) + 0.5) * vec2(pc.invDisplayWidth, pc.invDisplayHeight);
    vec2 prevUV = displayUV - mv;
    vec2 vPx = mv * vec2(float(pc.displayWidth), float(pc.displayHeight));
    float speed = length(vPx);

    bool validHistory = (pc.resetHistory == 0u);
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        validHistory = false;
    }

    vec3 historyColor = currentUpsampled;
    float currentDepth = (centerDepth < 5000.0 && centerDepth > 1e-3) ? centerDepth : ((minDepth < 1e8) ? minDepth : 10000.0);

    if (validHistory) {
        vec2 prevPx = prevUV * vec2(float(pc.displayWidth), float(pc.displayHeight)) - vec2(0.5);
        ivec2 p0 = ivec2(floor(prevPx));
        vec2 f = fract(prevPx);
        ivec2 dispMax = ivec2(int(pc.displayWidth) - 1, int(pc.displayHeight) - 1);

        ivec2 p00 = clamp(p0, ivec2(0), dispMax);
        ivec2 p10 = clamp(p0 + ivec2(1, 0), ivec2(0), dispMax);
        ivec2 p01 = clamp(p0 + ivec2(0, 1), ivec2(0), dispMax);
        ivec2 p11 = clamp(p0 + ivec2(1, 1), ivec2(0), dispMax);

        vec4 h00 = imageLoad(uHistoryInput, p00);
        vec4 h10 = imageLoad(uHistoryInput, p10);
        vec4 h01 = imageLoad(uHistoryInput, p01);
        vec4 h11 = imageLoad(uHistoryInput, p11);

        // Tonemap RGB history
        h00.rgb = tonemapKaris(h00.rgb);
        h10.rgb = tonemapKaris(h10.rgb);
        h01.rgb = tonemapKaris(h01.rgb);
        h11.rgb = tonemapKaris(h11.rgb);

        vec4 hBilinear = mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
        if (isnan(hBilinear.r) || isinf(hBilinear.r)) {
            validHistory = false;
        } else {
            // Geometric Disocclusion Test:
            // Use nearest history pixel depth to prevent bilinear depth bleeding across silhouettes
            ivec2 nearestPrevPx = clamp(ivec2(round(prevPx)), ivec2(0), dispMax);
            float prevDepth = imageLoad(uHistoryInput, nearestPrevPx).a;
            if (currentDepth < 5000.0 && prevDepth < 5000.0 && prevDepth > 1e-3) {
                float depthRelDiff = abs(currentDepth - prevDepth) / max(currentDepth, 0.1);
                if (depthRelDiff > 0.20) {
                    validHistory = false;
                }
            }
            if (validHistory) {
                historyColor = hBilinear.rgb;
            }
        }
    }

    // 3. Velocity-Adaptive Variance Clamping in YCoCg Space
    if (validHistory) {
        vec3 mu = m1_ycocg * (1.0 / 9.0);
        vec3 sigma = sqrt(max(m2_ycocg * (1.0 / 9.0) - mu * mu, vec3(0.0)));

        // In motion, widen gamma to avoid truncating stable temporal history into noisy 1-SPP samples
        float motionFactor = smoothstep(0.5, 10.0, speed);
        float gamma = mix(1.75, 2.50, motionFactor);

        vec3 boxMinYCoCg = mu - gamma * sigma;
        vec3 boxMaxYCoCg = mu + gamma * sigma;

        vec3 histYCoCg = RGBToYCoCg(historyColor);
        histYCoCg = clamp(histYCoCg, boxMinYCoCg, boxMaxYCoCg);
        historyColor = YCoCgToRGB(histYCoCg);
    }

    // 4. Velocity-Adaptive Temporal Blending (AMD FSR 3 Accumulation Model)
    vec3 finalRgb;
    if (pc.cameraMoved == 0u && (pc.invTotalSamples < 0.99 || pc.isInputNormalized == 1u)) {
        // Stationary convergence: unbiased progressive Monte Carlo pass-through
        finalRgb = currentUpsampledLinear;
    } else {
        // Dynamic camera motion or 1-SPP real-time navigation:
        // Scale alpha smoothly with velocity:
        float baseAlpha = clamp(1.0 - pc.temporalWeight, 0.08, 0.12);
        float motionFactor = smoothstep(0.5, 10.0, speed);
        float maxMotionAlpha = mix(0.20, 0.25, smoothstep(10.0, 25.0, speed));
        float alpha = mix(baseAlpha, maxMotionAlpha, motionFactor);

        if (!validHistory) {
            // Feature F8: Disocclusion Spatial Pre-Filtering
            // True geometric disocclusion: apply 3x3 bilateral filter to incoming sample
            // to suppress raw Monte Carlo noise before output.
            if (centerDepth > 0.0 && centerDepth < 5000.0) {
                vec3 filterSum = vec3(0.0);
                float filterWeightSum = 0.0;
                for (int dy = -1; dy <= 1; ++dy) {
                    for (int dx = -1; dx <= 1; ++dx) {
                        ivec2 tc = clamp(baseCoord + ivec2(dx, dy), ivec2(0), maxCoord);
                        vec4 tapND = imageLoad(uNormalDepth, tc);
                        if (tapND.w <= 0.0 || tapND.w >= 5000.0) continue;

                        float dDiff = abs(tapND.w - centerDepth);
                        float wD = exp(-dDiff / (0.10 * centerDepth + 1e-4));
                        float wN = pow(max(0.0, dot(centerNorm, tapND.xyz)), 4.0);
                        float wDist = (dx == 0 && dy == 0) ? 1.0 : ((dx == 0 || dy == 0) ? 0.707 : 0.5);
                        float w = wD * wN * wDist;

                        vec3 tapC = imageLoad(uRenderColor, tc).rgb * ((pc.isInputNormalized == 1u) ? 1.0 : pc.invTotalSamples);
                        filterSum += tonemapKaris(max(tapC, vec3(0.0))) * w;
                        filterWeightSum += w;
                    }
                }
                if (filterWeightSum > 1e-4) {
                    currentUpsampled = filterSum / filterWeightSum;
                }
            }
            alpha = 1.0;
        }

        vec3 accumulatedKaris = mix(historyColor, currentUpsampled, alpha);
        finalRgb = invTonemapKaris(accumulatedKaris);
    }

    finalRgb = max(finalRgb, vec3(0.0));
    if (isnan(finalRgb.r) || isnan(finalRgb.g) || isnan(finalRgb.b) ||
        isinf(finalRgb.r) || isinf(finalRgb.g) || isinf(finalRgb.b)) {
        finalRgb = max(centerTapRgb, vec3(0.0));
    }

    imageStore(uHistoryOutput, pixelCoord, vec4(finalRgb, currentDepth));
    imageStore(uUpscaledOutput, pixelCoord, vec4(finalRgb, 1.0));
}
