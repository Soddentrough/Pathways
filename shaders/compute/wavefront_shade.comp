#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0, rgba32f) uniform image2D uAccumImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[16];

layout(std430, binding = 9) readonly buffer InRayQueue {
    RayPayload inRays[];
};

layout(std430, binding = 10) writeonly buffer OutRayQueue {
    RayPayload outRays[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint padding;
} queueCounters;

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
} pc;

bool isShadowOccluded(vec3 origin, vec3 dir, float tMin, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, tMin, dir, tMax);
    while (rayQueryProceedEXT(rq)) {
        uint triIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
        if (materials[triangles[triIdx].materialId].type != 3u /* Skip EMISSIVE */) {
            rayQueryConfirmIntersectionEXT(rq);
            rayQueryTerminateEXT(rq);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        uint triIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        if (materials[triangles[triIdx].materialId].type != 3u) {
            return true;
        }
    }
    for (uint i = 0; i < pc.numSpheres; ++i) {
        if (materials[spheres[i].materialId].type == 3u) continue;
        float spT;
        vec3 spNorm;
        if (intersectSphere(origin, dir, spheres[i], tMin, tMax, spT, spNorm)) {
            return true;
        }
    }
    return false;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    bool inRange = (idx < queueCounters.activeRayCount);
    bool survivesToNext = false;
    RayPayload nextPayload;

    if (inRange) {
        RayPayload ray = inRays[idx];

        vec3 hitPoint = ray.origin.xyz;
        vec3 rayDir = ray.direction.xyz;
        uint bounce = floatBitsToUint(ray.direction.w);
        vec3 throughput = ray.throughput.rgb;
        uint seed = floatBitsToUint(ray.throughput.w);
        vec3 accumRadiance = ray.radiance.rgb;
        uint pixelIndex = floatBitsToUint(ray.radiance.w);
        vec3 hitNormal = ray.hitNormal.xyz;
        uint matId = floatBitsToUint(ray.hitNormal.w);
        vec2 hitUv = ray.hitExtra.xy;
        bool frontFace = (floatBitsToUint(ray.hitExtra.w) != 0u);

        Material mat = materials[matId];

        // Sample textures
        vec4 matAlbedo = mat.albedo;
        if (mat.albedoTex > 0u && mat.albedoTex <= 16u) {
            matAlbedo *= texture(sceneTextures[mat.albedoTex - 1u], hitUv);
        }

        if (mat.normalTex > 0u && mat.normalTex <= 16u) {
            vec3 normalMap = texture(sceneTextures[mat.normalTex - 1u], hitUv).rgb * 2.0 - 1.0;
            vec3 up = abs(hitNormal.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
            vec3 tangent = normalize(cross(up, hitNormal));
            vec3 bitangent = cross(hitNormal, tangent);
            mat3 tbn = mat3(tangent, bitangent, hitNormal);
            hitNormal = normalize(tbn * normalMap);
        }

        bool enableDirect = (ubo.flags & (1 << 0)) != 0;
        bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
        bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
        bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
        bool enableShadows = (ubo.flags & (1 << 4)) != 0;

        // 1. Next Event Estimation (Direct Lighting on Area & Spot Lights)
        if (enableDirect && (mat.type == 0u || mat.type == 1u)) {
            for (uint l = 0; l < pc.numLights; ++l) {
                Light light = lights[l];
                vec3 lightPoint;
                vec3 lightDir;
                float lightDist;
                float lightPdf = 1.0;
                vec3 lightEmission = light.emission.rgb;

                if (uint(light.position.w) == 0u /* AREA QUAD */) {
                    vec2 luv = randVec2(seed);
                    lightPoint = light.position.xyz + luv.x * light.u.xyz + luv.y * light.v.xyz;
                    vec3 toLight = lightPoint - hitPoint;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);

                    float cosLight = dot(-lightDir, light.normal.xyz);
                    if (cosLight <= 0.0) continue;

                    float area = light.emission.w;
                    lightPdf = (lightDist * lightDist) / (area * cosLight);
                } else if (uint(light.position.w) == 1u /* SPOT */) {
                    vec3 toLight = light.position.xyz - hitPoint;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);

                    float cosSpot = dot(-lightDir, light.normal.xyz);
                    float innerCos = light.u.w;
                    float outerCos = light.v.w;
                    if (cosSpot < outerCos) continue;

                    float spotFactor = clamp((cosSpot - outerCos) / max(innerCos - outerCos, 1e-4), 0.0, 1.0);
                    lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                    lightPdf = 1.0;
                } else {
                    continue;
                }

                float cosTheta = dot(hitNormal, lightDir);
                if (cosTheta > 0.0) {
                    bool inShadow = false;
                    if (enableShadows) {
                        inShadow = isShadowOccluded(hitPoint + hitNormal * EPSILON, lightDir, EPSILON, lightDist - EPSILON);
                    }

                    if (!inShadow) {
                        vec3 brdf = matAlbedo.rgb * INV_PI;
                        accumRadiance += throughput * lightEmission * brdf * cosTheta / max(lightPdf, 1e-4);
                    }
                }
            }
        }

        // 2. Sample BSDF for Secondary Bounce
        bool pathTerminated = false;
        if (bounce + 1u >= pc.maxBounces || (!enableIndirect && bounce > 0u)) {
            pathTerminated = true;
        }

        vec3 nextDirection;
        vec3 nextOrigin;

        if (!pathTerminated) {
            if (mat.type == 2u /* DIELECTRIC / REFRACTION */) {
                if (!enableRefraction) {
                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                    nextOrigin = hitPoint + hitNormal * EPSILON;
                    throughput *= matAlbedo.rgb;
                } else {
                    float refractionRatio = frontFace ? (1.0 / mat.ior) : mat.ior;
                    vec3 unitDir = normalize(rayDir);
                    float cosTheta = min(dot(-unitDir, hitNormal), 1.0);
                    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                    bool cannotRefract = refractionRatio * sinTheta > 1.0;
                    float reflectProb = fresnelSchlick(cosTheta, refractionRatio);

                    if (cannotRefract || reflectProb > randFloat(seed)) {
                        nextDirection = reflect(unitDir, hitNormal);
                        nextOrigin = hitPoint + hitNormal * EPSILON;
                    } else {
                        nextDirection = refract(unitDir, hitNormal, refractionRatio);
                        nextOrigin = hitPoint - hitNormal * EPSILON;
                    }
                    throughput *= matAlbedo.rgb;
                }
            } else if (mat.type == 1u /* METALLIC / SPECULAR */) {
                if (!enableSpecular) {
                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                    throughput *= matAlbedo.rgb;
                } else {
                    vec3 reflected = reflect(normalize(rayDir), hitNormal);
                    if (mat.roughness > 0.001) {
                        reflected += mat.roughness * randVec3(seed);
                    }
                    nextDirection = normalize(reflected);
                    throughput *= matAlbedo.rgb;
                }
                nextOrigin = hitPoint + hitNormal * EPSILON;
            } else {
                // Diffuse Lambertian
                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                nextOrigin = hitPoint + hitNormal * EPSILON;
                throughput *= matAlbedo.rgb;
            }

            // 3. Russian Roulette path termination
            if (bounce >= 1u) {
                float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
                if (randFloat(seed) > p) {
                    pathTerminated = true;
                } else {
                    throughput /= p;
                }
            }
        }

        // 4. Incoherent BVH Traversal for Secondary Ray
        if (!pathTerminated) {
            float closestT = 1e4;
            int closestTri = -1;
            vec2 closestBary = vec2(0.0);

            rayQueryEXT rq;
            rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, nextOrigin, EPSILON, nextDirection, closestT);
            while (rayQueryProceedEXT(rq)) {}

            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                closestT = rayQueryGetIntersectionTEXT(rq, true);
                closestTri = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
                closestBary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
            }

            int closestSphere = -1;
            vec3 sphereNormal = vec3(0.0);
            for (uint i = 0; i < pc.numSpheres; ++i) {
                float spT;
                vec3 spNorm;
                if (intersectSphere(nextOrigin, nextDirection, spheres[i], EPSILON, closestT, spT, spNorm)) {
                    closestT = spT;
                    closestSphere = int(i);
                    closestTri = -1;
                    sphereNormal = spNorm;
                }
            }

            if (closestTri < 0 && closestSphere < 0) {
                // Miss: Secondary ray hit sky
                vec3 skyColor;
                if (pc.hasEnvMap == 1u) {
                    vec2 envUv = directionToEquirectangular(nextDirection);
                    skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
                } else {
                    float t = 0.5 * (nextDirection.y + 1.0);
                    skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
                }
                accumRadiance += throughput * skyColor;
                pathTerminated = true;
            } else {
                // Hit geometry (triangle or procedural sphere)
                uint nextMatId = 0;
                vec3 nextNorm = vec3(0.0, 1.0, 0.0);
                vec2 nextUv = vec2(0.0);

                if (closestTri >= 0) {
                    Triangle nextTri = triangles[closestTri];
                    nextMatId = nextTri.materialId;

                    float u = closestBary.x;
                    float v = closestBary.y;
                    float w = 1.0 - u - v;

                    vec3 n0 = nextTri.v0.normal.xyz;
                    vec3 n1 = nextTri.v1.normal.xyz;
                    vec3 n2 = nextTri.v2.normal.xyz;
                    nextNorm = normalize(w * n0 + u * n1 + v * n2);

                    vec2 uv0 = vec2(nextTri.v0.position.w, nextTri.v0.normal.w);
                    vec2 uv1 = vec2(nextTri.v1.position.w, nextTri.v1.normal.w);
                    vec2 uv2 = vec2(nextTri.v2.position.w, nextTri.v2.normal.w);
                    nextUv = w * uv0 + u * uv1 + v * uv2;
                } else if (closestSphere >= 0) {
                    nextNorm = sphereNormal;
                    nextMatId = spheres[closestSphere].materialId;
                }

                Material nextMat = materials[nextMatId];

                if (nextMat.type == 3u /* EMISSIVE */) {
                    accumRadiance += throughput * nextMat.emissive.rgb;
                    pathTerminated = true;
                } else {
                    // Survives to the next bounce!
                    survivesToNext = true;

                    bool nextFront = dot(nextDirection, nextNorm) < 0.0;
                    nextNorm = nextFront ? nextNorm : -nextNorm;

                    vec3 nextHitPt = nextOrigin + closestT * nextDirection;

                    nextPayload.origin = vec4(nextHitPt, uintBitsToFloat(1u));
                    nextPayload.direction = vec4(nextDirection, uintBitsToFloat(bounce + 1u));
                    nextPayload.throughput = vec4(throughput, uintBitsToFloat(seed));
                    nextPayload.radiance = vec4(accumRadiance, uintBitsToFloat(pixelIndex));
                    nextPayload.hitNormal = vec4(nextNorm, uintBitsToFloat(nextMatId));
                    nextPayload.hitExtra = vec4(nextUv, closestT, uintBitsToFloat(nextFront ? 1u : 0u));
                }
            }
        }

        // If path terminated at this stage, accumulate its radiance into the image
        if (pathTerminated) {
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            if (ubo.frameIndex == 0u && pc.sppSampleIndex == 0u) {
                imageStore(uAccumImage, pixelCoord, vec4(accumRadiance, 1.0));
            } else {
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, prev + vec4(accumRadiance, 1.0));
            }
        }
    }

    // Subgroup Wave Ballot Compaction into downstream queue
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (subgroupElect()) {
        waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
    }
    waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);

    if (survivesToNext) {
        uint targetIdx = waveGlobalOffset + laneSlot;
        if (targetIdx < pc.maxQueueCapacity) {
            outRays[targetIdx] = nextPayload;
        }
    }
}
