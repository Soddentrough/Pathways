#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_image_load_formatted : require

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[64];

layout(std430, binding = 9) readonly buffer InRayStateQueue {
    RayState inStates[];
};

layout(std430, binding = 10) writeonly buffer OutRayStateQueue {
    RayState outStates[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint pad1;
    uint pad2;
} queueCounters;

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    BounceDispatch bounceDispatches[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    BounceDGC bounceDGC[];
} dgcStream;

layout(std430, binding = 15) readonly buffer InRayGeomQueue {
    RayGeometry inGeoms[];
};

layout(std430, binding = 16) writeonly buffer OutRayGeomQueue {
    RayGeometry outGeoms[];
};

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
    uint useHardwareRT;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    bool inRange = (idx < queueCounters.activeRayCount);
    bool survivesToNext = false;
    bool hasShadowRay = false;
    RayGeometry nextGeom;
    RayState nextState;
    PackedShadowRay shadowCandidate;

    if (inRange) {
        RayGeometry geom = inGeoms[idx];
        RayHit hit = inHits[idx];
        RayState state = inStates[idx];

        vec3 origin = geom.originAndTMin.xyz;
        vec3 rayDir = geom.dirAndTMax.xyz;
        float hitT = hit.hitData.x;
        uint primId = floatBitsToUint(hit.hitData.y);
        vec2 hitBary = unpackHalf2x16(floatBitsToUint(hit.hitData.z));
        uint hitType = floatBitsToUint(hit.hitData.w);

        vec3 throughput = state.throughputSeed.rgb;
        uint seed = floatBitsToUint(state.throughputSeed.w);
        vec3 accumRadiance = state.radiancePixel.rgb;
        uint pixelIndex = floatBitsToUint(state.radiancePixel.w);
        uint bounce = pc.currentBounce;

        // 0. Check if secondary ray hit sky / environment (Miss)
        if (hitType == 2u) {
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            accumRadiance += throughput * skyColor;
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, prev + vec4(accumRadiance, 0.0));
            // Ray terminates here (survivesToNext remains false)
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            vec3 hitNormal = vec3(0.0, 1.0, 0.0);
            vec2 hitUv = vec2(0.0);
            uint matId = 0u;
            bool frontFace = true;

            if (hitType == 0u) {
                // Triangle geometry: load only needed attributes directly without copying full 160B struct
                float u = hitBary.x;
                float v = hitBary.y;
                float w = 1.0 - u - v;

                vec3 n0 = triangles[primId].v0.normal.xyz;
                vec3 n1 = triangles[primId].v1.normal.xyz;
                vec3 n2 = triangles[primId].v2.normal.xyz;
                hitNormal = normalize(w * n0 + u * n1 + v * n2);

                vec2 uv0 = vec2(triangles[primId].v0.position.w, triangles[primId].v0.normal.w);
                vec2 uv1 = vec2(triangles[primId].v1.position.w, triangles[primId].v1.normal.w);
                vec2 uv2 = vec2(triangles[primId].v2.position.w, triangles[primId].v2.normal.w);
                hitUv = w * uv0 + u * uv1 + v * uv2;
                matId = triangles[primId].materialId;

                frontFace = dot(rayDir, hitNormal) < 0.0;
                hitNormal = frontFace ? hitNormal : -hitNormal;

                Material mat = materials[matId];

                // Tangent frame & Normal mapping: load tangents only when normal texture is active
                if (mat.normalTex > 0u && mat.normalTex <= 64u) {
                    vec4 tan0 = triangles[primId].v0.tangent;
                    vec4 tan1 = triangles[primId].v1.tangent;
                    vec4 tan2 = triangles[primId].v2.tangent;
                    vec3 geomTan = normalize(w * tan0.xyz + u * tan1.xyz + v * tan2.xyz);
                    float tanSign = tan0.w != 0.0 ? tan0.w : 1.0;

                    vec3 normalMap = texture(sceneTextures[mat.normalTex - 1u], hitUv).rgb * 2.0 - 1.0;
                    normalMap.xy *= mat.normalScale;
                    normalMap = normalize(normalMap);

                    geomTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
                    vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                    mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                    hitNormal = normalize(tbn * normalMap);
                }
            } else if (hitType == 1u) {
                // Procedural Sphere
                Sphere sp = spheres[primId];
                hitNormal = (hitPoint - sp.centerRadius.xyz) / sp.centerRadius.w;
                matId = sp.materialId;
                frontFace = dot(rayDir, hitNormal) < 0.0;
                hitNormal = frontFace ? hitNormal : -hitNormal;
            }

            Material mat = materials[matId];

            // 1. Sample glTF 2.0 Material Textures & Factors
            vec4 baseColor = mat.albedo;
            if (mat.albedoTex > 0u && mat.albedoTex <= 64u) {
                baseColor *= texture(sceneTextures[mat.albedoTex - 1u], hitUv);
            }

            // Alpha masking & stochastic alpha blending
            if ((mat.alphaMode == 1u && baseColor.a < mat.alphaCutoff) ||
                (mat.alphaMode == 2u && randFloat(seed) > baseColor.a)) {
                // Transparent / masked pixel - passthrough ray
                survivesToNext = true;
                nextGeom.originAndTMin = vec4(hitPoint + rayDir * EPSILON, EPSILON);
                nextGeom.dirAndTMax = vec4(rayDir, 10000.0);
                nextState.throughputSeed = vec4(throughput, uintBitsToFloat(seed));
                nextState.radiancePixel = vec4(accumRadiance, uintBitsToFloat(pixelIndex));
            } else {
                // Emissive radiance evaluation
                vec3 emissive = mat.emissive.rgb;
                if (mat.emissiveTex > 0u && mat.emissiveTex <= 64u) {
                    emissive *= texture(sceneTextures[mat.emissiveTex - 1u], hitUv).rgb;
                }
                if (length(emissive) > 1e-3) {
                    accumRadiance += throughput * emissive;
                }

                bool pathTerminated = false;
                if (mat.type == 3u /* MATERIAL_EMISSIVE */) {
                    pathTerminated = true;
                } else {
                    float roughness = mat.roughness;
                    float metallic = mat.metallic;
                    if (mat.mrTex > 0u && mat.mrTex <= 64u) {
                        vec4 mrSample = texture(sceneTextures[mat.mrTex - 1u], hitUv);
                        roughness *= mrSample.g; // Green = roughness
                        metallic *= mrSample.b;  // Blue = metallic
                    }
                    roughness = clamp(roughness, 0.04, 1.0);
                    metallic = clamp(metallic, 0.0, 1.0);
                    float alphaRoughness = roughness * roughness;

                    float transmission = mat.transmission;
                    if (mat.transmissionTex > 0u && mat.transmissionTex <= 64u) {
                        transmission *= texture(sceneTextures[mat.transmissionTex - 1u], hitUv).r;
                    }

                    float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
                    float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
                    float specFactor = mat.specularFactor;
                    if (mat.specularTex > 0u && mat.specularTex <= 64u) {
                        specFactor *= texture(sceneTextures[mat.specularTex - 1u], hitUv).a;
                    }
                    vec3 dielectricF0 = vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0));
                    vec3 F0 = mix(dielectricF0, baseColor.rgb, metallic);
                    vec3 diffuseColor = baseColor.rgb * (1.0 - metallic);
                    vec3 V = -rayDir;

                    // Clearcoat properties
                    float clearcoat = mat.clearcoat;
                    if (mat.clearcoatTex > 0u && mat.clearcoatTex <= 64u) {
                        clearcoat *= texture(sceneTextures[mat.clearcoatTex - 1u], hitUv).r;
                    }
                    float clearcoatRoughness = mat.clearcoatRoughness;
                    if (mat.clearcoatRoughnessTex > 0u && mat.clearcoatRoughnessTex <= 64u) {
                        clearcoatRoughness *= texture(sceneTextures[mat.clearcoatRoughnessTex - 1u], hitUv).g;
                    }
                    clearcoatRoughness = clamp(clearcoatRoughness, 0.001, 1.0);
                    float clearcoatAlpha = clearcoatRoughness * clearcoatRoughness;

                    vec3 clearcoatNormal = hitNormal;
                    if (mat.clearcoatNormalTex > 0u && mat.clearcoatNormalTex <= 64u) {
                        vec3 up = abs(hitNormal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
                        vec3 cTan = normalize(cross(up, hitNormal));
                        vec3 cBitan = cross(hitNormal, cTan);
                        vec3 cNormMap = texture(sceneTextures[mat.clearcoatNormalTex - 1u], hitUv).rgb * 2.0 - 1.0;
                        clearcoatNormal = normalize(mat3(cTan, cBitan, hitNormal) * cNormMap);
                    }

                    // Volumetric Beer-Lambert absorption (physical ray traversal distance)
                    float mediumDist = !frontFace ? hitT : 0.0;
                    if (mat.attenuationColor.w > 0.0 && mediumDist > 0.0) {
                        vec3 sigma_a = -log(max(mat.attenuationColor.rgb, vec3(0.0001))) / mat.attenuationColor.w;
                        vec3 transmittance = exp(-sigma_a * mediumDist);
                        throughput *= transmittance;
                    }

                    bool enableDirect = (ubo.flags & (1 << 0)) != 0;
                    bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
                    bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
                    bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
                    bool enableShadows = (ubo.flags & (1 << 4)) != 0;

                    float clearcoatProb = (clearcoat > 0.001 && enableSpecular) ? (clearcoat * 0.25) : 0.0;
                    float baseSpecProb = enableSpecular ? clamp(mix(0.04, 1.0, metallic), 0.05, 0.95) * (1.0 - clearcoatProb) : 0.0;

                    // 2. Next Event Estimation (Stochastic 1-Light NEE + Cook-Torrance GGX Microfacet Model + MIS)
                    if (enableDirect && transmission < 0.1 && mat.type != 2u && pc.numLights > 0u) {
                        uint lightIdx = 0u;
                        float lightSelectPdf = 1.0;
                        if (pc.numLights > 1u) {
                            lightIdx = uint(randFloat(seed) * float(pc.numLights));
                            lightIdx = min(lightIdx, pc.numLights - 1u);
                            lightSelectPdf = 1.0 / float(pc.numLights);
                        }

                        Light light = lights[lightIdx];
                        vec3 lightPoint;
                        vec3 lightDir;
                        float lightDist = 0.0;
                        float lightPdf = 1.0;
                        vec3 lightEmission = light.emission.rgb;
                        bool validLightSample = false;

                        if (uint(light.position.w) == 0u /* AREA QUAD */) {
                            vec2 luv = randVec2(seed);
                            lightPoint = light.position.xyz + luv.x * light.u.xyz + luv.y * light.v.xyz;
                            vec3 toLight = lightPoint - hitPoint;
                            lightDist = length(toLight);
                            lightDir = toLight / max(lightDist, 1e-4);

                            float cosLight = dot(-lightDir, light.normal.xyz);
                            if (cosLight > 0.0) {
                                float area = light.emission.w;
                                lightPdf = (lightDist * lightDist) / (area * cosLight);
                                validLightSample = true;
                            }
                        } else if (uint(light.position.w) == 1u /* SPOT */) {
                            vec3 toLight = light.position.xyz - hitPoint;
                            lightDist = length(toLight);
                            lightDir = toLight / max(lightDist, 1e-4);

                            float cosSpot = dot(-lightDir, light.normal.xyz);
                            float innerCos = light.u.w;
                            float outerCos = light.v.w;
                            if (cosSpot >= outerCos) {
                                float spotFactor = clamp((cosSpot - outerCos) / max(innerCos - outerCos, 1e-4), 0.0, 1.0);
                                lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                                lightPdf = 1.0;
                                validLightSample = true;
                            }
                        }

                        if (validLightSample) {
                            float NdotL = dot(hitNormal, lightDir);
                            if (NdotL > 0.0) {
                                vec3 H = normalize(V + lightDir);
                                float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);
                                float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                                float VdotH = clamp(dot(V, H), 0.0, 1.0);

                                float D = distributionGGX(NdotH, alphaRoughness);
                                float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                                vec3 F = fresnelSchlickVec(VdotH, F0);

                                vec3 specBRDF = enableSpecular ? (D * Vis * F) : vec3(0.0);
                                vec3 diffBRDF = (vec3(1.0) - F) * diffuseColor * INV_PI;

                                // Clearcoat layer evaluation
                                float Fc = 0.0;
                                vec3 clearcoatBRDF = vec3(0.0);
                                float Dc = 0.0;
                                float NcDotH = 0.0;
                                float VDotHc = 0.0;
                                float NcDotL = 0.0;
                                if (clearcoat > 0.001 && enableSpecular) {
                                    NcDotL = clamp(dot(clearcoatNormal, lightDir), 0.0, 1.0);
                                    float NcDotV = clamp(dot(clearcoatNormal, V), 0.001, 1.0);
                                    NcDotH = clamp(dot(clearcoatNormal, H), 0.0, 1.0);
                                    VDotHc = VdotH;

                                    Fc = fresnelSchlick(VdotH, 1.5) * clearcoat;
                                    Dc = distributionGGX(NcDotH, clearcoatAlpha);
                                    float VisC = visibilitySmithGGXCorrelated(NcDotL, NcDotV, clearcoatAlpha);
                                    clearcoatBRDF = vec3(Fc * Dc * VisC);
                                }

                                vec3 brdf = (diffBRDF + specBRDF) * (1.0 - Fc) + clearcoatBRDF;

                                // Multiple Importance Sampling (MIS) balance heuristic for NEE
                                float misWeightLight = 1.0;
                                if (uint(light.position.w) == 0u /* AREA QUAD */) {
                                    float diffProb = max(1.0 - clearcoatProb - baseSpecProb, 0.0);
                                    float diffPdf = NdotL * INV_PI;
                                    float specPdf = (D * NdotH) / max(4.0 * VdotH, 1e-4);
                                    float clearcoatPdf = (clearcoat > 0.001 && NcDotL > 0.0) ? ((Dc * NcDotH) / max(4.0 * VDotHc, 1e-4)) : 0.0;
                                    float bsdfPdf = diffProb * diffPdf + baseSpecProb * specPdf + clearcoatProb * clearcoatPdf;
                                    float lightPdfTotal = lightPdf * lightSelectPdf;
                                    misWeightLight = lightPdfTotal / (lightPdfTotal + bsdfPdf);
                                }

                                vec3 unshadowed = (throughput * lightEmission * brdf * NdotL * misWeightLight) / (max(lightPdf, 1e-4) * lightSelectPdf);

                                if (any(greaterThan(unshadowed, vec3(1e-5)))) {
                                    if (enableShadows) {
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(hitPoint + hitNormal * EPSILON, lightDist);
                                        shadowCandidate.dirPixel = vec4(lightDir, uintBitsToFloat(pixelIndex));
                                        shadowCandidate.unshadowedRadiance = vec4(unshadowed, uintBitsToFloat(bounce));
                                    } else {
                                        accumRadiance += unshadowed;
                                    }
                                }
                            }
                        }
                    }

                    // 3. Sample BSDF for Secondary Bounce
                    if (bounce + 1u >= pc.maxBounces || (!enableIndirect && bounce > 0u)) {
                        pathTerminated = true;
                    }

                    vec3 nextDirection;
                    vec3 nextOrigin;
                    bool isDelta = false;

                    if (!pathTerminated) {
                        if (transmission > 0.01 || mat.type == 2u /* DIELECTRIC / REFRACTION */) {
                            isDelta = true;
                            if (!enableRefraction) {
                                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                                nextOrigin = hitPoint + hitNormal * EPSILON;
                                throughput *= baseColor.rgb;
                            } else {
                                float refractionRatio = frontFace ? (1.0 / iorVal) : iorVal;
                                vec3 unitDir = normalize(rayDir);
                                float cosTheta = min(dot(-unitDir, hitNormal), 1.0);
                                float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                                bool cannotRefract = refractionRatio * sinTheta > 1.0;
                                float reflectProb = fresnelSchlick(cosTheta, refractionRatio);

                                if (cannotRefract || reflectProb > randFloat(seed)) {
                                    nextDirection = reflect(unitDir, hitNormal);
                                    nextOrigin = hitPoint + hitNormal * EPSILON;
                                } else {
                                    nextDirection = refract(unitDir, hitNormal, refractionRatio);
                                    nextOrigin = hitPoint - hitNormal * EPSILON;
                                }
                                throughput *= baseColor.rgb;
                            }
                        } else {
                            // Clearcoat + Cook-Torrance GGX importance sampling
                            float xi = randFloat(seed);

                            if (xi < clearcoatProb) {
                                // Clearcoat specular lobe: GGX microfacet sampling with clearcoatNormal
                                vec3 Hc = sampleGGX(clearcoatNormal, clearcoatAlpha, seed);
                                vec3 L = reflect(-V, Hc);
                                float NcDotL = dot(clearcoatNormal, L);

                                if (NcDotL > 0.0) {
                                    float NcDotV = clamp(dot(clearcoatNormal, V), 0.001, 1.0);
                                    float NcDotH = clamp(dot(clearcoatNormal, Hc), 0.001, 1.0);
                                    float VDotHc = clamp(dot(V, Hc), 0.0, 1.0);

                                    float VisC = visibilitySmithGGXCorrelated(NcDotL, NcDotV, clearcoatAlpha);
                                    float Fc = fresnelSchlick(VDotHc, 1.5) * clearcoat;

                                    vec3 specWeight = vec3((4.0 * VisC * Fc * NcDotL * VDotHc) / max(NcDotH * clearcoatProb, 1e-4));
                                    throughput *= clamp(specWeight, vec3(0.0), vec3(10.0));
                                    nextDirection = L;
                                } else {
                                    // Fallback to diffuse
                                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                                    vec3 H_diff = normalize(V + nextDirection);
                                    vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                                    throughput *= (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                                }
                            } else if (xi < clearcoatProb + baseSpecProb) {
                                // Base Specular lobe: GGX microfacet sampling
                                vec3 H = sampleGGX(hitNormal, alphaRoughness, seed);
                                vec3 L = reflect(-V, H);
                                float NdotL = dot(hitNormal, L);

                                if (NdotL > 0.0) {
                                    float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);
                                    float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                                    float VdotH = clamp(dot(V, H), 0.0, 1.0);

                                    float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                                    vec3 F = fresnelSchlickVec(VdotH, F0);
                                    float Fc = fresnelSchlick(VdotH, 1.5) * clearcoat;

                                    vec3 specWeight = (4.0 * Vis * F * NdotL * VdotH * (1.0 - Fc)) / max(NdotH * baseSpecProb, 1e-4);
                                    throughput *= clamp(specWeight, vec3(0.0), vec3(10.0));
                                    nextDirection = L;
                                } else {
                                    // Fallback to diffuse
                                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                                    vec3 H_diff = normalize(V + nextDirection);
                                    vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                                    float Fc = fresnelSchlick(clamp(dot(V, H_diff), 0.0, 1.0), 1.5) * clearcoat;
                                    throughput *= (1.0 - Fc) * (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                                }
                            } else {
                                // Diffuse lobe: Cosine-weighted hemisphere sampling
                                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                                vec3 H_diff = normalize(V + nextDirection);
                                vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                                float Fc = fresnelSchlick(clamp(dot(V, H_diff), 0.0, 1.0), 1.5) * clearcoat;
                                throughput *= (1.0 - Fc) * (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                            }
                            nextOrigin = hitPoint + hitNormal * EPSILON;
                        }

                        // 4. Luminance check & Russian Roulette path termination (aligned with raytrace.rgen)
                        float lum = dot(throughput, vec3(0.2126, 0.7152, 0.0722));
                        if (lum < 0.001) {
                            pathTerminated = true;
                        } else if (bounce >= 1u) {
                            float minP = (bounce >= 2u) ? 0.02 : 0.05;
                            float p = clamp(lum, minP, 0.95);
                            if (randFloat(seed) > p) {
                                pathTerminated = true;
                            } else {
                                throughput /= p;
                            }
                        }
                    }

                    // 5. Emit Surviving Secondary Ray
                    if (!pathTerminated) {
                        survivesToNext = true;
                        nextGeom.originAndTMin = vec4(nextOrigin, EPSILON);
                        nextGeom.dirAndTMax = vec4(nextDirection, 10000.0);
                        nextState.throughputSeed = vec4(throughput, uintBitsToFloat(seed));
                        nextState.radiancePixel = vec4(accumRadiance, uintBitsToFloat(pixelIndex));
                    }
                }

                // If path terminated at this stage, accumulate any remaining radiance into the image
                if (pathTerminated && any(greaterThan(accumRadiance, vec3(1e-5)))) {
                    ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    vec4 prev = imageLoad(uAccumImage, pixelCoord);
                    imageStore(uAccumImage, pixelCoord, prev + vec4(accumRadiance, 0.0));
                }
            }
        }
    }

    // Subgroup Wave Ballot Compaction into downstream queue
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (subgroupElect()) {
        waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
    }
    waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);

    if (survivesToNext) {
        uint targetIdx = waveGlobalOffset + laneSlot;
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    // Subgroup Wave Ballot Compaction for Shadow Rays
    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (subgroupElect()) {
        shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
    }
    shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);

    if (hasShadowRay) {
        uint targetIdx = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdx < pc.maxQueueCapacity) {
            shadowRays[targetIdx] = shadowCandidate;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly (eliminating Mode 1 Resolve)
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint totalWgs = gl_NumWorkGroups.x;
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == totalWgs - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.bounceDispatches[b].shadowDispatch.x = shadowGroups;
            indirect.bounceDispatches[b].shadowDispatch.y = 1u;
            indirect.bounceDispatches[b].shadowDispatch.z = 1u;
            indirect.bounceDispatches[b].shadowDispatch.pad = shadowCount;

            dgcStream.bounceDGC[b].shadowCmd.pipelineIndex = 3u;
            dgcStream.bounceDGC[b].shadowCmd.x = shadowGroups;
            dgcStream.bounceDGC[b].shadowCmd.y = 1u;
            dgcStream.bounceDGC[b].shadowCmd.z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            uint intersectGroups = (nextCount + 31u) / 32u;
            indirect.bounceDispatches[b].intersectDispatch.x = intersectGroups;
            indirect.bounceDispatches[b].intersectDispatch.y = 1u;
            indirect.bounceDispatches[b].intersectDispatch.z = 1u;
            indirect.bounceDispatches[b].intersectDispatch.pad = nextCount;

            dgcStream.bounceDGC[b].intersectCmd.pipelineIndex = 1u;
            dgcStream.bounceDGC[b].intersectCmd.x = intersectGroups;
            dgcStream.bounceDGC[b].intersectCmd.y = 1u;
            dgcStream.bounceDGC[b].intersectCmd.z = 1u;

            if (b + 1u < pc.maxBounces) {
                indirect.bounceDispatches[b + 1u].shadeDispatch.x = intersectGroups;
                indirect.bounceDispatches[b + 1u].shadeDispatch.y = 1u;
                indirect.bounceDispatches[b + 1u].shadeDispatch.z = 1u;
                indirect.bounceDispatches[b + 1u].shadeDispatch.pad = nextCount;

                dgcStream.bounceDGC[b + 1u].shadeCmd.pipelineIndex = 2u;
                dgcStream.bounceDGC[b + 1u].shadeCmd.x = intersectGroups;
                dgcStream.bounceDGC[b + 1u].shadeCmd.y = 1u;
                dgcStream.bounceDGC[b + 1u].shadeCmd.z = 1u;
            }

            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces) ? nextCount : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
