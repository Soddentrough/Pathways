#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0, rgba32f) uniform image2D uAccumImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[64];

layout(std430, binding = 9) readonly buffer InRayQueue {
    RayPayload inRays[];
};

layout(std430, binding = 10) writeonly buffer OutRayQueue {
    RayPayload outRays[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint padding;
} queueCounters;

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
    uint useHardwareRT;
} pc;

bool isShadowOccluded(vec3 origin, vec3 dir, float tMin, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, tMin, dir, tMax);
    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint triIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            Material mat = materials[triangles[triIdx].materialId];
            if (mat.type == 3u /* Skip EMISSIVE */) {
                continue;
            }
            if (mat.alphaMode == 1u /* MASK */) {
                vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                float u = bary.x, v = bary.y, w = 1.0 - u - v;
                Triangle tri = triangles[triIdx];
                vec2 uv = w * vec2(tri.v0.position.w, tri.v0.normal.w) +
                          u * vec2(tri.v1.position.w, tri.v1.normal.w) +
                          v * vec2(tri.v2.position.w, tri.v2.normal.w);
                float alpha = mat.albedo.a;
                if (mat.albedoTex > 0u && mat.albedoTex <= 64u) {
                    alpha *= texture(sceneTextures[mat.albedoTex - 1u], uv).a;
                }
                if (alpha < mat.alphaCutoff) {
                    continue; // Skip transparent pixel
                }
            }
            rayQueryConfirmIntersectionEXT(rq);
            rayQueryTerminateEXT(rq);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        uint triIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        if (materials[triangles[triIdx].materialId].type != 3u) {
            return true;
        }
    }
    for (uint i = 0; i < pc.numSpheres; ++i) {
        if (materials[spheres[i].materialId].type == 3u) continue;
        float spT;
        vec3 spNorm;
        if (intersectSphere(origin, dir, spheres[i], tMin, tMax, spT, spNorm)) {
            return true;
        }
    }
    return false;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    bool inRange = (idx < queueCounters.activeRayCount);
    bool survivesToNext = false;
    RayPayload nextPayload;

    if (inRange) {
        RayPayload ray = inRays[idx];

        vec3 hitPoint = ray.origin.xyz;
        vec3 rayDir = ray.direction.xyz;
        uint bounce = floatBitsToUint(ray.direction.w);
        vec3 throughput = ray.throughput.rgb;
        uint seed = floatBitsToUint(ray.throughput.w);
        vec3 accumRadiance = ray.radiance.rgb;
        uint pixelIndex = floatBitsToUint(ray.radiance.w);
        vec3 hitNormal = ray.hitNormal.xyz;
        uint matId = floatBitsToUint(ray.hitNormal.w);
        vec2 hitUv = ray.hitExtra.xy;
        bool frontFace = (floatBitsToUint(ray.hitExtra.w) != 0u);

        Material mat = materials[matId];

        // 1. Sample glTF 2.0 Material Textures & Factors
        vec4 baseColor = mat.albedo;
        if (mat.albedoTex > 0u && mat.albedoTex <= 64u) {
            baseColor *= texture(sceneTextures[mat.albedoTex - 1u], hitUv);
        }

        float roughness = mat.roughness;
        float metallic = mat.metallic;
        if (mat.mrTex > 0u && mat.mrTex <= 64u) {
            vec4 mrSample = texture(sceneTextures[mat.mrTex - 1u], hitUv);
            roughness *= mrSample.g; // Green = roughness
            metallic *= mrSample.b;  // Blue = metallic
        }
        roughness = clamp(roughness, 0.04, 1.0);
        metallic = clamp(metallic, 0.0, 1.0);
        float alphaRoughness = roughness * roughness;

        float ao = 1.0;
        if (mat.occlusionTex > 0u && mat.occlusionTex <= 64u) {
            float occSample = texture(sceneTextures[mat.occlusionTex - 1u], hitUv).r;
            ao = 1.0 + mat.occlusionStrength * (occSample - 1.0);
        }

        float transmission = mat.transmission;
        if (mat.transmissionTex > 0u && mat.transmissionTex <= 64u) {
            transmission *= texture(sceneTextures[mat.transmissionTex - 1u], hitUv).r;
        }

        float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
        float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
        float specFactor = mat.specularFactor;
        if (mat.specularTex > 0u && mat.specularTex <= 64u) {
            specFactor *= texture(sceneTextures[mat.specularTex - 1u], hitUv).a;
        }
        vec3 dielectricF0 = vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0));
        vec3 F0 = mix(dielectricF0, baseColor.rgb, metallic);
        vec3 diffuseColor = baseColor.rgb * (1.0 - metallic);
        vec3 V = -rayDir;

        // Clearcoat properties
        float clearcoat = mat.clearcoat;
        if (mat.clearcoatTex > 0u && mat.clearcoatTex <= 64u) {
            clearcoat *= texture(sceneTextures[mat.clearcoatTex - 1u], hitUv).r;
        }
        float clearcoatRoughness = mat.clearcoatRoughness;
        if (mat.clearcoatRoughnessTex > 0u && mat.clearcoatRoughnessTex <= 64u) {
            clearcoatRoughness *= texture(sceneTextures[mat.clearcoatRoughnessTex - 1u], hitUv).g;
        }
        clearcoatRoughness = clamp(clearcoatRoughness, 0.001, 1.0);
        float clearcoatAlpha = clearcoatRoughness * clearcoatRoughness;

        vec3 clearcoatNormal = hitNormal;
        if (mat.clearcoatNormalTex > 0u && mat.clearcoatNormalTex <= 64u) {
            vec3 up = abs(hitNormal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
            vec3 cTan = normalize(cross(up, hitNormal));
            vec3 cBitan = cross(hitNormal, cTan);
            vec3 cNormMap = texture(sceneTextures[mat.clearcoatNormalTex - 1u], hitUv).rgb * 2.0 - 1.0;
            clearcoatNormal = normalize(mat3(cTan, cBitan, hitNormal) * cNormMap);
        }

        // Volumetric Beer-Lambert absorption
        float thickness = mat.thickness;
        if (mat.thicknessTex > 0u && mat.thicknessTex <= 64u) {
            thickness *= texture(sceneTextures[mat.thicknessTex - 1u], hitUv).g;
        }
        float mediumDist = !frontFace ? ray.hitExtra.z : (thickness > 0.0 ? thickness / max(abs(dot(rayDir, hitNormal)), 0.01) : 0.0);
        if (mat.attenuationColor.w > 0.0 && mediumDist > 0.0) {
            vec3 sigma_a = -log(max(mat.attenuationColor.rgb, vec3(0.0001))) / mat.attenuationColor.w;
            vec3 transmittance = exp(-sigma_a * mediumDist);
            throughput *= transmittance;
        }

        bool enableDirect = (ubo.flags & (1 << 0)) != 0;
        bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
        bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
        bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
        bool enableShadows = (ubo.flags & (1 << 4)) != 0;

        float clearcoatProb = (clearcoat > 0.001 && enableSpecular) ? (clearcoat * 0.25) : 0.0;
        float baseSpecProb = enableSpecular ? clamp(mix(0.04, 1.0, metallic), 0.05, 0.95) * (1.0 - clearcoatProb) : 0.0;

        // 2. Next Event Estimation (Direct Lighting with Cook-Torrance GGX Microfacet Model + MIS)
        if (enableDirect && transmission < 0.1 && mat.type != 2u) {
            for (uint l = 0; l < pc.numLights; ++l) {
                Light light = lights[l];
                vec3 lightPoint;
                vec3 lightDir;
                float lightDist;
                float lightPdf = 1.0;
                vec3 lightEmission = light.emission.rgb;

                if (uint(light.position.w) == 0u /* AREA QUAD */) {
                    vec2 luv = randVec2(seed);
                    lightPoint = light.position.xyz + luv.x * light.u.xyz + luv.y * light.v.xyz;
                    vec3 toLight = lightPoint - hitPoint;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);

                    float cosLight = dot(-lightDir, light.normal.xyz);
                    if (cosLight <= 0.0) continue;

                    float area = light.emission.w;
                    lightPdf = (lightDist * lightDist) / (area * cosLight);
                } else if (uint(light.position.w) == 1u /* SPOT */) {
                    vec3 toLight = light.position.xyz - hitPoint;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);

                    float cosSpot = dot(-lightDir, light.normal.xyz);
                    float innerCos = light.u.w;
                    float outerCos = light.v.w;
                    if (cosSpot < outerCos) continue;

                    float spotFactor = clamp((cosSpot - outerCos) / max(innerCos - outerCos, 1e-4), 0.0, 1.0);
                    lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                    lightPdf = 1.0;
                } else {
                    continue;
                }

                float NdotL = dot(hitNormal, lightDir);
                if (NdotL > 0.0) {
                    bool inShadow = false;
                    if (enableShadows) {
                        inShadow = isShadowOccluded(hitPoint + hitNormal * EPSILON, lightDir, EPSILON, lightDist - EPSILON);
                    }

                    if (!inShadow) {
                        vec3 H = normalize(V + lightDir);
                        float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);
                        float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                        float VdotH = clamp(dot(V, H), 0.0, 1.0);

                        float D = distributionGGX(NdotH, alphaRoughness);
                        float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                        vec3 F = fresnelSchlickVec(VdotH, F0);

                        vec3 specBRDF = enableSpecular ? (D * Vis * F) : vec3(0.0);
                        vec3 diffBRDF = (vec3(1.0) - F) * diffuseColor * INV_PI;

                        // Clearcoat layer evaluation
                        float Fc = 0.0;
                        vec3 clearcoatBRDF = vec3(0.0);
                        if (clearcoat > 0.001 && enableSpecular) {
                            vec3 Hc = normalize(V + lightDir);
                            float NcDotL = clamp(dot(clearcoatNormal, lightDir), 0.0, 1.0);
                            float NcDotV = clamp(dot(clearcoatNormal, V), 0.001, 1.0);
                            float NcDotH = clamp(dot(clearcoatNormal, Hc), 0.0, 1.0);
                            float VDotHc = clamp(dot(V, Hc), 0.0, 1.0);

                            Fc = fresnelSchlick(VDotHc, 1.5) * clearcoat;
                            float Dc = distributionGGX(NcDotH, clearcoatAlpha);
                            float VisC = visibilitySmithGGXCorrelated(NcDotL, NcDotV, clearcoatAlpha);
                            clearcoatBRDF = vec3(clearcoat * Dc * VisC * fresnelSchlick(VDotHc, 1.5));
                        }

                        vec3 brdf = (diffBRDF + specBRDF) * (1.0 - Fc) + clearcoatBRDF;

                        // Multiple Importance Sampling (MIS) balance heuristic for NEE
                        float misWeightLight = 1.0;
                        if (uint(light.position.w) == 0u /* AREA QUAD */) {
                            float bsdfPdf = evalBSDFPdf(V, lightDir, hitNormal, clearcoatNormal, alphaRoughness, clearcoatAlpha, clearcoatProb, baseSpecProb, clearcoat);
                            misWeightLight = lightPdf / (lightPdf + bsdfPdf);
                        }
                        accumRadiance += throughput * lightEmission * brdf * NdotL * misWeightLight / max(lightPdf, 1e-4);
                    }
                }
            }
        }

        // 3. Sample BSDF for Secondary Bounce
        bool pathTerminated = false;
        if (bounce + 1u >= pc.maxBounces || (!enableIndirect && bounce > 0u)) {
            pathTerminated = true;
        }

        vec3 nextDirection;
        vec3 nextOrigin;
        bool isDelta = false;
        float bsdfPdf = 1.0;

        if (!pathTerminated) {
            if (transmission > 0.01 || mat.type == 2u /* DIELECTRIC / REFRACTION */) {
                isDelta = true;
                if (!enableRefraction) {
                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                    nextOrigin = hitPoint + hitNormal * EPSILON;
                    throughput *= baseColor.rgb;
                } else {
                    float refractionRatio = frontFace ? (1.0 / iorVal) : iorVal;
                    vec3 unitDir = normalize(rayDir);
                    float cosTheta = min(dot(-unitDir, hitNormal), 1.0);
                    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                    bool cannotRefract = refractionRatio * sinTheta > 1.0;
                    float reflectProb = fresnelSchlick(cosTheta, refractionRatio);

                    if (cannotRefract || reflectProb > randFloat(seed)) {
                        nextDirection = reflect(unitDir, hitNormal);
                        nextOrigin = hitPoint + hitNormal * EPSILON;
                    } else {
                        nextDirection = refract(unitDir, hitNormal, refractionRatio);
                        nextOrigin = hitPoint - hitNormal * EPSILON;
                    }
                    throughput *= baseColor.rgb;
                }
            } else {
                // Clearcoat + Cook-Torrance GGX importance sampling
                float xi = randFloat(seed);

                if (xi < clearcoatProb) {
                    // Clearcoat specular lobe: GGX microfacet sampling with clearcoatNormal
                    vec3 Hc = sampleGGX(clearcoatNormal, clearcoatAlpha, seed);
                    vec3 L = reflect(-V, Hc);
                    float NcDotL = dot(clearcoatNormal, L);

                    if (NcDotL > 0.0) {
                        float NcDotV = clamp(dot(clearcoatNormal, V), 0.001, 1.0);
                        float NcDotH = clamp(dot(clearcoatNormal, Hc), 0.001, 1.0);
                        float VDotHc = clamp(dot(V, Hc), 0.0, 1.0);

                        float VisC = visibilitySmithGGXCorrelated(NcDotL, NcDotV, clearcoatAlpha);
                        float Fc = fresnelSchlick(VDotHc, 1.5) * clearcoat;

                        vec3 specWeight = vec3((4.0 * VisC * Fc * NcDotL * VDotHc) / max(NcDotH * clearcoatProb, 1e-4));
                        throughput *= clamp(specWeight, vec3(0.0), vec3(10.0));
                        nextDirection = L;
                    } else {
                        // Fallback to diffuse
                        nextDirection = sampleCosineHemisphere(hitNormal, seed);
                        vec3 H_diff = normalize(V + nextDirection);
                        vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                        throughput *= (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                    }
                } else if (xi < clearcoatProb + baseSpecProb) {
                    // Base Specular lobe: GGX microfacet sampling
                    vec3 H = sampleGGX(hitNormal, alphaRoughness, seed);
                    vec3 L = reflect(-V, H);
                    float NdotL = dot(hitNormal, L);

                    if (NdotL > 0.0) {
                        float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);
                        float NdotH = clamp(dot(hitNormal, H), 0.001, 1.0);
                        float VdotH = clamp(dot(V, H), 0.0, 1.0);

                        float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                        vec3 F = fresnelSchlickVec(VdotH, F0);
                        float Fc = fresnelSchlick(VdotH, 1.5) * clearcoat;

                        vec3 specWeight = (4.0 * Vis * F * NdotL * VdotH * (1.0 - Fc)) / max(NdotH * baseSpecProb, 1e-4);
                        throughput *= clamp(specWeight, vec3(0.0), vec3(10.0));
                        nextDirection = L;
                    } else {
                        // Fallback to diffuse
                        nextDirection = sampleCosineHemisphere(hitNormal, seed);
                        vec3 H_diff = normalize(V + nextDirection);
                        vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                        float Fc = fresnelSchlick(clamp(dot(V, H_diff), 0.0, 1.0), 1.5) * clearcoat;
                        throughput *= (1.0 - Fc) * (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                    }
                } else {
                    // Diffuse lobe: Cosine-weighted hemisphere sampling
                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                    vec3 H_diff = normalize(V + nextDirection);
                    vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                    float Fc = fresnelSchlick(clamp(dot(V, H_diff), 0.0, 1.0), 1.5) * clearcoat;
                    throughput *= (1.0 - Fc) * (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                }
                nextOrigin = hitPoint + hitNormal * EPSILON;
            }

            if (!isDelta) {
                bsdfPdf = evalBSDFPdf(V, nextDirection, hitNormal, clearcoatNormal, alphaRoughness, clearcoatAlpha, clearcoatProb, baseSpecProb, clearcoat);
            }

            // 4. Russian Roulette path termination
            if (bounce >= 1u) {
                float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
                if (randFloat(seed) > p) {
                    pathTerminated = true;
                } else {
                    throughput /= p;
                }
            }
        }

        // 5. Incoherent BVH Traversal for Secondary Ray
        if (!pathTerminated) {
            float closestT = 1e4;
            int closestTri = -1;
            vec2 closestBary = vec2(0.0);

            rayQueryEXT rq;
            rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, nextOrigin, EPSILON, nextDirection, closestT);
            while (rayQueryProceedEXT(rq)) {
                if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                    uint triIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
                    Material candMat = materials[triangles[triIdx].materialId];
                    if (candMat.alphaMode == 1u /* MASK */) {
                        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                        float cu = bary.x, cv = bary.y, cw = 1.0 - cu - cv;
                        Triangle ctri = triangles[triIdx];
                        vec2 cuv = cw * vec2(ctri.v0.position.w, ctri.v0.normal.w) +
                                   cu * vec2(ctri.v1.position.w, ctri.v1.normal.w) +
                                   cv * vec2(ctri.v2.position.w, ctri.v2.normal.w);
                        float calpha = candMat.albedo.a;
                        if (candMat.albedoTex > 0u && candMat.albedoTex <= 64u) {
                            calpha *= texture(sceneTextures[candMat.albedoTex - 1u], cuv).a;
                        }
                        if (calpha < candMat.alphaCutoff) {
                            continue; // Skip transparent pixel
                        }
                    }
                    rayQueryConfirmIntersectionEXT(rq);
                }
            }

            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                closestT = rayQueryGetIntersectionTEXT(rq, true);
                closestTri = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
                closestBary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
            }

            int closestSphere = -1;
            vec3 sphereNormal = vec3(0.0);
            for (uint i = 0; i < pc.numSpheres; ++i) {
                float spT;
                vec3 spNorm;
                if (intersectSphere(nextOrigin, nextDirection, spheres[i], EPSILON, closestT, spT, spNorm)) {
                    closestT = spT;
                    closestSphere = int(i);
                    closestTri = -1;
                    sphereNormal = spNorm;
                }
            }

            if (closestTri < 0 && closestSphere < 0) {
                // Miss: Secondary ray hit sky
                vec3 skyColor;
                if (pc.hasEnvMap == 1u) {
                    vec2 envUv = directionToEquirectangular(nextDirection);
                    skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
                } else {
                    float t = 0.5 * (nextDirection.y + 1.0);
                    skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
                }
                accumRadiance += throughput * skyColor * ao;
                pathTerminated = true;
            } else {
                // Hit geometry (triangle or procedural sphere)
                uint nextMatId = 0;
                vec3 nextNorm = vec3(0.0, 1.0, 0.0);
                vec2 nextUv = vec2(0.0);
                bool nextFront = true;

                if (closestTri >= 0) {
                    Triangle nextTri = triangles[closestTri];
                    nextMatId = nextTri.materialId;

                    float u = closestBary.x;
                    float v = closestBary.y;
                    float w = 1.0 - u - v;

                    vec3 n0 = nextTri.v0.normal.xyz;
                    vec3 n1 = nextTri.v1.normal.xyz;
                    vec3 n2 = nextTri.v2.normal.xyz;
                    nextNorm = normalize(w * n0 + u * n1 + v * n2);

                    vec2 uv0 = vec2(nextTri.v0.position.w, nextTri.v0.normal.w);
                    vec2 uv1 = vec2(nextTri.v1.position.w, nextTri.v1.normal.w);
                    vec2 uv2 = vec2(nextTri.v2.position.w, nextTri.v2.normal.w);
                    nextUv = w * uv0 + u * uv1 + v * uv2;

                    nextFront = dot(nextDirection, nextNorm) < 0.0;
                    nextNorm = nextFront ? nextNorm : -nextNorm;

                    Material nextMat = materials[nextMatId];

                    // Tangent frame & Normal mapping for secondary hit
                    if (nextMat.normalTex > 0u && nextMat.normalTex <= 64u) {
                        vec4 tan0 = nextTri.v0.tangent;
                        vec4 tan1 = nextTri.v1.tangent;
                        vec4 tan2 = nextTri.v2.tangent;
                        vec3 geomTan = normalize(w * tan0.xyz + u * tan1.xyz + v * tan2.xyz);
                        float tanSign = tan0.w != 0.0 ? tan0.w : 1.0;

                        vec3 normalMap = texture(sceneTextures[nextMat.normalTex - 1u], nextUv).rgb * 2.0 - 1.0;
                        normalMap.xy *= nextMat.normalScale;
                        normalMap = normalize(normalMap);

                        geomTan = normalize(geomTan - dot(geomTan, nextNorm) * nextNorm);
                        vec3 geomBitangent = cross(nextNorm, geomTan) * tanSign;
                        mat3 tbn = mat3(geomTan, geomBitangent, nextNorm);
                        nextNorm = normalize(tbn * normalMap);
                    }
                } else if (closestSphere >= 0) {
                    nextNorm = sphereNormal;
                    nextMatId = spheres[closestSphere].materialId;
                    nextFront = dot(nextDirection, nextNorm) < 0.0;
                    nextNorm = nextFront ? nextNorm : -nextNorm;
                }

                Material nextMat = materials[nextMatId];

                vec3 nextEmissive = nextMat.emissive.rgb;
                if (nextMat.emissiveTex > 0u && nextMat.emissiveTex <= 64u) {
                    nextEmissive *= texture(sceneTextures[nextMat.emissiveTex - 1u], nextUv).rgb;
                }

                // Multiple Importance Sampling (MIS) balance heuristic for secondary emissive hit
                float misWeightEmissive = 1.0;
                if (!isDelta && pc.numLights > 0u && enableDirect) {
                    float lightPdf = 0.0;
                    for (uint l = 0; l < pc.numLights; ++l) {
                        Light light = lights[l];
                        if (uint(light.position.w) == 0u /* AREA QUAD */) {
                            float cosLight = dot(-nextDirection, light.normal.xyz);
                            if (cosLight > 0.0) {
                                float area = light.emission.w;
                                if (area > 0.0 && (nextMat.type == 3u || dot(nextNorm, light.normal.xyz) > 0.9)) {
                                    lightPdf = (closestT * closestT) / (area * cosLight);
                                    break;
                                }
                            }
                        }
                    }
                    if (lightPdf > 0.0) {
                        misWeightEmissive = bsdfPdf / (bsdfPdf + lightPdf);
                    }
                }

                if (nextMat.type == 3u /* EMISSIVE */) {
                    accumRadiance += throughput * nextEmissive * misWeightEmissive;
                    pathTerminated = true;
                } else {
                    if (length(nextEmissive) > 1e-3) {
                        accumRadiance += throughput * nextEmissive * misWeightEmissive;
                    }
                    // Survives to the next bounce!
                    survivesToNext = true;
                    vec3 nextHitPt = nextOrigin + closestT * nextDirection;

                    nextPayload.origin = vec4(nextHitPt, uintBitsToFloat(1u));
                    nextPayload.direction = vec4(nextDirection, uintBitsToFloat(bounce + 1u));
                    nextPayload.throughput = vec4(throughput, uintBitsToFloat(seed));
                    nextPayload.radiance = vec4(accumRadiance, uintBitsToFloat(pixelIndex));
                    nextPayload.hitNormal = vec4(nextNorm, uintBitsToFloat(nextMatId));
                    nextPayload.hitExtra = vec4(nextUv, closestT, uintBitsToFloat(nextFront ? 1u : 0u));
                }
            }
        }

        // If path terminated at this stage, accumulate its radiance into the image
        if (pathTerminated) {
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            if (ubo.frameIndex == 0u && pc.sppSampleIndex == 0u) {
                imageStore(uAccumImage, pixelCoord, vec4(accumRadiance, 1.0));
            } else {
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, prev + vec4(accumRadiance, 1.0));
            }
        }
    }

    // Subgroup Wave Ballot Compaction into downstream queue
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (subgroupElect()) {
        waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
    }
    waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);

    if (survivesToNext) {
        uint targetIdx = waveGlobalOffset + laneSlot;
        if (targetIdx < pc.maxQueueCapacity) {
            outRays[targetIdx] = nextPayload;
        }
    }
}
