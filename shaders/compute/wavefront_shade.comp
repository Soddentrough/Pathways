#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 31, rgba16f) uniform readonly image2D uCausticImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
DECLARE_SCENE_TEXTURES_BINDING(8)

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    BounceDispatch bounceDispatches[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    BounceDGC bounceDGC[];
} dgcStream;

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 19) writeonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(std430, binding = 20) writeonly buffer OutNRCQueryQueue {
    NRCQuery nrcQueries[];
};

layout(std430, binding = 21) buffer InOutNRCTrainQueue {
    NRCTrainingRecord nrcTrainRecords[];
};

layout(std430, binding = 22) buffer InOutNRCCounters {
    NRCCountersBuffer nrcCounters;
};

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

#include "mis_common.glsl"
#include "bsdf_standard.glsl"

#ifndef ENABLE_INLINE_SHADOWS
#define ENABLE_INLINE_SHADOWS 1
#endif

#if ENABLE_INLINE_SHADOWS
#include "wavefront_shadow_inline.glsl"
#endif

#define SHADING_CORE_ENABLE_NEE
#include "shading_core.glsl"

layout(push_constant) uniform PushConstants {
    WavefrontShadePC pc;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    bool inRange = (idx < queueCounters.activeRayCount);
    bool survivesToNext = false;
    bool hasShadowRay = false;
    vec3 nextDirection = vec3(0.0);
    RayGeometry nextGeom;
    RayState nextState;
    PackedShadowRay shadowCandidate;

    if (inRange) {
        RayGeometry geom = inGeoms[idx];
        RayHit hit = inHits[idx];
        RayState state = inStates[idx];

        vec3 origin = geom.originPackedDir.xyz;
        vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        float hitT;
        uint matId, hitType;
        vec3 hitNormal, geomTan;
        vec2 hitUv;
        float tanSign;
        unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

        f16vec3 throughputHalf;
        uint seed, pixelIndex;
        bool isSpecularPath, causticApplied;
        uint dispersionChannel = 0u;
        unpackRayState(state, throughputHalf, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
        uint inPdfCode = unpackRayPdfCode(state);
        vec3 throughput = vec3(throughputHalf);
        uint bounce = pc.currentBounce;
        bool sampledSpecularLobe = false;

        // 0. Check if secondary ray hit sky / environment (Miss)
        if (hitType == 2u) {
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            vec3 skyContrib = throughput * skyColor;
            if (bounce > 0u) {
                skyContrib = clampIndirectRadiance(skyContrib, pc.indirectClamp);
            }
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), prev.a));
            }
            if (pc.captureMlData != 0u) {
                if (isSpecularPath) {
                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), prevSpec.a));
                } else {
                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, skyContrib, seed), prevDiff.a));
                }
            }
            // Ray terminates here (survivesToNext remains false)
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            hitNormal = frontFace ? hitNormal : -hitNormal;

            Material mat = materials[matId];

            // Tangent frame & Normal mapping: load tangents only when normal texture is active
            if (hitType == 0u && mat.normalTex > 0u && mat.normalTex <= 512u) {
                vec3 normalMap = SAMPLE_SCENE_TEXTURE(mat.normalTex, hitUv).rgb * 2.0 - 1.0;
                normalMap.xy *= mat.normalScale;
                normalMap = normalize(normalMap);

                geomTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
                vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                hitNormal = adjustShadingNormal(normalize(tbn * normalMap), -rayDir);
            }

            // 1. Sample glTF 2.0 Material Textures & Factors
            vec4 baseColor = mat.albedo;
            if (mat.albedoTex > 0u && mat.albedoTex <= 512u) {
                baseColor *= SAMPLE_SCENE_TEXTURE(mat.albedoTex, hitUv);
            }

            // Alpha masking & stochastic alpha blending
            if ((mat.alphaMode == 1u && baseColor.a < mat.alphaCutoff) ||
                (mat.alphaMode == 2u && randFloat(seed) > baseColor.a)) {
                // Transparent / masked pixel - passthrough ray
                survivesToNext = true;
                nextDirection = rayDir;
                nextGeom.originPackedDir = vec4(hitPoint + rayDir * EPSILON, uintBitsToFloat(packOct32(rayDir)));
                nextState = packRayState(f16vec3(throughput), seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel, inPdfCode);
            } else {
                bool routeAllToSpec = (bounce > 0u) && isSpecularPath;

                // Emissive radiance evaluation
                vec3 emissive = mat.emissive.rgb;
                if ((mat.type & MATERIAL_FLAG_HOLO_VIDEO) != 0u && mat.emissiveTex > 0u && mat.emissiveTex <= 512u) {
                    vec3 vidSample = SAMPLE_SCENE_TEXTURE(mat.emissiveTex, hitUv).rgb;
                    float time = float(ubo.frameIndex) * 0.01666667;
                    float sweep = sin(hitPoint.y * 24.0 - time * 4.0) * 0.5 + 0.5;
                    float scanMod = 0.94 + 0.06 * sweep;
                    float edgeDist = length(hitUv - vec2(0.5)) * 2.0;
                    float fringeFactor = pow(clamp((edgeDist - 0.5) * 2.0, 0.0, 1.0), 2.5) * 0.06;
                    vec3 chromaDisp = vec3(0.0);
                    if (fringeFactor > 1e-4) {
                        float phase = hitPoint.y * 48.0 - time * 5.0;
                        chromaDisp = vec3(sin(phase), sin(phase + 1.2), sin(phase + 2.4)) * fringeFactor;
                    }
                    vec3 holoBase = vidSample * (0.65 * scanMod) + chromaDisp;
                    vec3 tonemappedVid = holoBase / (vec3(1.0) + 0.20 * max(holoBase - vec3(0.40), vec3(0.0)));
                    float lum = dot(vidSample, vec3(0.2126, 0.7152, 0.0722));
                    vec3 holoPedestal = vec3(0.008, 0.025, 0.045) * (0.7 + 0.3 * sweep) * (1.0 - smoothstep(0.0, 0.40, lum));
                    vec3 rimGlow = vec3(0.0);
                    if (frontFace) {
                        float cosTheta = clamp(abs(dot(hitNormal, -rayDir)), 0.0, 1.0);
                        float fres = pow(1.0 - cosTheta, 3.0);
                        rimGlow = mix(vec3(0.02, 0.25, 0.70), vec3(0.05, 0.85, 0.95), fres) * (fres * 0.18);
                    }
                    float glitchPulse = smoothstep(0.986, 0.990, sin(time * 19.0 + hitPoint.y * 23.0)) * 0.08;
                    emissive = tonemappedVid * (1.0 + glitchPulse) + holoPedestal + rimGlow;
                } else if (mat.emissiveTex > 0u && mat.emissiveTex <= 512u) {
                    emissive *= SAMPLE_SCENE_TEXTURE(mat.emissiveTex, hitUv).rgb;
                }
                float emitMisW = shouldSuppressCausticEmitterHit(causticApplied, isSpecularPath, inPdfCode, bounce)
                    ? 0.0
                    : ((bounce == 0u) ? 1.0 : emitterHitMisWeight(hitType, hit.hitData1.y, hit.hitData1.x, origin, rayDir, hitT, inPdfCode, pc.numLights));
                if (length(emissive) > 1e-3 && emitMisW > 0.0) {
                    vec3 emissiveContrib = throughput * emissive * emitMisW;
                    if (bounce > 0u) {
                        float effClamp = computeAdaptiveFireflyClamp(pc.indirectClamp, inPdfCode);
                        emissiveContrib = clampIndirectRadiance(emissiveContrib, effClamp);
                    }
                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                        vec4 prev = imageLoad(uAccumImage, pCoord);
                        bool dynamicVideoBypass = (ubo.flags & (1u << 12)) != 0u;
                        float isDynamicVideo = (bounce == 0u && dynamicVideoBypass && (mat.emissiveTex == 1u || (mat.type & MATERIAL_FLAG_HOLO_VIDEO) != 0u)) ? 1.0 : prev.a;
                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, emissiveContrib, seed), isDynamicVideo));
                    }
                    if (pc.captureMlData != 0u) {
                        if (routeAllToSpec) {
                            vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                            imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, emissiveContrib, seed), prevSpec.a));
                        } else {
                            vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                            imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, emissiveContrib, seed), prevDiff.a));
                        }
                    }
                }

                bool pathTerminated = false;
                if ((mat.type & MATERIAL_TYPE_MASK) == 3u /* MATERIAL_EMISSIVE */) {
                    pathTerminated = true;
                } else {
                    float roughness = mat.roughness;
                    float metallic = mat.metallic;
                    if (mat.mrTex > 0u && mat.mrTex <= 512u) {
                        vec4 mrSample = SAMPLE_SCENE_TEXTURE(mat.mrTex, hitUv);
                        roughness *= mrSample.g;
                        metallic *= mrSample.b;
                    }
                    bool isMirrorDelta = (metallic > 0.99 && roughness <= 0.008);
                    roughness = clamp(roughness, 0.001, 1.0);
                    metallic = clamp(metallic, 0.0, 1.0);
                    float alphaRoughness = roughness * roughness;

                    float transmission = mat.transmission;
                    if (mat.transmissionTex > 0u && mat.transmissionTex <= 512u) {
                        transmission *= SAMPLE_SCENE_TEXTURE(mat.transmissionTex, hitUv).r;
                    }

                    float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
                    float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
                    float specFactor = mat.specularFactor;
                    if (mat.specularTex > 0u && mat.specularTex <= 512u) {
                        specFactor *= SAMPLE_SCENE_TEXTURE(mat.specularTex, hitUv).a;
                    }
                    vec3 dielectricF0 = vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0));
                    vec3 F0 = mix(dielectricF0, baseColor.rgb, metallic);
                    vec3 diffuseColor = baseColor.rgb * (1.0 - metallic);
                    vec3 V = -rayDir;

                    float diffTrans = clamp(mat.diffuseTransmission, 0.0, 1.0);
                    if (mat.diffuseTransmissionTex > 0u && mat.diffuseTransmissionTex <= 512u) {
                        diffTrans *= SAMPLE_SCENE_TEXTURE(mat.diffuseTransmissionTex, hitUv).r;
                    }
                    diffTrans = clamp(diffTrans, 0.0, 1.0);

                    // Clearcoat properties
                    float clearcoat = clamp(mat.clearcoat, 0.0, 1.0);
                    if (mat.clearcoatTex > 0u && mat.clearcoatTex <= 512u) {
                        clearcoat *= SAMPLE_SCENE_TEXTURE(mat.clearcoatTex, hitUv).r;
                    }
                    float clearcoatRoughness = mat.clearcoatRoughness;
                    if (mat.clearcoatRoughnessTex > 0u && mat.clearcoatRoughnessTex <= 512u) {
                        clearcoatRoughness *= SAMPLE_SCENE_TEXTURE(mat.clearcoatRoughnessTex, hitUv).g;
                    }
                    clearcoatRoughness = clamp(clearcoatRoughness, 0.001, 1.0);
                    float clearcoatAlpha = clearcoatRoughness * clearcoatRoughness;

                    vec3 surfTan = geomTan - dot(geomTan, hitNormal) * hitNormal;
                    if (hitType != 0u || dot(surfTan, surfTan) <= 1e-6) {
                        vec3 b1, b2;
                        buildOrthonormalBasis(hitNormal, b1, b2);
                        surfTan = b1;
                        tanSign = 1.0;
                    } else {
                        surfTan = normalize(surfTan);
                    }
                    vec3 surfBitan = cross(hitNormal, surfTan) * tanSign;

                    vec3 clearcoatNormal = hitNormal;
                    if (clearcoat > 0.001 && mat.clearcoatNormalTex > 0u && mat.clearcoatNormalTex <= 512u) {
                        vec3 cNormMap = SAMPLE_SCENE_TEXTURE(mat.clearcoatNormalTex, hitUv).rgb * 2.0 - 1.0;
                        clearcoatNormal = adjustShadingNormal(normalize(mat3(surfTan, surfBitan, hitNormal) * cNormMap), -rayDir);
                    }

                    vec3 sheenColor = mat.sheenColor;
                    if (mat.sheenTex > 0u && mat.sheenTex <= 512u) {
                        sheenColor *= SAMPLE_SCENE_TEXTURE(mat.sheenTex, hitUv).rgb;
                    }
                    float sheenRoughness = clamp(mat.sheenRoughness, 0.01, 1.0);

                    float anisoStrength = clamp(mat.anisotropyStrength, 0.0, 1.0);
                    vec2 anisoRot = vec2(cos(mat.anisotropyRotation), sin(mat.anisotropyRotation));
                    vec2 anisoDir = anisoRot;
                    if (anisoStrength > 0.001 && mat.anisotropyTex > 0u && mat.anisotropyTex <= 512u) {
                        vec3 anisoSample = SAMPLE_SCENE_TEXTURE(mat.anisotropyTex, hitUv).rgb;
                        vec2 texDir = anisoSample.xy * 2.0 - 1.0;
                        float texLen = length(texDir);
                        texDir = (texLen > 1e-4) ? (texDir / texLen) : vec2(1.0, 0.0);
                        anisoDir = vec2(texDir.x * anisoRot.x - texDir.y * anisoRot.y,
                                        texDir.x * anisoRot.y + texDir.y * anisoRot.x);
                        anisoStrength *= anisoSample.b;
                    }
                    vec3 anisoT = normalize(surfTan * anisoDir.x + surfBitan * anisoDir.y);
                    vec3 anisoB = normalize(cross(hitNormal, anisoT));
                    float alphaX = mix(alphaRoughness, 1.0, anisoStrength * anisoStrength);
                    float alphaY = alphaRoughness;

                    // Volumetric Beer-Lambert absorption (physical ray traversal distance)
                    float mediumDist = !frontFace ? hitT : 0.0;
                    if (mat.attenuationColor.w > 0.0 && mediumDist > 0.0) {
                        vec3 sigma_a = -log(max(mat.attenuationColor.rgb, vec3(0.0001))) / mat.attenuationColor.w;
                        vec3 transmittance = exp(-sigma_a * mediumDist);
                        throughput *= transmittance;
                    }

                    bool enableDirect = (ubo.flags & (1 << 0)) != 0;
                    bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
                    bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
                    bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
                    bool enableShadows = (ubo.flags & (1 << 4)) != 0;

                    bool isDielectricDelta = (transmission > 0.01 || (mat.type & MATERIAL_TYPE_MASK) == 2u);

                    bool enableCaustics = (ubo.flags & (1u << 8)) != 0u && (pc.numLights > 0u);
                    if (enableCaustics && bounce == 0u && !isDielectricDelta && metallic < 0.2 && !causticApplied) {
                        ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                        vec3 causticIrr = imageLoad(uCausticImage, pCoord).rgb;
                        if (dot(causticIrr, causticIrr) > 1e-8) {
                            vec3 causticRad = throughput * (diffuseColor * INV_PI) * causticIrr;
                            if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                vec4 prev = imageLoad(uAccumImage, pCoord);
                                imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, causticRad, seed), prev.a));
                            }
                            causticApplied = true;
                            if (pc.captureMlData != 0u) {
                                vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                                imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, causticRad, seed), prevDiff.a));
                            }
                        }
                    }

                    StdBsdf bsdf = makeStdBsdf(diffuseColor, F0, alphaRoughness, diffTrans, metallic, dot(hitNormal, V), STD_BSDF_FULL);
                    stdBsdfSetLayers(bsdf, enableSpecular, clearcoatNormal, clearcoat, clearcoatAlpha, sheenColor, sheenRoughness);
                    stdBsdfSetAnisoIridescence(bsdf, anisoT, anisoB, alphaX, alphaY,
                                               mat.iridescence, mat.iridescenceIor, mat.iridescenceThickness);

                    // 2. Direct Lighting via shared NEE + MIS
                    vec3 secDirectL = vec3(0.0);
                    if (enableDirect && !isDielectricDelta && !isMirrorDelta && pc.numLights > 0u) {
                        bool enableInlineShadows = ((ubo.flags & (1 << 6)) != 0) && (bounce == 0u);
                        uint M = (pc.numLights > 1u) ? min(pc.numLights, 4u) : 1u;
                        vec3 shadowOrigin, selectedLightDir, diffContrib, specContrib;
                        float selectedLightDist;
                        if (evalStandardDirectNEE(bsdf, hitPoint, hitNormal, V, pc.numLights, M,
                                                  bounce + 1u < pc.maxBounces, seed,
                                                  shadowOrigin, selectedLightDir, selectedLightDist,
                                                  diffContrib, specContrib)) {
                            secDirectL = diffContrib + specContrib;
                            vec3 diffUnshadowed = throughput * diffContrib;
                            vec3 specUnshadowed = throughput * specContrib;
                            vec3 unshadowed = diffUnshadowed + specUnshadowed;
                            if (bounce > 0u) {
                                unshadowed = clampIndirectRadiance(unshadowed, pc.indirectClamp);
                                diffUnshadowed = clampIndirectRadiance(diffUnshadowed, pc.indirectClamp);
                                specUnshadowed = clampIndirectRadiance(specUnshadowed, pc.indirectClamp);
                            }

                            if (any(greaterThan(unshadowed, vec3(1e-5)))) {
                                if (enableShadows) {
#if ENABLE_INLINE_SHADOWS
                                    if (enableInlineShadows && pc.useHardwareRT == 1u) {
                                        bool occluded = traceShadowRayInline(shadowOrigin, selectedLightDir, selectedLightDist,
                                                                             (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                        if (!occluded) {
                                            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                            if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                                imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, unshadowed, seed), prev.a));
                                            }
                                            if (pc.captureMlData != 0u) {
                                                if (routeAllToSpec) {
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, unshadowed, seed), prevSpec.a));
                                                } else {
                                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, diffUnshadowed, seed), prevDiff.a));
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, specUnshadowed, seed), prevSpec.a));
                                                }
                                            }
                                        }
                                    } else
#endif
                                    {
                                        float diffShadowLum = dot(diffUnshadowed, vec3(0.2126, 0.7152, 0.0722));
                                        float specShadowLum = dot(specUnshadowed, vec3(0.2126, 0.7152, 0.0722));
                                        float shadowSpecCode = routeAllToSpec ? 2.0 : clamp(specShadowLum / max(diffShadowLum + specShadowLum, 1e-8), 0.0, 1.0);
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(shadowOrigin, selectedLightDist);
                                        shadowCandidate.dirPixelRad = uvec4(packOct32(selectedLightDir), pixelIndex, packHalf2x16(unshadowed.rg), packHalf2x16(vec2(unshadowed.b, shadowSpecCode)));
                                    }
                                } else {
                                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                        vec4 prev = imageLoad(uAccumImage, pCoord);
                                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, unshadowed, seed), prev.a));
                                    }
                                }
                            }
                        }
                    }

                    // 3. Sample BSDF for Secondary Bounce
                    if (bounce + 1u >= pc.maxBounces || (!enableIndirect && bounce > 0u)) {
                        pathTerminated = true;
                    } else if (pc.enableNrc == 1u && bounce >= pc.nrcBounce && !isDielectricDelta && roughness >= 0.20 && metallic < 0.9 && hitT > 0.05) {
                        float prevPdf = (inPdfCode > 0u) ? exp2(float(inPdfCode) * (1.0 / 64.0) - 20.0) : 0.318309886;
                        float cosThetaIn = max(abs(dot(hitNormal, V)), 0.05);
                        float pathSpreadSq = (hitT * hitT) / max(prevPdf * cosThetaIn, 1e-3);
                        float camDistSq = max(dot(hitPoint - ubo.position.xyz, hitPoint - ubo.position.xyz), 0.01);
                        float pixelSolidAngle = 4.0 * abs(ubo.projInverse[1][1] * ubo.projInverse[1][1]) / max(float(pc.width * pc.height), 1.0);
                        bool spreadSufficient = (bounce > pc.nrcBounce) || (roughness >= 0.35) || (pathSpreadSq >= camDistSq * pixelSolidAngle * 16.0);
                        if (spreadSufficient) {
                            vec3 surfReflectance = max(diffuseColor + F0, vec3(0.05));
                            float nrcRoughness = max(roughness, 0.20);
                            bool isTrain = (randFloat(seed) < pc.nrcTrainRatio);
                            if (isTrain) {
                                uint trainIdx = atomicAdd(nrcCounters.trainCount, 1u);
                                if (trainIdx < pc.maxQueueCapacity) {
                                    nrcTrainRecords[trainIdx].pos_roughness = vec4(hitPoint, nrcRoughness);
                                    nrcTrainRecords[trainIdx].normal_flags = vec4(hitNormal, 1.0);
                                    nrcTrainRecords[trainIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                                    nrcTrainRecords[trainIdx].albedo_pad = vec4(diffuseColor, 0.0);
                                    nrcTrainRecords[trainIdx].throughput = vec4(throughput * surfReflectance, 0.0);
                                    nrcTrainRecords[trainIdx].targetRadiance = vec4(secDirectL / surfReflectance, 0.0);
                                }
                            } else {
                                uint qIdx = atomicAdd(nrcCounters.queryCount, 1u);
                                if (qIdx < pc.maxQueueCapacity) {
                                    if ((qIdx & 15u) == 0u) {
                                        atomicMax(nrcCounters.dispatchX, (qIdx >> 4u) + 1u);
                                    }
                                    nrcQueries[qIdx].pos_roughness = vec4(hitPoint, nrcRoughness);
                                    nrcQueries[qIdx].normal_flags = vec4(hitNormal, 0.0);
                                    nrcQueries[qIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                                    nrcQueries[qIdx].albedo_pad = vec4(diffuseColor, 0.0);
                                    nrcQueries[qIdx].throughput = vec4(throughput * surfReflectance, 0.0);
                                    pathTerminated = true;
                                } else {
                                    pathTerminated = false;
                                }
                            }
                        }
                    }

                    nextDirection = vec3(0.0);
                    vec3 nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                    uint nextPdfCode = 0u;

                    if (!pathTerminated) {
                        if (isDielectricDelta) {
                            sampledSpecularLobe = true;
                            if (!enableRefraction) {
                                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                                nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                                throughput *= baseColor.rgb;
                            } else {
                                if (mat.dispersion > 0.001 && dispersionChannel != 0u) {
                                    iorVal += (float(dispersionChannel - 1u) - 1.0) * (mat.dispersion * 0.03 * iorVal);
                                }
                                float refractionRatio = frontFace ? (1.0 / iorVal) : iorVal;
                                vec3 unitDir = normalize(rayDir);
                                float cosTheta = min(dot(-unitDir, hitNormal), 1.0);
                                float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                                bool cannotRefract = refractionRatio * sinTheta > 1.0;
                                float reflectProb = fresnelDielectric(cosTheta, refractionRatio);

                                bool isThinWalled = (mat.thickness <= 0.001);
                                if (isThinWalled) {
                                    if (!frontFace) {
                                        reflectProb = 0.0;
                                        cannotRefract = false;
                                    } else {
                                        reflectProb = (2.0 * reflectProb) / (1.0 + reflectProb);
                                    }
                                }

                                if (cannotRefract || reflectProb > randFloat(seed)) {
                                    nextDirection = reflect(unitDir, hitNormal);
                                    nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                                } else {
                                    if (isThinWalled) {
                                        nextDirection = unitDir;
                                        nextOrigin = offsetRayOrigin(hitPoint, unitDir * 2.0);
                                        throughput *= baseColor.rgb;
                                    } else {
                                        if (mat.dispersion > 0.001 && dispersionChannel == 0u) {
                                            uint channel = min(uint(randFloat(seed) * 3.0), 2u);
                                            dispersionChannel = channel + 1u;
                                            vec3 mask = vec3(channel == 0u ? 3.0 : 0.0, channel == 1u ? 3.0 : 0.0, channel == 2u ? 3.0 : 0.0);
                                            throughput *= mask;
                                            iorVal += (float(channel) - 1.0) * (mat.dispersion * 0.03 * iorVal);
                                            refractionRatio = frontFace ? (1.0 / iorVal) : iorVal;
                                        }
                                        vec3 refrVec = refract(unitDir, hitNormal, refractionRatio);
                                        if (dot(refrVec, refrVec) > 1e-6) {
                                            nextDirection = normalize(refrVec);
                                            nextOrigin = offsetRayOrigin(hitPoint, -hitNormal);
                                            throughput *= baseColor.rgb;
                                        } else {
                                            nextDirection = reflect(unitDir, hitNormal);
                                            nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                                        }
                                    }
                                }
                            }
                        } else if (isMirrorDelta) {
                            sampledSpecularLobe = true;
                            float NdotV = clamp(dot(hitNormal, V), 0.0, 1.0);
                            nextDirection = reflect(-V, hitNormal);
                            nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                            throughput *= fresnelSchlickVec(NdotV, F0);
                        } else {
                            float uLobe = randFloat(seed);
                            float uTrans = randFloat(seed);
                            vec2 uDir = randVec2(seed);
                            vec3 bsdfWeight;
                            float outPdf;
                            bool isTrans;
                            if (sampleStdBsdfBounce(bsdf, hitNormal, V, uLobe, uTrans, uDir,
                                                    nextDirection, bsdfWeight, outPdf, sampledSpecularLobe, isTrans)) {
                                throughput *= min(bsdfWeight, vec3(65000.0));
                                nextOrigin = offsetRayOrigin(hitPoint, isTrans ? -hitNormal : hitNormal);
                                nextPdfCode = encodeBsdfPdf(outPdf);
                            } else {
                                pathTerminated = true;
                            }
                        }

                        if (!pathTerminated) {
                            // 4. Adaptive Russian Roulette path termination
                            float pathLum = dot(throughput * float(max(ubo.spp, 1u)), vec3(0.2126, 0.7152, 0.0722));
                            pathTerminated = applyRussianRoulette(throughput, pathLum, bounce, seed);
                        }
                    }

                    // 5. Emit Surviving Secondary Ray
                    if (!pathTerminated) {
                        survivesToNext = true;
                        nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                        bool mergeMatteIndirectSpec = (roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01);
                        bool outIsSpecularPath = (bounce == 0u) ? (sampledSpecularLobe && !mergeMatteIndirectSpec) : isSpecularPath;
                        nextState = packRayState(f16vec3(throughput), seed, pixelIndex, outIsSpecularPath, causticApplied, dispersionChannel, nextPdfCode);
                    }
                }
            }
        }
    }

    // Standard single-queue linear compaction for ray geometry and state
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (waveActiveCount > 0u) {
        if (subgroupElect()) {
            waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);
    }

    uint targetIdx = waveGlobalOffset + laneSlot;
    if (survivesToNext) {
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    if (pc.secondarySortMode == 1u) {
        // Producer-Side Binning: Record compacted ray indices into 8 directional octant queues
        uint oct = survivesToNext ? getDirectionalOctant(nextDirection) : 0u;
        uvec4 activeBallot = subgroupBallot(survivesToNext);
        while (subgroupBallotBitCount(activeBallot) > 0u) {
            uint leaderLane = subgroupBallotFindLSB(activeBallot);
            uint k = subgroupBroadcast(oct, leaderLane);
            bool isOct = survivesToNext && (oct == k);
            uvec4 octBallot = subgroupBallot(isOct);
            uint octCount = subgroupBallotBitCount(octBallot);
            uint octSlot = subgroupBallotExclusiveBitCount(octBallot);
            uint octBase = 0u;
            if (gl_SubgroupInvocationID == leaderLane) {
                octBase = atomicAdd(queueCounters.octantCounts[k], octCount);
            }
            octBase = subgroupBroadcast(octBase, leaderLane);
            if (isOct) {
                uint dest = k * pc.maxQueueCapacity + (octBase + octSlot);
                if (octBase + octSlot < pc.maxQueueCapacity) {
                    secondaryIndices[dest] = targetIdx;
                }
            }
            activeBallot.x &= ~octBallot.x;
            activeBallot.y &= ~octBallot.y;
            activeBallot.z &= ~octBallot.z;
            activeBallot.w &= ~octBallot.w;
        }
    }

    // Subgroup Wave Ballot Compaction for Shadow Rays
    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (shadowWaveCount > 0u) {
        if (subgroupElect()) {
            shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
        }
        shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);
    }

    if (hasShadowRay) {
        uint targetIdxShadow = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdxShadow < pc.maxQueueCapacity) {
            shadowRays[targetIdxShadow] = shadowCandidate;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly (eliminating Mode 1 Resolve)
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint totalWgs = gl_NumWorkGroups.x;
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == totalWgs - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.bounceDispatches[b].shadowDispatch.x = shadowGroups;
            indirect.bounceDispatches[b].shadowDispatch.y = 1u;
            indirect.bounceDispatches[b].shadowDispatch.z = 1u;
            indirect.bounceDispatches[b].shadowDispatch.pad = shadowCount;

            dgcStream.bounceDGC[b].shadowCmd.pipelineIndex = 3u;
            dgcStream.bounceDGC[b].shadowCmd.x = shadowGroups;
            dgcStream.bounceDGC[b].shadowCmd.y = 1u;
            dgcStream.bounceDGC[b].shadowCmd.z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            bool skipNextBounce = (b > 0u && pc.minRayThreshold > 0u && nextCount <= pc.minRayThreshold);
            uint intersectGroups = skipNextBounce ? 0u : ((nextCount + 31u) / 32u);
            indirect.bounceDispatches[b].intersectDispatch.x = intersectGroups;
            indirect.bounceDispatches[b].intersectDispatch.y = 1u;
            indirect.bounceDispatches[b].intersectDispatch.z = 1u;
            indirect.bounceDispatches[b].intersectDispatch.pad = nextCount;

            dgcStream.bounceDGC[b].intersectCmd.pipelineIndex = 1u;
            dgcStream.bounceDGC[b].intersectCmd.x = intersectGroups;
            dgcStream.bounceDGC[b].intersectCmd.y = 1u;
            dgcStream.bounceDGC[b].intersectCmd.z = 1u;

            if (b + 1u < pc.maxBounces) {
                indirect.bounceDispatches[b + 1u].shadeDispatch.x = intersectGroups;
                indirect.bounceDispatches[b + 1u].shadeDispatch.y = 1u;
                indirect.bounceDispatches[b + 1u].shadeDispatch.z = 1u;
                indirect.bounceDispatches[b + 1u].shadeDispatch.pad = skipNextBounce ? 0u : nextCount;

                dgcStream.bounceDGC[b + 1u].shadeCmd.pipelineIndex = 2u;
                dgcStream.bounceDGC[b + 1u].shadeCmd.x = intersectGroups;
                dgcStream.bounceDGC[b + 1u].shadeCmd.y = 1u;
                dgcStream.bounceDGC[b + 1u].shadeCmd.z = 1u;
            }

            queueCounters.totalIntersectWorkgroups = intersectGroups;
            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces && !skipNextBounce) ? nextCount : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
