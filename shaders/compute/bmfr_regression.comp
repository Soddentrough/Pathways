#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 8, local_size_y = 8) in;

// Binding 0: Input radiance (from Temporal Accumulation or Raw Accumulation)
layout(binding = 0) readonly uniform image2D uInputRadiance;

// Binding 1: Normal and Depth G-Buffer (RGB: World Normal, A: Linear Depth)
layout(binding = 1) readonly uniform image2D uNormalDepth;

// Binding 2: Denoised Output Radiance
layout(binding = 2) writeonly uniform image2D uOutputRadiance;

layout(push_constant) uniform PushConstants {
    ivec2 imageSize;
    vec2 invImageSize;
    float lambda;   // Tikhonov regularization (default: 0.01)
    float maxDepth; // Linear depth scale normalization (default: 50.0)
    uint tileSize;  // 8
    uint pad;
} pc;

// Shared memory for wave reduction and regression weights
shared float s_wave1[39];
shared float s_weights[18]; // 6 weights for R, 6 for G, 6 for B

bool isInvalid(vec3 v) {
    return isnan(v.r) || isnan(v.g) || isnan(v.b) || isinf(v.r) || isinf(v.g) || isinf(v.b);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    bool inBounds = (pixelCoord.x < pc.imageSize.x && pixelCoord.y < pc.imageSize.y);

    // 1. Fetch input radiance and G-buffer features
    vec3 C = vec3(0.0);
    vec3 N = vec3(0.0, 0.0, 1.0);
    float depth = 1000.0;

    if (inBounds) {
        vec4 rad = imageLoad(uInputRadiance, pixelCoord);
        C = rad.rgb;
        if (isInvalid(C)) C = vec3(0.0);

        vec4 nd = imageLoad(uNormalDepth, pixelCoord);
        if (length(nd.xyz) > 0.1) {
            N = normalize(nd.xyz);
        }
        depth = nd.w;
    }

    bool isSky = (depth > 5000.0 || depth <= 0.0);
    float dNorm = isSky ? 1.0 : clamp(depth / max(pc.maxDepth, 1.0), 0.0, 10.0);

    // 6 Features: [1, Nx, Ny, Nz, D, D^2]
    float f[6];
    f[0] = 1.0;
    f[1] = N.x;
    f[2] = N.y;
    f[3] = N.z;
    f[4] = dNorm;
    f[5] = dNorm * dNorm;

    // Outer products S = f * f^T (21 unique elements for symmetric 6x6)
    float localVals[39];
    int idx = 0;
    for (int j = 0; j < 6; ++j) {
        for (int k = j; k < 6; ++k) {
            localVals[idx++] = inBounds ? (f[j] * f[k]) : 0.0;
        }
    }

    // Right-hand sides b = f * C^T (18 elements: 6 R, 6 G, 6 B)
    for (int j = 0; j < 6; ++j) {
        localVals[21 + j]     = inBounds ? (f[j] * C.r) : 0.0;
        localVals[21 + 6 + j] = inBounds ? (f[j] * C.g) : 0.0;
        localVals[21 + 12 + j]= inBounds ? (f[j] * C.b) : 0.0;
    }

    // 2. Parallel Reduction across 64 threads (2 Wave32 subgroups)
    uint waveID = gl_SubgroupInvocationID;
    uint subgroupId = gl_SubgroupID;

    for (int i = 0; i < 39; ++i) {
        float waveSum = subgroupAdd(localVals[i]);
        if (subgroupId == 1u && waveID == uint(i)) {
            s_wave1[i] = waveSum;
        }
    }

    barrier();

    // 3. Lane 0 solves 6x6 SPD system via Cholesky Decomposition
    if (gl_LocalInvocationIndex == 0u) {
        float S[6][6];
        int sIdx = 0;
        for (int j = 0; j < 6; ++j) {
            for (int k = j; k < 6; ++k) {
                float total = subgroupAdd(localVals[sIdx]) + s_wave1[sIdx];
                S[j][k] = total;
                S[k][j] = total;
                sIdx++;
            }
        }

        float bR[6], bG[6], bB[6];
        for (int j = 0; j < 6; ++j) {
            bR[j] = subgroupAdd(localVals[21 + j])      + s_wave1[21 + j];
            bG[j] = subgroupAdd(localVals[21 + 6 + j])  + s_wave1[21 + 6 + j];
            bB[j] = subgroupAdd(localVals[21 + 12 + j]) + s_wave1[21 + 12 + j];
        }

        // Add Tikhonov regularization lambda * trace(S)/6 * I
        float traceS = S[0][0] + S[1][1] + S[2][2] + S[3][3] + S[4][4] + S[5][5];
        float reg = max(pc.lambda * (traceS / 6.0), 1e-4);
        for (int j = 0; j < 6; ++j) {
            S[j][j] += reg;
        }

        // Cholesky Factorization: S = L * L^T
        float L[6][6];
        for (int i = 0; i < 6; ++i) {
            for (int j = 0; j <= i; ++j) {
                float sum = S[i][j];
                for (int k = 0; k < j; ++k) {
                    sum -= L[i][k] * L[j][k];
                }
                if (i == j) {
                    if (sum <= 1e-6) {
                        sum = 1e-6;
                    }
                    L[i][j] = sqrt(sum);
                } else {
                    L[i][j] = sum / max(L[j][j], 1e-6);
                }
            }
        }

        // Solve for each channel: L * y = b, then L^T * w = y
        // Channel R:
        float yR[6], wR[6];
        for (int i = 0; i < 6; ++i) {
            float sum = bR[i];
            for (int k = 0; k < i; ++k) sum -= L[i][k] * yR[k];
            yR[i] = sum / max(L[i][i], 1e-6);
        }
        for (int i = 5; i >= 0; --i) {
            float sum = yR[i];
            for (int k = i + 1; k < 6; ++k) sum -= L[k][i] * wR[k];
            wR[i] = sum / max(L[i][i], 1e-6);
        }

        // Channel G:
        float yG[6], wG[6];
        for (int i = 0; i < 6; ++i) {
            float sum = bG[i];
            for (int k = 0; k < i; ++k) sum -= L[i][k] * yG[k];
            yG[i] = sum / max(L[i][i], 1e-6);
        }
        for (int i = 5; i >= 0; --i) {
            float sum = yG[i];
            for (int k = i + 1; k < 6; ++k) sum -= L[k][i] * wG[k];
            wG[i] = sum / max(L[i][i], 1e-6);
        }

        // Channel B:
        float yB[6], wB[6];
        for (int i = 0; i < 6; ++i) {
            float sum = bB[i];
            for (int k = 0; k < i; ++k) sum -= L[i][k] * yB[k];
            yB[i] = sum / max(L[i][i], 1e-6);
        }
        for (int i = 5; i >= 0; --i) {
            float sum = yB[i];
            for (int k = i + 1; k < 6; ++k) sum -= L[k][i] * wB[k];
            wB[i] = sum / max(L[i][i], 1e-6);
        }

        // Store weights to LDS
        for (int m = 0; m < 6; ++m) {
            s_weights[m]          = wR[m];
            s_weights[6 + m]      = wG[m];
            s_weights[12 + m]     = wB[m];
        }
    }

    barrier();

    // 4. Reconstruct pixel radiance using fitted weights
    if (inBounds) {
        if (isSky) {
            imageStore(uOutputRadiance, pixelCoord, vec4(C, 1.0));
        } else {
            vec3 recon = vec3(0.0);
            for (int m = 0; m < 6; ++m) {
                recon.r += s_weights[m] * f[m];
                recon.g += s_weights[6 + m] * f[m];
                recon.b += s_weights[12 + m] * f[m];
            }

            recon = max(vec3(0.0), recon);
            if (isInvalid(recon)) recon = C;

            vec3 finalColor = mix(C, recon, 0.90);
            imageStore(uOutputRadiance, pixelCoord, vec4(finalColor, 1.0));
        }
    }
}
