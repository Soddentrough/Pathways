#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 8, local_size_y = 8) in;

// Binding 0: Input radiance (from Temporal Accumulation or Raw Accumulation)
layout(binding = 0) readonly uniform image2D uInputRadiance;

// Binding 1: Normal and Depth G-Buffer (RGB: World Normal, A: Linear Depth)
layout(binding = 1) readonly uniform image2D uNormalDepth;

// Binding 2: Denoised Output Radiance
layout(binding = 2) writeonly uniform image2D uOutputRadiance;

layout(push_constant) uniform PushConstants {
    ivec2 imageSize;
    vec2 invImageSize;
    float lambda;   // Tikhonov regularization (default: 0.01)
    float maxDepth; // Linear depth scale normalization (default: 50.0)
    uint tileSize;  // 8
    uint pad;
} pc;

// Shared memory for wave reduction, regression system, and fitted weights
shared float s_subgroupSums[2][39];
shared float s_weights[18]; // 6 weights for R, 6 for G, 6 for B
shared float s_S[6][6];
shared float s_L[6][6];
shared float s_y[6];

bool isInvalid(vec3 v) {
    return isnan(v.r) || isnan(v.g) || isnan(v.b) || isinf(v.r) || isinf(v.g) || isinf(v.b);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    bool inBounds = (pixelCoord.x < pc.imageSize.x && pixelCoord.y < pc.imageSize.y);

    // 1. Fetch input radiance and G-buffer features
    vec3 C = vec3(0.0);
    vec3 N = vec3(0.0, 0.0, 1.0);
    float depth = 1000.0;

    if (inBounds) {
        vec4 rad = imageLoad(uInputRadiance, pixelCoord);
        C = rad.rgb;
        if (isInvalid(C)) C = vec3(0.0);

        vec4 nd = imageLoad(uNormalDepth, pixelCoord);
        if (length(nd.xyz) > 0.1) {
            N = normalize(nd.xyz);
        }
        depth = nd.w;
    }

    bool isSky = (depth > 5000.0 || depth <= 0.0);
    float dNorm = isSky ? 1.0 : clamp(depth / max(pc.maxDepth, 1.0), 0.0, 10.0);

    // 2. Outer products and parallel reduction across 64 threads (2 Wave32 subgroups)
    {
        // 6 Features: [1, Nx, Ny, Nz, D, D^2]
        float f[6];
        f[0] = 1.0;
        f[1] = N.x;
        f[2] = N.y;
        f[3] = N.z;
        f[4] = dNorm;
        f[5] = dNorm * dNorm;

        uint waveID = gl_SubgroupInvocationID;
        uint subgroupId = gl_SubgroupID;

        // S = f * f^T (21 unique elements for symmetric 6x6)
        int idx = 0;
        for (int j = 0; j < 6; ++j) {
            for (int k = j; k < 6; ++k) {
                float val = inBounds ? (f[j] * f[k]) : 0.0;
                float waveSum = subgroupAdd(val);
                if (waveID == 0u) {
                    s_subgroupSums[subgroupId][idx] = waveSum;
                }
                idx++;
            }
        }

        // Right-hand sides b = f * C^T (18 elements: 6 R, 6 G, 6 B)
        for (int j = 0; j < 6; ++j) {
            float valR = inBounds ? (f[j] * C.r) : 0.0;
            float sumR = subgroupAdd(valR);
            if (waveID == 0u) {
                s_subgroupSums[subgroupId][21 + j] = sumR;
            }

            float valG = inBounds ? (f[j] * C.g) : 0.0;
            float sumG = subgroupAdd(valG);
            if (waveID == 0u) {
                s_subgroupSums[subgroupId][21 + 6 + j] = sumG;
            }

            float valB = inBounds ? (f[j] * C.b) : 0.0;
            float sumB = subgroupAdd(valB);
            if (waveID == 0u) {
                s_subgroupSums[subgroupId][21 + 12 + j] = sumB;
            }
        }
    }

    barrier();

    // 3. Lane 0 solves 6x6 SPD system via Cholesky Decomposition
    if (gl_LocalInvocationIndex == 0u) {
        int sIdx = 0;
        for (int j = 0; j < 6; ++j) {
            for (int k = j; k < 6; ++k) {
                float total = s_subgroupSums[0][sIdx] + s_subgroupSums[1][sIdx];
                s_S[j][k] = total;
                s_S[k][j] = total;
                sIdx++;
            }
        }

        // Add Tikhonov regularization lambda * trace(S)/6 * I
        float traceS = s_S[0][0] + s_S[1][1] + s_S[2][2] + s_S[3][3] + s_S[4][4] + s_S[5][5];
        float reg = max(pc.lambda * (traceS / 6.0), 1e-4);
        for (int j = 0; j < 6; ++j) {
            s_S[j][j] += reg;
        }

        // Cholesky Factorization: S = L * L^T (written to s_L in LDS)
        for (int i = 0; i < 6; ++i) {
            for (int j = 0; j <= i; ++j) {
                float sum = s_S[i][j];
                for (int k = 0; k < j; ++k) {
                    sum -= s_L[i][k] * s_L[j][k];
                }
                if (i == j) {
                    if (sum <= 1e-6) {
                        sum = 1e-6;
                    }
                    s_L[i][j] = sqrt(sum);
                } else {
                    s_L[i][j] = sum / max(s_L[j][j], 1e-6);
                }
            }
        }

        // Solve for each color channel: L * y = b, then L^T * w = y
        for (int c = 0; c < 3; ++c) {
            int bOffset = 21 + c * 6;
            int wOffset = c * 6;

            // Forward solve: L * y = b
            for (int i = 0; i < 6; ++i) {
                float sum = s_subgroupSums[0][bOffset + i] + s_subgroupSums[1][bOffset + i];
                for (int k = 0; k < i; ++k) sum -= s_L[i][k] * s_y[k];
                s_y[i] = sum / max(s_L[i][i], 1e-6);
            }

            // Backward solve: L^T * w = y (writes directly into s_weights in LDS)
            for (int i = 5; i >= 0; --i) {
                float sum = s_y[i];
                for (int k = i + 1; k < 6; ++k) sum -= s_L[k][i] * s_weights[wOffset + k];
                s_weights[wOffset + i] = sum / max(s_L[i][i], 1e-6);
            }
        }
    }

    barrier();

    // 4. Reconstruct pixel radiance using fitted weights
    if (inBounds) {
        if (isSky) {
            imageStore(uOutputRadiance, pixelCoord, vec4(C, 1.0));
        } else {
            float dNorm2 = dNorm * dNorm;
            vec3 recon = vec3(
                s_weights[0]  + s_weights[1]*N.x  + s_weights[2]*N.y  + s_weights[3]*N.z  + s_weights[4]*dNorm  + s_weights[5]*dNorm2,
                s_weights[6]  + s_weights[7]*N.x  + s_weights[8]*N.y  + s_weights[9]*N.z  + s_weights[10]*dNorm + s_weights[11]*dNorm2,
                s_weights[12] + s_weights[13]*N.x + s_weights[14]*N.y + s_weights[15]*N.z + s_weights[16]*dNorm + s_weights[17]*dNorm2
            );

            recon = max(vec3(0.0), recon);
            if (isInvalid(recon)) recon = C;

            // Overlapping block boundary smoothing (FEAT-03)
            // Taper reconstruction weight near block borders to eliminate discrete 8x8 grid seams
            float distToEdge = min(
                min(float(gl_LocalInvocationID.x), float(7u - gl_LocalInvocationID.x)),
                min(float(gl_LocalInvocationID.y), float(7u - gl_LocalInvocationID.y))
            );
            float edgeSmooth = smoothstep(0.0, 2.0, distToEdge);
            float blendWeight = mix(0.50, 0.70, edgeSmooth);

            vec3 finalColor = mix(C, recon, blendWeight);
            imageStore(uOutputRadiance, pixelCoord, vec4(finalColor, 1.0));
        }
    }
}
