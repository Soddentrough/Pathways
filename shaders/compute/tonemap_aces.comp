#version 460
#extension GL_EXT_shader_image_load_formatted : require
#include "rgb9e5.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uAccumImage;
layout(binding = 1) writeonly uniform image2D uOutputImage;
layout(std430, binding = 2) readonly buffer BandStitchBuf {
    uint packed[];
} uBandStitch;

layout(push_constant) uniform PushConstants {
    float exposure;
    uint totalSamples;
    uint applyACES;
    uint visualizeSplit; // 0 = off, 1 = Checkerboard Tile Overlay, 2 = Upways Band-Parallel Split
    uint tileSize;       // Checkerboard tile size (16, 32, 64, or 128; defaults to 64 if 0)
    uint displayMode;    // 0 = SDR (sRGB 2.2), 1 = HDR scRGB Linear, 2 = HDR10 (Rec.2020 ST 2084 PQ)
    float peakNits;      // Display peak luminance in cd/m^2 (e.g. 1000.0)
    float paperWhiteNits;// Reference paper white luminance in cd/m^2 (e.g. 200.0)
    uint stitchYStart;   // First HR row read from uBandStitch (0 when inactive)
    uint stitchRowCount; // Number of HR rows read from uBandStitch (0 = disabled)
} pc;

// ACES Filmic Tone Mapping Curve (Narkowicz / Stephen Hill fit)
vec3 ACESFilm(vec3 x) {
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Rec.709 to Rec.2020 Color Gamut Conversion Matrix
const mat3 REC709_TO_REC2020 = mat3(
    0.6274040, 0.0690970, 0.0163916,
    0.3292820, 0.9195400, 0.0880132,
    0.0433136, 0.0113612, 0.8955952
);

// SMPTE ST 2084 (Perceptual Quantizer / PQ) Fast Rational Polynomial Approximation
// Eliminates double transcendental pow evaluations (pow(L, m1) and pow(num/den, m2))
// Validated error bound: max error across [0, 1] is < 0.0242 10-bit code values (< 0.5 target)
// Strictly monotonic non-decreasing, zero poles (den >= 1.0)
vec3 LinearToST2084(vec3 L) {
    L = max(L, vec3(0.0));
    // u = L^(0.25) = sqrt(sqrt(L)) via fast hardware sqrt ALU instructions
    vec3 u = sqrt(sqrt(L));

    const float c_a1 = 0.00233850f;
    const float c_a2 = 5.71714250f;
    const float c_a3 = 1929.72524420f;
    const float c_a4 = 1920.96468508f;

    const float c_b1 = 46.08360134f;
    const float c_b2 = 675.62486894f;
    const float c_b3 = 2060.99079800f;
    const float c_b4 = 1072.71014201f;

    // Horner's scheme using hardware FMA
    vec3 num = u * (c_a1 + u * (c_a2 + u * (c_a3 + u * c_a4)));
    vec3 den = vec3(1.0) + u * (c_b1 + u * (c_b2 + u * (c_b3 + u * c_b4)));

    return clamp(num / den, vec3(0.0), vec3(1.0));
}

// Filmic HDR S-Curve Tone Mapping
// Maps scene linear radiance [0, inf) into target absolute display luminance [0, peakNits]
// - Anchors true blacks (x -> 0 => L -> 0).
// - Preserves contrast and filmic response in midtones anchored to paper white.
// - Diffuse white (x = 1.0) maps precisely to paperWhite nits.
// - Asymptotically rolls off HDR specular highlights (x > 1.0) up to peak display nits.
float FilmicHdrLuminance(float x, float paperWhite, float peakNits) {
    if (x <= 1e-6) return 0.0;
    const float ACES_AT_1 = 0.803797f;
    if (x <= 1.0) {
        float m = ACESFilm(vec3(x)).r;
        return (m / ACES_AT_1) * paperWhite;
    } else {
        float headroom = max(peakNits - paperWhite, 0.0);
        float extra = x - 1.0;
        float k = max(1.5 * (headroom / max(paperWhite, 100.0)), 1.0);
        float shoulder = headroom > 0.0 ? (headroom * (extra / (extra + k))) : 0.0;
        return paperWhite + shoulder;
    }
}

vec3 TonemapHDR(vec3 color, float paperWhite, float peakNits) {
    float inLum = dot(color, vec3(0.2126, 0.7152, 0.0722));
    if (inLum <= 1e-6) {
        return vec3(0.0);
    }
    // Compute mapped absolute display luminance in cd/m^2 (nits)
    float outLumNits = FilmicHdrLuminance(inLum, paperWhite, peakNits);
    // Convert target luminance in nits to scRGB units (1.0 = 80 nits)
    float outLumScRgb = outLumNits / 80.0;
    // Scale color preserving chromaticity
    return color * (outLumScRgb / inLum);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(uAccumImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }

    vec3 linearColor;
    if (pc.stitchRowCount > 0u &&
        uint(pixelCoord.y) >= pc.stitchYStart &&
        uint(pixelCoord.y) < (pc.stitchYStart + pc.stitchRowCount)) {
        uint stitchRow = uint(pixelCoord.y) - pc.stitchYStart;
        linearColor = unpackRGB9E5(uBandStitch.packed[stitchRow * uint(imageSize.x) + uint(pixelCoord.x)]);
    } else {
        linearColor = imageLoad(uAccumImage, pixelCoord).rgb;
    }

    if (pc.totalSamples > 0) {
        linearColor /= float(pc.totalSamples);
    }

    // Apply exposure compensation
    linearColor *= pc.exposure;

    // Fast vector NaN/Inf/Negative sanitization
    if (any(isnan(linearColor)) || any(isinf(linearColor))) {
        linearColor = vec3(0.0);
    }
    linearColor = max(linearColor, vec3(0.0));

    vec3 finalColor;

    if (pc.displayMode == 1u) {
        // --- HDR scRGB Linear (16-bit Float, 1.0 = 80 nits) ---
        if (pc.applyACES != 0u) {
            finalColor = TonemapHDR(linearColor, pc.paperWhiteNits, pc.peakNits);
        } else {
            // Uncompressed Linear Radiance scaled to scRGB units
            float sWhite = pc.paperWhiteNits / 80.0;
            float sPeak = pc.peakNits / 80.0;
            finalColor = clamp(linearColor * sWhite, vec3(0.0), vec3(sPeak));
        }
        // scRGB is strictly linear — NO gamma power curve!
    } else if (pc.displayMode == 2u) {
        // --- HDR10 (10-bit Rec.2020 SMPTE ST 2084 PQ) ---
        vec3 scRgbColor;
        if (pc.applyACES != 0u) {
            scRgbColor = TonemapHDR(linearColor, pc.paperWhiteNits, pc.peakNits);
        } else {
            float sWhite = pc.paperWhiteNits / 80.0;
            float sPeak = pc.peakNits / 80.0;
            scRgbColor = clamp(linearColor * sWhite, vec3(0.0), vec3(sPeak));
        }
        // Convert Rec.709 linear primaries to Rec.2020 linear primaries
        vec3 rec2020Linear = REC709_TO_REC2020 * scRgbColor;
        // Convert scRGB units (1.0 = 80 nits) to absolute PQ units (1.0 = 10,000 nits)
        vec3 normalizedL = rec2020Linear / 125.0;
        finalColor = LinearToST2084(normalizedL);
    } else {
        // --- SDR Fallback (sRGB ~2.2 Gamma, [0.0, 1.0]) ---
        vec3 mappedColor = (pc.applyACES != 0u) ? ACESFilm(linearColor) : (linearColor / (linearColor + vec3(1.0)));
        finalColor = pow(mappedColor, vec3(1.0 / 2.2));
    }

    // Multi-GPU Load Split Visualization Overlay
    if (pc.visualizeSplit == 1u) {
        float tintScale = (pc.displayMode == 1u) ? (pc.paperWhiteNits / 80.0) : 1.0;
        uint sz = (pc.tileSize != 0u) ? pc.tileSize : 64u;
        uint check = ((pixelCoord.x / sz) + (pixelCoord.y / sz)) & 1u;
        bool isBorder = (pixelCoord.x % sz == 0u) || (pixelCoord.y % sz == 0u);
        if (isBorder) {
            finalColor = mix(finalColor, vec3(0.0), 0.6);
        }
        vec3 tint = (check == 0u) ? (vec3(0.1, 0.55, 1.0) * tintScale) : (vec3(1.0, 0.45, 0.1) * tintScale);
        finalColor = mix(finalColor, tint, 0.25);
    } else if (pc.visualizeSplit == 2u && pc.stitchRowCount > 0u) {
        float tintScale = (pc.displayMode == 1u) ? (pc.paperWhiteNits / 80.0) : 1.0;
        bool isBotBand = (uint(pixelCoord.y) >= pc.stitchYStart) &&
                         (uint(pixelCoord.y) < (pc.stitchYStart + pc.stitchRowCount));
        vec3 tint = isBotBand ? (vec3(1.0, 0.45, 0.1) * tintScale) : (vec3(0.1, 0.55, 1.0) * tintScale);
        finalColor = mix(finalColor, tint, 0.22);
        if (uint(pixelCoord.y) == pc.stitchYStart) {
            finalColor = mix(finalColor, vec3(1.0) * tintScale, 0.85);
        }
    }

    imageStore(uOutputImage, pixelCoord, vec4(finalColor, 1.0));
}
