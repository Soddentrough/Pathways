#version 450
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uAccumImage;
layout(binding = 1) writeonly uniform image2D uOutputImage;

layout(push_constant) uniform PushConstants {
    float exposure;
    uint totalSamples;
    uint applyACES;
    uint visualizeSplit; // 0 = off, 1 = Checkerboard Tile Overlay
    uint tileSize;       // Checkerboard tile size (16, 32, 64, or 128; defaults to 64 if 0)
    uint displayMode;    // 0 = SDR (sRGB 2.2), 1 = HDR scRGB Linear, 2 = HDR10 (Rec.2020 ST 2084 PQ)
    float peakNits;      // Display peak luminance in cd/m^2 (e.g. 1000.0)
    float paperWhiteNits;// Reference paper white luminance in cd/m^2 (e.g. 200.0)
} pc;

// ACES Filmic Tone Mapping Curve (Narkowicz / Stephen Hill fit)
vec3 ACESFilm(vec3 x) {
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Rec.709 to Rec.2020 Color Gamut Conversion Matrix
const mat3 REC709_TO_REC2020 = mat3(
    0.6274040, 0.0690970, 0.0163916,
    0.3292820, 0.9195400, 0.0880132,
    0.0433136, 0.0113612, 0.8955952
);

// SMPTE ST 2084 (Perceptual Quantizer / PQ) Transfer Function
// Input: absolute luminance normalized to 10,000 nits ([0.0, 1.0])
// Output: non-linear PQ encoded value ([0.0, 1.0])
vec3 LinearToST2084(vec3 L) {
    L = max(L, vec3(0.0));
    const float m1 = 0.1593017578125;      // 2610 / 16384
    const float m2 = 78.84375;             // (2523 / 4096) * 128
    const float c1 = 0.8359375;            // 3424 / 4096
    const float c2 = 18.8515625;           // (2413 / 4096) * 32
    const float c3 = 18.6875;              // (2392 / 4096) * 32

    vec3 Lm1 = pow(L, vec3(m1));
    vec3 num = c1 + c2 * Lm1;
    vec3 den = vec3(1.0) + c3 * Lm1;
    return pow(num / den, vec3(m2));
}

// Filmic HDR S-Curve Tone Mapping
// Maps scene linear radiance [0, inf) into target absolute display luminance [0, peakNits]
// - Anchors true blacks (x -> 0 => L -> 0) with a natural filmic contrast toe (p = 1.25).
// - Preserves contrast in dark regions rather than linearly boosting them.
// - Anchors reference diffuse paper white (x = 1.0) cleanly to paperWhite nits.
// - Asymptotically rolls off high-dynamic-range highlights to peakNits.
// - Scales color vector by mapped luminance ratio to preserve chromaticity without color shifts.
float FilmicHdrLuminance(float x, float paperWhite, float peakNits) {
    if (x <= 1e-6) return 0.0;
    const float p = 1.25;
    float k = max((peakNits / max(paperWhite, 50.0)) - 1.0, 0.1);
    float xp = pow(x, p);
    return peakNits * (xp / (xp + k));
}

vec3 TonemapHDR(vec3 color, float paperWhite, float peakNits) {
    float inLum = dot(color, vec3(0.2126, 0.7152, 0.0722));
    if (inLum <= 1e-6) {
        return vec3(0.0);
    }
    // Compute mapped absolute display luminance in cd/m^2 (nits)
    float outLumNits = FilmicHdrLuminance(inLum, paperWhite, peakNits);
    // Convert target luminance in nits to scRGB units (1.0 = 80 nits)
    float outLumScRgb = outLumNits / 80.0;
    // Scale color preserving chromaticity
    return color * (outLumScRgb / inLum);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(uAccumImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }

    vec4 accumColor = imageLoad(uAccumImage, pixelCoord);
    vec3 linearColor = accumColor.rgb;

    if (pc.totalSamples > 0) {
        linearColor /= float(pc.totalSamples);
    }

    // Apply exposure compensation
    linearColor *= pc.exposure;

    // Sanitize against NaN, Inf, and negative radiance
    if (isnan(linearColor.r) || isnan(linearColor.g) || isnan(linearColor.b) ||
        isinf(linearColor.r) || isinf(linearColor.g) || isinf(linearColor.b)) {
        linearColor = vec3(0.0);
    }
    linearColor = max(linearColor, vec3(0.0));

    vec3 finalColor;

    if (pc.displayMode == 1u) {
        // --- HDR scRGB Linear (16-bit Float, 1.0 = 80 nits) ---
        if (pc.applyACES != 0u) {
            finalColor = TonemapHDR(linearColor, pc.paperWhiteNits, pc.peakNits);
        } else {
            // Uncompressed Linear Radiance scaled to scRGB units
            float sWhite = pc.paperWhiteNits / 80.0;
            float sPeak = pc.peakNits / 80.0;
            finalColor = clamp(linearColor * sWhite, vec3(0.0), vec3(sPeak));
        }
        // scRGB is strictly linear — NO gamma power curve!
    } else if (pc.displayMode == 2u) {
        // --- HDR10 (10-bit Rec.2020 SMPTE ST 2084 PQ) ---
        vec3 scRgbColor;
        if (pc.applyACES != 0u) {
            scRgbColor = TonemapHDR(linearColor, pc.paperWhiteNits, pc.peakNits);
        } else {
            float sWhite = pc.paperWhiteNits / 80.0;
            float sPeak = pc.peakNits / 80.0;
            scRgbColor = clamp(linearColor * sWhite, vec3(0.0), vec3(sPeak));
        }
        // Convert Rec.709 linear primaries to Rec.2020 linear primaries
        vec3 rec2020Linear = REC709_TO_REC2020 * scRgbColor;
        // Convert scRGB units (1.0 = 80 nits) to absolute PQ units (1.0 = 10,000 nits)
        // normalizedL = (scRGB * 80.0) / 10000.0 = scRGB / 125.0
        vec3 normalizedL = rec2020Linear / 125.0;
        finalColor = LinearToST2084(normalizedL);

        // High-frequency triangular dither (scaled for 10-bit quantization: 1024 discrete code levels)
        float dither = (fract(sin(dot(vec2(pixelCoord), vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 1023.0;
        finalColor = clamp(finalColor + vec3(dither), 0.0, 1.0);
    } else {
        // --- SDR Fallback (sRGB ~2.2 Gamma, [0.0, 1.0]) ---
        vec3 mappedColor = linearColor;
        if (pc.applyACES != 0u) {
            mappedColor = ACESFilm(linearColor);
        } else {
            // Reinhard fallback
            mappedColor = linearColor / (linearColor + vec3(1.0));
        }
        // Gamma correction (sRGB ~2.2)
        finalColor = pow(clamp(mappedColor, vec3(0.0), vec3(1.0)), vec3(1.0 / 2.2));

        // High-frequency triangular dither (scaled for 10-bit / 8-bit backbuffer quantization)
        float dither = (fract(sin(dot(vec2(pixelCoord), vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 1023.0;
        finalColor = clamp(finalColor + vec3(dither), 0.0, 1.0);
    }

    // Multi-GPU Load Split Visualization Overlay
    if (pc.visualizeSplit == 1u) {
        float tintScale = (pc.displayMode == 1u) ? (pc.paperWhiteNits / 80.0) : 1.0;
        uint check;
        if (pc.tileSize == 0u) {
            check = uint(pixelCoord.y) & 1u;
            finalColor *= (check == 0u) ? 1.15 : 0.85;
            if (pixelCoord.y % 16u == 0u) {
                finalColor *= 0.65;
            }
            if (check == 0u) {
                finalColor = mix(finalColor, vec3(0.0, 0.85, 1.0) * tintScale, 0.35);
            } else {
                finalColor = mix(finalColor, vec3(1.0, 0.50, 0.0) * tintScale, 0.35);
            }
            if (pixelCoord.x < 14u) {
                finalColor = (check == 0u) ? (vec3(0.0, 0.9, 1.0) * tintScale) : (vec3(1.0, 0.5, 0.0) * tintScale);
            }
        } else {
            uint sz = pc.tileSize;
            check = ((pixelCoord.x / sz) + (pixelCoord.y / sz)) & 1u;
            bool isBorder = (pixelCoord.x % sz == 0u) || (pixelCoord.y % sz == 0u);
            if (isBorder) {
                finalColor = mix(finalColor, vec3(0.0), 0.6);
            }
            if (check == 0u) {
                finalColor = mix(finalColor, vec3(0.1, 0.55, 1.0) * tintScale, 0.25);
            } else {
                finalColor = mix(finalColor, vec3(1.0, 0.45, 0.1) * tintScale, 0.25);
            }
        }
    }

    if (isnan(finalColor.r) || isnan(finalColor.g) || isnan(finalColor.b) ||
        isinf(finalColor.r) || isinf(finalColor.g) || isinf(finalColor.b)) {
        finalColor = vec3(0.0);
    }

    imageStore(uOutputImage, pixelCoord, vec4(finalColor, 1.0));
}
