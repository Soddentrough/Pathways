#version 450
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uAccumImage;
layout(binding = 1, rgba8) writeonly uniform image2D uOutputImage;

layout(push_constant) uniform PushConstants {
    float exposure;
    uint totalSamples;
    uint applyACES;
    uint visualizeSplit; // 0 = off, 1 = Checkerboard Tile Overlay
    uint tileSize;       // Checkerboard tile size (16, 32, 64, or 128; defaults to 64 if 0)
    uint padding[3];
} pc;

// ACES Filmic Tone Mapping Curve (Narkowicz / Stephen Hill fit)
vec3 ACESFilm(vec3 x) {
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(uAccumImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }

    vec4 accumColor = imageLoad(uAccumImage, pixelCoord);
    vec3 linearColor = accumColor.rgb;

    if (pc.totalSamples > 0) {
        linearColor /= float(pc.totalSamples);
    }

    // Apply exposure compensation
    linearColor *= pc.exposure;

    // Apply ACES Tonemapping
    vec3 mappedColor = linearColor;
    if (pc.applyACES != 0) {
        mappedColor = ACESFilm(linearColor);
    } else {
        // Fallback Reinhard
        mappedColor = linearColor / (linearColor + vec3(1.0));
    }

    // Gamma correction (sRGB ~2.2)
    vec3 finalColor = pow(mappedColor, vec3(1.0 / 2.2));

    // Multi-GPU Load Split Visualization Overlay
    if (pc.visualizeSplit == 1u) {
        uint check;
        if (pc.tileSize == 0u) {
            // Interleaved Scanline mode: alternating scanline tint with CRT-style luminance modulation
            check = uint(pixelCoord.y) & 1u;
            // Apply scanline contrast to prevent optical blending at 4K
            finalColor *= (check == 0u) ? 1.15 : 0.85;
            if (pixelCoord.y % 16u == 0u) {
                finalColor *= 0.65; // Horizontal grid demarcation line every 16 scanlines
            }
            if (check == 0u) {
                // GPU 0 (Primary) - Electric Cyan
                finalColor = mix(finalColor, vec3(0.0, 0.85, 1.0), 0.35);
            } else {
                // GPU 1 (Secondary) - Warm Radiant Amber
                finalColor = mix(finalColor, vec3(1.0, 0.50, 0.0), 0.35);
            }
            // Left edge indicator bar
            if (pixelCoord.x < 14u) {
                finalColor = (check == 0u) ? vec3(0.0, 0.9, 1.0) : vec3(1.0, 0.5, 0.0);
            }
        } else {
            uint sz = pc.tileSize;
            check = ((pixelCoord.x / sz) + (pixelCoord.y / sz)) & 1u;
            bool isBorder = (pixelCoord.x % sz == 0u) || (pixelCoord.y % sz == 0u);
            if (isBorder) {
                finalColor = mix(finalColor, vec3(0.0, 0.0, 0.0), 0.6);
            }
            if (check == 0u) {
                // GPU 0 (Primary) - cool cyan tint
                finalColor = mix(finalColor, vec3(0.1, 0.55, 1.0), 0.25);
            } else {
                // GPU 1 (Secondary) - warm amber tint
                finalColor = mix(finalColor, vec3(1.0, 0.45, 0.1), 0.25);
            }
        }
    }

    imageStore(uOutputImage, pixelCoord, vec4(finalColor, 1.0));
}
