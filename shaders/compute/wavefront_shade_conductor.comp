#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 24, rgba16f) uniform readonly image2D uNormalDepthImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[512];

layout(std430, binding = 9) readonly buffer InRayStateQueue {
    RayState inStates[];
};

layout(std430, binding = 10) writeonly buffer OutRayStateQueue {
    RayState outStates[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint diffuseCount;
    uint dielectricCount;
    uint conductorCount;
    uint complexCount;
    uint emissiveCount;
    uint alphamaskCount;
    uint nextDiffuseCount;
    uint nextDielectricCount;
    uint nextConductorCount;
    uint nextComplexCount;
    uint nextEmissiveCount;
    uint nextAlphamaskCount;
    uint currentMaterialCounts[6];
    uint totalShadeWorkgroups;
    uint octantCounts[8];
    uint currentOctantCounts[8];
    uint totalIntersectWorkgroups;
    uint secondaryRayCount;
    uint activeMaterialSequenceCount;
    uint pad[20];
} queueCounters;

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 15) readonly buffer InRayGeomQueue {
    RayGeometry inGeoms[];
};

layout(std430, binding = 16) writeonly buffer OutRayGeomQueue {
    RayGeometry outGeoms[];
};

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 18) readonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(std430, binding = 19) writeonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

#include "restir_common.glsl"

layout(std430, binding = 32) buffer ReSTIRReservoirsBuffer {
    ReservoirDI restirReservoirs[];
};

#include "wavefront_shadow_inline.glsl"

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
    uint useHardwareRT;
    uint secondarySortMode;
    uint enableNrc;
    uint nrcBounce;
    float nrcTrainRatio;
    uint frameIndex;
    uint numOpaqueTriangles;
    uint captureMlData;
    float indirectClamp;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint activeCount = queueCounters.currentMaterialCounts[2]; // Conductor queue
    bool inRange = (idx < activeCount);
    bool survivesToNext = false;
    bool hasShadowRay = false;
    vec3 nextDirection = vec3(0.0);
    RayGeometry nextGeom;
    RayState nextState;
    PackedShadowRay shadowCandidate;

    if (inRange) {
        uint rayIdx = materialIndices[2u * pc.maxQueueCapacity + idx];
        RayGeometry geom = inGeoms[rayIdx];
        RayHit hit = inHits[rayIdx];
        RayState state = inStates[rayIdx];

        vec3 origin = geom.originPackedDir.xyz;
        vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        float hitT;
        uint matId, hitType;
        vec3 hitNormal, geomTan;
        vec2 hitUv;
        float tanSign;
        unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

        f16vec3 throughput;
        uint seed, pixelIndex;
        bool isSpecularPath, causticApplied;
        unpackRayState(state, throughput, seed, pixelIndex, isSpecularPath, causticApplied);
        uint bounce = pc.currentBounce;

        if (hitType == 2u) {
            // Environment sky miss
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            vec3 skyContrib = vec3(throughput) * skyColor;
            if (bounce > 0u) {
                skyContrib = clampIndirectRadiance(skyContrib, pc.indirectClamp);
            }
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), 0.0));

            bool enableRestir = ((ubo.flags & (1 << 9)) != 0);
            if (enableRestir && bounce == 1u && length(skyColor) > 1e-3) {
                vec3 n0 = imageLoad(uNormalDepthImage, pixelCoord).xyz;
                vec3 fakeSkyPoint = origin + rayDir * 10000.0;
                float p_hat = evalUnshadowedTargetGI(origin, n0, f16vec3(1.0), fakeSkyPoint, -rayDir, skyColor);
                if (p_hat > 0.0) {
                    updateReservoirGI(restirReservoirs[pixelIndex], seed, p_hat, p_hat, rayDir, 10000.0, -rayDir, skyColor, seed);
                }
            }
            if (pc.captureMlData != 0u) {
                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), 0.0));
            }
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            hitNormal = frontFace ? hitNormal : -hitNormal;

            Material mat = materials[matId];
            if (hitType == 0u && mat.normalTex > 0u && mat.normalTex <= 512u) {
                vec3 normalMap = SAMPLE_SCENE_TEXTURE(mat.normalTex, hitUv).rgb * 2.0 - 1.0;
                normalMap.xy *= mat.normalScale;
                normalMap = normalize(normalMap);

                geomTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
                vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                hitNormal = normalize(tbn * normalMap);
            }

            f16vec3 baseColor = f16vec3(mat.albedo.rgb);
            if (mat.albedoTex > 0u && mat.albedoTex <= 512u) {
                baseColor *= f16vec3(SAMPLE_SCENE_TEXTURE(mat.albedoTex, hitUv).rgb);
            }

            vec3 emissive = mat.emissive.rgb;
            if (mat.emissiveTex > 0u && mat.emissiveTex <= 512u) {
                emissive *= SAMPLE_SCENE_TEXTURE(mat.emissiveTex, hitUv).rgb;
            }
            if (length(emissive) > 1e-3) {
                vec3 emissiveContrib = vec3(throughput) * emissive;
                if (bounce > 0u) {
                    emissiveContrib = clampIndirectRadiance(emissiveContrib, pc.indirectClamp);
                }
                ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                vec4 prev = imageLoad(uAccumImage, pCoord);
                imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, emissiveContrib, seed), prev.a));
                if (pc.captureMlData != 0u) {
                    vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                    imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, emissiveContrib, seed), 0.0));
                }
                bool enableRestir = ((ubo.flags & (1 << 9)) != 0);
                if (enableRestir && bounce == 1u && hitT > 1e-3) {
                    vec3 n0 = imageLoad(uNormalDepthImage, pCoord).xyz;
                    float p_hat = evalUnshadowedTargetGI(origin, n0, f16vec3(1.0), hitPoint, hitNormal, emissive);
                    if (p_hat > 0.0) {
                        updateReservoirGI(restirReservoirs[pixelIndex], seed, p_hat, p_hat, rayDir, hitT, hitNormal, emissive, seed);
                    }
                }
            }

            bool pathTerminated = false;
            if (mat.type == 3u /* MATERIAL_EMISSIVE */) {
                pathTerminated = true;
            }

            float roughness = mat.roughness;
            float metallic = mat.metallic;
            if (mat.mrTex > 0u && mat.mrTex <= 512u) {
                vec4 mrSample = SAMPLE_SCENE_TEXTURE(mat.mrTex, hitUv);
                roughness *= mrSample.g;
                metallic *= mrSample.b;
            }
            roughness = clamp(roughness, 0.04, 1.0);
            metallic = clamp(metallic, 0.0, 1.0);
            float alphaRoughness = roughness * roughness;

            // KHR_materials_anisotropy & KHR_materials_iridescence
            float ax = alphaRoughness;
            float ay = alphaRoughness;
            vec3 T = abs(hitNormal.z) < 0.999 ? normalize(cross(vec3(0.0, 0.0, 1.0), hitNormal)) : normalize(cross(vec3(1.0, 0.0, 0.0), hitNormal));
            vec3 B = cross(hitNormal, T);
            bool isAniso = (mat.anisotropyStrength > 0.001);
            if (isAniso) {
                float anisoFactor = clamp(mat.anisotropyStrength, 0.0, 0.99);
                float rX = max(roughness * (1.0 + anisoFactor), 0.001);
                float rY = max(roughness * (1.0 - anisoFactor), 0.001);
                ax = rX * rX;
                ay = rY * rY;
                if (abs(mat.anisotropyRotation) > 0.001) {
                    float sRot = sin(mat.anisotropyRotation);
                    float cRot = cos(mat.anisotropyRotation);
                    vec3 rotT = cRot * T + sRot * B;
                    B = -sRot * T + cRot * B;
                    T = rotT;
                }
            }

            f16vec3 F0 = mix(f16vec3(0.04), baseColor, float16_t(metallic));
            vec3 V = -rayDir;
            float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);

            if (mat.iridescence > 0.001) {
                vec3 iridColor = evalThinFilmIridescence(NdotV, mat.iridescenceIor, mat.iridescenceThickness > 0.0 ? mat.iridescenceThickness : 350.0);
                F0 = mix(F0, f16vec3(iridColor), float16_t(mat.iridescence));
            }

            bool enableDirect = (ubo.flags & (1 << 0)) != 0;
            bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
            bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
            bool enableShadows = (ubo.flags & (1 << 4)) != 0;
            f16vec3 secDirectL = f16vec3(0.0);

            // Direct Lighting (Stochastic NEE with ReSTIR DI and Alias Table)
            if (!pathTerminated && enableDirect && enableSpecular && pc.numLights > 0u) {
                bool enableInlineShadows = (ubo.flags & (1 << 6)) != 0;
                uint M = (pc.numLights > 1u) ? min(pc.numLights, 4u) : 1u;

                uint selectedLightIdx = 0u;
                vec3 selectedLightDir = vec3(0.0);
                float selectedLightDist = 0.0;
                vec3 selectedLightEmission = vec3(0.0);
                float selectedLightPdf = 1.0;
                f16vec3 selectedBrdf = f16vec3(0.0);
                float selectedNdotL = 0.0;
                float selectedMisWeight = 1.0;
                float selectedTarget = 0.0;
                float totalWeightSum = 0.0;
                bool hasCandidate = false;
                bool usedRestir = false;

                bool enableRestirDI = ((ubo.flags & (1 << 9)) != 0 && pc.currentBounce == 0u);
                if (enableRestirDI) {
                    ReservoirDI res = restirReservoirs[pixelIndex];
                    if (isValidReservoir(res.age_flags) && res.wSum > 0.0) {
                        uint pLen = getPathLength(res.flags_uv_age);
                        if (pLen <= 1u) {
                            uint lightIdx = getLightIndex(res.lightIndex_M);
                            if (lightIdx < pc.numLights) {
                                Light light = lights[lightIdx];
                                vec3 lightPoint;
                                vec3 lightDir;
                                float lightDist = 0.0;
                                float lightPdf = 1.0;
                                vec3 lightEmission = light.emission.rgb;
                                bool validLightSample = false;

                                if (uint(light.position.w) == 0u /* AREA QUAD */) {
                                    vec2 luv = unpackUV(res.age_flags);
                                    lightPoint = light.position.xyz + luv.x * light.u.xyz + luv.y * light.v.xyz;
                                    vec3 toLight = lightPoint - hitPoint;
                                    lightDist = length(toLight);
                                    lightDir = toLight / max(lightDist, 1e-4);

                                    float cosLight = dot(-lightDir, light.normal.xyz);
                                    if (cosLight > 0.0) {
                                        float area = max(light.emission.w, 1e-4);
                                        lightPdf = (lightDist * lightDist) / (area * cosLight);
                                        validLightSample = true;
                                    }
                                } else if (uint(light.position.w) == 1u /* SPOT */) {
                                    vec3 toLight = light.position.xyz - hitPoint;
                                    lightDist = length(toLight);
                                    lightDir = toLight / max(lightDist, 1e-4);

                                    float cosSpot = dot(-lightDir, light.normal.xyz);
                                    float innerCos = light.u.w;
                                    float outerCos = light.v.w;
                                    if (cosSpot >= outerCos) {
                                        float spotFactor = clamp((cosSpot - outerCos) / max(innerCos - outerCos, 1e-4), 0.0, 1.0);
                                        lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                                        lightPdf = 1.0;
                                        validLightSample = true;
                                    }
                                } else if (uint(light.position.w) == 2u /* DIRECTIONAL */) {
                                    lightDir = normalize(light.normal.xyz);
                                    lightDist = 10000.0;
                                    lightPdf = 1.0;
                                    validLightSample = true;
                                }

                                float NdotL = dot(hitNormal, lightDir);
                                if (validLightSample && NdotL > 0.0) {
                                    vec3 H = normalize(V + lightDir);
                                    float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                                    float VdotH = clamp(dot(V, H), 0.0, 1.0);

                                    float D = isAniso ? distributionAnisotropicGGX(dot(T, H), dot(B, H), NdotH, ax, ay)
                                                      : distributionGGX(NdotH, alphaRoughness);
                                    float G = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                                    f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);
                                    f16vec3 specBrdf = float16_t(clamp(D * G, 0.0, 65500.0)) * F;

                                    selectedLightIdx = lightIdx;
                                    selectedLightDir = lightDir;
                                    selectedLightDist = lightDist;
                                    selectedLightEmission = lightEmission;
                                    selectedLightPdf = lightPdf;
                                    selectedBrdf = specBrdf;
                                    selectedNdotL = NdotL;
                                    selectedMisWeight = 1.0;
                                    selectedTarget = max(res.targetPdf, 1e-6);
                                    totalWeightSum = res.wSum;
                                    hasCandidate = true;
                                    usedRestir = true;
                                }
                            }
                        } else if (pLen >= 2u) {
                            vec3 secDir = unpackOct16((res.flags_uv_age >> 16u) & 0xFFFFu);
                            float NdotL = dot(hitNormal, secDir);
                            if (NdotL > 0.0 && res.secondaryHitDist > 1e-4) {
                                vec3 H = normalize(V + secDir);
                                float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                                float VdotH = clamp(dot(V, H), 0.0, 1.0);

                                float D = isAniso ? distributionAnisotropicGGX(dot(T, H), dot(B, H), NdotH, ax, ay)
                                                  : distributionGGX(NdotH, alphaRoughness);
                                float G = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                                f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);
                                f16vec3 specBrdf = float16_t(clamp(D * G, 0.0, 65500.0)) * F;
                                vec3 secRadiance = vec3(unpackRadianceRG(res.secondaryRadianceRG), float(unpackRadianceB(res.secondaryRadianceB_flags)));

                                selectedLightIdx = 0u;
                                selectedLightDir = secDir;
                                selectedLightDist = res.secondaryHitDist;
                                selectedLightEmission = secRadiance;
                                selectedLightPdf = 1.0;
                                selectedBrdf = specBrdf;
                                selectedNdotL = NdotL;
                                selectedMisWeight = 1.0;
                                selectedTarget = max(res.targetPdf, 1e-6);
                                totalWeightSum = res.wSum;
                                hasCandidate = true;
                                usedRestir = true;
                            }
                        }
                    }
                }

                if (!hasCandidate) {
                    for (uint c = 0u; c < M; ++c) {
                        uint lightIdx = 0u;
                        float lightSelectPdf = 1.0;
                        if ((ubo.flags & (1 << 7)) != 0 && pc.numLights > 1u) {
                            SAMPLE_LIGHT_TREE(pc.numLights, hitPoint, hitNormal, seed, lightIdx, lightSelectPdf);
                        } else {
                            SAMPLE_LIGHT_ALIAS(pc.numLights, seed, lightIdx, lightSelectPdf);
                        }

                        Light light = lights[lightIdx];
                        vec3 lightPoint;
                        vec3 lightDir;
                        float lightDist = 0.0;
                        float lightPdf = 1.0;
                        vec3 lightEmission = light.emission.rgb;
                        bool validLightSample = false;

                        if (uint(light.position.w) == 0u /* AREA QUAD */) {
                            vec2 luv = randVec2(seed);
                            lightPoint = light.position.xyz + luv.x * light.u.xyz + luv.y * light.v.xyz;
                            vec3 toLight = lightPoint - hitPoint;
                            lightDist = length(toLight);
                            lightDir = toLight / max(lightDist, 1e-4);

                            float cosLight = dot(-lightDir, light.normal.xyz);
                            if (cosLight > 0.0) {
                                float area = light.emission.w;
                                lightPdf = (lightDist * lightDist) / (area * cosLight);
                                validLightSample = true;
                            }
                        } else if (uint(light.position.w) == 1u /* SPOT */) {
                            vec3 toLight = light.position.xyz - hitPoint;
                            lightDist = length(toLight);
                            lightDir = toLight / max(lightDist, 1e-4);

                            float cosSpot = dot(-lightDir, light.normal.xyz);
                            float innerCos = light.u.w;
                            float outerCos = light.v.w;
                            if (cosSpot >= outerCos) {
                                float spotFactor = clamp((cosSpot - outerCos) / max(innerCos - outerCos, 1e-4), 0.0, 1.0);
                                lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                                lightPdf = 1.0;
                                validLightSample = true;
                            }
                        } else if (uint(light.position.w) == 2u /* DIRECTIONAL */) {
                            lightDir = normalize(light.normal.xyz);
                            lightDist = 10000.0;
                            lightPdf = 1.0;
                            validLightSample = true;
                        }

                        float NdotL = dot(hitNormal, lightDir);
                        if (validLightSample && NdotL > 0.0) {
                            vec3 H = normalize(V + lightDir);
                            float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                            float VdotH = clamp(dot(V, H), 0.0, 1.0);

                            float D = isAniso ? distributionAnisotropicGGX(dot(T, H), dot(B, H), NdotH, ax, ay)
                                              : distributionGGX(NdotH, alphaRoughness);
                            float G = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                            f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);

                            f16vec3 specBrdf = float16_t(clamp(D * G, 0.0, 65500.0)) * F;
                            float specPdf = (D * NdotH) / max(4.0 * VdotH, 1e-4);

                            float misWeight = 1.0;
                            if (uint(light.position.w) == 0u) {
                                float lightPdfEff = lightPdf * lightSelectPdf;
                                misWeight = lightPdfEff / (lightPdfEff + specPdf);
                            }

                            vec3 directLightRadiance = clamp(lightEmission * (NdotL * misWeight), vec3(0.0), vec3(65500.0));
                            f16vec3 candidateContrib = specBrdf * f16vec3(directLightRadiance);
                            float target = max(float(dot(candidateContrib, f16vec3(0.2126, 0.7152, 0.0722))), 1e-6);
                            float sourcePdf = max(lightPdf * lightSelectPdf, 1e-6);
                            float weight = target / sourcePdf;

                            totalWeightSum += weight;
                            if (randFloat(seed) * totalWeightSum < weight) {
                                selectedLightIdx = lightIdx;
                                selectedLightDir = lightDir;
                                selectedLightDist = lightDist;
                                selectedLightEmission = lightEmission;
                                selectedLightPdf = lightPdf;
                                selectedBrdf = specBrdf;
                                selectedNdotL = NdotL;
                                selectedMisWeight = misWeight;
                                selectedTarget = target;
                                hasCandidate = true;
                            }
                        }
                    }
                }

                if (hasCandidate && selectedTarget > 1e-6) {
                    uint restirM = usedRestir ? max(getM(restirReservoirs[pixelIndex].lightIndex_M), 1u) : M;
                    float risWeight = totalWeightSum / (float(restirM) * max(selectedTarget, 1e-6));
                    risWeight = clamp(risWeight, 0.0, 10000.0);
                    uint pLen = usedRestir ? getPathLength(restirReservoirs[pixelIndex].flags_uv_age) : 1u;
                    float geomFactor = (usedRestir && pLen <= 1u && uint(lights[selectedLightIdx].position.w) == 0u) ? (1.0 / max(selectedLightPdf, 1e-6)) : 1.0;
                    vec3 directLightRadiance = clamp(selectedLightEmission * (selectedNdotL * geomFactor * selectedMisWeight * risWeight), vec3(0.0), vec3(65500.0));
                    secDirectL = selectedBrdf * f16vec3(directLightRadiance);
                    f16vec3 unshadowed = throughput * secDirectL;
                    if (bounce > 0u) {
                        unshadowed = clampIndirectRadiance(unshadowed, pc.indirectClamp);
                    }

                    if (length(unshadowed) > float16_t(1e-5)) {
                        if (enableShadows) {
                            bool occluded = false;
                            if (enableInlineShadows && pc.useHardwareRT == 1u) {
                                occluded = traceShadowRayInline(hitPoint + hitNormal * EPSILON, selectedLightDir, selectedLightDist,
                                                                (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                if (!occluded) {
                                    ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                    imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), 0.0));
                                    if (pc.captureMlData != 0u) {
                                        vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                        imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(unshadowed), seed), 0.0));
                                    }
                                } else {
                                    if (enableRestirDI) {
                                        restirReservoirs[pixelIndex].wSum = 0.0;
                                        restirReservoirs[pixelIndex].flags_uv_age = 0u;
                                        restirReservoirs[pixelIndex].targetPdf = 0.0;
                                        restirReservoirs[pixelIndex].lightIndex_M = 0u;
                                    }
                                }
                            } else {
                                hasShadowRay = true;
                                shadowCandidate.originDist = vec4(hitPoint + hitNormal * EPSILON, selectedLightDist);
                                shadowCandidate.dirPixelRad = uvec4(packOct32(selectedLightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, 1.0)));
                            }
                        } else {
                            ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                            vec4 prev = imageLoad(uAccumImage, pCoord);
                            imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                        }
                    }
                }
            }

            // Indirect Bounce: GGX importance sampling
            if (!pathTerminated) {
                if (bounce + 1u >= pc.maxBounces || !enableIndirect || !enableSpecular) {
                    pathTerminated = true;
                } else {
                vec3 H = isAniso ? sampleAnisotropicGGX(hitNormal, T, B, ax, ay, seed)
                                 : sampleGGX(hitNormal, alphaRoughness, seed);
                nextDirection = reflect(-V, H);
                vec3 nextOrigin = hitPoint + hitNormal * EPSILON;

                float NdotL_next = dot(hitNormal, nextDirection);
                if (NdotL_next <= 0.0) {
                    // Grazing rejection fallback: reflect into upper hemisphere along macro normal
                    nextDirection = reflect(-V, hitNormal);
                    NdotL_next = clamp(dot(hitNormal, nextDirection), 0.001, 1.0);
                    H = normalize(V + nextDirection);
                }
                float VdotH = clamp(dot(V, H), 0.0, 1.0);
                float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                f16vec3 F_sample = fresnelSchlickVec(float16_t(VdotH), F0);
                float G_sample = visibilitySmithGGXCorrelated(NdotL_next, NdotV, alphaRoughness);

                // Microfacet reflection weight: (F * G * D * NdotL) / specPdf = 4 * F * G * VdotH * NdotL / NdotH
                throughput *= F_sample * float16_t(clamp(4.0 * G_sample * NdotL_next * VdotH / max(NdotH, 1e-4), 0.0, 10.0));

                    float pathLum = float(dot(throughput * float16_t(max(ubo.spp, 1u)), f16vec3(0.2126, 0.7152, 0.0722)));
                    if (pathLum < 0.001) {
                        pathTerminated = true;
                    } else if (bounce >= 1u) {
                        float minP = (bounce >= 2u) ? 0.02 : 0.05;
                        float maxP = 0.95;
                        float p = clamp(pathLum, minP, maxP);
                        if (bounce >= 2u && pathLum >= 0.35) {
                            p = clamp(pathLum * 0.85, minP, 0.90);
                        }
                        if (randFloat(seed) > p) {
                            pathTerminated = true;
                        } else {
                            throughput /= float16_t(p);
                        }
                    }

                    if (!pathTerminated) {
                        survivesToNext = true;
                        nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                        nextState = packRayState(throughput, seed, pixelIndex, true, causticApplied);
                    }
                }
            }
        }
    }

    // Standard single-queue linear compaction for ray geometry and state
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (subgroupElect()) {
        waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
    }
    waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);

    uint targetIdx = waveGlobalOffset + laneSlot;
    if (survivesToNext) {
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    if (pc.secondarySortMode == 1u) {
        // Producer-Side Binning: Record compacted ray indices into 8 directional octant queues
        uint oct = survivesToNext ? getDirectionalOctant(nextDirection) : 0u;
        uvec4 activeBallot = subgroupBallot(survivesToNext);
        for (uint w = 0u; w < 2u; ++w) {
            uint activeMask = (w == 0u) ? activeBallot.x : activeBallot.y;
            while (activeMask != 0u) {
                uint leaderLane = w * 32u + findLSB(activeMask);
                uint k = subgroupBroadcast(oct, leaderLane);
                bool isOct = survivesToNext && (oct == k);
                uvec4 octBallot = subgroupBallot(isOct);
                uint octCount = subgroupBallotBitCount(octBallot);
                uint octSlot = subgroupBallotExclusiveBitCount(octBallot);
                uint octBase = 0u;
                if (gl_SubgroupInvocationID == leaderLane) {
                    octBase = atomicAdd(queueCounters.octantCounts[k], octCount);
                }
                octBase = subgroupBroadcast(octBase, leaderLane);
                if (isOct) {
                    uint dest = k * pc.maxQueueCapacity + (octBase + octSlot);
                    if (octBase + octSlot < pc.maxQueueCapacity) {
                        secondaryIndices[dest] = targetIdx;
                    }
                }
                activeMask &= ~((w == 0u) ? octBallot.x : octBallot.y);
            }
        }
    }

    // Subgroup Wave Ballot Compaction for Shadow Rays
    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (subgroupElect()) {
        shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
    }
    shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);

    if (hasShadowRay) {
        uint targetIdxShadow = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdxShadow < pc.maxQueueCapacity) {
            shadowRays[targetIdxShadow] = shadowCandidate;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == queueCounters.totalShadeWorkgroups - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.commands[b * 16u + 6u].x = shadowGroups;
            indirect.commands[b * 16u + 6u].y = 1u;
            indirect.commands[b * 16u + 6u].z = 1u;
            indirect.commands[b * 16u + 6u].pad = shadowCount;

            dgcStream.commands[b * 16u + 6u].pipelineIndex = 3u; // Shadow pipeline
            dgcStream.commands[b * 16u + 6u].x = shadowGroups;
            dgcStream.commands[b * 16u + 6u].y = 1u;
            dgcStream.commands[b * 16u + 6u].z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            uint intersectGroups = (nextCount + 31u) / 32u;

            // Slot 7: Standard monolithic / Option 2 intersect dispatch
            indirect.commands[b * 16u + 7u].x = intersectGroups;
            indirect.commands[b * 16u + 7u].y = 1u;
            indirect.commands[b * 16u + 7u].z = 1u;
            indirect.commands[b * 16u + 7u].pad = nextCount;

            dgcStream.commands[b * 16u + 7u].pipelineIndex = 1u; // Intersect pipeline
            dgcStream.commands[b * 16u + 7u].x = intersectGroups;
            dgcStream.commands[b * 16u + 7u].y = 1u;
            dgcStream.commands[b * 16u + 7u].z = 1u;

            // Slots 8..15: Producer-Side Binning Directional DGC intersect dispatches
            uint totalIntersectWgs = 0u;
            uint totalOctantRays = 0u;
            if (pc.secondarySortMode == 1u) {
                for (uint k = 0u; k < 8u; ++k) {
                    uint octCnt = queueCounters.octantCounts[k];
                    queueCounters.currentOctantCounts[k] = octCnt;
                    uint octGroups = (octCnt + 31u) / 32u;
                    totalIntersectWgs += octGroups;
                    totalOctantRays += octCnt;

                    indirect.commands[b * 16u + 8u + k].x = octGroups;
                    indirect.commands[b * 16u + 8u + k].y = 1u;
                    indirect.commands[b * 16u + 8u + k].z = 1u;
                    indirect.commands[b * 16u + 8u + k].pad = octCnt;

                    dgcStream.commands[b * 16u + 8u + k].pipelineIndex = 1u;
                    dgcStream.commands[b * 16u + 8u + k].x = octGroups;
                    dgcStream.commands[b * 16u + 8u + k].y = 1u;
                    dgcStream.commands[b * 16u + 8u + k].z = 1u;

                    queueCounters.octantCounts[k] = 0u;
                }
            } else {
                totalIntersectWgs = intersectGroups;
                totalOctantRays = nextCount;
            }
            queueCounters.totalIntersectWorkgroups = totalIntersectWgs;
            queueCounters.secondaryRayCount = totalOctantRays;

            if (pc.secondarySortMode == 2u) {
                indirect.commands[b * 16u + 8u].x = intersectGroups;
                indirect.commands[b * 16u + 8u].y = 1u;
                indirect.commands[b * 16u + 8u].z = 1u;
                indirect.commands[b * 16u + 8u].pad = nextCount;
            }

            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces) ? totalOctantRays : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
