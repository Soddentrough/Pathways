#version 450
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

// Binding 0: Current frame raw radiance (from Ray Tracing / Wavefront accumulation image)
layout(binding = 0) readonly uniform image2D uCurrentRadiance;

// Binding 1: Screen-space motion vectors (RG16F, containing surface delta UV = currUV - prevUV)
layout(binding = 1) readonly uniform image2D uMotionVectors;

// Binding 2: Previous frame history (RGBA16F or RGBA32F, RGB: accumulated radiance, A: sample count N)
layout(binding = 2) readonly uniform image2D uHistoryRadiance;

// Binding 3: Output accumulated radiance (RGBA16F or RGBA32F, RGB: accumulated radiance, A: sample count N)
layout(binding = 3) writeonly uniform image2D uOutputRadiance;

// Binding 4: Current frame Primary hit Normal & Linear Depth (RGBA16F, RGB: normal, A: depth)
layout(binding = 4) readonly uniform image2D uCurrentNormalDepth;

// Binding 5: Previous frame Primary hit Normal & Linear Depth (RGBA16F, RGB: normal, A: depth)
layout(binding = 5) readonly uniform image2D uPrevNormalDepth;

layout(push_constant) uniform PushConstants {
    ivec2 imageSize;
    vec2 invImageSize;
    float clampingGamma;     // Neighborhood variance clamping box multiplier (e.g. 1.25)
    float outlierH;          // wRLS outlier rejection bandwidth (e.g. 0.75)
    float maxHistorySamples; // Maximum history sample accumulation limit (e.g. 32.0)
    uint resetHistory;       // 1 if history must be cleared (e.g. scene load / cut)
    uint cameraMoved;        // 1 if camera moved this frame, 0 if static
    uint totalSamples;       // Total static accumulation samples if stationary (for scaling)
} pc;

bool isInvalid(vec3 v) {
    return isnan(v.r) || isnan(v.g) || isnan(v.b) || isinf(v.r) || isinf(v.g) || isinf(v.b);
}

// Convert linear RGB to YCoCg space for perceptually decoupled variance clipping
vec3 RGBToYCoCg(vec3 rgb) {
    float Y  = dot(rgb, vec3( 0.25, 0.50,  0.25));
    float Co = dot(rgb, vec3( 0.50, 0.00, -0.50));
    float Cg = dot(rgb, vec3(-0.25, 0.50, -0.25));
    return vec3(Y, Co, Cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
    float Y  = ycocg.x;
    float Co = ycocg.y;
    float Cg = ycocg.z;
    float R = Y + Co - Cg;
    float G = Y + Cg;
    float B = Y - Co - Cg;
    return max(vec3(0.0), vec3(R, G, B));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= pc.imageSize.x || pixelCoord.y >= pc.imageSize.y) {
        return;
    }

    float invTotal = (pc.totalSamples > 1u) ? (1.0 / float(pc.totalSamples)) : 1.0;

    // 1. Fetch current frame radiance
    vec4 currData = imageLoad(uCurrentRadiance, pixelCoord);
    vec3 C_curr = currData.rgb * invTotal;
    if (isInvalid(C_curr)) {
        C_curr = vec3(0.0);
    }

    // When the camera is stationary, the path tracer performs progressive Monte Carlo accumulation.
    // C_curr already represents the exact, unbiased physical radiance without temporal lag or ghosting.
    // Pass through C_curr directly to output and store sample count in history.
    if (pc.cameraMoved == 0u) {
        float N_curr = min(float(max(pc.totalSamples, 1u)), pc.maxHistorySamples);
        imageStore(uOutputRadiance, pixelCoord, vec4(C_curr, N_curr));
        return;
    }

    // 2. Motion Vector Reprojection
    vec2 mv = imageLoad(uMotionVectors, pixelCoord).xy;
    vec2 currUV = (vec2(pixelCoord) + 0.5) * pc.invImageSize;
    vec2 prevUV = currUV - mv;

    bool validHistory = (pc.resetHistory == 0u);
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        validHistory = false;
    }

    vec4 historyVal = vec4(C_curr, 1.0);
    if (validHistory) {
        // Bilinear interpolation of historical radiance and sample count
        vec2 prevPx = prevUV * vec2(pc.imageSize) - 0.5;
        ivec2 p0 = ivec2(floor(prevPx));
        vec2 f = fract(prevPx);

        ivec2 p00 = clamp(p0, ivec2(0), pc.imageSize - 1);
        ivec2 p10 = clamp(p0 + ivec2(1, 0), ivec2(0), pc.imageSize - 1);
        ivec2 p01 = clamp(p0 + ivec2(0, 1), ivec2(0), pc.imageSize - 1);
        ivec2 p11 = clamp(p0 + ivec2(1, 1), ivec2(0), pc.imageSize - 1);

        vec4 h00 = imageLoad(uHistoryRadiance, p00);
        vec4 h10 = imageLoad(uHistoryRadiance, p10);
        vec4 h01 = imageLoad(uHistoryRadiance, p01);
        vec4 h11 = imageLoad(uHistoryRadiance, p11);

        historyVal = mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
        if (isInvalid(historyVal.rgb)) {
            historyVal = vec4(C_curr, 1.0);
            validHistory = false;
        }

        // Geometric Disocclusion Test: compare current primary hit against previous frame geometry
        vec4 currND = imageLoad(uCurrentNormalDepth, pixelCoord);
        ivec2 prevCoord = clamp(ivec2(prevUV * vec2(pc.imageSize)), ivec2(0), pc.imageSize - 1);
        vec4 prevND = imageLoad(uPrevNormalDepth, prevCoord);

        if (currND.w < 5000.0 && prevND.w < 5000.0) {
            float depthDiff = abs(currND.w - prevND.w) / max(currND.w, 0.1);
            float normalDot = dot(currND.xyz, prevND.xyz);
            if (depthDiff > 0.15 || normalDot < 0.70) {
                validHistory = false;
                historyVal = vec4(C_curr, 1.0);
            }
        } else if ((currND.w < 5000.0) != (prevND.w < 5000.0)) {
            validHistory = false;
            historyVal = vec4(C_curr, 1.0);
        }
    }

    // 3. Adaptive History Blending (Energy-Conserving Monte Carlo EMA)
    vec3 C_final = C_curr;
    float N_curr = 1.0;
    if (validHistory) {
        // In camera motion, cap effective sample count to 4.0 so ghost trails fade within 3-4 frames
        // and prevent bright highlights from bleeding into deep contact shadows.
        float maxMotionSamples = min(pc.maxHistorySamples, 4.0);
        N_curr = min(historyVal.a + 1.0, maxMotionSamples);
        float alpha = 1.0 / max(N_curr, 1.0);
        alpha = clamp(alpha, 0.25, 1.0);
        C_final = mix(historyVal.rgb, C_curr, alpha);
    }

    // 4. Store accumulated radiance (RGB) and tracked sample count (A)
    imageStore(uOutputRadiance, pixelCoord, vec4(C_final, N_curr));
}
