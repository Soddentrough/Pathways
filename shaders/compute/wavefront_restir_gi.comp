#version 460
#extension GL_EXT_shader_image_load_formatted : require

#include "wavefront_common.glsl"
#include "wavefront_restir_gi.glsl"

layout(local_size_x = 8, local_size_y = 4) in;

layout(binding = 0) uniform image2D uAccumImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint frameIndex;
    uint maxBounces;
} pc;

shared mat4 s_invVP;

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        s_invVP = ubo.viewInverse * ubo.projInverse;
    }
    barrier();

    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) return;
    uint pixelIndex = uint(pixelCoord.y * int(pc.width) + pixelCoord.x);

    // Gate: ReSTIR GI active only when bit 22 is set and maxBounces >= 2
    bool enableReSTIR_GI = (ubo.flags & (1u << 22)) != 0u;
    if (!enableReSTIR_GI || pc.maxBounces <= 1u) return;

    // 1. Retrieve Primary Surface Geometry and Albedo from rawGISamples buffer
    uvec4 rawD1 = rawGISamples[pixelIndex];
    if (rawD1.w != ubo.frameIndex + 1u) return; // Discard invalid or stale sample from previous frame / non-diffuse

    vec3 primaryNormal;
    float primaryDepth;
    unpackGeom(rawD1.x, primaryNormal, primaryDepth);
    if (primaryDepth <= 1e-4) return;

    vec2 albRG = unpackHalf2x16(rawD1.y);
    vec2 albB_pad = unpackHalf2x16(rawD1.z);
    vec3 primaryAlbedo = max(vec3(albRG, albB_pad.x), vec3(0.01));

    // Reconstruct Primary Hit Point x and Primary Ray Direction
    vec2 uv = (vec2(pixelCoord) + vec2(0.5)) / vec2(float(pc.width), float(pc.height));
    vec2 d = uv * 2.0 - 1.0;
    vec4 target = s_invVP * vec4(d.x, d.y, 1.0, 1.0);
    vec3 primaryRayDir = normalize(target.xyz);
    vec3 primaryHitPoint = ubo.position.xyz + primaryRayDir * primaryDepth;

    uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + (ubo.frameIndex + 1u) * 26699) | 1u;

    // 2. Load Raw Secondary Path Sample for this Pixel
    uvec4 rawD0 = rawGISamples[pc.width * pc.height + pixelIndex];
    ReservoirGI R;
    R.packedDir = rawD0.x;
    R.hitDist = uintBitsToFloat(rawD0.y);
    R.packedRadRG = rawD0.z;
    R.packedRadB_normS = rawD0.w;
    R.wSum = 0.0;
    R.M = 0.0;
    R.W = 0.0;
    R.primaryGeom = rawD1.x;

    vec3 winnerRad = vec3(0.0);
    vec3 winnerDir = vec3(0.0, 1.0, 0.0);
    float winnerTarget = 0.0;

    if (R.hitDist > 0.0) {
        vec3 rawDir = unpackOct32(R.packedDir);
        vec3 rawRad;
        vec3 rawNormS;
        unpackRadianceAndNorm(R.packedRadRG, R.packedRadB_normS, rawRad, rawNormS);

        float p_hat = evalGITarget(rawRad, primaryAlbedo, primaryNormal, rawDir);
        float q_pdf = max(dot(primaryNormal, rawDir), 0.0) * INV_PI;
        float w_init = (q_pdf > 1e-5) ? (p_hat / q_pdf) : 0.0;

        R.wSum = w_init;
        R.M = 1.0;
        winnerRad = rawRad;
        winnerDir = rawDir;
        winnerTarget = p_hat;
    }

    // 3. Temporal Resampling (History Reprojection + Jacobian Shift)
    vec4 prevClip = ubo.prevViewProj * vec4(primaryHitPoint, 1.0);
    if (prevClip.w > 0.0) {
        vec2 prevNDC = prevClip.xy / prevClip.w;
        vec2 prevUV = prevNDC * 0.5 + 0.5;
        if (prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0) {
            int prevPx = clamp(int(prevUV.x * float(pc.width)), 0, int(pc.width) - 1);
            int prevPy = clamp(int(prevUV.y * float(pc.height)), 0, int(pc.height) - 1);
            uint prevIdx = uint(prevPy * int(pc.width) + prevPx);

            ReservoirGI R_prev = historyGIReservoirs[prevIdx];
            if (R_prev.primaryGeom != 0u && R_prev.M > 0.0 && R_prev.hitDist > 0.0) {
                vec3 prevNorm;
                float prevDepth;
                unpackGeom(R_prev.primaryGeom, prevNorm, prevDepth);

                float normDot = dot(primaryNormal, prevNorm);
                float depthDiff = abs(primaryDepth - prevDepth) / max(primaryDepth, 1e-3);

                if (normDot > 0.90 && depthDiff < 0.10) {
                    vec3 histDir = unpackOct32(R_prev.packedDir);
                    vec3 histRad;
                    vec3 histNormS;
                    unpackRadianceAndNorm(R_prev.packedRadRG, R_prev.packedRadB_normS, histRad, histNormS);

                    vec3 w_shifted;
                    float dist_shifted;
                    float J;

                    if (prevPx == pixelCoord.x && prevPy == pixelCoord.y && abs(primaryDepth - prevDepth) < 0.05) {
                        w_shifted = histDir;
                        dist_shifted = R_prev.hitDist;
                        J = 1.0;
                    } else if (R_prev.hitDist >= 1e4) {
                        w_shifted = histDir;
                        dist_shifted = R_prev.hitDist;
                        J = 1.0;
                    } else {
                        // Reconstruct historical primary hit position x_prev
                        vec2 h_uv = (vec2(prevPx, prevPy) + vec2(0.5)) / vec2(float(pc.width), float(pc.height));
                        vec2 h_d = h_uv * 2.0 - 1.0;
                        vec4 h_target = s_invVP * vec4(h_d.x, h_d.y, 1.0, 1.0);
                        vec3 x_prev = ubo.position.xyz + normalize(h_target.xyz) * prevDepth;
                        J = evalGIJacobian(primaryHitPoint, x_prev, histDir, R_prev.hitDist, histNormS, w_shifted, dist_shifted);
                    }

                    if (J > 0.0) {
                        float p_hat_hist = evalGITarget(histRad * J, primaryAlbedo, primaryNormal, w_shifted);
                        float histM = min(R_prev.M, 20.0);
                        float w_temp = p_hat_hist * R_prev.W * histM;

                        R.wSum += w_temp;
                        R.M += histM;

                        if (randFloat(seed) * R.wSum < w_temp) {
                            R.packedDir = packOct32(w_shifted);
                            R.hitDist = dist_shifted;
                            packRadianceAndNorm(histRad * J, histNormS, R.packedRadRG, R.packedRadB_normS);
                            winnerRad = histRad * J;
                            winnerDir = w_shifted;
                            winnerTarget = p_hat_hist;
                        }
                    }
                }
            }
        }
    }

    // 4. Spatial Resampling (Cross-Bilateral Neighbor Pooling)
    bool enableSpatial = (ubo.flags & (1u << 7)) != 0u;
    if (enableSpatial) {
        const ivec2 kSpatialOffsets[8] = ivec2[8](
            ivec2( 3,  1), ivec2(-2,  4), ivec2(-4, -2), ivec2( 1, -5),
            ivec2( 6, -3), ivec2(-5,  5), ivec2( 4,  6), ivec2(-7, -1)
        );
        ivec2 offset = kSpatialOffsets[seed & 7u];

        ivec2 nbrCoord = clamp(pixelCoord + offset, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
        uint nbrIdx = uint(nbrCoord.y * int(pc.width) + nbrCoord.x);

            ReservoirGI R_nbr = historyGIReservoirs[nbrIdx];
            if (R_nbr.primaryGeom != 0u && R_nbr.M > 0.0 && R_nbr.hitDist > 0.0) {
                vec3 nbrNorm;
                float nbrDepth;
                unpackGeom(R_nbr.primaryGeom, nbrNorm, nbrDepth);

                float normDot = dot(primaryNormal, nbrNorm);
                float depthDiff = abs(primaryDepth - nbrDepth) / max(primaryDepth, 1e-3);

                if (normDot > 0.90 && depthDiff < 0.10) {
                    vec3 nbrDir = unpackOct32(R_nbr.packedDir);
                    vec3 nbrRad;
                    vec3 nbrNormS;
                    unpackRadianceAndNorm(R_nbr.packedRadRG, R_nbr.packedRadB_normS, nbrRad, nbrNormS);

                    vec3 w_shifted;
                    float dist_shifted;
                    float J;

                    if (R_nbr.hitDist >= 1e4) {
                        w_shifted = nbrDir;
                        dist_shifted = R_nbr.hitDist;
                        J = 1.0;
                    } else {
                        // Reconstruct neighbor primary hit position x_nbr
                        vec2 n_uv = (vec2(nbrCoord) + vec2(0.5)) / vec2(float(pc.width), float(pc.height));
                        vec2 n_d = n_uv * 2.0 - 1.0;
                        vec4 n_target = s_invVP * vec4(n_d.x, n_d.y, 1.0, 1.0);
                        vec3 x_nbr = ubo.position.xyz + normalize(n_target.xyz) * nbrDepth;
                        J = evalGIJacobian(primaryHitPoint, x_nbr, nbrDir, R_nbr.hitDist, nbrNormS, w_shifted, dist_shifted);
                    }

                    if (J > 0.0) {
                        float p_hat_nbr = evalGITarget(nbrRad * J, primaryAlbedo, primaryNormal, w_shifted);
                        float nbrM = min(R_nbr.M, 20.0);
                        float w_spat = p_hat_nbr * R_nbr.W * nbrM;

                        R.wSum += w_spat;
                        R.M += nbrM;

                        if (randFloat(seed) * R.wSum < w_spat) {
                            R.packedDir = packOct32(w_shifted);
                            R.hitDist = dist_shifted;
                            packRadianceAndNorm(nbrRad * J, nbrNormS, R.packedRadRG, R.packedRadB_normS);
                            winnerRad = nbrRad * J;
                            winnerDir = w_shifted;
                            winnerTarget = p_hat_nbr;
                        }
                }
            }
        }
    }

    // 5. Compute Final Unbiased Weight W with M-capping
    const float M_max = 24.0;
    if (R.M > M_max) {
        R.wSum *= (M_max / R.M);
        R.M = M_max;
    }

    if (winnerTarget > 1e-6 && R.M > 0.0) {
        R.W = R.wSum / (R.M * winnerTarget);
    } else {
        R.W = 0.0;
    }

    // Store current reservoir for next frame's temporal reprojection
    currentGIReservoirs[pixelIndex] = R;

    // 6. Accumulate Filtered Indirect Radiance into uAccumImage
    if (R.W > 0.0 && length(winnerRad) > 1e-5) {
        float nDotL = clamp(dot(primaryNormal, winnerDir), 0.0, 1.0);
        vec3 indirectContrib = winnerRad * primaryAlbedo * INV_PI * nDotL * R.W;

        if (any(greaterThan(indirectContrib, vec3(1e-5)))) {
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, prev + vec4(indirectContrib, 0.0));
        }
    }
}
