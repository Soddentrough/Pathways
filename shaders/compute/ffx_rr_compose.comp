#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly  uniform image2D uInDirectDiffuse;
layout(set = 0, binding = 1, rgba16f) readonly  uniform image2D uInIndirectDiffuse;
layout(set = 0, binding = 2, rgba16f) readonly  uniform image2D uInDirectSpecular;
layout(set = 0, binding = 3, rgba16f) readonly  uniform image2D uInIndirectSpecular;
layout(set = 0, binding = 4, rgba16f) readonly  uniform image2D uInDiffuseAlbedo;
layout(set = 0, binding = 5, rgba16f) readonly  uniform image2D uInSpecularAlbedo;
layout(set = 0, binding = 6, rgba16f) readonly  uniform image2D uInSkip;
layout(set = 0, binding = 7)          writeonly uniform image2D uOutDenoised;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint pad0;
    uint pad1;
} pc;

vec3 safeRgb(vec3 v) {
    bvec3 bad = bvec3(isnan(v.x) || isinf(v.x),
                      isnan(v.y) || isinf(v.y),
                      isnan(v.z) || isinf(v.z));
    return vec3(bad.x ? 0.0 : max(v.x, 0.0),
                bad.y ? 0.0 : max(v.y, 0.0),
                bad.z ? 0.0 : max(v.z, 0.0));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.width) || px.y >= int(pc.height)) return;

    vec3 dd = safeRgb(imageLoad(uInDirectDiffuse, px).rgb);
    vec3 id = safeRgb(imageLoad(uInIndirectDiffuse, px).rgb);
    vec3 ds = safeRgb(imageLoad(uInDirectSpecular, px).rgb);
    vec3 ispec = safeRgb(imageLoad(uInIndirectSpecular, px).rgb);
    vec3 diffAlb = safeRgb(imageLoad(uInDiffuseAlbedo, px).rgb);
    vec3 specAlb = safeRgb(imageLoad(uInSpecularAlbedo, px).rgb);
    vec3 skip = safeRgb(imageLoad(uInSkip, px).rgb);

    vec3 color = skip + (dd + id) * diffAlb + (ds + ispec) * specAlb;
    imageStore(uOutDenoised, px, vec4(color, 1.0));
}
