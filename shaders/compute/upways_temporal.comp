#version 460
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_GOOGLE_include_directive : require

#include "upways_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f)  uniform readonly image2D  uCurrentDiffuse;
layout(set = 0, binding = 1, rgba16f)  uniform readonly image2D  uCurrentSpecular;
layout(set = 0, binding = 2, rgba16f)  uniform readonly image2D  uNormalDepth;
layout(set = 0, binding = 3, rgba16f)  uniform readonly image2D  uPrevNormalDepth;
layout(set = 0, binding = 4, rgba16f)  uniform readonly image2D  uMotionVectors;
layout(set = 0, binding = 5, rgba16f)  uniform readonly image2D  uAlbedoRoughness;
layout(set = 0, binding = 6, rgba16f)  uniform readonly image2D  uSpecularMotion;
layout(set = 0, binding = 7, rgba16f)  uniform readonly image2D  uPrevSpecularMotion;
layout(set = 0, binding = 8, rg32ui)   uniform readonly uimage2D uHistoryDiffuseIn;
layout(set = 0, binding = 9, rg32ui)   uniform readonly uimage2D uHistorySpecularIn;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D  uHistoryMomentsIn;

layout(set = 0, binding = 11, rgba32ui) uniform writeonly uimage2D uTemporalDiffuseOut;
layout(set = 0, binding = 12, rgba32ui) uniform writeonly uimage2D uTemporalSpecularOut;
layout(set = 0, binding = 13, rgba16f)  uniform writeonly image2D  uReprojDiffuseOut;
layout(set = 0, binding = 14, rgba16f)  uniform writeonly image2D  uReprojSpecularOut;
layout(set = 0, binding = 15, rgba16f)  uniform writeonly image2D  uHistoryMomentsOut;

layout(std430, set = 0, binding = 16) writeonly buffer NeuralFeaturesOutBuffer {
    uvec4 features4[];
} uNeuralFeaturesOut;

layout(push_constant) uniform TemporalPushConstants {
    uint renderWidth;
    uint renderHeight;
    uint resetHistory;
    float minAlphaDiffuse;
    float minAlphaSpecular;
} pc;

const float MAX_LOG1P_IRRADIANCE = 11.09035489;
const float INV_MAX_LOG1P_IRRADIANCE = 1.0 / 11.09035489;

void computeBilinearCoords(
    vec2 uv,
    ivec2 texSize,
    out ivec2 p00,
    out ivec2 p10,
    out ivec2 p01,
    out ivec2 p11,
    out vec2 f
) {
    vec2 cUv   = clamp(uv, vec2(0.0), vec2(1.0));
    vec2 pos   = cUv * vec2(texSize) - vec2(0.5);
    vec2 rPos  = round(pos);
    pos        = mix(pos, rPos, lessThan(abs(pos - rPos), vec2(1e-5)));
    ivec2 base = ivec2(floor(pos));
    f          = pos - vec2(base);
    ivec2 maxP = texSize - ivec2(1);

    p00 = clamp(base + ivec2(0, 0), ivec2(0), maxP);
    p10 = clamp(base + ivec2(1, 0), ivec2(0), maxP);
    p01 = clamp(base + ivec2(0, 1), ivec2(0), maxP);
    p11 = clamp(base + ivec2(1, 1), ivec2(0), maxP);
}

#define UNPACK_IRR_P1(p) \
    vec3( \
        unpackHalf2x16((((p) & 0x7FFu) << 1u) + 0x3C00u | (((((p) >> 11u) & 0x7FFu) << 17u) + 0x3C000000u)), \
        unpackHalf2x16((((p) >> 22u) << 2u) + 0x3C00u).x \
    )

#define SAMPLE_BILINEAR_HIST_BOTH(img, p00, p10, p01, p11, f, outDiff, outSpec) \
    do { \
        if ((f).x == 0.0 && (f).y == 0.0) { \
            uvec2 h00_ = imageLoad(img, p00).xy; \
            outDiff = unpackIrr11_11_10(h00_.x); \
            outSpec = unpackIrr11_11_10(h00_.y); \
        } else { \
            uvec2 h00_ = imageLoad(img, p00).xy; \
            uvec2 h10_ = imageLoad(img, p10).xy; \
            uvec2 h01_ = imageLoad(img, p01).xy; \
            uvec2 h11_ = imageLoad(img, p11).xy; \
            vec3 d00_  = UNPACK_IRR_P1(h00_.x); \
            vec3 d10_  = UNPACK_IRR_P1(h10_.x); \
            vec3 d01_  = UNPACK_IRR_P1(h01_.x); \
            vec3 d11_  = UNPACK_IRR_P1(h11_.x); \
            vec3 s00_  = UNPACK_IRR_P1(h00_.y); \
            vec3 s10_  = UNPACK_IRR_P1(h10_.y); \
            vec3 s01_  = UNPACK_IRR_P1(h01_.y); \
            vec3 s11_  = UNPACK_IRR_P1(h11_.y); \
            outDiff = max(vec3(f16vec3(mix(mix(d00_, d10_, (f).x), mix(d01_, d11_, (f).x), (f).y) - vec3(1.0))), vec3(0.0)); \
            outSpec = max(vec3(f16vec3(mix(mix(s00_, s10_, (f).x), mix(s01_, s11_, (f).x), (f).y) - vec3(1.0))), vec3(0.0)); \
        } \
    } while (false)

#define SAMPLE_BILINEAR_HIST_COMP(img, compIdx, p00, p10, p01, p11, f, outRgb) \
    do { \
        if ((f).x == 0.0 && (f).y == 0.0) { \
            outRgb = unpackIrr11_11_10(imageLoad(img, p00)[compIdx]); \
        } else { \
            uint c00_ = imageLoad(img, p00)[compIdx]; \
            uint c10_ = imageLoad(img, p10)[compIdx]; \
            uint c01_ = imageLoad(img, p01)[compIdx]; \
            uint c11_ = imageLoad(img, p11)[compIdx]; \
            vec3 v00_ = UNPACK_IRR_P1(c00_); \
            vec3 v10_ = UNPACK_IRR_P1(c10_); \
            vec3 v01_ = UNPACK_IRR_P1(c01_); \
            vec3 v11_ = UNPACK_IRR_P1(c11_); \
            outRgb = max(vec3(f16vec3(mix(mix(v00_, v10_, (f).x), mix(v01_, v11_, (f).x), (f).y) - vec3(1.0))), vec3(0.0)); \
        } \
    } while (false)

#define SAMPLE_BILINEAR_VEC4(img, p00, p10, p01, p11, f, outVec4) \
    do { \
        if ((f).x == 0.0 && (f).y == 0.0) { \
            outVec4 = imageLoad(img, p00); \
        } else { \
            vec4 v00_ = imageLoad(img, p00); \
            vec4 v10_ = imageLoad(img, p10); \
            vec4 v01_ = imageLoad(img, p01); \
            vec4 v11_ = imageLoad(img, p11); \
            outVec4 = mix(mix(v00_, v10_, (f).x), mix(v01_, v11_, (f).x), (f).y); \
        } \
    } while (false)

void main() {
    uint tid     = gl_LocalInvocationIndex;
    uint waveId  = tid >> 6u;
    uint qInWave = (tid >> 2u) & 15u;
    uint subId   = tid & 3u;
    uint lx      = (((waveId & 1u) << 2u) | (qInWave & 3u)) << 1u | (subId & 1u);
    uint ly      = (((waveId >> 1u) << 2u) | (qInWave >> 2u)) << 1u | (subId >> 1u);

    ivec2 renderSize = ivec2(int(pc.renderWidth), int(pc.renderHeight));
    ivec2 p  = ivec2(gl_WorkGroupID.xy * 16u + uvec2(lx, ly));
    ivec2 gp = clamp(p, ivec2(0), renderSize - ivec2(1));

    // 1. Issue All Current-Frame G-Buffer & History VMEM Loads First Before Demodulation ALU
    ivec2 histSize   = imageSize(uHistorySpecularIn);
    vec4 rawD        = imageLoad(uCurrentDiffuse, gp);
    vec4 rawS        = imageLoad(uCurrentSpecular, gp);
    vec4 rawArLoad   = imageLoad(uAlbedoRoughness, gp);
    vec4 ndCenter    = imageLoad(uNormalDepth, gp);
    vec2 rawMvLoad   = imageLoad(uMotionVectors, gp).xy;

    bool activeHist   = ((pc.resetHistory & 1u) == 0u);
    float roughness   = clamp(rawArLoad.a, 0.0, 1.0);
    vec2 mvSurf       = activeHist ? rawMvLoad : vec2(0.0);
    vec2 effSpecMv    = mvSurf;
    bool hasSpecHit   = false;
    vec4 wPrevNd      = vec4(0.0);
    vec4 wPrevSm      = vec4(0.0);
    vec3 wDiffLr      = vec3(0.0);
    vec3 wSpecLr      = vec3(0.0);
    float validSurfLr = 0.0;

    vec4 rawSmCurr    = vec4(0.0);
    if (activeHist) {
        rawSmCurr = imageLoad(uSpecularMotion, gp);
        // RTXPT DenoiseSpecHitT: 3x3 bilateral spatial filter on glossy specular Hit-T & VMV
        if (roughness < 0.25 && ndCenter.w < 9999.0 &&
            (roughness > 0.015 || rawSmCurr.w <= 1e-4) &&
            (rawSmCurr.w < 999.0)) {
            bool centerValid = (rawSmCurr.w > 1e-4);
            vec4 smAccum = centerValid ? rawSmCurr : vec4(0.0);
            float wSum = centerValid ? 1.0 : 0.0;
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 qp = clamp(gp + ivec2(dx, dy), ivec2(0), renderSize - ivec2(1));
                    vec4 qSm = imageLoad(uSpecularMotion, qp);
                    if (qSm.w > 1e-4 && qSm.w < 999.0) {
                        vec4 qNd = imageLoad(uNormalDepth, qp);
                        float relZ = abs(ndCenter.w - qNd.w) / max(max(ndCenter.w, qNd.w), 0.1);
                        float nSim = max(dot(ndCenter.xyz, qNd.xyz), 0.0);
                        float nSim2 = nSim * nSim;
                        float nSim4 = nSim2 * nSim2;
                        float w = exp(-relZ * 20.0) * (nSim4 * nSim4);
                        smAccum += qSm * w;
                        wSum += w;
                    }
                }
            }
            if (wSum > 1e-3) {
                rawSmCurr = smAccum / wSum;
            }
        }
        float surfMvMag2 = dot(mvSurf, mvSurf);
        hasSpecHit = (rawSmCurr.w > 1e-4 && rawSmCurr.w < 999.0 &&
                      roughness < 0.25 && (roughness < 0.14 || surfMvMag2 > 1e-7));
        if (hasSpecHit) {
            effSpecMv = rawSmCurr.xy;
        }

        vec2 uv         = (vec2(gp) + vec2(0.5)) / vec2(renderSize);
        vec2 prevUvSurf = uv - mvSurf;
        float inBSurf   = (prevUvSurf.x >= 0.0 && prevUvSurf.x <= 1.0 && prevUvSurf.y >= 0.0 && prevUvSurf.y <= 1.0) ? 1.0 : 0.0;

        if (inBSurf > 0.0) {
            ivec2 hs00, hs10, hs01, hs11;
            vec2  fHSurf;
            computeBilinearCoords(prevUvSurf, histSize, hs00, hs10, hs01, hs11, fHSurf);
            SAMPLE_BILINEAR_HIST_BOTH(uHistorySpecularIn, hs00, hs10, hs01, hs11, fHSurf, wDiffLr, wSpecLr);
            SAMPLE_BILINEAR_VEC4(uPrevNormalDepth, hs00, hs10, hs01, hs11, fHSurf, wPrevNd);
            if (effSpecMv == mvSurf && hasSpecHit) {
                SAMPLE_BILINEAR_VEC4(uPrevSpecularMotion, hs00, hs10, hs01, hs11, fHSurf, wPrevSm);
            }
        }
        if (effSpecMv != mvSurf) {
            vec2 prevUvSpec = uv - effSpecMv;
            float inBSpec   = (prevUvSpec.x >= 0.0 && prevUvSpec.x <= 1.0 && prevUvSpec.y >= 0.0 && prevUvSpec.y <= 1.0) ? 1.0 : 0.0;
            if (inBSpec > 0.0) {
                ivec2 sp00, sp10, sp01, sp11;
                vec2  fHSpec;
                computeBilinearCoords(prevUvSpec, histSize, sp00, sp10, sp01, sp11, fHSpec);
                SAMPLE_BILINEAR_HIST_COMP(uHistorySpecularIn, 1, sp00, sp10, sp01, sp11, fHSpec, wSpecLr);
                if (hasSpecHit) {
                    SAMPLE_BILINEAR_VEC4(uPrevSpecularMotion, sp00, sp10, sp01, sp11, fHSpec, wPrevSm);
                }
            } else {
                wSpecLr = vec3(0.0);
            }
        }
        validSurfLr = inBSurf;
    }

    // 2. Demodulate Current Frame into Log1p Irradiance (Exact FP16 Grid Alignment)
    vec3 arRgb      = clamp(rawArLoad.rgb, vec3(0.0), vec3(1.0));
    float metallic  = clamp(rawS.a, 0.0, 1.0);

    vec3 fDiff      = denoiseDemodulationFactor(arRgb, ndCenter.w);
    vec3 fSpec      = denoiseSpecularModulationFactor(arRgb, metallic, roughness, ndCenter.z, ndCenter.w);
    vec3 rawDiffIrr = sanitizeVec3(rawD.rgb) / fDiff;
    vec3 rawSpecIrr = sanitizeVec3(rawS.rgb) / fSpec;

    vec3 logDiff    = vec3(f16vec3(clamp(log(vec3(1.0) + rawDiffIrr), vec3(0.0), vec3(MAX_LOG1P_IRRADIANCE))));
    vec3 logSpec    = vec3(f16vec3(clamp(log(vec3(1.0) + rawSpecIrr), vec3(0.0), vec3(MAX_LOG1P_IRRADIANCE))));
    float denomZ    = max(max(ndCenter.w, wPrevNd.w), 0.1);
    float dollyTol  = (0.03 + 0.8 * length(mvSurf)) * denomZ;
    float dzSigned  = ndCenter.w - wPrevNd.w;
    float dzDisocc  = max(dzSigned, max(-dzSigned - dollyTol, 0.0));
    float relDz     = activeHist ? float(float16_t(clamp(dzDisocc / denomZ, 0.0, 2.0))) : 1.0;
    float nDot      = activeHist ? float(float16_t(clamp(dot(ndCenter.xyz, wPrevNd.xyz), -1.0, 1.0))) : 0.0;
    float specHitT  = rawSmCurr.w;
    float denomRefl = max(max(specHitT, wPrevSm.w), 0.1);
    float skySlip   = (specHitT >= 999.0) ? (16.0 * length(rawSmCurr.xy - mvSurf)) : 0.0;
    float relDRefl  = activeHist
        ? ((hasSpecHit && wPrevSm.w > 1e-4)
            ? float(float16_t(clamp(abs(specHitT - wPrevSm.w) / denomRefl, 0.0, 2.0)))
            : float(float16_t(clamp(relDz + skySlip, 0.0, 2.0))))
        : 1.0;

    // 3. Zero-LDS Subgroup DPP Quad Average Pooling for Stage 2 Multi-Scale U-Net
    vec4 q0 = vec4(f16vec4(
        float16_t(logDiff.r * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(logDiff.g * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(logDiff.b * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(logSpec.r * INV_MAX_LOG1P_IRRADIANCE)
    ));
    vec4 q1 = vec4(f16vec4(
        float16_t(logSpec.g * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(logSpec.b * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(wDiffLr.r * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(wDiffLr.g * INV_MAX_LOG1P_IRRADIANCE)
    ));
    vec4 q2 = vec4(f16vec4(
        float16_t(wDiffLr.b * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(wSpecLr.r * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(wSpecLr.g * INV_MAX_LOG1P_IRRADIANCE),
        float16_t(wSpecLr.b * INV_MAX_LOG1P_IRRADIANCE)
    ));
    vec4 q3 = vec4(f16vec4(
        float16_t(relDz * 0.5),
        float16_t(nDot),
        float16_t(roughness),
        float16_t(validSurfLr)
    ));

    q0 += subgroupShuffleXor(q0, 1u);
    q1 += subgroupShuffleXor(q1, 1u);
    q2 += subgroupShuffleXor(q2, 1u);
    q3 += subgroupShuffleXor(q3, 1u);

    q0 = (q0 + subgroupShuffleXor(q0, 2u)) * 0.25;
    q1 = (q1 + subgroupShuffleXor(q1, 2u)) * 0.25;
    q2 = (q2 + subgroupShuffleXor(q2, 2u)) * 0.25;
    q3 = (q3 + subgroupShuffleXor(q3, 2u)) * 0.25;

    bool inBounds = (p.x < renderSize.x && p.y < renderSize.y);
    if (inBounds && subId == 0u) {
        uint qW         = (pc.renderWidth + 1u) >> 1u;
        uint qx         = uint(p.x) >> 1u;
        uint qy         = uint(p.y) >> 1u;
        uint qLinearIdx = qy * qW + qx;

        uvec4 f0 = uvec4(
            packHalf2x16(q0.xy),
            packHalf2x16(q0.zw),
            packHalf2x16(q1.xy),
            packHalf2x16(q1.zw)
        );
        uvec4 f1 = uvec4(
            packHalf2x16(q2.xy),
            packHalf2x16(q2.zw),
            packHalf2x16(q3.xy),
            packHalf2x16(q3.zw)
        );

        uNeuralFeaturesOut.features4[qLinearIdx * 2u + 0u] = f0;
        uNeuralFeaturesOut.features4[qLinearIdx * 2u + 1u] = f1;
    }

    if (inBounds) {
        bool isSurf          = (ndCenter.w < UPWAYS_SKY_DEPTH);
        bool hasCustomSpecMv = (effSpecMv != mvSurf);
        imageStore(uTemporalDiffuseOut, p, uvec4(
            packIrr11_11_10(logDiff),
            packIrr11_11_10(logSpec),
            packGuide11_11_10(fDiff),
            packSpecGuide29(fSpec, isSurf, hasCustomSpecMv)
        ));
        imageStore(uTemporalSpecularOut, p, uvec4(
            packHalf2x16(ndCenter.xy),
            packHalf2x16(ndCenter.zw),
            packHalf2x16(vec2(relDz, nDot)),
            packHalf2x16(vec2(relDRefl, roughness))
        ));
    }
}

