#version 460
#ifndef IS_SECONDARY_BOUNCE
#define IS_SECONDARY_BOUNCE 0
#endif
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "wavefront_common.glsl"
#include "procedural_noise.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 23, rg16f) uniform readonly image2D uMotionVectorImage;
layout(binding = 27, rgba16f) uniform image2D uMlSpecularMotionImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 31, rgba16f) uniform readonly image2D uCausticImage;
layout(binding = 24, rgba16f) uniform readonly image2D uNormalDepthImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[512];

layout(std430, binding = 9) readonly buffer InRayStateQueue {
    RayState inStates[];
};

layout(std430, binding = 10) writeonly buffer OutRayStateQueue {
    RayState outStates[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint diffuseCount; // Standard count
    uint complexCount;
    uint dielectricCount;
    uint emissiveCount;
    uint conductorCount; // Reserved
    uint alphamaskCount; // Reserved
    uint nextDiffuseCount;
    uint nextComplexCount;
    uint nextDielectricCount;
    uint nextEmissiveCount;
    uint nextConductorCount; // Reserved
    uint nextAlphamaskCount; // Reserved
    uint currentMaterialCounts[4];
    uint padMat[2];
    uint totalShadeWorkgroups;
    uint octantCounts[8];
    uint currentOctantCounts[8];
    uint totalIntersectWorkgroups;
    uint secondaryRayCount;
    uint activeMaterialSequenceCount;
    uint pad[20];
} queueCounters;

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 15) readonly buffer InRayGeomQueue {
    RayGeometry inGeoms[];
};

layout(std430, binding = 16) writeonly buffer OutRayGeomQueue {
    RayGeometry outGeoms[];
};

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 18) readonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(std430, binding = 19) writeonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(std430, binding = 20) writeonly buffer OutNRCQueryQueue {
    NRCQuery nrcQueries[];
};

layout(std430, binding = 21) buffer InOutNRCTrainQueue {
    NRCTrainingRecord nrcTrainRecords[];
};

layout(std430, binding = 22) buffer InOutNRCCounters {
    NRCCountersBuffer nrcCounters;
};

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

#define RESTIR_INCLUDE_SAMPLER_HELPERS
#include "restir_common.glsl"

layout(std430, binding = 32) buffer ReSTIRCurrentReservoirsBuffer {
    DiReservoir currentReservoirs[];
};

layout(std430, binding = 36) readonly buffer ReSTIRHistoryReservoirsBuffer {
    DiReservoir historyReservoirs[];
};

// ReSTIR GI (path-space) state — docs/RESTIR_PT_DESIGN.md
layout(std430, binding = 37) buffer X1ContextsBuffer {
    X1Context x1Contexts[];
};

layout(std430, binding = 38) buffer GiCurrentReservoirsBuffer {
    GiReservoir giReservoirs[];
};

layout(std430, binding = 39) readonly buffer GiHistoryReservoirsBuffer {
    GiReservoir giHistoryReservoirs[];
};

#ifndef ENABLE_INLINE_SHADOWS
#define ENABLE_INLINE_SHADOWS 1
#endif

#if ENABLE_INLINE_SHADOWS
#include "wavefront_shadow_inline.glsl"
#endif

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
    uint useHardwareRT;
    uint secondarySortMode;
    uint enableNrc;
    uint nrcBounce;
    float nrcTrainRatio;
    uint frameIndex;
    uint numOpaqueTriangles;
    uint captureMlData;
    float indirectClamp;
    uint deltaUnrollPC;
    uint restirMCap;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint activeCount = queueCounters.currentMaterialCounts[0]; // Diffuse queue
    bool inRange = (idx < activeCount);
    bool survivesToNext = false;
    bool hasShadowRay = false;
    vec3 nextDirection = vec3(0.0);
    RayGeometry nextGeom;
    RayState nextState;
    PackedShadowRay shadowCandidate;

    if (inRange) {
        uint rayIdx = materialIndices[0u * pc.maxQueueCapacity + idx];
        RayGeometry geom = inGeoms[rayIdx];
        RayHit hit = inHits[rayIdx];
        RayState state = inStates[rayIdx];

        vec3 origin = geom.originPackedDir.xyz;
        vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        float hitT;
        uint matId, hitType;
        vec3 hitNormal, geomTan;
        vec2 hitUv;
        float tanSign;
        unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

        f16vec3 throughput;
        uint seed, pixelIndex;
        bool isSpecularPath, causticApplied;
        uint dispersionChannel = 0u;
        unpackRayState(state, throughput, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
        uint bounce = pc.currentBounce;
        bool sampledSpecularLobe = false;

#if !IS_SECONDARY_BOUNCE
        // ReSTIR GI: the X1 context is invalidated by default at bounce 0 and
        // only made valid below where a diffuse cosine reflection lobe emits
        // the bounce-1 ray (docs/RESTIR_PT_DESIGN.md).
        bool giCtxEligible = false;
        if (bounce == 0u && (ubo.flags & (1u << 24)) != 0u) {
            x1Contexts[pixelIndex] = invalidX1Context();
        }
#endif

        if (hitType == 2u) {
            // Environment sky miss
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            vec3 skyContrib = vec3(throughput) * skyColor;
            if (bounce > 0u) {
                skyContrib = clampIndirectRadiance(skyContrib, pc.indirectClamp);
            }
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), prev.a));
            bool enableRestirPT = ((ubo.flags & (1 << 9)) != 0);
            if (enableRestirPT && bounce == 0u) {
                currentReservoirs[pixelIndex] = invalidDiReservoir();
            }
            if ((ubo.flags & (1u << 24)) != 0u && bounce == 1u) {
                // Bounce-1 ray escaped to the sky: no secondary vertex exists,
                // so this pixel contributes no GI candidate this frame.
                giReservoirs[pixelIndex] = invalidGiReservoir();
            }


            if (pc.captureMlData != 0u) {
                if (isSpecularPath) {
                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), 0.0));
                } else {
                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, skyContrib, seed), 0.0));
                }
            }
            RECORD_SPECULAR_VMV(pixelIndex, origin + rayDir * 1000.0, 10000.0, true);
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            RECORD_SPECULAR_VMV(pixelIndex, hitPoint, hitT, false);
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            hitNormal = frontFace ? hitNormal : -hitNormal;

            ShadeMaterial mat = shadeMaterials[matId];
            uint albedoTex = mat.tex_flags.x & 0xFFFFu;
            uint normalTex = mat.tex_flags.x >> 16u;
            uint mrTex = mat.tex_flags.y & 0xFFFFu;
            uint emissiveTex = mat.tex_flags.y >> 16u;
            uint diffTransTex = mat.tex_flags.z & 0xFFFFu;
            uint specularTex = mat.tex_flags.z >> 16u;
            uint matType = mat.tex_flags.w & 0xFFFFu;
            float normalScale = unpackHalf2x16(mat.tex_flags.w).y;

#if !IS_SECONDARY_BOUNCE
            if (bounce == 0u && hitType == 0u && normalTex > 0u && normalTex <= 512u) {
                vec3 normalMap = SAMPLE_SCENE_TEXTURE(normalTex, hitUv).rgb * 2.0 - 1.0;
                normalMap.xy *= normalScale;
                normalMap = normalize(normalMap);

                geomTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
                vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                hitNormal = normalize(tbn * normalMap);
            }
#endif

            vec4 baseColor = mat.albedo;
            bool isTerrain = ((matType & MATERIAL_FLAG_PROCEDURAL_TERRAIN) != 0u);
            bool isPuddle = ((matType & MATERIAL_FLAG_PROCEDURAL_PUDDLE) != 0u);
            float procRoughness = mat.pbrParams.x;
            if (isTerrain) {
                float slope = 1.0 - clamp(abs(hitNormal.y), 0.0, 1.0);
                vec3 dummyG;
                float biomeNoise = simplex3D_grad(hitPoint * 0.03125, dummyG);
                float rockThreshold = smoothstep(0.4, 0.7, slope + 0.25 * biomeNoise);

                vec3 gradBump;
                float rockDetail = fbm3D_grad(hitPoint * 0.5, 3, gradBump);

                float f1, f2;
                voronoi2D(hitPoint.xz * 2.0 + hitPoint.y * 0.5, f1, f2);
                float crack = smoothstep(0.02, 0.08, f2 - f1);

                vec3 grassColor = mix(vec3(0.12, 0.18, 0.08), vec3(0.25, 0.28, 0.12), biomeNoise * 0.5 + 0.5);
                vec3 rockColor = mix(vec3(0.22, 0.21, 0.20), vec3(0.38, 0.35, 0.32), rockDetail * 0.5 + 0.5);
                rockColor *= mix(0.4, 1.0, crack);
                baseColor = vec4(mix(grassColor, rockColor, rockThreshold), 1.0);

                // Modulate roughness: soil is rougher, exposed rock has varied specular response
                procRoughness = mix(0.85, clamp(0.65 + 0.25 * rockDetail, 0.3, 0.95), rockThreshold);

                // World-space tangentless normal perturbation
                vec3 gradProj = gradBump - dot(gradBump, hitNormal) * hitNormal;
                hitNormal = normalize(hitNormal - gradProj * (0.2 * rockThreshold));
            } else if (isPuddle) {
                // Procedural wet asphalt and puddle pooling
                vec3 gradBump;
                float microRough = fbm3D_grad(hitPoint * 3.0, 2, gradBump);
                float v = voronoi2D(hitPoint.xz * 0.15);
                // Puddle mask: pooling in Voronoi low basins, softened by micro-roughness
                float puddleMask = smoothstep(0.30, 0.45, 1.0 - v + 0.18 * microRough);

                // Wet asphalt darkening: wet ground is significantly darker due to subsurface internal reflection
                baseColor.rgb = mix(baseColor.rgb, baseColor.rgb * 0.35, clamp(puddleMask + 0.25, 0.0, 1.0));

                // Roughness modulation: puddle surface is mirror-smooth (0.02), dry/damp asphalt is rougher (0.55)
                procRoughness = mix(clamp(0.48 + 0.15 * microRough, 0.35, 0.70), 0.02, puddleMask);

                // Fine asphalt micro-texture normal perturbation outside of puddles
                vec3 gradProj = gradBump - dot(gradBump, hitNormal) * hitNormal;
                hitNormal = normalize(hitNormal - gradProj * (0.12 * (1.0 - puddleMask)));
            } else if (albedoTex > 0u && albedoTex <= 512u) {
                baseColor *= SAMPLE_SCENE_TEXTURE(albedoTex, hitUv);
            }

            uint alphaMode = (matId < pc.numMaterials) ? materials[matId].alphaMode : 0u;
            bool isCutout = (alphaMode == 1u && baseColor.a < materials[matId].alphaCutoff) ||
                            (alphaMode == 2u && randFloat(seed) > baseColor.a);
            if (isCutout) {
                if ((ubo.flags & (1u << 24)) != 0u && bounce == 1u) {
                    // Cutout pass-through: the shaded x2 belongs to the next
                    // vertex; this pixel's GI slot must not reuse stale data.
                    giReservoirs[pixelIndex] = invalidGiReservoir();
                }
                if (bounce + 1u < pc.maxBounces) {
                    survivesToNext = true;
                    nextDirection = rayDir;
                    vec3 nextOrigin = hitPoint + rayDir * 0.001;
                    nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                    nextState = packRayState(f16vec3(throughput), seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
                }
            } else {
            vec3 emissive = mat.emissive_spec.rgb;
            if (emissiveTex > 0u && emissiveTex <= 512u && (matType & MATERIAL_FLAG_PROCEDURAL_HOLO) == 0u) {
                emissive *= SAMPLE_SCENE_TEXTURE(emissiveTex, hitUv).rgb;
            } else if ((matType & MATERIAL_FLAG_PROCEDURAL_HOLO) != 0u) {
                float time = float(ubo.frameIndex) * 0.01666667;
                float scanline = sin(hitPoint.y * 24.0 - time * 8.0) * 0.5 + 0.5;
                float fineScan = sin(hitPoint.y * 96.0 + time * 3.0) * 0.5 + 0.5;
                vec3 dummyG;
                float glitch = simplex3D_grad(vec3(floor(hitPoint.y * 3.0), time * 5.0, 0.0), dummyG);
                float glitchBand = step(0.72, glitch);
                vec3 holoMod = vec3(
                    0.85 + 0.35 * scanline + 0.40 * glitchBand,
                    0.75 + 0.25 * fineScan - 0.25 * glitchBand,
                    0.90 + 0.45 * scanline + 0.50 * glitchBand
                );
                emissive *= holoMod;
            }
            if (length(emissive) > 1e-3 && (bounce == 0u || isSpecularPath)) {
                vec3 emissiveContrib = vec3(throughput) * emissive;
                if (bounce > 0u) {
                    emissiveContrib = clampIndirectRadiance(emissiveContrib, pc.indirectClamp);
                }
                ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                vec4 prev = imageLoad(uAccumImage, pCoord);
                imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, emissiveContrib, seed), prev.a));
                if (pc.captureMlData != 0u) {
                    if (isSpecularPath) {
                        vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                        imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, emissiveContrib, seed), 0.0));
                    } else {
                        vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                        imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, emissiveContrib, seed), 0.0));
                    }
                }
                bool enableRestirPT = ((ubo.flags & (1 << 9)) != 0);
                if (enableRestirPT && bounce == 0u) {
                    currentReservoirs[pixelIndex] = invalidDiReservoir();
                }
            }

            f16vec3 diffuseColor = f16vec3(baseColor.rgb);

            float diffTrans = clamp(mat.pbrParams.w, 0.0, 1.0);
            if (diffTransTex > 0u && diffTransTex <= 512u) {
                diffTrans *= SAMPLE_SCENE_TEXTURE(diffTransTex, hitUv).r;
            }
            diffTrans = clamp(diffTrans, 0.0, 1.0);

            float roughness = (isTerrain || isPuddle) ? procRoughness : mat.pbrParams.x;
            float metallic = mat.pbrParams.y;
            if (!isTerrain && !isPuddle && mrTex > 0u && mrTex <= 512u) {
                vec4 mrSample = SAMPLE_SCENE_TEXTURE(mrTex, hitUv);
                roughness *= mrSample.g;
                metallic *= mrSample.b;
            }
            if ((matType & 0xFFu) == 1u /* MATERIAL_METALLIC */) {
                metallic = max(metallic, 1.0);
            }
            bool isDelta = (metallic > 0.5 && roughness <= 0.008);
            roughness = isDelta ? 0.001 : clamp(roughness, 0.02, 1.0);
            metallic = clamp(metallic, 0.0, 1.0);
            float alphaRoughness = roughness * roughness;

            float iorVal = mat.pbrParams.z > 0.0 ? mat.pbrParams.z : 1.5;
            float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
#if IS_SECONDARY_BOUNCE
            f16vec3 F0 = mix(f16vec3(clamp(f0Dielectric * mat.emissive_spec.w, 0.0, 1.0)), diffuseColor, float16_t(metallic));
#else
            float specFactor = mat.emissive_spec.w;
            if (specularTex > 0u && specularTex <= 512u) {
                specFactor *= SAMPLE_SCENE_TEXTURE(specularTex, hitUv).a;
            }
            f16vec3 F0 = mix(f16vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0)), diffuseColor, float16_t(metallic));
#endif
            diffuseColor = mix(diffuseColor, f16vec3(0.0), float16_t(metallic));

            bool enableDirect = (ubo.flags & (1 << 0)) != 0;
            bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
            bool enableShadows = (ubo.flags & (1 << 4)) != 0;

            bool pathTerminated = false;
            if ((matType & MATERIAL_TYPE_MASK) == 3u /* MATERIAL_EMISSIVE */) {
                pathTerminated = true;
            }

            bool enableCaustics = (ubo.flags & (1u << 8)) != 0u && (pc.numLights > 0u);
            if (enableCaustics && !pathTerminated) {
                bool alreadyApplied = causticApplied;
                if (!alreadyApplied) {
                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    vec3 causticIrr = imageLoad(uCausticImage, pCoord).rgb;
                    if (dot(causticIrr, causticIrr) > 1e-8) {
                        vec3 causticRad = vec3(throughput) * (vec3(diffuseColor) * INV_PI) * causticIrr;
                        if (bounce > 0u) {
                            causticRad = clampIndirectRadiance(causticRad, pc.indirectClamp);
                        }
                        vec4 prev = imageLoad(uAccumImage, pCoord);
                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, causticRad, seed), prev.a));
                        causticApplied = true;
                        if (pc.captureMlData != 0u) {
                            vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                            imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, causticRad, seed), 0.0));
                        }
                    }
                }
            }

            vec3 V = -rayDir;
            f16vec3 secDirectL = f16vec3(0.0);

#if IS_SECONDARY_BOUNCE
            // --- STREAMLINED SECONDARY DIRECT LIGHTING (1-Sample NEE + Pure Lambertian Diffuse) ---
            // ReSTIR GI (docs/RESTIR_PT_DESIGN.md): for bounce-1 rays the 2-bounce
            // term T1·L_direct(x1) is estimated by resampling cached secondary
            // vertices at the primary hit x1 (this ray's origin) instead of the
            // plain T1·NEE(x2) accumulation. Requires inline ray queries for the
            X1Context giCtx = x1Contexts[pixelIndex];
            bool giActive = ((ubo.flags & (1u << 24)) != 0u) && (bounce == 1u) &&
                            (pc.useHardwareRT == 1u) && enableDirect && (pc.numLights > 0u) &&
                            x1ContextValid(giCtx);
            if (!giActive && bounce == 1u && (ubo.flags & (1u << 24)) != 0u) {
                giReservoirs[pixelIndex] = invalidGiReservoir();
            }
            vec3 giL2 = vec3(0.0);              // shadowed radiance leaving x2 toward x1
            vec3 giLightDir = vec3(0.0);
            float giLightDist = 0.0;
            vec3 giShadowOrigin = vec3(0.0);
            bool giLightSampled = false;
            if (!pathTerminated && !isDelta && enableDirect && pc.numLights > 0u) {
                uint lightIdx = 0u;
                float lightSelectPdf = 1.0;
                if ((ubo.flags & (1 << 7)) != 0 && pc.numLights > 1u) {
                    SAMPLE_LIGHT_TREE(pc.numLights, hitPoint, hitNormal, seed, lightIdx, lightSelectPdf);
                } else {
                    SAMPLE_LIGHT_ALIAS(pc.numLights, seed, lightIdx, lightSelectPdf);
                }

                Light light = lights[lightIdx];
                vec3 lightDir;
                float lightDist = 0.0;
                float lightPdf = 1.0;
                vec3 lightEmission = light.emission.rgb;
                bool validLight = false;

                if (uint(light.position.w) == 0u /* AREA QUAD */) {
                    vec2 luv = randVec2(seed);
                    vec3 lightPoint = light.position.xyz + luv.x * light.u.xyz + luv.y * light.v.xyz;
                    vec3 toLight = lightPoint - hitPoint;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);
                    float cosLight = dot(-lightDir, light.normal.xyz);
                    if (cosLight > 0.0) {
                        lightPdf = (lightDist * lightDist) / (light.emission.w * cosLight);
                        validLight = true;
                    }
                } else if (uint(light.position.w) == 1u /* SPOT */) {
                    vec3 toLight = light.position.xyz - hitPoint;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);
                    float cosSpot = dot(-lightDir, light.normal.xyz);
                    if (cosSpot >= light.v.w) {
                        float spotFactor = clamp((cosSpot - light.v.w) / max(light.u.w - light.v.w, 1e-4), 0.0, 1.0);
                        lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                        validLight = true;
                    }
                } else if (uint(light.position.w) == 2u /* DIRECTIONAL */) {
                    lightDir = normalize(light.normal.xyz);
                    lightDist = 10000.0;
                    validLight = true;
                }

                float lightDirDotN = dot(hitNormal, lightDir);
                bool isTransmitted = (lightDirDotN < 0.0 && diffTrans > 0.001);
                float NdotL = isTransmitted ? -lightDirDotN : clamp(lightDirDotN, 0.0, 1.0);
                if (validLight && NdotL > 0.0 && (lightDirDotN > 0.0 || isTransmitted)) {
                    float transFactor = isTransmitted ? diffTrans : (1.0 - diffTrans);
                    f16vec3 diffBrdf = diffuseColor * float16_t(INV_PI * transFactor);
                    float lightPdfEff = max(lightPdf * lightSelectPdf, 1e-6);
                    float diffPdf = NdotL * INV_PI * transFactor;
                    float misWeight = (uint(light.position.w) == 0u) ? (lightPdfEff / (lightPdfEff + diffPdf)) : 1.0;

                    float factor = (NdotL / lightPdfEff) * misWeight;
                    vec3 directLightRadiance = clamp(lightEmission * factor, vec3(0.0), vec3(65500.0));
                    secDirectL = diffBrdf * f16vec3(directLightRadiance);

                    if (giActive) {
                        // Candidate data for this frame's own secondary vertex.
                        giL2 = vec3(secDirectL);
                        giLightDir = lightDir;
                        giLightDist = lightDist;
                        giShadowOrigin = isTransmitted ? (hitPoint - hitNormal * EPSILON) : (hitPoint + hitNormal * EPSILON);
                        giLightSampled = true;
                    } else {
                    f16vec3 unshadowed = clampIndirectRadiance(throughput * secDirectL, pc.indirectClamp);

                    if (length(unshadowed) > float16_t(1e-5)) {
                        bool keepShadow = true;
                        if (bounce >= 1u && !isSpecularPath) {
                            float lum = float(max(unshadowed.r, max(unshadowed.g, unshadowed.b)));
                            float prob = clamp(lum * 1.5, 0.20, 1.0);
                            if (randFloat(seed) < prob) {
                                unshadowed /= float16_t(prob);
                            } else {
                                keepShadow = false;
                            }
                        }
                        if (keepShadow) {
                            if (enableShadows) {
                                vec3 shadowOrigin = isTransmitted ? (hitPoint - hitNormal * EPSILON) : (hitPoint + hitNormal * EPSILON);
#if ENABLE_INLINE_SHADOWS
                                bool enableInlineShadows = ((ubo.flags & (1 << 6)) != 0) && (bounce == 0u);
                                if (enableInlineShadows && pc.useHardwareRT == 1u) {
                                    bool occluded = traceShadowRayInline(shadowOrigin, lightDir, lightDist,
                                                                         (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                    if (!occluded) {
                                        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                        vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                        imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                        if (pc.captureMlData != 0u) {
                                            if (isSpecularPath) {
                                                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(unshadowed), seed), 0.0));
                                            } else {
                                                vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                                imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, vec3(unshadowed), seed), 0.0));
                                            }
                                        }
                                    } else {
                                        secDirectL = f16vec3(0.0);
                                    }
                                } else
#endif
                                {
                                    hasShadowRay = true;
                                    shadowCandidate.originDist = vec4(shadowOrigin, lightDist);
                                    shadowCandidate.dirPixelRad = uvec4(packOct32(lightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, isSpecularPath ? 1.0 : 0.0)));
                                }
                            } else {
                                ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                vec4 prev = imageLoad(uAccumImage, pCoord);
                                imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                            }
                        }
                    }
                    } // !giActive (legacy secondary accumulation)
                }
            }

            if (giActive) {
                // Shadow-test this frame's own L̂2 inline (synchronous: the
                // reservoir must store the shadowed estimate; the deferred
                // shadow queue cannot feed it).
                if (giLightSampled && enableShadows) {
                    bool giOcc0 = traceShadowRayInline(giShadowOrigin, giLightDir, giLightDist,
                                                       (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                    if (giOcc0) {
                        giL2 = vec3(0.0);
                    }
                }

                // Every bounce-1 ray owns its pixel's GI slot this frame:
                // write invalid first, overwrite below when a candidate exists.
                giReservoirs[pixelIndex] = invalidGiReservoir();

                if (!pathTerminated && !isDelta) {
                    vec3 giX1 = origin;              // primary hit point (epsilon-offset)
                    vec3 giN1 = x1ContextNormal(giCtx);
                    vec3 giAlbedo = x1ContextAlbedo(giCtx);
                    float giAlbedoBar = max(dot(clamp(giAlbedo, vec3(0.0), vec3(1.0)), vec3(0.3333333)), 1e-4);

                    // Fresh candidate: the path's own secondary vertex.
                    // q̂ = cosine pdf at x1, so w = p̂/q̂ = albedoBar·l̄um(L̂2).
                    float giCosSelf = max(dot(giN1, rayDir), 0.0);
                    float giPSelf = giTargetAt(giAlbedo, giN1, giX1, hitPoint, giL2);
                    GiReservoir giR = invalidGiReservoir();
                    bool giWinnerSelf = true;
                    if (giPSelf > 0.0 && giCosSelf > 0.0) {
                        float giWSelf = giPSelf / max(giCosSelf * INV_PI, 1e-9);
                        giR = makeGiReservoir(hitPoint, giWSelf, 1u, giPSelf, giL2, hitT, 0u);
                    }

                    if (ubo.frameIndex > 0u && (ubo.flags & (1u << 23)) == 0u) {
                        // History taps on the previous frame's GI grid:
                        // temporal center (MV-reprojected) + rotated cross.
                        ivec2 giPix = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                        vec2 giMv = imageLoad(uMotionVectorImage, giPix).xy;
                        ivec2 giPrev = ivec2(round(vec2(giPix) - giMv * vec2(pc.width, pc.height)));
                        uint giHash = (pixelIndex * 0x9E3779B9u) ^ (pc.frameIndex * 0x85EBCA6Bu);
                        uint giRot = (giHash >> 30u) & 3u;

                        for (uint tap = 0u; tap < 5u; ++tap) {
                            ivec2 giOff = ivec2(0, 0);
                            if (tap > 0u) {
                                ivec2 base = RESTIR_TAP_OFFSETS[tap - 1u];
                                for (uint rr = 0u; rr < giRot; ++rr) {
                                    base = ivec2(-base.y, base.x);
                                }
                                giOff = base;
                            }
                            ivec2 giCoord = giPrev + giOff;
                            if (giCoord.x < 0 || giCoord.y < 0 ||
                                giCoord.x >= int(pc.width) || giCoord.y >= int(pc.height)) {
                                continue;
                            }
                            GiReservoir giTap = giHistoryReservoirs[uint(giCoord.y) * pc.width + uint(giCoord.x)];
                            if (!giIsValid(giTap) || giGetAge(giTap) >= RESTIR_MAX_AGE) continue;
                            uint giMCap = (tap == 0u) ? pc.restirMCap : min(pc.restirMCap, 8u);
                            uint giAgeNew = min(giGetAge(giTap) + (tap == 0u ? 1u : 0u), RESTIR_MAX_AGE);
                            if (giApplyTap(giR, giTap, giX1, giN1, giAlbedo, giMCap, giAgeNew, seed)) {
                                giWinnerSelf = false;
                            }
                        }
                    }

                    if (giIsValid(giR) && giGetM(giR) > 0u) {
                        vec3 giL2w = giGetRadiance(giR);
                        float giLumW = max(dot(giL2w, vec3(0.2126, 0.7152, 0.0722)), 1e-4);

                        // Finalization: C2 = T1·f_r(x1)·cosθ1_w·L̂2_w·W with
                        // W = wsum/(M·p̂_w) and p̂_w = (albedoBar/π)·cosθ1_w·l̄um_w.
                        // The bounce-0 continuation folded
                        // ratio = (1-F̂)·albedo/(1-specProb) into this ray's
                        // throughput T2 (lobe coin and RR conditioning cancel),
                        // giving per-channel:
                        //   C2 = T2·L̂2_w · wsum/(M·albedoBar·l̄um_w) · (1-F_w)/(1-F̂)
                        // Single candidate reduces exactly to T2·L̂2 (legacy).
                        float giW = clamp(giGetWSum(giR) / (float(giGetM(giR)) * giAlbedoBar * giLumW), 0.0, 500.0);

                        // Fresnel ratio between the winner direction and the
                        // path's own direction at x1 (both vs the stored wo).
                        vec3 giWo = x1ContextWo(giCtx);
                        float giF0 = x1ContextF0(giCtx);
                        vec3 giDirSelfN = normalize(rayDir);
                        vec3 giHs = normalize(giDirSelfN + giWo);
                        float giFS = fresnelSchlick(clamp(dot(giWo, giHs), 0.0, 1.0), giF0);
                        vec3 giDirW0 = normalize(giGetX2(giR) - giX1);
                        vec3 giHw = normalize(giDirW0 + giWo);
                        float giFW = fresnelSchlick(clamp(dot(giWo, giHw), 0.0, 1.0), giF0);
                        giW *= (1.0 - giFW) / max(1.0 - giFS, 0.05);

                        // Replay visibility x1↔x2_w; the path itself already
                        // traversed x1→x2, so a self winner needs no ray.
                        float giVis = 1.0;
                        if (!giWinnerSelf) {
                            vec3 giX2w = giGetX2(giR);
                            vec3 giDirW = giX2w - giX1;
                            float giDistW = length(giDirW);
                            if (giDistW > 2.0 * EPSILON) {
                                giDirW /= giDistW;
                                bool giOccW = traceShadowRayInline(giX1 + giN1 * EPSILON, giDirW, giDistW - 2.0 * EPSILON,
                                                                   (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                giVis = giOccW ? 0.0 : 1.0;
                            } else {
                                giVis = 0.0;
                            }
                        }

                        vec3 giContrib = clampIndirectRadiance(vec3(throughput) * giL2w * (giW * giVis), pc.indirectClamp);
                        if (dot(giContrib, giContrib) > 1e-12) {
                            ivec2 giPixC = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                            vec4 giPrevAcc = imageLoad(uAccumImage, giPixC);
                            imageStore(uAccumImage, giPixC, vec4(addFp16Stochastic(giPrevAcc.rgb, giContrib, seed), giPrevAcc.a));
                            if (pc.captureMlData != 0u) {
                                if (isSpecularPath) {
                                    vec4 prevSpec = imageLoad(uMlSpecularImage, giPixC);
                                    imageStore(uMlSpecularImage, giPixC, vec4(addFp16Stochastic(prevSpec.rgb, giContrib, seed), 0.0));
                                } else {
                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, giPixC);
                                    imageStore(uMlDiffuseImage, giPixC, vec4(addFp16Stochastic(prevDiff.rgb, giContrib, seed), 0.0));
                                }
                            }
                        }

                        giReservoirs[pixelIndex] = giR;
                    }
                }
            }
#else
            // Direct Lighting (Unified ReSTIR PT Inline Path Resampling & Stochastic NEE)
            bool enableRestirPT = ((ubo.flags & (1 << 9)) != 0);
            if (!pathTerminated && !isDelta && enableDirect && pc.numLights > 0u) {
                bool enableInlineShadows = ((ubo.flags & (1 << 6)) != 0) && (bounce == 0u);
                uint M = (enableRestirPT && bounce == 0u && pc.numLights > 1u) ? min(pc.numLights, 4u) : 1u;

                f16vec3 proxyLumWeight = max(diffuseColor + F0, f16vec3(0.04)) * f16vec3(0.2126, 0.7152, 0.0722);

                DiReservoir r;
                DiSample sel;
                restirDiFreshStream(pc.numLights, (ubo.flags & (1 << 7)) != 0,
                                    hitPoint, hitNormal, hitT, proxyLumWeight,
                                    diffTrans, M, seed, r, sel);

                if (enableRestirPT && bounce == 0u && ubo.frameIndex > 0u &&
                    (ubo.flags & (1 << 23)) == 0u) {
                    // History taps over the previous frame's reservoir grid:
                    // tap 0 = temporal center (MV-reprojected), taps 1..4 = spatial
                    // neighborhood at a per-pixel rotated cross offset. Buffer reads
                    // only: legal under divergent wavefront control flow.
                    ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    vec2 mv = imageLoad(uMotionVectorImage, pixelCoord).xy;
                    ivec2 prevCoord = ivec2(round(vec2(pixelCoord) - mv * vec2(pc.width, pc.height)));

                    uint tapHash = (pixelIndex * 0x9E3779B9u) ^ (pc.frameIndex * 0x85EBCA6Bu);
                    uint rot = (tapHash >> 30u) & 3u;

                    for (uint tap = 0u; tap < 5u; ++tap) {
                        ivec2 tapOff = ivec2(0, 0);
                        if (tap > 0u) {
                            ivec2 base = RESTIR_TAP_OFFSETS[tap - 1u];
                            for (uint rr = 0u; rr < rot; ++rr) {
                                base = ivec2(-base.y, base.x);
                            }
                            tapOff = base;
                        }
                        ivec2 tapCoord = prevCoord + tapOff;
                        if (tapCoord.x < 0 || tapCoord.y < 0 ||
                            tapCoord.x >= int(pc.width) || tapCoord.y >= int(pc.height)) {
                            continue;
                        }
                        DiReservoir src = historyReservoirs[uint(tapCoord.y) * pc.width + uint(tapCoord.x)];
                        uint mCap = (tap == 0u) ? pc.restirMCap : min(pc.restirMCap, 8u);
                        uint ageNew = min(restirGetAge(src.flags) + (tap == 0u ? 1u : 0u), RESTIR_MAX_AGE);
                        restirDiApplyTap(r, sel, src, pc.numLights, hitPoint, hitNormal, hitT,
                                         proxyLumWeight, diffTrans, mCap, ageNew, seed);
                    }

                }

                // Local aliases consumed by the finalization block below
                uint selectedLightIdx = sel.lightIdx;
                vec3 selectedLightDir = sel.dir;
                float selectedLightDist = sel.dist;
                vec3 selectedLightEmission = sel.emission;
                float selectedNdotL = sel.ndotL;
                bool selectedIsTrans = sel.isTrans;
                float selectedTarget = sel.target;
                float selectedCosLight = sel.cosLight;
                float selectedLightSelectPdf = sel.selectPdf;
                bool hasCandidate = sel.has;

                if (hasCandidate && selectedTarget > 1e-6) {
                    float NdotV = clamp(dot(hitNormal, V), 0.0, 1.0);
                    if (NdotV > 0.0) {
                        vec3 H = normalize(V + (selectedIsTrans ? -selectedLightDir : selectedLightDir));
                        float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                        float VdotH = clamp(dot(V, H), 0.0, 1.0);

                        f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);
                        float D = distributionGGX(NdotH, alphaRoughness);
                        float Vis = visibilitySmithGGXCorrelated(selectedNdotL, NdotV, alphaRoughness);
                        f16vec3 specBrdf = !selectedIsTrans ? (float16_t(clamp(D * Vis, 0.0, 65500.0)) * F) : f16vec3(0.0);

                        float transFactor = selectedIsTrans ? diffTrans : (1.0 - diffTrans);
                        f16vec3 diffBrdf = (f16vec3(1.0) - F) * (diffuseColor * float16_t(INV_PI * transFactor));
                        f16vec3 combinedBrdf = diffBrdf + specBrdf;

                        float diffPdf = selectedNdotL * INV_PI * transFactor;
                        float specPdf = selectedIsTrans ? 0.0 : ((D * NdotH) / max(4.0 * VdotH, 1e-4));
                        float specProb = selectedIsTrans ? 0.0 : clamp(float(dot(F, f16vec3(0.3333))), 0.05, 0.95);
                        float bsdfPdf = (1.0 - specProb) * diffPdf + specProb * specPdf;

                        // Balance-heuristic MIS weight vs. the path's own
                        // random-walk light hits (emissive surfaces accumulated
                        // along the continuation). Applies in BOTH modes: the
                        // RIS finalization Ī = g(x̂)·W is unbiased for ∫g for any
                        // target p̂, so multiplying the winner by misW makes the
                        // NEE term estimate ∫g·misW — exactly the share left to
                        // light sampling once random hits keep their own term.
                        // (Skipping this double-counts area lights; measured
                        //  +9% energy on cornell-box before the fix.)
                        float misWeight = 1.0;
                        {
                            Light selLight = lights[selectedLightIdx];
                            if (uint(selLight.position.w) == 0u) {
                                float effCos = max(selectedCosLight, 1e-4);
                                float effDist = max(selectedLightDist, 1e-4);
                                float lightPdfEff = ((effDist * effDist) / (selLight.emission.w * effCos)) * selectedLightSelectPdf;
                                misWeight = lightPdfEff / (lightPdfEff + bsdfPdf);
                            }
                        }

                        float risWeight = 1.0;
                        if (enableRestirPT && bounce == 0u) {
                            uint finalM = restirGetM(r.idxM);
                            risWeight = (finalM > 0u && selectedTarget > 1e-6) ? (r.wSum / (float(finalM) * selectedTarget)) : 0.0;
                            risWeight = clamp(risWeight, 0.0, 500.0);
                        } else {
                            risWeight = r.wSum / (float(M) * max(selectedTarget, 1e-6));
                            risWeight = clamp(risWeight, 0.0, 10000.0);
                        }

                        float factor = selectedNdotL * misWeight * risWeight;
                        vec3 directLightRadiance = clamp(selectedLightEmission * factor, vec3(0.0), vec3(65500.0));
                        secDirectL = (diffBrdf + specBrdf) * f16vec3(directLightRadiance);
                        f16vec3 unshadowed = throughput * secDirectL;
                        if (bounce > 0u) {
                            unshadowed = clampIndirectRadiance(unshadowed, pc.indirectClamp);
                        }

                        if (length(unshadowed) > float16_t(1e-5)) {
                            bool keepShadow = true;
                            if (bounce >= 1u && !isSpecularPath) {
                                float lum = float(max(unshadowed.r, max(unshadowed.g, unshadowed.b)));
                                float prob = clamp(lum * 1.5, 0.20, 1.0);
                                if (randFloat(seed) < prob) {
                                    unshadowed /= float16_t(prob);
                                } else {
                                    keepShadow = false;
                                }
                            }
                            if (keepShadow) {
                                if (enableShadows) {
                                    vec3 shadowOrigin = selectedIsTrans ? (hitPoint - hitNormal * EPSILON) : (hitPoint + hitNormal * EPSILON);
#if ENABLE_INLINE_SHADOWS
                                    if (enableInlineShadows && pc.useHardwareRT == 1u) {
                                        bool occluded = traceShadowRayInline(shadowOrigin, selectedLightDir, selectedLightDist,
                                                                             (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                        if (!occluded) {
                                            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                            vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                            if (pc.captureMlData != 0u) {
                                                f16vec3 diffUnshadowed = throughput * diffBrdf * f16vec3(directLightRadiance);
                                                f16vec3 specUnshadowed = throughput * specBrdf * f16vec3(directLightRadiance);
                                                if (bounce > 0u) {
                                                    diffUnshadowed = clampIndirectRadiance(diffUnshadowed, pc.indirectClamp);
                                                    specUnshadowed = clampIndirectRadiance(specUnshadowed, pc.indirectClamp);
                                                }
                                                if (isSpecularPath) {
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(unshadowed), seed), 0.0));
                                                } else {
                                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, vec3(diffUnshadowed), seed), 0.0));
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(specUnshadowed), seed), 0.0));
                                                }
                                            }
                                        } else {
                                            secDirectL = f16vec3(0.0);
                                            r = invalidDiReservoir();
                                        }
                                    } else
#endif
                                    {
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(shadowOrigin, selectedLightDist);
                                        shadowCandidate.dirPixelRad = uvec4(packOct32(selectedLightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, isSpecularPath ? 1.0 : 0.0)));
                                    }
                                } else {
                                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    vec4 prev = imageLoad(uAccumImage, pCoord);
                                    imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                }
                            }
                        }
                    }
                }
                if (enableRestirPT && bounce == 0u) {
                    currentReservoirs[pixelIndex] = r;
                }
            } else {
                if (enableRestirPT && bounce == 0u) {
                    currentReservoirs[pixelIndex] = invalidDiReservoir();
                }
            }

            // Ambient Skylight Irradiance:
            // When an environment map is present, illuminate open-air diffuse surfaces with ambient daylight.
            // This prevents shadowed surfaces in outdoor scenes from collapsing into pitch-black voids (0,0,0)
            // and eliminates extreme high-contrast noise and horizon bleeding.
            if (bounce == 0u && !pathTerminated && enableDirect && pc.hasEnvMap == 1u) {
                float upFactor = clamp(hitNormal.y * 0.5 + 0.5, 0.0, 1.0);
                float zenithFactor = clamp(hitNormal.y, 0.0, 1.0);
                vec3 skyZenith = vec3(0.08, 0.18, 0.45);
                vec3 skyHorizon = vec3(0.65, 0.55, 0.45);
                vec3 groundReflect = vec3(0.08, 0.07, 0.06);
                vec3 upperSky = mix(skyHorizon, skyZenith, pow(zenithFactor, 0.6));
                vec3 skyHemisphere = mix(groundReflect, upperSky, upFactor) * pc.envMapIntensity;

                vec3 ambientRad = vec3(throughput) * (vec3(diffuseColor) * skyHemisphere * 0.22);

                ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, ambientRad, seed), prev.a));
                if (pc.captureMlData != 0u) {
                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, ambientRad, seed), 0.0));
                }
            }
#endif

            // Indirect Bounce: Stochastic Lobe Selection (Dielectric Specular GGX vs Diffuse Cosine)
            if (!pathTerminated) {
                if (bounce + 1u >= pc.maxBounces || !enableIndirect) {
                    pathTerminated = true;
                } else if (pc.enableNrc == 1u && bounce >= pc.nrcBounce && roughness >= 0.05 && metallic < 0.9) {
                    bool isTrain = (randFloat(seed) < pc.nrcTrainRatio);
                    if (isTrain) {
                        uint trainIdx = atomicAdd(nrcCounters.trainCount, 1u);
                        if (trainIdx < pc.maxQueueCapacity) {
                            vec3 targetRad = vec3(secDirectL);
#if ENABLE_INLINE_SHADOWS
                            if (hasShadowRay && pc.useHardwareRT == 1u && length(targetRad) > 1e-4) {
                                vec3 sOrigin = shadowCandidate.originDist.xyz;
                                float sDist = shadowCandidate.originDist.w;
                                vec3 sDir = unpackOct32(shadowCandidate.dirPixelRad.x);
                                bool occluded = traceShadowRayInline(sOrigin, sDir, sDist,
                                                                     (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                if (occluded) {
                                    targetRad = vec3(0.0);
                                }
                            }
#endif
                            nrcTrainRecords[trainIdx].pos_roughness = vec4(hitPoint, roughness);
                            nrcTrainRecords[trainIdx].normal_flags = vec4(hitNormal, 1.0);
                            nrcTrainRecords[trainIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                            nrcTrainRecords[trainIdx].albedo_pad = vec4(vec3(diffuseColor), 0.0);
                            nrcTrainRecords[trainIdx].throughput = vec4(vec3(throughput), 0.0);
                            nrcTrainRecords[trainIdx].targetRadiance = vec4(targetRad, 0.0);
                        }
                    } else {
                        uint qIdx = atomicAdd(nrcCounters.queryCount, 1u);
                        if (qIdx < pc.maxQueueCapacity) {
                            nrcQueries[qIdx].pos_roughness = vec4(hitPoint, roughness);
                            nrcQueries[qIdx].normal_flags = vec4(hitNormal, 0.0);
                            nrcQueries[qIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                            nrcQueries[qIdx].albedo_pad = vec4(vec3(diffuseColor), 0.0);
                            nrcQueries[qIdx].throughput = vec4(vec3(throughput), 0.0);
                            pathTerminated = true;
                        } else {
                            // Queue capacity exceeded: do NOT drop ray silently (CRIT-04). Continue standard bounce.
                            pathTerminated = false;
                        }
                    }
                }

                if (!pathTerminated) {
                    float NdotV = clamp(dot(hitNormal, V), 0.0, 1.0);
                    f16vec3 Fview = fresnelSchlickVec(float16_t(NdotV), F0);
                    float specProb = mix(clamp(float(dot(Fview, f16vec3(0.3333))), 0.05, 0.95), 1.0, metallic);

                    nextDirection = vec3(0.0);
                    vec3 nextOrigin = hitPoint + hitNormal * EPSILON;
                    bool validBounce = false;

#if IS_SECONDARY_BOUNCE
                    if (metallic > 0.5) {
                        sampledSpecularLobe = true;
                        if (isDelta) {
                            nextDirection = reflect(-V, hitNormal);
                            nextOrigin = hitPoint + hitNormal * EPSILON;
                            throughput *= Fview;
                            validBounce = true;
                        } else {
                            vec3 H = sampleGGX(hitNormal, alphaRoughness, seed);
                            nextDirection = reflect(-V, H);
                            nextOrigin = hitPoint + hitNormal * EPSILON;
                            float NdotL = dot(hitNormal, nextDirection);
                            if (NdotL > 0.0) {
                                float VdotH = clamp(dot(V, H), 0.0, 1.0);
                                f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);
                                float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                                float scale = 4.0 * VdotH * Vis * NdotL;
                                throughput *= F * float16_t(scale);
                                validBounce = true;
                            }
                        }
                    } else {
                        // Secondary diffuse bounce: Pure Lambertian Cosine Hemisphere sampling (reflection or transmission)
                        uint clusterK = (pc.secondarySortMode == 3u) ? 8u : 4u;
                        uint frameRot = pc.frameIndex + pc.sppSampleIndex;
                        if (diffTrans > 0.001 && randFloat(seed) < diffTrans) {
                            nextDirection = (pc.secondarySortMode >= 2u)
                                ? sampleCosineHemisphereCoherent(-hitNormal, seed, clusterK, frameRot)
                                : sampleCosineHemisphere(-hitNormal, seed);
                            nextOrigin = hitPoint - hitNormal * EPSILON;
                        } else {
                            nextDirection = (pc.secondarySortMode >= 2u)
                                ? sampleCosineHemisphereCoherent(hitNormal, seed, clusterK, frameRot)
                                : sampleCosineHemisphere(hitNormal, seed);
                            nextOrigin = hitPoint + hitNormal * EPSILON;
                        }
                        throughput *= diffuseColor;
                        validBounce = true;
                    }
#else
                    if (isDelta) {
                        sampledSpecularLobe = true;
                        nextDirection = reflect(-V, hitNormal);
                        nextOrigin = hitPoint + hitNormal * EPSILON;
                        throughput *= Fview;
                        validBounce = true;
                    } else if (randFloat(seed) < specProb) {
                        // Specular GGX Lobe
                        sampledSpecularLobe = true;
                        vec3 H = sampleGGX(hitNormal, alphaRoughness, seed);
                        nextDirection = reflect(-V, H);
                        nextOrigin = hitPoint + hitNormal * EPSILON;
                        float NdotL = dot(hitNormal, nextDirection);
                        if (NdotL > 0.0) {
                            float VdotH = clamp(dot(V, H), 0.0, 1.0);
                            f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);
                            float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                            float scale = (4.0 * VdotH * Vis * NdotL) / specProb;
                            throughput *= F * float16_t(scale);
                            validBounce = true;
                        }
                    } else {
                        // Diffuse Cosine Lobe (reflection or transmission)
                        uint clusterK = (pc.secondarySortMode == 3u) ? 8u : 4u;
                        uint frameRot = pc.frameIndex + pc.sppSampleIndex;
                        bool isTrans = (diffTrans > 0.001 && randFloat(seed) < diffTrans);
                        if (isTrans) {
                            nextDirection = (pc.secondarySortMode >= 2u)
                                ? sampleCosineHemisphereCoherent(-hitNormal, seed, clusterK, frameRot)
                                : sampleCosineHemisphere(-hitNormal, seed);
                            nextOrigin = hitPoint - hitNormal * EPSILON;
                        } else {
                            nextDirection = (pc.secondarySortMode >= 2u)
                                ? sampleCosineHemisphereCoherent(hitNormal, seed, clusterK, frameRot)
                                : sampleCosineHemisphere(hitNormal, seed);
                            nextOrigin = hitPoint + hitNormal * EPSILON;
                        }
                        vec3 H = normalize(V + (isTrans ? -nextDirection : nextDirection));
                        float VdotH = clamp(dot(V, H), 0.0, 1.0);
                        f16vec3 F = fresnelSchlickVec(float16_t(VdotH), F0);
                        float invDiffProb = 1.0 / (1.0 - specProb);
                        throughput *= (f16vec3(1.0) - F) * (diffuseColor * float16_t(invDiffProb));
                        validBounce = true;
#if !IS_SECONDARY_BOUNCE
                        // ReSTIR GI context: diffuse cosine REFLECTION lobe only.
                        // Transmitted lobes carry a different BSDF branch and are
                        // excluded from GI reuse for now.
                        giCtxEligible = !isTrans;
#endif
                    }
#endif

                    if (!validBounce) {
                        pathTerminated = true;
                    } else {
                        float maxThresh = float(max(throughput.r, max(throughput.g, throughput.b))) * float(max(ubo.spp, 1u));
                        pathTerminated = applyRussianRoulette16(throughput, maxThresh, bounce, seed);

                        if (!pathTerminated) {
                            survivesToNext = true;
                            nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                            nextState = packRayState(throughput, seed, pixelIndex, isSpecularPath || sampledSpecularLobe, causticApplied, dispersionChannel);
#if !IS_SECONDARY_BOUNCE
                            if (giCtxEligible && bounce == 0u && (ubo.flags & (1u << 24)) != 0u) {
                                x1Contexts[pixelIndex] = makeX1Context(hitNormal, vec3(diffuseColor), V, dot(vec3(F0), vec3(0.3333333)));
                            }
#endif
                        }
                    }
                }
            }
            } // !isCutout
        }
    }

    // Standard single-queue linear compaction for ray geometry and state
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (waveActiveCount > 0u) {
        if (subgroupElect()) {
            waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);
    }

    uint targetIdx = waveGlobalOffset + laneSlot;
    if (survivesToNext) {
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    if (pc.secondarySortMode == 1u) {
        // Producer-Side Binning: Record compacted ray indices into 8 directional octant queues
        uint oct = survivesToNext ? getDirectionalOctant(nextDirection) : 0u;
        uvec4 activeBallot = subgroupBallot(survivesToNext);
        while (subgroupBallotBitCount(activeBallot) > 0u) {
            uint leaderLane = subgroupBallotFindLSB(activeBallot);
            uint k = subgroupBroadcast(oct, leaderLane);
            bool isOct = survivesToNext && (oct == k);
            uvec4 octBallot = subgroupBallot(isOct);
            uint octCount = subgroupBallotBitCount(octBallot);
            uint octSlot = subgroupBallotExclusiveBitCount(octBallot);
            uint octBase = 0u;
            if (gl_SubgroupInvocationID == leaderLane) {
                octBase = atomicAdd(queueCounters.octantCounts[k], octCount);
            }
            octBase = subgroupBroadcast(octBase, leaderLane);
            if (isOct) {
                uint dest = k * pc.maxQueueCapacity + (octBase + octSlot);
                if (octBase + octSlot < pc.maxQueueCapacity) {
                    secondaryIndices[dest] = targetIdx;
                }
            }
            activeBallot.x &= ~octBallot.x;
            activeBallot.y &= ~octBallot.y;
            activeBallot.z &= ~octBallot.z;
            activeBallot.w &= ~octBallot.w;
        }
    }

    // Subgroup Wave Ballot Compaction for Shadow Rays
    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (shadowWaveCount > 0u) {
        if (subgroupElect()) {
            shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
        }
        shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);
    }

    if (hasShadowRay) {
        uint targetIdxShadow = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdxShadow < pc.maxQueueCapacity) {
            shadowRays[targetIdxShadow] = shadowCandidate;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == queueCounters.totalShadeWorkgroups - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.commands[b * 16u + 6u].x = shadowGroups;
            indirect.commands[b * 16u + 6u].y = 1u;
            indirect.commands[b * 16u + 6u].z = 1u;
            indirect.commands[b * 16u + 6u].pad = shadowCount;

            dgcStream.commands[b * 16u + 6u].pipelineIndex = 3u; // Shadow pipeline
            dgcStream.commands[b * 16u + 6u].x = shadowGroups;
            dgcStream.commands[b * 16u + 6u].y = 1u;
            dgcStream.commands[b * 16u + 6u].z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            uint intersectGroups = (nextCount + 31u) / 32u;

            // Slot 7: Standard monolithic / Option 2 intersect dispatch
            indirect.commands[b * 16u + 7u].x = intersectGroups;
            indirect.commands[b * 16u + 7u].y = 1u;
            indirect.commands[b * 16u + 7u].z = 1u;
            indirect.commands[b * 16u + 7u].pad = nextCount;

            dgcStream.commands[b * 16u + 7u].pipelineIndex = 1u; // Intersect pipeline
            dgcStream.commands[b * 16u + 7u].x = intersectGroups;
            dgcStream.commands[b * 16u + 7u].y = 1u;
            dgcStream.commands[b * 16u + 7u].z = 1u;

            // Slots 8..15: Producer-Side Binning Directional DGC intersect dispatches
            uint totalIntersectWgs = 0u;
            uint totalOctantRays = 0u;
            if (pc.secondarySortMode == 1u) {
                for (uint k = 0u; k < 8u; ++k) {
                    uint octCnt = queueCounters.octantCounts[k];
                    queueCounters.currentOctantCounts[k] = octCnt;
                    uint octGroups = (octCnt + 31u) / 32u;
                    totalIntersectWgs += octGroups;
                    totalOctantRays += octCnt;

                    indirect.commands[b * 16u + 8u + k].x = octGroups;
                    indirect.commands[b * 16u + 8u + k].y = 1u;
                    indirect.commands[b * 16u + 8u + k].z = 1u;
                    indirect.commands[b * 16u + 8u + k].pad = octCnt;

                    dgcStream.commands[b * 16u + 8u + k].pipelineIndex = 1u;
                    dgcStream.commands[b * 16u + 8u + k].x = octGroups;
                    dgcStream.commands[b * 16u + 8u + k].y = 1u;
                    dgcStream.commands[b * 16u + 8u + k].z = 1u;

                    queueCounters.octantCounts[k] = 0u;
                }
            } else {
                totalIntersectWgs = intersectGroups;
                totalOctantRays = nextCount;
            }
            queueCounters.totalIntersectWorkgroups = totalIntersectWgs;
            queueCounters.secondaryRayCount = totalOctantRays;

            if (pc.secondarySortMode == 2u) {
                indirect.commands[b * 16u + 8u].x = intersectGroups;
                indirect.commands[b * 16u + 8u].y = 1u;
                indirect.commands[b * 16u + 8u].z = 1u;
                indirect.commands[b * 16u + 8u].pad = nextCount;
            }

            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces) ? totalOctantRays : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
