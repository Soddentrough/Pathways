#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_GOOGLE_include_directive : enable

#include "nrc_common.glsl"

layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

#define ML_CAPTURE_UPWAYS_V4_BIT 4u
#define ML_CAPTURE_SPLIT_4SIG_BIT 8u

// Quad-subgroup shared memory buffers for 4 independent Wave32 batches (64 queries total)
shared float16_t s_layer0[4 * 16 * 64]; // 8 KB: layer 0/2 activation staging
shared float16_t s_layer1[4 * 16 * 64]; // 8 KB: layer 1 activation staging
shared uint      s_uTileA[4 * 128];     // 2 KB: packed 16x16 FP16 WMMA A-tile scratch
shared uint      s_uTileB[4 * 128];     // 2 KB: packed 16x16 FP16 WMMA B-tile scratch
shared float     s_fAcc[4 * 16 * 16];   // 4 KB: FP32 WMMA accumulator staging
shared vec3 s_throughput[64];
shared uint s_pixelMeta[64]; // 0xFFFFFFFFu = invalid; bit 31 = isSpec, bits 0..30 = pixelIdx

layout(std430, set = 0, binding = 0) buffer AtomicAccumBuffer {
    uint nrcAtomicBuffer[];
};

layout(std430, set = 0, binding = 1) readonly buffer InQueryQueue {
    NRCQuery queries[];
};

layout(std430, set = 0, binding = 2) readonly buffer InWeights {
    float16_t weights[];
};

layout(std430, set = 0, binding = 3) readonly buffer InCounters {
    NRCCountersBuffer counters;
};

layout(std430, set = 0, binding = 4) readonly buffer InHashGrid {
    uint hashGrid[];
};

layout(set = 1, binding = 0) uniform image2D uAccumImage;
layout(set = 1, binding = 2, rgba16f) uniform image2D uMlDiffuseImage;
layout(set = 1, binding = 3, rgba16f) uniform image2D uMlSpecularImage;
layout(set = 1, binding = 4, rgba16f) uniform readonly image2D uMlAlbedoRoughnessImage;
layout(set = 1, binding = 5, rgba16f) uniform readonly image2D uMlSpecAlbedoImage;
layout(set = 1, binding = 6, rgba16f) uniform image2D uIndirectDiffuseImage;
layout(set = 1, binding = 7, rgba16f) uniform image2D uIndirectSpecularImage;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint queryCount;
    float maxRadiance;
    vec4 worldMin;
    vec4 invWorldExtent;
} pc;

vec3 demodulateMlSafe(vec3 rad, vec3 demodFactor) {
    bool valid = any(greaterThan(demodFactor, vec3(1e-4)));
    vec3 safeDenom = valid ? max(demodFactor, vec3(0.02)) : vec3(1.0);
    return min(rad / safeDenom, vec3(65000.0));
}

void main() {
    uint sg = gl_SubgroupID;
    uint tid = gl_SubgroupInvocationID;
    uint actualCount = min(pc.queryCount, counters.queryCount);
    if (gl_WorkGroupID.x * 64u >= actualCount) return;
    uint queryBase = (gl_WorkGroupID.x * 4u + sg) * 16u;
    if (queryBase >= actualCount) return;

    uint sgLayerOff = sg * 1024u;
    uint sgMetaOff = sg * 16u;

    // 1. Wave32 parallel multi-frequency encoding (2 lanes per query: 16 queries x 64 features per subgroup)
    //    Out-of-range trailing slots are zero-padded so subgroupBarrier() covers the whole subgroup cleanly.
    uint qSlot = tid >> 1u;
    uint halfLane = tid & 1u;
    uint metaSlot = sgMetaOff + qSlot;
    uint qIdx = queryBase + qSlot;
    uint rowBase = sgLayerOff + qSlot * 64u;

    if (qIdx < actualCount) {
        vec4 qPosRough = queries[qIdx].pos_roughness;
        vec4 qNormFlags = queries[qIdx].normal_flags;
        vec4 qDirPix = queries[qIdx].dir_pixelIndex;
        vec3 normPos = clamp((qPosRough.xyz - pc.worldMin.xyz) * pc.invWorldExtent.xyz, vec3(0.0), vec3(1.0));
        const float PI = 3.14159265359;

        float nLen = length(qNormFlags.xyz);
        vec3 N = (nLen > 1e-6) ? (qNormFlags.xyz / nLen) : vec3(0.0, 1.0, 0.0);
        float vLen = length(qDirPix.xyz);
        vec3 V = (vLen > 1e-6) ? (qDirPix.xyz / vLen) : vec3(0.0, 0.0, 1.0);

        // Channels 0..15: 8-level multi-resolution spatial hash grid (4-corner 3D simplex interpolation)
        for (uint lStep = 0u; lStep < 4u; ++lStep) {
            uint l = halfLane * 4u + lStep;
            ivec3 c0, d1, d2;
            vec4 w4;
            nrcSimplexCorners(normPos * NRC_ACTIVE_SCALES[l], c0, d1, d2, w4);
            vec2 feat = w4.x * unpackHalf2x16(hashGrid[nrcHashCorner(c0, l)])
                      + w4.y * unpackHalf2x16(hashGrid[nrcHashCorner(c0 + d1, l)])
                      + w4.z * unpackHalf2x16(hashGrid[nrcHashCorner(c0 + d2, l)])
                      + w4.w * unpackHalf2x16(hashGrid[nrcHashCorner(c0 + ivec3(1), l)]);
            s_layer0[rowBase + l * 2u + 0u] = float16_t(feat.x);
            s_layer0[rowBase + l * 2u + 1u] = float16_t(feat.y);
        }

        if (halfLane == 0u) {
            s_throughput[metaSlot] = queries[qIdx].throughput.xyz;
            uint pix = floatBitsToUint(qDirPix.w);
            bool isSpec = (qNormFlags.w > 0.5);
            s_pixelMeta[metaSlot] = (pix < pc.width * pc.height) ? (pix | (isSpec ? 0x80000000u : 0u)) : 0xFFFFFFFFu;

            // Channels 16..23: Linear identity coordinate & direction skip-encoding
            s_layer0[rowBase + 16u] = float16_t(normPos.x);
            s_layer0[rowBase + 17u] = float16_t(normPos.y);
            s_layer0[rowBase + 18u] = float16_t(normPos.z);
            s_layer0[rowBase + 19u] = float16_t(N.x);
            s_layer0[rowBase + 20u] = float16_t(N.y);
            s_layer0[rowBase + 21u] = float16_t(N.z);
            s_layer0[rowBase + 22u] = float16_t(V.x);
            s_layer0[rowBase + 23u] = float16_t(V.y);

            // Channels 24..35: Coarse Fourier frequency encoding axes 0..1 (balanced SFU sin/cos)
            for (uint axis = 0u; axis < 2u; ++axis) {
                float th = normPos[axis] * PI;
                float s = sin(th);
                float c = cos(th);
                float amp = 1.0;
                uint axisBase = rowBase + 24u + axis * 6u;
                for (uint o = 0u; o < 3u; ++o) {
                    s_layer0[axisBase + o * 2u + 0u] = float16_t(s * amp);
                    s_layer0[axisBase + o * 2u + 1u] = float16_t(c * amp);
                    if (o < 2u) {
                        float s2 = 2.0 * s * c;
                        float c2 = c * c - s * s;
                        s = s2;
                        c = c2;
                        amp *= 0.5;
                    }
                }
            }
        } else {
            // Channels 36..41: Coarse Fourier frequency encoding axis 2
            {
                float th = normPos[2u] * PI;
                float s = sin(th);
                float c = cos(th);
                float amp = 1.0;
                uint axisBase = rowBase + 36u;
                for (uint o = 0u; o < 3u; ++o) {
                    s_layer0[axisBase + o * 2u + 0u] = float16_t(s * amp);
                    s_layer0[axisBase + o * 2u + 1u] = float16_t(c * amp);
                    if (o < 2u) {
                        float s2 = 2.0 * s * c;
                        float c2 = c * c - s * s;
                        s = s2;
                        c = c2;
                        amp *= 0.5;
                    }
                }
            }

            vec3 R = reflect(-V, N);
            float ndotv = clamp(dot(N, V), 0.0, 1.0);
            float rough = clamp(qPosRough.w, 0.04, 1.0);
            float specRatio = clamp(queries[qIdx].albedo_pad.x, 0.0, 1.0);

            // Channels 42..50: Order-2 real Spherical Harmonics of surface normal
            s_layer0[rowBase + 42u] = float16_t(0.282095);
            s_layer0[rowBase + 43u] = float16_t(0.488603 * N.y);
            s_layer0[rowBase + 44u] = float16_t(0.488603 * N.z);
            s_layer0[rowBase + 45u] = float16_t(0.488603 * N.x);
            s_layer0[rowBase + 46u] = float16_t(1.092548 * N.x * N.y);
            s_layer0[rowBase + 47u] = float16_t(1.092548 * N.y * N.z);
            s_layer0[rowBase + 48u] = float16_t(0.315392 * (3.0 * N.z * N.z - 1.0));
            s_layer0[rowBase + 49u] = float16_t(1.092548 * N.x * N.z);
            s_layer0[rowBase + 50u] = float16_t(0.546274 * (N.x * N.x - N.y * N.y));

            // Channels 51..63: View, Reflection, NdotV, Roughness, Specular Ratio, Fresnel, Bias
            float omc = 1.0 - ndotv;
            float omc2 = omc * omc;
            s_layer0[rowBase + 51u] = float16_t(V.x);
            s_layer0[rowBase + 52u] = float16_t(V.y);
            s_layer0[rowBase + 53u] = float16_t(V.z);
            s_layer0[rowBase + 54u] = float16_t(R.x);
            s_layer0[rowBase + 55u] = float16_t(R.y);
            s_layer0[rowBase + 56u] = float16_t(R.z);
            s_layer0[rowBase + 57u] = float16_t(ndotv);
            s_layer0[rowBase + 58u] = float16_t(rough);
            s_layer0[rowBase + 59u] = float16_t(rough * rough);
            s_layer0[rowBase + 60u] = float16_t(specRatio);
            s_layer0[rowBase + 61u] = float16_t(1.0 - specRatio);
            s_layer0[rowBase + 62u] = float16_t(omc2 * omc2 * omc);
            s_layer0[rowBase + 63u] = float16_t(1.0);
        }
    } else {
        if (halfLane == 0u) {
            s_pixelMeta[metaSlot] = 0xFFFFFFFFu;
        }
        uint colStart = halfLane * 32u;
        for (uint c = 0u; c < 32u; ++c) {
            s_layer0[rowBase + colStart + c] = float16_t(0.0);
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    uint sgUTileOff  = sg * 128u;
    uint sgAccOff    = sg * 256u;
    // Workaround for AMD LLPC 26.11.1 dropping OpConstantComposite zero-init on f32 WMMA accumulators.
    float zAcc = float(pc.width == 0xFFFFFFFFu);

    // ==========================================
    // 3. LAYER 0: 64 -> 64 WMMA (packed 16x16 uint tiles + FP32 accumulator)
    // ==========================================
    for (uint col = 0u; col < 4u; ++col) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c0 =
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(zAcc);

        for (uint k = 0u; k < 4u; ++k) {
            uint wOff = NRC_W0_OFFSET + (k * 16u * 64u) + (col * 16u);
            for (uint e = 0u; e < 4u; ++e) {
                uint uIdx = tid * 4u + e;
                uint r = uIdx >> 3u;
                uint c2 = (uIdx & 7u) * 2u;
                s_uTileA[sgUTileOff + uIdx] = packHalf2x16(vec2(
                    float(s_layer0[sgLayerOff + r * 64u + k * 16u + c2]),
                    float(s_layer0[sgLayerOff + r * 64u + k * 16u + c2 + 1u])));
                s_uTileB[sgUTileOff + uIdx] = packHalf2x16(vec2(
                    float(weights[wOff + r * 64u + c2]),
                    float(weights[wOff + r * 64u + c2 + 1u])));
            }
            subgroupMemoryBarrierShared();
            subgroupBarrier();

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> aTile;
            coopMatLoad(aTile, s_uTileA, sgUTileOff, 8u, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bTile;
            coopMatLoad(bTile, s_uTileB, sgUTileOff, 8u, gl_CooperativeMatrixLayoutRowMajor);
            c0 = coopMatMulAdd(aTile, bTile, c0);
            subgroupBarrier();
        }

        coopMatStore(c0, s_fAcc, sgAccOff, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        for (uint e = 0u; e < 8u; ++e) {
            uint idx = tid * 8u + e;
            uint r = idx >> 4u;
            uint c = idx & 15u;
            float v = s_fAcc[sgAccOff + idx] + float(weights[NRC_B0_OFFSET + col * 16u + c]);
            s_layer1[sgLayerOff + r * 64u + col * 16u + c] = float16_t((v > 0.0) ? v : (0.01 * v));
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();
    }

    // ==========================================
    // 4. LAYER 1: 64 -> 64 WMMA
    // ==========================================
    for (uint col = 0u; col < 4u; ++col) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c1 =
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(zAcc);

        for (uint k = 0u; k < 4u; ++k) {
            uint wOff = NRC_W1_OFFSET + (k * 16u * 64u) + (col * 16u);
            for (uint e = 0u; e < 4u; ++e) {
                uint uIdx = tid * 4u + e;
                uint r = uIdx >> 3u;
                uint c2 = (uIdx & 7u) * 2u;
                s_uTileA[sgUTileOff + uIdx] = packHalf2x16(vec2(
                    float(s_layer1[sgLayerOff + r * 64u + k * 16u + c2]),
                    float(s_layer1[sgLayerOff + r * 64u + k * 16u + c2 + 1u])));
                s_uTileB[sgUTileOff + uIdx] = packHalf2x16(vec2(
                    float(weights[wOff + r * 64u + c2]),
                    float(weights[wOff + r * 64u + c2 + 1u])));
            }
            subgroupMemoryBarrierShared();
            subgroupBarrier();

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> aTile;
            coopMatLoad(aTile, s_uTileA, sgUTileOff, 8u, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bTile;
            coopMatLoad(bTile, s_uTileB, sgUTileOff, 8u, gl_CooperativeMatrixLayoutRowMajor);
            c1 = coopMatMulAdd(aTile, bTile, c1);
            subgroupBarrier();
        }

        coopMatStore(c1, s_fAcc, sgAccOff, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        for (uint e = 0u; e < 8u; ++e) {
            uint idx = tid * 8u + e;
            uint r = idx >> 4u;
            uint c = idx & 15u;
            float v = s_fAcc[sgAccOff + idx] + float(weights[NRC_B1_OFFSET + col * 16u + c]);
            s_layer0[sgLayerOff + r * 64u + col * 16u + c] = float16_t((v > 0.0) ? v : (0.01 * v));
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();
    }

    // ==========================================
    // 5. LAYER 2: 64 -> 16 WMMA (Output layer in-place s_layer0)
    // ==========================================
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c2 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(zAcc);

    for (uint k = 0u; k < 4u; ++k) {
        uint wOff = NRC_W2_OFFSET + (k * 16u * 16u);
        for (uint e = 0u; e < 4u; ++e) {
            uint uIdx = tid * 4u + e;
            uint r = uIdx >> 3u;
            uint c2_col = (uIdx & 7u) * 2u;
            s_uTileA[sgUTileOff + uIdx] = packHalf2x16(vec2(
                float(s_layer0[sgLayerOff + r * 64u + k * 16u + c2_col]),
                float(s_layer0[sgLayerOff + r * 64u + k * 16u + c2_col + 1u])));
            s_uTileB[sgUTileOff + uIdx] = packHalf2x16(vec2(
                float(weights[wOff + uIdx * 2u]),
                float(weights[wOff + uIdx * 2u + 1u])));
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> aTile;
        coopMatLoad(aTile, s_uTileA, sgUTileOff, 8u, gl_CooperativeMatrixLayoutRowMajor);

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bTile;
        coopMatLoad(bTile, s_uTileB, sgUTileOff, 8u, gl_CooperativeMatrixLayoutRowMajor);

        c2 = coopMatMulAdd(aTile, bTile, c2);
        subgroupBarrier();
    }
    subgroupBarrier();

    coopMatStore(c2, s_fAcc, sgAccOff, 16u, gl_CooperativeMatrixLayoutRowMajor);
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    // 6. Direct image resolve (1-SPP unique-pixel fast path) or Q16.16 atomic accumulation fallback
    if (tid < 16u) {
        uint slot = sgMetaOff + tid;
        uint meta = s_pixelMeta[slot];
        if (meta != 0xFFFFFFFFu) {
            uint pixelIdx = meta & 0x7FFFFFFFu;
            bool isSpec = (meta & 0x80000000u) != 0u;
            uint outRow = sgAccOff + tid * 16u;
            vec3 rawPred = vec3(
                s_fAcc[outRow + 0u] + float(weights[NRC_B2_OFFSET + 0u]),
                s_fAcc[outRow + 1u] + float(weights[NRC_B2_OFFSET + 1u]),
                s_fAcc[outRow + 2u] + float(weights[NRC_B2_OFFSET + 2u])
            );
            if (isnan(rawPred.x) || isinf(rawPred.x)) rawPred.x = 0.0;
            if (isnan(rawPred.y) || isinf(rawPred.y)) rawPred.y = 0.0;
            if (isnan(rawPred.z) || isinf(rawPred.z)) rawPred.z = 0.0;
            float maxRad = (pc.maxRadiance > 0.0) ? pc.maxRadiance : 10.0;
            vec3 predRadiance = nrcClampChromaticity(rawPred, maxRad);
            vec3 radiance = nrcClampChromaticity(s_throughput[slot] * predRadiance, maxRad);

            if (isnan(radiance.x) || isinf(radiance.x)) radiance.x = 0.0;
            if (isnan(radiance.y) || isinf(radiance.y)) radiance.y = 0.0;
            if (isnan(radiance.z) || isinf(radiance.z)) radiance.z = 0.0;

            uint resolveFlags = floatBitsToUint(pc.invWorldExtent.w);
            if ((resolveFlags & 0x80000000u) != 0u) {
                vec3 radPos = max(radiance, vec3(0.0));
                if (dot(radPos, vec3(1.0)) > 0.0) {
                    ivec2 pixelCoord = ivec2(int(pixelIdx % pc.width), int(pixelIdx / pc.width));
                    uint capMl = resolveFlags & 0xFFu;
                    if (capMl == 0u) {
                        vec4 prev = imageLoad(uAccumImage, pixelCoord);
                        imageStore(uAccumImage, pixelCoord, vec4(prev.rgb + radPos, prev.a));
                    } else {
                        if ((capMl & 1u) == 0u || (capMl & 2u) != 0u) {
                            vec4 prev = imageLoad(uAccumImage, pixelCoord);
                            imageStore(uAccumImage, pixelCoord, vec4(prev.rgb + radPos, prev.a));
                        }
                        bool isV4 = (capMl & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                        bool isSplit4 = (capMl & ML_CAPTURE_SPLIT_4SIG_BIT) != 0u;
                        if ((capMl & 1u) != 0u && (isV4 || !isSplit4)) {
                            if (!isSpec) {
                                vec3 contribDiff = isV4
                                    ? demodulateMlSafe(radPos, imageLoad(uMlAlbedoRoughnessImage, pixelCoord).rgb)
                                    : radPos;
                                vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                imageStore(uMlDiffuseImage, pixelCoord, vec4(prevDiff.rgb + contribDiff, prevDiff.a));
                            } else {
                                vec3 contribSpec = isV4
                                    ? demodulateMlSafe(radPos, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb)
                                    : radPos;
                                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                imageStore(uMlSpecularImage, pixelCoord, vec4(prevSpec.rgb + contribSpec, prevSpec.a));
                            }
                        }
                        if (isSplit4) {
                            if (!isSpec) {
                                vec4 prevIndDiff = imageLoad(uIndirectDiffuseImage, pixelCoord);
                                imageStore(uIndirectDiffuseImage, pixelCoord, vec4(prevIndDiff.rgb + radPos, prevIndDiff.a));
                            } else {
                                vec4 prevIndSpec = imageLoad(uIndirectSpecularImage, pixelCoord);
                                imageStore(uIndirectSpecularImage, pixelCoord, vec4(prevIndSpec.rgb + radPos, prevIndSpec.a));
                            }
                        }
                    }
                }
            } else {
                bool splitSpec = (pc.worldMin.w > 0.5);
                uint base = splitSpec ? (pixelIdx * 6u + (isSpec ? 3u : 0u)) : (pixelIdx * 3u);
                // Q16.16 fixed-point scaling (65536.0)
                uvec3 fixedRad = uvec3(clamp(radiance, vec3(0.0), vec3(65535.0)) * 65536.0 + 0.5);
                if (fixedRad.x > 0u) atomicAdd(nrcAtomicBuffer[base + 0u], fixedRad.x);
                if (fixedRad.y > 0u) atomicAdd(nrcAtomicBuffer[base + 1u], fixedRad.y);
                if (fixedRad.z > 0u) atomicAdd(nrcAtomicBuffer[base + 2u], fixedRad.z);
            }
        }
    }
}
