#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : enable

#include "nrc_common.glsl"

layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

// Quad-subgroup shared memory buffers for 4 independent Wave32 batches (64 queries total)
shared float16_t s_layer0[4 * 16 * 64];
shared float16_t s_layer1[4 * 16 * 64];
shared float16_t s_output[4 * 16 * 16];

shared vec3 s_throughput[64];
shared uint s_pixelIndex[64];
shared bool s_valid[64];
shared bool s_isSpec[64];

layout(std430, set = 0, binding = 0) buffer AtomicAccumBuffer {
    uint nrcAtomicBuffer[];
};

layout(std430, set = 0, binding = 1) readonly buffer InQueryQueue {
    NRCQuery queries[];
};

layout(std430, set = 0, binding = 2) readonly buffer InWeights {
    float16_t weights[];
};

layout(std430, set = 0, binding = 3) readonly buffer InCounters {
    NRCCountersBuffer counters;
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint queryCount;
    float maxRadiance;
    vec4 worldMin;
    vec4 invWorldExtent;
} pc;


void main() {
    uint sg = gl_SubgroupID;
    uint tid = gl_SubgroupInvocationID;
    uint actualCount = min(pc.queryCount, counters.queryCount);
    if (gl_WorkGroupID.x * 64u >= actualCount) return;
    uint queryBase = (gl_WorkGroupID.x * 4u + sg) * 16u;
    if (queryBase >= actualCount) return;

    uint sgLayerOff = sg * 1024u;
    uint sgOutOff = sg * 256u;
    uint sgMetaOff = sg * 16u;

    // 1. Wave32 parallel multi-frequency encoding (2 lanes per query: 16 queries x 64 features per subgroup)
    //    Out-of-range trailing slots are zero-padded so workgroup-uniform barrier() covers all 4 subgroups.
    uint qSlot = tid >> 1u;
    uint halfLane = tid & 1u;
    uint metaSlot = sgMetaOff + qSlot;
    uint qIdx = queryBase + qSlot;
    uint rowBase = sgLayerOff + qSlot * 64u;

    if (qIdx < actualCount) {
        NRCQuery q = queries[qIdx];
        vec3 normPos = clamp((q.pos_roughness.xyz - pc.worldMin.xyz) * pc.invWorldExtent.xyz, vec3(0.0), vec3(1.0));
        const float PI = 3.14159265359;

        if (halfLane == 0u) {
            s_throughput[metaSlot] = q.throughput.xyz;
            s_pixelIndex[metaSlot] = floatBitsToUint(q.dir_pixelIndex.w);
            s_isSpec[metaSlot] = (q.normal_flags.w > 0.5);
            s_valid[metaSlot] = true;

            // 28 features (channels 0..27): axes X & Y x 7 octaves via double-angle recurrence
            for (uint axis = 0u; axis < 2u; ++axis) {
                float th = normPos[axis] * PI;
                float s = sin(th);
                float c = cos(th);
                float amp = 1.0;
                uint axisBase = rowBase + axis * 14u;
                for (uint l = 0u; l < 7u; ++l) {
                    s_layer0[axisBase + l * 2u + 0u] = float16_t(s * amp);
                    s_layer0[axisBase + l * 2u + 1u] = float16_t(c * amp);
                    if (l < 6u) {
                        float s2 = 2.0 * s * c;
                        float c2 = c * c - s * s;
                        s = s2;
                        c = c2;
                        amp *= 0.75;
                    }
                }
            }

            // Normal (channels 54..56), View Direction (57..59), Roughness (60), Reflectance (61..63)
            s_layer0[rowBase + 54u] = float16_t(q.normal_flags.x);
            s_layer0[rowBase + 55u] = float16_t(q.normal_flags.y);
            s_layer0[rowBase + 56u] = float16_t(q.normal_flags.z);
            s_layer0[rowBase + 57u] = float16_t(q.dir_pixelIndex.x);
            s_layer0[rowBase + 58u] = float16_t(q.dir_pixelIndex.y);
            s_layer0[rowBase + 59u] = float16_t(q.dir_pixelIndex.z);
            s_layer0[rowBase + 60u] = float16_t(q.pos_roughness.w);
            s_layer0[rowBase + 61u] = float16_t(q.albedo_pad.x);
            s_layer0[rowBase + 62u] = float16_t(q.albedo_pad.y);
            s_layer0[rowBase + 63u] = float16_t(q.albedo_pad.z);
        } else {
            // 14 features (channels 28..41): axis Z x 7 octaves via double-angle recurrence
            float th = normPos.z * PI;
            float s = sin(th);
            float c = cos(th);
            float amp = 1.0;
            uint axisBase = rowBase + 28u;
            for (uint l = 0u; l < 7u; ++l) {
                s_layer0[axisBase + l * 2u + 0u] = float16_t(s * amp);
                s_layer0[axisBase + l * 2u + 1u] = float16_t(c * amp);
                if (l < 6u) {
                    float s2 = 2.0 * s * c;
                    float c2 = c * c - s * s;
                    s = s2;
                    c = c2;
                    amp *= 0.75;
                }
            }

            // 12 features (channels 42..53): 6 3D cross-axis diagonals x 2 (sin/cos)
            float diagCoords[6] = float[6](
                0.5 * (normPos.x + normPos.y),
                0.5 * (normPos.y + normPos.z),
                0.5 * (normPos.z + normPos.x),
                0.5 * (normPos.x - normPos.y) + 0.5,
                0.5 * (normPos.y - normPos.z) + 0.5,
                0.5 * (normPos.z - normPos.x) + 0.5
            );
            for (uint d = 0u; d < 6u; ++d) {
                float ang = diagCoords[d] * (6.0 * PI);
                s_layer0[rowBase + 42u + d * 2u + 0u] = float16_t(sin(ang) * 0.5);
                s_layer0[rowBase + 42u + d * 2u + 1u] = float16_t(cos(ang) * 0.5);
            }
        }
    } else {
        if (halfLane == 0u) {
            s_valid[metaSlot] = false;
            s_isSpec[metaSlot] = false;
        }
        uint colStart = halfLane * 32u;
        for (uint c = 0u; c < 32u; ++c) {
            s_layer0[rowBase + colStart + c] = float16_t(0.0);
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    // ==========================================
    // 3. LAYER 0: 64 -> 64 WMMA
    // ==========================================
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> aTiles0[4];
    for (uint k = 0u; k < 4u; ++k) {
        coopMatLoad(aTiles0[k], s_layer0, sgLayerOff + k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);
    }
    for (uint col = 0u; col < 4u; ++col) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c0;
        c0 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));

        for (uint k = 0u; k < 4u; ++k) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bTile;
            uint wOff = NRC_W0_OFFSET + (k * 16u * 64u) + (col * 16u);
            coopMatLoad(bTile, weights, wOff, 64u, gl_CooperativeMatrixLayoutRowMajor);
            c0 = coopMatMulAdd(aTiles0[k], bTile, c0);
        }

        coopMatStore(c0, s_layer1, sgLayerOff + col * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    {
        float16_t b0_lo = weights[NRC_B0_OFFSET + tid];
        float16_t b0_hi = weights[NRC_B0_OFFSET + tid + 32u];
        for (uint r = 0u; r < 16u; ++r) {
            uint rowOff = sgLayerOff + r * 64u;
            float16_t v0 = s_layer1[rowOff + tid] + b0_lo;
            s_layer1[rowOff + tid] = (v0 > float16_t(0.0)) ? v0 : (float16_t(0.01) * v0);
            float16_t v1 = s_layer1[rowOff + tid + 32u] + b0_hi;
            s_layer1[rowOff + tid + 32u] = (v1 > float16_t(0.0)) ? v1 : (float16_t(0.01) * v1);
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    // ==========================================
    // 4. LAYER 1: 64 -> 64 WMMA
    // ==========================================
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> aTiles1[4];
    for (uint k = 0u; k < 4u; ++k) {
        coopMatLoad(aTiles1[k], s_layer1, sgLayerOff + k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);
    }
    for (uint col = 0u; col < 4u; ++col) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c1;
        c1 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));

        for (uint k = 0u; k < 4u; ++k) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bTile;
            uint wOff = NRC_W1_OFFSET + (k * 16u * 64u) + (col * 16u);
            coopMatLoad(bTile, weights, wOff, 64u, gl_CooperativeMatrixLayoutRowMajor);
            c1 = coopMatMulAdd(aTiles1[k], bTile, c1);
        }

        coopMatStore(c1, s_layer0, sgLayerOff + col * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    {
        float16_t b1_lo = weights[NRC_B1_OFFSET + tid];
        float16_t b1_hi = weights[NRC_B1_OFFSET + tid + 32u];
        for (uint r = 0u; r < 16u; ++r) {
            uint rowOff = sgLayerOff + r * 64u;
            float16_t v0 = s_layer0[rowOff + tid] + b1_lo;
            s_layer0[rowOff + tid] = (v0 > float16_t(0.0)) ? v0 : (float16_t(0.01) * v0);
            float16_t v1 = s_layer0[rowOff + tid + 32u] + b1_hi;
            s_layer0[rowOff + tid + 32u] = (v1 > float16_t(0.0)) ? v1 : (float16_t(0.01) * v1);
        }
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    // ==========================================
    // 5. LAYER 2: 64 -> 16 WMMA (Output layer)
    // ==========================================
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c2;
    c2 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));

    for (uint k = 0u; k < 4u; ++k) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> aTile;
        coopMatLoad(aTile, s_layer0, sgLayerOff + k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> bTile;
        uint wOff = NRC_W2_OFFSET + (k * 16u * 16u);
        coopMatLoad(bTile, weights, wOff, 16u, gl_CooperativeMatrixLayoutRowMajor);

        c2 = coopMatMulAdd(aTile, bTile, c2);
    }

    // Store linear output to s_output
    coopMatStore(c2, s_output, sgOutOff, 16u, gl_CooperativeMatrixLayoutRowMajor);
    subgroupMemoryBarrierShared();
    subgroupBarrier();

    // 6. Write final predicted radiance to 32-bit fixed-point atomic buffer (CRIT-05)
    if (tid < 16u) {
        uint slot = sgMetaOff + tid;
        if (s_valid[slot]) {
            uint outRow = sgOutOff + tid * 16u;
            vec3 rawPred = vec3(
                float(s_output[outRow + 0u] + weights[NRC_B2_OFFSET + 0u]),
                float(s_output[outRow + 1u] + weights[NRC_B2_OFFSET + 1u]),
                float(s_output[outRow + 2u] + weights[NRC_B2_OFFSET + 2u])
            );
            if (isnan(rawPred.x) || isinf(rawPred.x)) rawPred.x = 0.0;
            if (isnan(rawPred.y) || isinf(rawPred.y)) rawPred.y = 0.0;
            if (isnan(rawPred.z) || isinf(rawPred.z)) rawPred.z = 0.0;
            float maxRad = (pc.maxRadiance > 0.0) ? pc.maxRadiance : 10.0;
            vec3 predRadiance = clamp(rawPred, vec3(0.0), vec3(maxRad));
            vec3 radiance = clamp(s_throughput[slot] * predRadiance, vec3(0.0), vec3(maxRad));

            if (isnan(radiance.x) || isinf(radiance.x)) radiance.x = 0.0;
            if (isnan(radiance.y) || isinf(radiance.y)) radiance.y = 0.0;
            if (isnan(radiance.z) || isinf(radiance.z)) radiance.z = 0.0;

            uint pixelIdx = s_pixelIndex[slot];
            if (pixelIdx < pc.width * pc.height) {
                uint base = pixelIdx * 6u + (s_isSpec[slot] ? 3u : 0u);
                // Q16.16 fixed-point scaling (65536.0)
                uvec3 fixedRad = uvec3(clamp(radiance, vec3(0.0), vec3(65535.0)) * 65536.0 + 0.5);
                if (fixedRad.x > 0u) atomicAdd(nrcAtomicBuffer[base + 0u], fixedRad.x);
                if (fixedRad.y > 0u) atomicAdd(nrcAtomicBuffer[base + 1u], fixedRad.y);
                if (fixedRad.z > 0u) atomicAdd(nrcAtomicBuffer[base + 2u], fixedRad.z);
            }
        }
    }
}
