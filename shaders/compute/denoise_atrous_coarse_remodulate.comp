#version 460

// =============================================================================
// PASS 5: Coarse Wavelet Iteration 4 (s = 8, accumulated radius 30,
//         accumulated diameter 61, covering Fu et al. k = 33)
//         & FUSED ALBEDO REMODULATION
// Reference: docs/design/adaptive_svgf_denoiser_proposal.md Section 4.2 / Pass 5
// =============================================================================

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_vote : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly uniform image2D uInDiffuse;    // from m_pingPongDiffuse[0]
layout(set = 0, binding = 1, rgba16f) readonly uniform image2D uInSpecular;   // from m_pingPongSpecular[0]
layout(set = 0, binding = 2, rgba16f) readonly uniform image2D uNormalDepth;
layout(set = 0, binding = 3, rgba16f) readonly uniform image2D uAlbedoRoughness;
layout(set = 0, binding = 4, rg8) readonly uniform image2D uEdgeDensity;  // G: rho_effective
layout(set = 0, binding = 5, rgba16f) writeonly uniform image2D uFinalDenoised; // -> m_denoisedImage

#ifdef ENABLE_STATIONARY_PREVIEW
layout(set = 0, binding = 6, rgba16f) readonly uniform image2D uMotionVectors;
layout(set = 0, binding = 7, rgba16f) readonly uniform image2D uAccumImage;
#endif

#include "denoise_atrous_common.glsl"

layout(push_constant) uniform AtrousCoarseRemodulatePushConstants {
    uint  width;
    uint  height;
    int   stepSize;              // 8
    float phiNormal;             // 32.0
    float phiPlaneDepth;         // 2.00
    float phiLuminance;          // 4.00
    float tanHalfFovY;
    float aspectRatio;
    float edgeThresholdLow;      // 0.35 (ramp top)
    uint  accumulatedSamples;    // Used only if ENABLE_STATIONARY_PREVIEW
    float padding[2];
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    ivec2 imgMax = ivec2(int(pc.width) - 1, int(pc.height) - 1);

    float effectiveRho = imageLoad(uEdgeDensity, coord).g;
    vec4 nd = imageLoad(uNormalDepth, coord);
    vec4 albRough = imageLoad(uAlbedoRoughness, coord);
    vec3 modulate = denoiseDemodulationFactor(albRough.rgb, nd.w);
    vec3 specModulate = vec3(1.0);

    vec4 inDiffuse = imageLoad(uInDiffuse, coord);
    bool hasSpec = (inDiffuse.a < 0.0);
    inDiffuse.a = abs(inDiffuse.a);
    vec4 inSpecular = hasSpec ? imageLoad(uInSpecular, coord) : vec4(0.0);

    // Wavefront uniform voting: moderate curvature or already-converged waves bypass the coarse
    // s = 8 taps and evaluate remodulation directly from converged radiance
    bool bypassCoarseTaps = subgroupAll(effectiveRho >= pc.edgeThresholdLow || (inDiffuse.a < 1e-4 && (!hasSpec || inSpecular.a < 1e-4)));
    if (bypassCoarseTaps) {
        vec3 L_remod = inDiffuse.rgb * modulate + inSpecular.rgb * specModulate;
        L_remod = clamp(L_remod, 0.0, 65000.0);
        imageStore(uFinalDenoised, coord, vec4(L_remod, 1.0));
        return;
    }

    // Coarse dilated convolution (s = 8) for smooth / flat regions
    vec3 centerPos = unprojectToView(coord, nd.w, pc.tanHalfFovY, pc.aspectRatio, vec2(pc.width, pc.height));

    float centerLumD = denoiseLuminance(inDiffuse.rgb);
    vec4 filteredDiffuse = atrousFilterDiffuse(
        coord, pc.stepSize, inDiffuse,
        nd.xyz, centerPos, centerLumD, max(inDiffuse.a, 1e-4),
        pc.phiNormal, pc.phiPlaneDepth, pc.phiLuminance,
        pc.tanHalfFovY, pc.aspectRatio, imgMax);

    vec4 filteredSpecular = inSpecular;
    if (hasSpec) {
        float centerLumS = denoiseLuminance(inSpecular.rgb);
        filteredSpecular = atrousFilterSpecular(
            coord, pc.stepSize, inSpecular,
            nd.xyz, centerPos, centerLumS, max(inSpecular.a, 1e-4),
            albRough.a, pc.phiNormal, pc.phiPlaneDepth, pc.phiLuminance,
            pc.tanHalfFovY, pc.aspectRatio, imgMax);
    }

    // Continuous smoothstep blend across [0.25, 0.35] prevents spatial boundary seams
    float edgeBlend = smoothstep(0.25, pc.edgeThresholdLow, effectiveRho);
    vec3 finalDiffuse  = mix(filteredDiffuse.rgb,  inDiffuse.rgb,  edgeBlend);
    vec3 finalSpecular = mix(filteredSpecular.rgb, inSpecular.rgb, edgeBlend);

    // Fused albedo remodulation + specular addition
    vec3 L_remod = finalDiffuse * modulate + finalSpecular * specModulate;

#ifdef ENABLE_STATIONARY_PREVIEW
    if (pc.accumulatedSamples >= 16u) {
        vec2 mv = imageLoad(uMotionVectors, coord).xy * vec2(pc.width, pc.height);
        if (dot(mv, mv) < 1e-4) {
            float w = clamp((float(pc.accumulatedSamples) - 16.0) / 48.0, 0.0, 1.0);
            vec3 groundTruth = imageLoad(uAccumImage, coord).rgb / float(max(pc.accumulatedSamples, 1u));
            L_remod = mix(L_remod, groundTruth, w);
        }
    }
#endif

    L_remod = clamp(L_remod, 0.0, 65000.0);
    imageStore(uFinalDenoised, coord, vec4(L_remod, 1.0));
}
