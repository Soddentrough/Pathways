#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

#include "wavefront_common.glsl"
#include "wavefront_radiance_output.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 26, rgba16f) uniform readonly image2D uMlAlbedoRoughnessImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 41, rgba16f) uniform readonly image2D uMlSpecAlbedoImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
DECLARE_SCENE_TEXTURES_BINDING(8)

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

rayQueryEXT g_rq;
#define USE_GLOBAL_RAY_QUERY 1
#define ENABLE_INLINE_SHADOWS 1
#include "wavefront_shadow_inline.glsl"
#include "mis_common.glsl"
#include "bsdf_standard.glsl"
#define SHADING_CORE_SKIP_SCENE_HIT
#define SHADING_CORE_ENABLE_NEE
#include "shading_core.glsl"

layout(push_constant) uniform PushConstants {
    WavefrontTailPC pc;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= queueCounters.activeRayCount || idx >= pc.maxQueueCapacity) {
        return;
    }

    RayGeometry geom = inGeoms[idx];
    RayState state = inStates[idx];

    vec3 rayOrigin = geom.originPackedDir.xyz;
    vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));

    f16vec3 throughputHalf;
    uint seed, pixelIndex;
    bool isSpecularPath, causticApplied;
    uint dispersionChannel = 0u;
    unpackRayState(state, throughputHalf, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
    uint inPdfCode = unpackRayPdfCode(state);
    f16vec3 throughput = throughputHalf;

    vec3 accumRadiance = vec3(0.0);
    f16vec3 accumMlDiffuse = f16vec3(0.0);
    f16vec3 accumMlSpecular = f16vec3(0.0);
    bool hasAlphaMask = (ubo.flags & (1u << 10)) != 0u;

    for (uint bounce = pc.currentBounce; bounce < pc.maxBounces; ++bounce) {
        float closestT = (pc.maxRayDistance > 0.0) ? pc.maxRayDistance : 10000.0;
        int closestTri = -1;
        uint closestInst = 0u;
        vec2 closestBary = vec2(0.0);
        mat4x3 hitW2o = mat4x3(1.0);
        uint hitInstMatOffset = 0u;

        // Trace scene intersection with single-site hardware rayQueryEXT
        uint sceneRqFlags = hasAlphaMask ? gl_RayFlagsNoneEXT : gl_RayFlagsOpaqueEXT;
        rayQueryInitializeEXT(g_rq, topLevelAS, sceneRqFlags, RAY_MASK_ALL, rayOrigin, EPSILON, rayDir, closestT);
        while (rayQueryProceedEXT(g_rq)) {
            if (rayQueryGetIntersectionTypeEXT(g_rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                if (hasAlphaMask) {
                    uint cInstIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(g_rq, false);
                    uint cGeomIdx = rayQueryGetIntersectionGeometryIndexEXT(g_rq, false);
                    uint cPrimIdx = rayQueryGetIntersectionPrimitiveIndexEXT(g_rq, false);
                    InstanceGPU cInst = instances[cInstIdx];
                    uint cTriIdx = cInst.firstTriangle + ((cGeomIdx == 0u) ? cPrimIdx : (cPrimIdx + cInst.numOpaqueTriangles));
                    ShadeMaterial smMask = shadeMaterials[triangles[cTriIdx].materialId + cInst.materialOffset];
                    if (smGetAlphaMode(smMask) == 1u) {
                        vec2 cBary = rayQueryGetIntersectionBarycentricsEXT(g_rq, false);
                        float cw = 1.0 - cBary.x - cBary.y;
                        vec2 cUv = cw * vec2(triangles[cTriIdx].uv0x, triangles[cTriIdx].uv0y)
                                 + cBary.x * vec2(triangles[cTriIdx].uv1x, triangles[cTriIdx].uv1y)
                                 + cBary.y * vec2(triangles[cTriIdx].uv2x, triangles[cTriIdx].uv2y);
                        float cAlpha = smMask.albedo.a;
                        uint albTexMask = smGetAlbedoTex(smMask);
                        if (albTexMask > 0u && albTexMask <= 512u) {
                            cAlpha *= SAMPLE_SCENE_TEXTURE(albTexMask, cUv).a;
                        }
                        if (cAlpha < smGetAlphaCutoff(smMask)) {
                            continue;
                        }
                    }
                }
                rayQueryConfirmIntersectionEXT(g_rq);
            }
        }

        if (rayQueryGetIntersectionTypeEXT(g_rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            closestT = rayQueryGetIntersectionTEXT(g_rq, true);
            uint instIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(g_rq, true);
            uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(g_rq, true);
            uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(g_rq, true);
            InstanceGPU inst = instances[instIdx];
            closestTri = int(inst.firstTriangle + ((geomIdx == 0u) ? primIdx : (primIdx + inst.numOpaqueTriangles)));
            closestInst = instIdx;
            closestBary = rayQueryGetIntersectionBarycentricsEXT(g_rq, true);
            hitW2o = rayQueryGetIntersectionWorldToObjectEXT(g_rq, true);
            hitInstMatOffset = inst.materialOffset;
        }

        // Miss: hit sky / environment
        if (closestTri < 0) {
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            float skyMisW = 1.0;
            if (bounce > 0u && pc.hasEnvMap == 1u && envNeeActive() && pc.envMapIntensity > 0.0) {
                float skyLightScale = (bounce >= 2u)
                    ? restirSecondaryMisLightScale(bounce - 1u, pc.numLights, pc.captureMlData, pc.enableNrc)
                    : 1.0;
                skyMisW = envHitMisWeightScaled(rayDir, inPdfCode, pc.numLights, skyLightScale);
            }
            vec3 skyContrib = vec3(throughput) * skyColor * skyMisW;
            if (bounce > 0u) {
                skyContrib = clampIndirectRadiance(skyContrib, pc.indirectClamp);
            }
            accumRadiance += skyContrib;
            if (pc.captureMlData != 0u) {
                if (isSpecularPath) accumMlSpecular += f16vec3(skyContrib);
                else accumMlDiffuse += f16vec3(skyContrib);
            }
            break;
        }

        // Surface Hit Evaluation (64B ShadeMaterial fast path; secondary bounces skip normal/clearcoat/sheen/aniso)
        Triangle tri = triangles[closestTri];
        vec3 hitNormal = normalize(transpose(mat3(hitW2o)) * getTriangleNormal(tri, closestBary));
        vec2 hitUv = getTriangleUV(tri, closestBary);
        uint matId = tri.materialId + hitInstMatOffset;

        vec3 hitPoint = rayOrigin + closestT * rayDir;
        bool frontFace = dot(rayDir, hitNormal) < 0.0;
        hitNormal = frontFace ? hitNormal : -hitNormal;

        ShadeMaterial sm = shadeMaterials[matId];
        uint matType = smGetTypeFlags(sm);
        uint albedoTex = smGetAlbedoTex(sm);
        uint mrTex = smGetMrTex(sm);
        uint emissiveTex = smGetEmissiveTex(sm);
        uint diffTransTex = smGetDiffTransTex(sm);
        uint specularTex = smGetSpecularTex(sm);
        uint alphaMode = smGetAlphaMode(sm);

        vec4 baseColor = sm.albedo;
        if (albedoTex > 0u && albedoTex <= 512u) {
            baseColor *= SAMPLE_SCENE_TEXTURE(albedoTex, hitUv);
        }

        // Alpha testing
        if ((alphaMode == 1u && baseColor.a < smGetAlphaCutoff(sm)) ||
            (alphaMode == 2u && randFloat(seed) > baseColor.a)) {
            rayOrigin = hitPoint + rayDir * EPSILON;
            continue;
        }

        // Emissive with consistent MIS + caustic DS+L suppression
        vec3 emissive = sm.emissive_spec.rgb;
        if (emissiveTex > 0u && emissiveTex <= 512u) {
            emissive *= SAMPLE_SCENE_TEXTURE(emissiveTex, hitUv).rgb;
        }
        float emitLightScale = (bounce >= 2u)
            ? restirSecondaryMisLightScale(bounce - 1u, pc.numLights, pc.captureMlData, pc.enableNrc)
            : 1.0;
        float emitMisW = shouldSuppressCausticEmitterHit(causticApplied, isSpecularPath, inPdfCode, bounce)
            ? 0.0
            : ((bounce == 0u) ? 1.0 : emitterHitMisWeightScaled(0u, uint(max(closestTri, 0)), closestInst, rayOrigin, rayDir, closestT, inPdfCode, pc.numLights, emitLightScale));
        if (length(emissive) > 1e-3 && emitMisW > 0.0) {
            vec3 emissiveContrib = vec3(throughput) * emissive * emitMisW;
            if (bounce > 0u) {
                float effClamp = computeAdaptiveFireflyClamp(pc.indirectClamp, inPdfCode);
                if (bounce >= 2u && isSpecularPath) {
                    effClamp = min(effClamp, 1.5);
                }
                emissiveContrib = clampIndirectRadiance(emissiveContrib, effClamp);
            }
            accumRadiance += emissiveContrib;
            if (pc.captureMlData != 0u) {
                if (isSpecularPath) accumMlSpecular += f16vec3(emissiveContrib);
                else accumMlDiffuse += f16vec3(emissiveContrib);
            }
        }
        if ((matType & MATERIAL_TYPE_MASK) == 3u /* MATERIAL_EMISSIVE */) {
            break;
        }

        float roughness = sm.pbrParams.x;
        float metallic = sm.pbrParams.y;
        if (mrTex > 0u && mrTex <= 512u) {
            vec4 mrSample = SAMPLE_SCENE_TEXTURE(mrTex, hitUv);
            roughness *= mrSample.g;
            metallic *= mrSample.b;
        }
        if ((matType & 0xFFu) == 1u /* MATERIAL_METALLIC */) {
            metallic = max(metallic, 1.0);
        }
        bool isMirrorDelta = (metallic > 0.99 && roughness <= 0.008);
        roughness = clamp(roughness, 0.001, 1.0);
        metallic = clamp(metallic, 0.0, 1.0);
        float alphaRoughness = roughness * roughness;

        float iorVal = sm.pbrParams.z > 0.0 ? sm.pbrParams.z : 1.5;
        float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
        float specFactor = sm.emissive_spec.w;
        if (specularTex > 0u && specularTex <= 512u) {
            specFactor *= SAMPLE_SCENE_TEXTURE(specularTex, hitUv).a;
        }
        vec3 dielectricF0 = vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0));
        vec3 F0 = mix(dielectricF0, baseColor.rgb, metallic);
        vec3 diffuseColor = baseColor.rgb * (1.0 - metallic);
        vec3 V = -rayDir;

        float diffTrans = clamp(sm.pbrParams.w, 0.0, 1.0);
        if (diffTransTex > 0u && diffTransTex <= 512u) {
            diffTrans *= SAMPLE_SCENE_TEXTURE(diffTransTex, hitUv).r;
        }
        diffTrans = clamp(diffTrans, 0.0, 1.0);

        bool isDielectricDelta = smIsTransmissive(sm) || ((matType & MATERIAL_TYPE_MASK) == 2u) ||
                                 ((matId < pc.numMaterials) && (materialArchetypes[matId] == MATERIAL_ARCHETYPE_DIELECTRIC));

        // Volumetric Beer-Lambert absorption (dielectric interior traversal only)
        if (isDielectricDelta && !frontFace && closestT > 0.0) {
            vec4 attenColor = materials[matId].attenuationColor;
            if (attenColor.w > 0.0) {
                vec3 sigma_a = -log(max(attenColor.rgb, vec3(0.0001))) / attenColor.w;
                throughput *= f16vec3(exp(-sigma_a * closestT));
            }
        }

        bool enableDirect = (ubo.flags & (1 << 0)) != 0;
        bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
        bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
        bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
        bool enableShadows = (ubo.flags & (1 << 4)) != 0;

        uint bsdfMode = (metallic > 0.5) ? STD_BSDF_SIMPLE_METAL : STD_BSDF_SIMPLE_DIFF;
        StdBsdf bsdf = makeStdBsdf(diffuseColor, F0, alphaRoughness, diffTrans, metallic, dot(hitNormal, V), bsdfMode);
        bsdf.specEnabled = enableSpecular;
        if (!enableSpecular) {
            bsdf.specProb = 0.0;
        }

        // Direct Lighting (Streamlined 1-Sample NEE via shared StdBsdf + MIS)
        float effEnvIntensity = (pc.hasEnvMap == 1u) ? pc.envMapIntensity : 0.0;
        bool envNeeOn = envNeeActive() && (effEnvIntensity > 0.0);
        uint effNumLights = restirEffectiveLightCount(pc.numLights);
        if (enableDirect && !isDielectricDelta && !isMirrorDelta && (pc.numLights > 0u || envNeeOn)) {
            vec3 shadowOrigin, lightDir, diffContrib, specContrib;
            float lightDist;
            float secLightScale = (bounce >= 1u)
                ? restirSecondaryMisLightScale(bounce, pc.numLights, pc.captureMlData, pc.enableNrc)
                : 1.0;
            uint M = (effNumLights > 1u && secLightScale > 1.0)
                ? restirSecondaryFreshM(bounce, pc.numLights, isSpecularPath, pc.captureMlData)
                : 1u;
            if (evalStandardDirectNEEScaled(bsdf, hitPoint, hitNormal, V, pc.numLights, effEnvIntensity, M,
                                            bounce + 1u < pc.maxBounces, secLightScale, seed,
                                            shadowOrigin, lightDir, lightDist, diffContrib, specContrib)) {
                vec3 unshadowed = vec3(throughput) * (diffContrib + specContrib);
                if (bounce > 0u) {
                    float secClamp = (bounce >= 2u && isSpecularPath) ? min(pc.indirectClamp, 1.5) : pc.indirectClamp;
                    unshadowed = clampIndirectRadiance(unshadowed, secClamp);
                }

                if (any(greaterThan(unshadowed, vec3(1e-5)))) {
                    bool keepShadow = true;
                    uint shadowRrMinBounce = (pc.captureMlData != 0u) ? 2u : 1u;
                    if (bounce >= shadowRrMinBounce && !isSpecularPath) {
                        float lum = max(unshadowed.r, max(unshadowed.g, unshadowed.b));
                        float prob = clamp(lum * 1.5, 0.20, 1.0);
                        if (randFloat(seed) < prob) {
                            unshadowed *= (1.0 / prob);
                        } else {
                            keepShadow = false;
                        }
                    }
                    if (keepShadow) {
                        bool occluded = false;
                        if (enableShadows) {
                            occluded = traceShadowRayInline(shadowOrigin, lightDir, lightDist,
                                                           (ubo.flags & (1u << 5)) != 0u, pc.numOpaqueTriangles);
                        }
                        if (!occluded) {
                            accumRadiance += unshadowed;
                            if (pc.captureMlData != 0u) {
                                if (isSpecularPath) {
                                    accumMlSpecular += f16vec3(unshadowed);
                                } else {
                                    accumMlDiffuse += f16vec3(unshadowed);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Secondary bounce termination check
        if (bounce + 1u >= pc.maxBounces || (!enableIndirect && bounce > 0u)) {
            break;
        }

        vec3 nextDirection = vec3(0.0);
        vec3 nextOrigin = offsetRayOrigin(hitPoint, hitNormal);

        if (isDielectricDelta) {
            inPdfCode = 0u;
            if (!enableRefraction) {
                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                throughput *= f16vec3(baseColor.rgb);
            } else {
                float matDispersion = materials[matId].dispersion;
                if (matDispersion > 0.001 && dispersionChannel != 0u) {
                    iorVal += (float(dispersionChannel - 1u) - 1.0) * (matDispersion * 0.03 * iorVal);
                }
                float refractionRatio = frontFace ? (1.0 / iorVal) : iorVal;
                vec3 unitDir = normalize(rayDir);
                float cosTheta = min(dot(-unitDir, hitNormal), 1.0);
                float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                bool cannotRefract = refractionRatio * sinTheta > 1.0;
                float reflectProb = fresnelDielectric(cosTheta, refractionRatio);

                bool isWater = (matType & MATERIAL_FLAG_PROCEDURAL_WATER) != 0u;
                bool isThinWalled = smIsThin(sm) && !isWater;
                if (isThinWalled) {
                    if (!frontFace) {
                        reflectProb = 0.0;
                        cannotRefract = false;
                    } else {
                        reflectProb = (2.0 * reflectProb) / (1.0 + reflectProb);
                    }
                }

                if (cannotRefract || reflectProb > randFloat(seed)) {
                    nextDirection = reflect(unitDir, hitNormal);
                    nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                } else {
                    if (isThinWalled) {
                        nextDirection = unitDir;
                        nextOrigin = offsetRayOrigin(hitPoint, unitDir * 2.0);
                        throughput *= f16vec3(baseColor.rgb);
                    } else {
                        if (matDispersion > 0.001 && dispersionChannel == 0u) {
                            uint channel = min(uint(randFloat(seed) * 3.0), 2u);
                            dispersionChannel = channel + 1u;
                            vec3 mask = vec3(channel == 0u ? 3.0 : 0.0, channel == 1u ? 3.0 : 0.0, channel == 2u ? 3.0 : 0.0);
                            throughput *= f16vec3(mask);
                            iorVal += (float(channel) - 1.0) * (matDispersion * 0.03 * iorVal);
                            refractionRatio = frontFace ? (1.0 / iorVal) : iorVal;
                        }
                        vec3 refrVec = refract(unitDir, hitNormal, refractionRatio);
                        if (dot(refrVec, refrVec) > 1e-6) {
                            nextDirection = normalize(refrVec);
                            nextOrigin = offsetRayOrigin(hitPoint, -hitNormal);
                            throughput *= f16vec3(baseColor.rgb);
                        } else {
                            nextDirection = reflect(unitDir, hitNormal);
                            nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                        }
                    }
                }
            }
        } else if (isMirrorDelta) {
            inPdfCode = 0u;
            float NdotV = clamp(dot(hitNormal, V), 0.0, 1.0);
            nextDirection = reflect(-V, hitNormal);
            nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
            throughput *= f16vec3(fresnelSchlickVec(NdotV, F0));
        } else {
            float uLobe = randFloat(seed);
            float uTrans = randFloat(seed);
            vec2 uDir = randVec2(seed);
            vec3 bsdfWeight;
            float outPdf;
            bool sampledSpecularLobe, isTrans;
            if (!sampleStdBsdfBounce(bsdf, hitNormal, V, uLobe, uTrans, uDir,
                                     nextDirection, bsdfWeight, outPdf, sampledSpecularLobe, isTrans)) {
                break;
            }
            throughput *= f16vec3(min(bsdfWeight, vec3(65000.0)));
            nextOrigin = offsetRayOrigin(hitPoint, isTrans ? -hitNormal : hitNormal);
            inPdfCode = encodeBsdfPdf(outPdf);
        }

        // Russian roulette
        float pathLum = float(dot(throughput, f16vec3(0.2126, 0.7152, 0.0722)));
        if (applyRussianRoulette16(throughput, pathLum, bounce, seed)) {
            break;
        }

        // Primary AOV path classification (isSpecularPath) is fixed at bounce 0
        rayOrigin = nextOrigin;
        rayDir = nextDirection;
    }

    // Write final accumulated radiance to uAccumImage
    float invSpp = (ubo.spp > 0u) ? (1.0 / float(ubo.spp)) : 1.0;
    if ((pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) && any(greaterThan(accumRadiance, vec3(0.0)))) {
        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
        if (pixelCoord.x < int(pc.width) && pixelCoord.y < int(pc.height)) {
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, accumRadiance * invSpp, seed), prev.a));
        }
    }
    if (pc.captureMlData != 0u) {
        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
        if (pixelCoord.x < int(pc.width) && pixelCoord.y < int(pc.height)) {
            vec3 mlDiffVec = vec3(accumMlDiffuse) * invSpp;
            vec3 mlSpecVec = vec3(accumMlSpecular) * invSpp;
            wfAddSplitIndirect(pixelCoord, mlDiffVec, mlSpecVec, pc.captureMlData, seed);
            bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
            if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                if (any(greaterThan(accumMlDiffuse, f16vec3(0.0)))) {
                    vec3 outDiff = isV4
                        ? demodulateMlSafe(mlDiffVec, imageLoad(uMlAlbedoRoughnessImage, pixelCoord).rgb)
                        : mlDiffVec;
                    vec4 prevD = imageLoad(uMlDiffuseImage, pixelCoord);
                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevD.rgb, outDiff, seed), prevD.a));
                }
                if (any(greaterThan(accumMlSpecular, f16vec3(0.0)))) {
                    vec3 outSpec = isV4
                        ? demodulateMlSafe(mlSpecVec, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb)
                        : mlSpecVec;
                    vec4 prevS = imageLoad(uMlSpecularImage, pixelCoord);
                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevS.rgb, outSpec, seed), prevS.a));
                }
            }
        }
    }
}
