#version 460
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uCurrentFrame;  // Per-frame FP16/FP32 radiance
layout(binding = 1) uniform image2D uHistoryAccum;           // Persistent RGBA16F / RGBA32F / B10G11R11 history buffer

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint sampleCount; // Bits [0..29]: accumulated frame count N (>= 1); Bits [30..31]: AccumFormat (0=RGBA16F, 1=RGBA32F, 2=RG11B10F)
    float invSpp;     // 1.0 / activeSpp
} pc;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float stochasticRoundBits(float x, uint dropBits, uint rng) {
    // Guard subnormal/zero and max finite 5-bit-exponent float (< 65504.0)
    if (x <= 6.103515625e-5 || x >= 65504.0) {
        return clamp(x, 0.0, 65504.0);
    }
    uint mask = (1u << dropBits) - 1u;
    uint bits = floatBitsToUint(x);
    bits = (bits + (rng & mask)) & ~mask;
    return min(uintBitsToFloat(bits), 65504.0);
}

vec3 stochasticRoundAccum(vec3 c, uint fmt, uvec2 px, uint sampleIdx) {
    if (fmt == 1u) {
        return c; // RGBA32_SFLOAT: full FP32 mantissa
    }
    uint seedBase = px.x * 1973u + px.y * 9277u + sampleIdx * 26699u;
    uint r0 = pcgHash(seedBase ^ 0x68bc21ebu);
    uint r1 = pcgHash(seedBase ^ 0x02e5be93u);
    uint r2 = pcgHash(seedBase ^ 0x967a889bu);
    if (fmt == 2u) {
        // VK_FORMAT_B10G11R11_UFLOAT_PACK32: R=6m (drop 17), G=6m (drop 17), B=5m (drop 18)
        return vec3(
            stochasticRoundBits(c.r, 17u, r0),
            stochasticRoundBits(c.g, 17u, r1),
            stochasticRoundBits(c.b, 18u, r2)
        );
    }
    // Default fmt == 0u: VK_FORMAT_R16G16B16A16_SFLOAT: 10-bit mantissa (drop 13)
    return vec3(
        stochasticRoundBits(c.r, 13u, r0),
        stochasticRoundBits(c.g, 13u, r1),
        stochasticRoundBits(c.b, 13u, r2)
    );
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) {
        return;
    }

    uint sampleCount = pc.sampleCount & 0x3FFFFFFFu;
    uint accumFmt    = pc.sampleCount >> 30u;

    vec4 frameVal = imageLoad(uCurrentFrame, pixelCoord);
    vec3 frameColor = frameVal.rgb * pc.invSpp;

    // Sanitize current frame against NaN and Inf
    if (any(isnan(frameColor)) || any(isinf(frameColor))) {
        frameColor = vec3(0.0);
    }
    frameColor = max(frameColor, vec3(0.0));
    bool isDynamicVideo = (frameVal.a > 0.5);

    if (sampleCount <= 1u || isDynamicVideo) {
        vec3 initVal = stochasticRoundAccum(frameColor, accumFmt, uvec2(pixelCoord), 1u);
        imageStore(uHistoryAccum, pixelCoord, vec4(initVal, 1.0));
    } else {
        vec4 histVal = imageLoad(uHistoryAccum, pixelCoord);
        vec3 history = histVal.rgb;
        if (any(isnan(history)) || any(isinf(history))) {
            history = vec3(0.0);
        }
        history = max(history, vec3(0.0));

        float alpha = 1.0 / float(sampleCount);
        vec3 newAvg = fma(vec3(alpha), frameColor - history, history);
        newAvg = stochasticRoundAccum(max(newAvg, vec3(0.0)), accumFmt, uvec2(pixelCoord), sampleCount);
        imageStore(uHistoryAccum, pixelCoord, vec4(newAvg, 1.0));
    }
}
