#version 460 core

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : enable

#include "upways_common_v3.glsl"

// Exactly 64 threads per workgroup = 2x Wave32 subgroups on AMD RDNA 4
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// --------------------------------------------------------------------------
// CONSTANTS & DESCRIPTORS
// --------------------------------------------------------------------------
const uint DISPLAY_TILE_DIM = 16;
const uint RENDER_TILE_DIM  = 8;
const uint HALO_DIM         = 10; // 8x8 render tile + 1px halo for 3x3 stencil

// Render-resolution inputs (1 SPP, Albedo-free Demodulated Irradiance)
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D uDemodDiffuse;     // Irradiance L_diff / max(albedo, eps)
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D uDemodSpecular;    // Specular Radiance
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D uNormalDepth;       // xyz: View Normal, w: Linear Depth
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D uAlbedoRoughness;  // rgb: Albedo, a: Roughness
layout(set = 0, binding = 4, rg16f)   uniform readonly image2D uSurfaceMV;        // Surface MV (uv_curr - uv_prev)
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D uSpecularMV;       // xy: Specular MV, z: HitDist/Disparity, w: Conf
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D uReStirMetadata;   // x: M, y: W, z: HitDist, w: Curvature

// Display-resolution history (Linear Radiance + World Geometry)
layout(set = 0, binding = 7) uniform sampler2D uHistoryLinearDiff;  // rgb: Linear Diffuse Irradiance, a: Expected Depth
layout(set = 0, binding = 8) uniform sampler2D uHistoryLinearSpec;  // rgb: Linear Specular, a: Roughness
layout(set = 0, binding = 9) uniform sampler2D uHistoryWorldNormal; // rgb: World Normal, a: Validity

// Native Display-Resolution Guides (4K)
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D uDisplayAlbedo;   // Native 4K Albedo
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D uDisplayNormals;  // Native 4K Normal (xyz) & Depth (w)

// Output Targets (Display Res 4K)
layout(set = 0, binding = 12, rgba16f) uniform writeonly image2D uFinalOutput;
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D uOutHistoryDiff;
layout(set = 0, binding = 14, rgba16f) uniform writeonly image2D uOutHistorySpec;
layout(set = 0, binding = 15, rgba16f) uniform writeonly image2D uOutHistoryNormal;

layout(push_constant) uniform Uniforms {
    mat4  u_CurrInvView;       // 0..63: View to World
    mat4  u_PrevViewProj;      // 64..127: World to Previous Clip
    mat4  u_InvProj;           // 128..191: Clip to View
    vec4  u_PrevViewZ;         // 192..207: Row 2 of PrevView for axial depth
    vec2  u_JitterOffset;      // 208..215: Subpixel camera jitter in render pixels
    uvec2 u_RenderRes;         // 216..223
    uvec2 u_DisplayRes;        // 224..231
    vec2  u_ScaleFactor;       // 232..239: DisplayRes / RenderRes (e.g. 2.0, 2.0)
    uint  u_ResetHistory;      // 240..243
    uint  u_FrameIndex;        // 244..247
    float u_InvTotalSamples;   // 248..251
    uint  u_TotalSamples;      // 252..255
};

// Pre-Tiled Neural KPN Weights SSBO (16 tiles of 16x16 for FC1, 16 tiles of 16x16 for FC2)
layout(set = 0, binding = 16, std430) readonly buffer WeightsBuffer {
    float16_t w_l1[16 * 256]; // 16 contiguous tiles of 16x16 (stride 16)
    float16_t w_l2[16 * 256]; // 16 contiguous tiles of 16x16 (stride 16)
    float16_t b_l1[128];
    float16_t b_l2[32];
} u_Weights;

// --------------------------------------------------------------------------
// SHARED MEMORY (LDS Bank Alignment & Flat Backing Arrays)
// --------------------------------------------------------------------------
// 10x10 Halo cache of Linear Radiance packed into 32-bit uints to prevent bank conflicts
shared uint s_rawLinearDiff_RG[HALO_DIM][HALO_DIM];
shared uint s_rawLinearDiff_B[HALO_DIM][HALO_DIM];
shared uint s_rawLinearSpec_RG[HALO_DIM][HALO_DIM];
shared uint s_rawLinearSpec_B[HALO_DIM][HALO_DIM];

// Halo geometry and motion cache for analytic edge-stopping stencil and MV dilation
shared float s_haloDepth[HALO_DIM][HALO_DIM];
shared uint  s_haloNormal_XY[HALO_DIM][HALO_DIM];
shared uint  s_haloNormal_Z_Unused[HALO_DIM][HALO_DIM];
shared uint  s_haloSurfaceMV[HALO_DIM][HALO_DIM];

// Flat arrays for cooperative matrix input features and output logits (64 render pixels)
shared float16_t s_neuralFeaturesFlat[64 * 32];
shared float16_t s_renderLogitsFlat[64 * 32];


// Specular confidence factor cache per render pixel
shared float16_t s_specConf[64];

// --------------------------------------------------------------------------
// MATHEMATICAL & GEOMETRIC HELPER FUNCTIONS
// --------------------------------------------------------------------------
// Exact Planar Axial-Z View Unprojection
vec3 UnprojectToView(vec2 uv, float linearZ) {
    vec4 clipPoint = vec4(uv * 2.0 - 1.0, 0.5, 1.0);
    vec4 h = u_InvProj * clipPoint;
    vec3 ray = h.xyz / h.w;
    return ray * (linearZ / max(abs(ray.z), 1e-6));
}

float LogCompress(float val) {
    return log(1.0 + 16.0 * max(val, 0.0)) * 0.3529913; // 1.0 / ln(17)
}

// 3x3 Nearest-Depth Motion Vector Dilation evaluated entirely from LDS
vec2 GetDilatedSurfaceMV_LDS(int cx, int cy) {
    float centerDepth = s_haloDepth[cy][cx];
    vec2 centerMV = unpackFloat2x16(s_haloSurfaceMV[cy][cx]);
    if (centerDepth <= 0.0 || centerDepth >= 10000.0) return centerMV;

    float minDepth = centerDepth;
    vec2 bestMV = centerMV;

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue;
            int hy = cy + dy;
            int hx = cx + dx;
            float d = s_haloDepth[hy][hx];
            if (d > 0.0 && d < minDepth) {
                minDepth = d;
                bestMV = unpackFloat2x16(s_haloSurfaceMV[hy][hx]);
            }
        }
    }
    return bestMV;
}

// Physical Virtual-Hit Specular Reprojection with Geometric Curvature
vec2 CalculatePhysicalSpecularMV(ivec2 renderCoord, float depth, vec3 normalView, float curvature, vec2 surfaceMV,
                                 vec4 specInfo, vec4 meta, float roughness, out float specConfidenceFactor) {
    vec2 uv = (vec2(renderCoord) + 0.5) / vec2(u_RenderRes);

    // Fast-path: if ray-traced virtual-hit motion vector is valid (from wavefront classification), prioritize it
    if (abs(specInfo.x) > 1e-6 || abs(specInfo.y) > 1e-6) {
        specConfidenceFactor = 1.0;
        float specReliability = clamp(1.0 - roughness * roughness, 0.0, 1.0);
        return mix(surfaceMV, specInfo.xy, specReliability);
    }

    float hitDist = (meta.z > 0.0) ? meta.z : ((specInfo.z > 0.0) ? (1.0 / max(specInfo.z, 1e-4) - 1.0) : 0.0);

    // Default confidence
    specConfidenceFactor = 1.0;

    if (hitDist <= 0.0 || hitDist >= 100.0) {
        specConfidenceFactor = 0.0; // Invalidate specular history on sky/divergence
        return surfaceMV;
    }

    // 1. Current surface point in view & world space
    vec3 X_view = UnprojectToView(uv, depth);
    vec3 X_world = (u_CurrInvView * vec4(X_view, 1.0)).xyz;
    vec3 N_world = normalize(mat3(u_CurrInvView) * normalView);
    vec3 V_world = normalize(X_world - (u_CurrInvView * vec4(0, 0, 0, 1)).xyz);

    // 2. Incident & Reflected directions
    vec3 R_world = reflect(V_world, N_world);

    // 3. Mirror equation for curved surfaces: 1/dv = 1/dh + 2*kappa (directional geometric curvature)
    float safeCurv = max(curvature, 0.0);
    float effectiveHitDist = hitDist / max(1.0 + 2.0 * hitDist * safeCurv, 0.01);

    // 4. Virtual Hit Point reflected across tangent plane
    vec3 H_world = X_world + R_world * effectiveHitDist;
    vec3 H_v_world = H_world - 2.0 * N_world * dot(N_world, H_world - X_world);

    // 5. Project virtual hit into previous clip space
    vec4 prevClip = u_PrevViewProj * vec4(H_v_world, 1.0);
    if (prevClip.w <= 0.0) {
        specConfidenceFactor = 0.0;
        return surfaceMV;
    }

    vec2 prevUV_spec = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
    vec2 v_spec_sharp = uv - prevUV_spec; // Unified convention: uv_curr - uv_prev

    // Blend between sharp specular MV and surface MV according to roughness
    float specReliability = clamp(1.0 - roughness * roughness, 0.0, 1.0);
    vec2 finalSpecMV = mix(surfaceMV, v_spec_sharp, specReliability);

    return finalSpecMV;
}

// --------------------------------------------------------------------------
// MODULE 1: COOPERATIVE LDS TILE INGESTION & OUTLIER CLAMPING
// --------------------------------------------------------------------------
void LoadRenderTileLDS(ivec2 renderTileOrigin) {
    uint tid = gl_LocalInvocationIndex;

    // Load 10x10 halo (100 samples) cooperatively across 64 threads
    for (uint i = tid; i < 100; i += 64) {
        uint hy = i / HALO_DIM;
        uint hx = i % HALO_DIM;
        ivec2 coord = clamp(renderTileOrigin + ivec2(hx - 1, hy - 1), ivec2(0), ivec2(u_RenderRes) - 1);

        vec3 diff = imageLoad(uDemodDiffuse, coord).rgb * u_InvTotalSamples;
        vec3 spec = imageLoad(uDemodSpecular, coord).rgb * u_InvTotalSamples;
        vec4 normDepth = imageLoad(uNormalDepth, coord);
        float depth = normDepth.w;
        vec3 normal = normDepth.xyz;
        vec2 surfMV = imageLoad(uSurfaceMV, coord).xy;

        s_rawLinearDiff_RG[hy][hx] = packFloat2x16(f16vec2(diff.r, diff.g));
        s_rawLinearDiff_B[hy][hx]  = packFloat2x16(f16vec2(diff.b, 0.0hf));
        s_rawLinearSpec_RG[hy][hx] = packFloat2x16(f16vec2(spec.r, spec.g));
        s_rawLinearSpec_B[hy][hx]  = packFloat2x16(f16vec2(spec.b, 0.0hf));

        s_haloDepth[hy][hx] = depth;
        s_haloNormal_XY[hy][hx] = packFloat2x16(f16vec2(normal.x, normal.y));
        s_haloNormal_Z_Unused[hy][hx] = packFloat2x16(f16vec2(normal.z, 0.0hf));
        s_haloSurfaceMV[hy][hx] = packFloat2x16(f16vec2(surfMV));
    }

    barrier();

    // Assemble 32 neural guide features per render pixel
    if (tid < 64) {
        uint lx = tid % 8;
        uint ly = tid / 8;
        ivec2 coord = renderTileOrigin + ivec2(lx, ly);

        float depth = s_haloDepth[ly + 1][lx + 1];
        f16vec2 norm_xy = unpackFloat2x16(s_haloNormal_XY[ly + 1][lx + 1]);
        float norm_z    = unpackFloat2x16(s_haloNormal_Z_Unused[ly + 1][lx + 1]).x;
        vec3 normal = vec3(norm_xy, norm_z);

        // Compute true geometric curvature from 3x3 normal halo in LDS
        f16vec2 n_r = unpackFloat2x16(s_haloNormal_XY[ly + 1][lx + 2]);
        f16vec2 n_l = unpackFloat2x16(s_haloNormal_XY[ly + 1][lx]);
        f16vec2 n_t = unpackFloat2x16(s_haloNormal_XY[ly + 2][lx + 1]);
        f16vec2 n_b = unpackFloat2x16(s_haloNormal_XY[ly][lx + 1]);
        float dndx = length(n_r - n_l) * 0.5;
        float dndy = length(n_t - n_b) * 0.5;
        float geomCurvature = clamp((dndx + dndy) / max(depth * 0.05, 1e-3), 0.0, 50.0);

        vec4 albRough = imageLoad(uAlbedoRoughness, coord);
        vec4 specInfo = imageLoad(uSpecularMV, coord);
        vec4 restir   = imageLoad(uReStirMetadata, coord);

        vec2 surfMV = GetDilatedSurfaceMV_LDS(int(lx) + 1, int(ly) + 1);
        float specConfidenceFactor;
        vec2 specMV = CalculatePhysicalSpecularMV(coord, depth, normal, geomCurvature, surfMV,
                                                 specInfo, restir, albRough.a, specConfidenceFactor);
        s_specConf[tid] = float16_t(specConfidenceFactor);

        f16vec2 d_rg = unpackFloat2x16(s_rawLinearDiff_RG[ly + 1][lx + 1]);
        float d_b    = unpackFloat2x16(s_rawLinearDiff_B[ly + 1][lx + 1]).x;
        f16vec2 s_rg = unpackFloat2x16(s_rawLinearSpec_RG[ly + 1][lx + 1]);
        float s_b    = unpackFloat2x16(s_rawLinearSpec_B[ly + 1][lx + 1]).x;

        // Compute 3x3 local radiance standard deviation for diffuse and specular
        vec3 sumDiff = vec3(0.0);
        vec3 sumSqDiff = vec3(0.0);
        vec3 sumSpec = vec3(0.0);
        vec3 sumSqSpec = vec3(0.0);

        for (int vy = -1; vy <= 1; ++vy) {
            for (int vx = -1; vx <= 1; ++vx) {
                uint hy = ly + 1u + uint(vy);
                uint hx = lx + 1u + uint(vx);
                f16vec2 d_rg_t = unpackFloat2x16(s_rawLinearDiff_RG[hy][hx]);
                float   d_b_t  = unpackFloat2x16(s_rawLinearDiff_B[hy][hx]).x;
                vec3    d_val  = vec3(d_rg_t, d_b_t);

                f16vec2 s_rg_t = unpackFloat2x16(s_rawLinearSpec_RG[hy][hx]);
                float   s_b_t  = unpackFloat2x16(s_rawLinearSpec_B[hy][hx]).x;
                vec3    s_val  = vec3(s_rg_t, s_b_t);

                sumDiff   += d_val;
                sumSqDiff += d_val * d_val;
                sumSpec   += s_val;
                sumSqSpec += s_val * s_val;
            }
        }
        vec3 meanDiff = sumDiff / 9.0;
        vec3 varDiff  = max(sumSqDiff / 9.0 - meanDiff * meanDiff, vec3(0.0));
        float sigmaDiff = sqrt(max((varDiff.r + varDiff.g + varDiff.b) / 3.0, 0.0));
        float normVarDiff = log(1.0 + sigmaDiff) * 0.3333333; // 1 / 3.0

        vec3 meanSpec = sumSpec / 9.0;
        vec3 varSpec  = max(sumSqSpec / 9.0 - meanSpec * meanSpec, vec3(0.0));
        float sigmaSpec = sqrt(max((varSpec.r + varSpec.g + varSpec.b) / 3.0, 0.0));
        float normVarSpec = log(1.0 + sigmaSpec) * 0.3333333; // 1 / 3.0

        // Disparity: scale-invariant in (0, 1]
        float disparity = 0.1 / max(depth, 0.1);

        // ReSTIR non-linear normalizations with bounded scaling
        float mNorm = restir.x / (restir.x + 16.0);
        float wNorm = clamp(asinh(max(restir.y, 0.0)) * 0.25, 0.0, 1.0);

        // MV Divergence
        float mvDiv = clamp(length(surfMV - specMV), 0.0, 1.0);

        // Temporal history age
        vec2 renderUV = (vec2(coord) + 0.5) / vec2(u_RenderRes);
        vec2 prevRenderUV = renderUV - surfMV;
        float prevAge = textureLod(uHistoryWorldNormal, prevRenderUV, 0.0).a;
        float ageNorm = 1.0 - exp(-prevAge / 16.0);

        // Assemble 32 neural guide features per render pixel
        uint baseIdx = tid * 32u;
        s_neuralFeaturesFlat[baseIdx + 0u]  = float16_t(LogCompress(d_rg.x));
        s_neuralFeaturesFlat[baseIdx + 1u]  = float16_t(LogCompress(d_rg.y));
        s_neuralFeaturesFlat[baseIdx + 2u]  = float16_t(LogCompress(d_b));
        s_neuralFeaturesFlat[baseIdx + 3u]  = float16_t(LogCompress(s_rg.x));
        s_neuralFeaturesFlat[baseIdx + 4u]  = float16_t(LogCompress(s_rg.y));
        s_neuralFeaturesFlat[baseIdx + 5u]  = float16_t(LogCompress(s_b));
        s_neuralFeaturesFlat[baseIdx + 6u]  = float16_t(normal.x);
        s_neuralFeaturesFlat[baseIdx + 7u]  = float16_t(normal.y);
        s_neuralFeaturesFlat[baseIdx + 8u]  = float16_t(normal.z);
        s_neuralFeaturesFlat[baseIdx + 9u]  = float16_t(disparity);
        s_neuralFeaturesFlat[baseIdx + 10u] = float16_t(albRough.r);
        s_neuralFeaturesFlat[baseIdx + 11u] = float16_t(albRough.g);
        s_neuralFeaturesFlat[baseIdx + 12u] = float16_t(albRough.b);
        s_neuralFeaturesFlat[baseIdx + 13u] = float16_t(albRough.a); // Roughness
        s_neuralFeaturesFlat[baseIdx + 14u] = float16_t(surfMV.x);
        s_neuralFeaturesFlat[baseIdx + 15u] = float16_t(surfMV.y);
        s_neuralFeaturesFlat[baseIdx + 16u] = float16_t(specMV.x);
        s_neuralFeaturesFlat[baseIdx + 17u] = float16_t(specMV.y);
        s_neuralFeaturesFlat[baseIdx + 18u] = float16_t(mNorm);
        s_neuralFeaturesFlat[baseIdx + 19u] = float16_t(wNorm);
        s_neuralFeaturesFlat[baseIdx + 20u] = float16_t(mvDiv);
        s_neuralFeaturesFlat[baseIdx + 21u] = float16_t(normVarDiff);
        s_neuralFeaturesFlat[baseIdx + 22u] = float16_t(normVarSpec);
        s_neuralFeaturesFlat[baseIdx + 23u] = float16_t(ageNorm);

        for (uint k = 24u; k < 32u; ++k) {
            s_neuralFeaturesFlat[baseIdx + k] = 0.0hf;
        }
    }
    barrier();
}

// --------------------------------------------------------------------------
// MODULE 2: SUBGROUP-PARTITIONED COOPERATIVE MATRIX EVALUATION
// --------------------------------------------------------------------------
void EvaluateCoopMLPForBlock(uint blockIdx, uint sgIdx) {
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matIn0, matIn1;
    uint inOffset = blockIdx * 16u * 32u;
    coopMatLoad(matIn0, s_neuralFeaturesFlat, inOffset + 0u,  32u, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(matIn1, s_neuralFeaturesFlat, inOffset + 16u, 32u, gl_CooperativeMatrixLayoutRowMajor);

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matOut0 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matOut1 = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));

    // Stream 8 hidden tiles entirely in registers: ZERO LDS, ZERO BARRIERS
    for (uint k = 0u; k < 8u; ++k) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matW1_0, matW1_1;
        coopMatLoad(matW1_0, u_Weights.w_l1, k * 256u,        16u, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matW1_1, u_Weights.w_l1, (8u + k) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matH = coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
        matH = coopMatMulAdd(matIn0, matW1_0, matH);
        matH = coopMatMulAdd(matIn1, matW1_1, matH);

        // Apply LeakyReLU directly in registers and chain into MatrixUseA (B1 is zero)
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matH_act;
        [[unroll]]
        for (uint i = 0u; i < 8u; ++i) {
            float16_t v = matH[i];
            matH_act[i] = (v > 0.0hf) ? v : (v * float16_t(0.1));
        }

        // Accumulate into Layer 2 outputs (Out0: cols 0..15, Out1: cols 16..31)
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matW2_0, matW2_1;
        coopMatLoad(matW2_0, u_Weights.w_l2, (2u * k + 0u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matW2_1, u_Weights.w_l2, (2u * k + 1u) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);

        matOut0 = coopMatMulAdd(matH_act, matW2_0, matOut0);
        matOut1 = coopMatMulAdd(matH_act, matW2_1, matOut1);
    }

    // Store final Layer 2 outputs
    uint outOffset = blockIdx * 16u * 32u;
    coopMatStore(matOut0, s_renderLogitsFlat, outOffset + 0u,  32u, gl_CooperativeMatrixLayoutRowMajor);
    coopMatStore(matOut1, s_renderLogitsFlat, outOffset + 16u, 32u, gl_CooperativeMatrixLayoutRowMajor);

    // Layer 2 Bias addition (512 elements per block: 16 pixels * 32 logits)
    uint sLane = gl_SubgroupInvocationID;
    for (uint elem = sLane; elem < 512u; elem += 32u) {
        uint col = elem % 32u;
        s_renderLogitsFlat[outOffset + elem] += u_Weights.b_l2[col];
    }
}

// --------------------------------------------------------------------------
// MODULE 3: DISPLAY-RESOLUTION PHASE RESOLVE & BILATERAL RESOLVE
// --------------------------------------------------------------------------
void main() {
    uint tid = gl_LocalInvocationIndex;
    uint sgId = gl_SubgroupID;
    bool isNative = (u_ScaleFactor.x <= 1.25);
    ivec2 renderTileOrigin  = ivec2(gl_WorkGroupID.xy) * int(RENDER_TILE_DIM);
    ivec2 displayTileOrigin = isNative ? renderTileOrigin : (ivec2(gl_WorkGroupID.xy) * int(DISPLAY_TILE_DIM));

    // 1. Cooperative load of 10x10 halo into LDS
    LoadRenderTileLDS(renderTileOrigin);

    // 2. Race-Free Matrix Scheduling: Subgroup 0 handles blocks 0 & 2; Subgroup 1 handles blocks 1 & 3
    for (uint b = sgId; b < 4u; b += gl_NumSubgroups) {
        EvaluateCoopMLPForBlock(b, sgId);
    }
    // Synchronize entire workgroup before display resolution resolve
    barrier();

    // 3. Resolve Display-Resolution Pixels (64 threads process 1 or 4 display pixels)
    uint numSub = isNative ? 1u : 2u;
    uint lx_d = isNative ? (tid % 8) : ((tid % 8) * 2);
    uint ly_d = isNative ? (tid / 8) : ((tid / 8) * 2);

    for (uint dy_sub = 0; dy_sub < numSub; ++dy_sub) {
        for (uint dx_sub = 0; dx_sub < numSub; ++dx_sub) {
            ivec2 outCoord = displayTileOrigin + ivec2(lx_d + dx_sub, ly_d + dy_sub);
            if (any(greaterThanEqual(outCoord, ivec2(u_DisplayRes)))) continue;


            vec2 displayUV = (vec2(outCoord) + 0.5) / vec2(u_DisplayRes);

            // A. Exact Continuous Phase Mapping
            vec2 r_p = (vec2(outCoord) + 0.5) / u_ScaleFactor - 0.5 - u_JitterOffset;
            ivec2 tapBase = ivec2(floor(r_p));
            vec2 phase = fract(r_p);

            // Determine valid local base coordinate in halo (bounds check protects tile edges)
            ivec2 localBaseForRadiance = tapBase - renderTileOrigin;
            ivec2 localBaseForLogits   = clamp(localBaseForRadiance, ivec2(0), ivec2(7));
            uint renderIdx = uint(localBaseForLogits.y * 8 + localBaseForLogits.x);
            uint baseFeat  = renderIdx * 32u;

            // Fetch pre-computed surface MV, specular MV, roughness, spec confidence from LDS (Zero VRAM traffic)
            vec2 v_surf      = vec2(s_neuralFeaturesFlat[baseFeat + 14u], s_neuralFeaturesFlat[baseFeat + 15u]);
            vec2 v_spec      = vec2(s_neuralFeaturesFlat[baseFeat + 16u], s_neuralFeaturesFlat[baseFeat + 17u]);
            float roughAtTap = float(s_neuralFeaturesFlat[baseFeat + 13u]);
            float specConf   = float(s_specConf[renderIdx]);

            // PREFETCH HISTORY TEXTURES (Overlap memory latency with subsequent VALU math)
            vec2 prevUV_diff = displayUV - v_surf;
            vec2 prevUV_spec = displayUV - v_spec;

            bool inBoundsDiff = all(greaterThanEqual(prevUV_diff, vec2(0.0))) && all(lessThanEqual(prevUV_diff, vec2(1.0)));
            bool inBoundsSpec = all(greaterThanEqual(prevUV_spec, vec2(0.0))) && all(lessThanEqual(prevUV_spec, vec2(1.0)));

            vec4 histDiffSample = inBoundsDiff ? texture(uHistoryLinearDiff, prevUV_diff) : vec4(0.0);
            vec4 histSpecSample = inBoundsSpec ? texture(uHistoryLinearSpec, prevUV_spec) : vec4(0.0);
            vec4 histNormSample = inBoundsDiff ? texture(uHistoryWorldNormal, prevUV_diff) : vec4(0.0);

            // B. Extract Logits with Center-Tap Structural Prior
            float diffLogits[9];
            float specLogits[9];
            float maxL_d = -1e20, maxL_s = -1e20;

            [[unroll]]
            for (int k = 0; k < 9; ++k) {
                float centerBiasAdj = (k == 4) ? -1.8 : 0.0;
                diffLogits[k] = float(s_renderLogitsFlat[baseFeat + k]) + centerBiasAdj;
                specLogits[k] = float(s_renderLogitsFlat[baseFeat + 9u + k]) + centerBiasAdj;
                maxL_d = max(maxL_d, diffLogits[k]);
                maxL_s = max(maxL_s, specLogits[k]);
            }

            // Learned Temporal Alpha and Anisotropic Phase Warping Logits
            float rawAlphaLogit = float(s_renderLogitsFlat[baseFeat + 18u]);
            float rawAnisoLogit = float(s_renderLogitsFlat[baseFeat + 19u]);
            float alphaBase = clamp((1.0 / (1.0 + exp(-rawAlphaLogit))) * 0.12, 0.02, 0.25);
            float kappaAniso = tanh(rawAnisoLogit);

            // C. Analytic Bilateral Edge-Stopping Weights & Anisotropic Phase Metric
            int hx_base = clamp(localBaseForRadiance.x + 1, 1, 8);
            int hy_base = clamp(localBaseForRadiance.y + 1, 1, 8);
            float centerDepth = s_haloDepth[hy_base][hx_base];
            f16vec2 c_norm_xy = unpackFloat2x16(s_haloNormal_XY[hy_base][hx_base]);
            float   c_norm_z  = unpackFloat2x16(s_haloNormal_Z_Unused[hy_base][hx_base]).x;
            vec3 centerNormal = vec3(c_norm_xy, c_norm_z);

            // 2D Edge Tangent and Normal in Image Plane for Anisotropic Phase Warping
            vec2 norm2D = centerNormal.xy;
            float normLen = length(norm2D);
            vec2 t2D = (normLen > 1e-4) ? vec2(-norm2D.y, norm2D.x) / normLen : vec2(1.0, 0.0);
            vec2 n2D = (normLen > 1e-4) ? norm2D / normLen : vec2(0.0, 1.0);
            float scaleTangent = exp(-kappaAniso);
            float scaleNormal  = 1.0 / max(scaleTangent, 1e-4);

            // D. Unified Spatial Filtering & Convolution in LINEAR RADIANCE SPACE (Flux-Conserving)
            vec3 spatialLinearDiff = vec3(0.0);
            vec3 spatialLinearSpec = vec3(0.0);
            vec3 centerDiff = vec3(0.0);
            vec3 centerSpec = vec3(0.0);
            vec3 minDiff = vec3(1e30);
            vec3 maxDiff = vec3(0.0);
            vec3 minSpec = vec3(1e30);
            vec3 maxSpec = vec3(0.0);
            float sumW_d = 0.0, sumW_s = 0.0;
            int tapIndex = 0;

            [[unroll]]
            for (int ty = -1; ty <= 1; ++ty) {
                [[unroll]]
                for (int tx = -1; tx <= 1; ++tx) {
                    vec2 tapOffset = vec2(tx, ty) - phase;
                    float dt = dot(tapOffset, t2D) * scaleTangent;
                    float dn = dot(tapOffset, n2D) * scaleNormal;
                    float distSq = dt * dt + dn * dn;

                    int hx = clamp(localBaseForRadiance.x + 1 + tx, 0, int(HALO_DIM) - 1);
                    int hy = clamp(localBaseForRadiance.y + 1 + ty, 0, int(HALO_DIM) - 1);

                    float tapDepth = s_haloDepth[hy][hx];
                    f16vec2 t_norm_xy = unpackFloat2x16(s_haloNormal_XY[hy][hx]);
                    float   t_norm_z  = unpackFloat2x16(s_haloNormal_Z_Unused[hy][hx]).x;
                    vec3 tapNormal = vec3(t_norm_xy, t_norm_z);

                    // Bilateral edge-stopping: protects geometric silhouettes
                    float depthDiff = abs(tapDepth - centerDepth) / max(centerDepth * 0.10, 1e-3);
                    float nd = max(dot(centerNormal, tapNormal), 0.0);
                    nd *= nd; nd *= nd; nd *= nd; // pow(nd, 8.0) on VALU

                    // Combined exponential: exp(diffLogits - maxL_d) * exp(-distSq * 2.0) * exp(-depthDiff)
                    float exp_d = (diffLogits[tapIndex] - maxL_d) - (distSq * 2.0 + depthDiff);
                    float exp_s = (specLogits[tapIndex] - maxL_s) - (distSq * 2.0 + depthDiff);
                    float unnorm_w_d = (exp_d < -20.0) ? 0.0 : (exp(exp_d) * nd);
                    float unnorm_w_s = (exp_s < -20.0) ? 0.0 : (exp(exp_s) * nd);

                    f16vec2 rg_d = unpackFloat2x16(s_rawLinearDiff_RG[hy][hx]);
                    float   b_d  = unpackFloat2x16(s_rawLinearDiff_B[hy][hx]).x;
                    f16vec2 rg_s = unpackFloat2x16(s_rawLinearSpec_RG[hy][hx]);
                    float   b_s  = unpackFloat2x16(s_rawLinearSpec_B[hy][hx]).x;

                    vec3 tapDiff = min(vec3(rg_d.xy, b_d), vec3(65000.0));
                    vec3 tapSpec = min(vec3(rg_s.xy, b_s), vec3(65000.0));

                    if (tx == 0 && ty == 0) {
                        centerDiff = tapDiff;
                        centerSpec = tapSpec;
                    }

                    minDiff = min(minDiff, tapDiff);
                    maxDiff = max(maxDiff, tapDiff);
                    minSpec = min(minSpec, tapSpec);
                    maxSpec = max(maxSpec, tapSpec);

                    spatialLinearDiff += unnorm_w_d * tapDiff;
                    spatialLinearSpec += unnorm_w_s * tapSpec;
                    sumW_d += unnorm_w_d;
                    sumW_s += unnorm_w_s;

                    tapIndex++;
                }
            }

            spatialLinearDiff = (sumW_d < 1e-5) ? centerDiff : (spatialLinearDiff / sumW_d);
            spatialLinearSpec = (sumW_s < 1e-5) ? centerSpec : (spatialLinearSpec / sumW_s);

            // Bounded linear radiance with local neighborhood clamping (suppresses outliers and boiling)
            vec3 boxPadDiff = (maxDiff - minDiff) * 0.80 + vec3(0.06);
            vec3 boxPadSpec = (maxSpec - minSpec) * 0.80 + vec3(0.06);
            vec3 histDiff = clamp(max(histDiffSample.rgb, vec3(0.0)), max(minDiff - boxPadDiff, vec3(0.0)), maxDiff + boxPadDiff);
            vec3 histSpec = clamp(max(histSpecSample.rgb, vec3(0.0)), max(minSpec - boxPadSpec, vec3(0.0)), maxSpec + boxPadSpec);

            // F. Planar Depth World-Space Expected Disocclusion Validation
            vec3 X_view = UnprojectToView(displayUV, centerDepth);
            vec3 X_world = (u_CurrInvView * vec4(X_view, 1.0)).xyz;
            float normLen_curr = length(centerNormal);
            vec3 N_curr_world = (normLen_curr > 1e-4) ? normalize(mat3(u_CurrInvView) * centerNormal) : vec3(0.0, 0.0, 1.0);

            // Row 2 dot product yields axial linear depth along camera forward (-Z)
            float expectedPrevDepth = -dot(u_PrevViewZ, vec4(X_world, 1.0));
            float storedPrevDepth = histDiffSample.a;

            float depthDelta = abs(expectedPrevDepth - storedPrevDepth) / max(expectedPrevDepth, 1e-3);
            float worldNormalDot = dot(N_curr_world, histNormSample.xyz);

            // Hard Disocclusion Rejection: 20% Depth Delta or >60 Degree Normal Angle (matches FSR 3 / DLSS)
            bool rejectDiff = (u_ResetHistory != 0u) || (!inBoundsDiff) || (depthDelta > 0.20) || (worldNormalDot < 0.50) || (centerDepth <= 0.0);
            bool rejectSpec = (u_ResetHistory != 0u) || (!inBoundsSpec) || (specConf <= 0.0);

            float depthConf = 1.0 - smoothstep(0.05, 0.20, depthDelta);
            float normalConf = smoothstep(0.50, 0.85, worldNormalDot);
            float confDiff = rejectDiff ? 0.0 : (depthConf * normalConf);
            float confSpec = rejectSpec ? 0.0 : (confDiff * specConf);

            // G. Linear Adaptive Blending with Roughness-Dependent Specular Alpha Floor
            float specAlphaFloor = mix(0.10, 0.05, smoothstep(0.0, 0.25, roughAtTap));
            float mvDivDisplay = clamp(length(v_surf - v_spec), 0.0, 1.0);
            specAlphaFloor = max(specAlphaFloor, 0.15 * mvDivDisplay);

            float alphaDiff = (u_TotalSamples > 1u) ? 1.0 : mix(1.0, alphaBase, confDiff);
            float alphaSpec = (u_TotalSamples > 1u) ? 1.0 : mix(1.0, clamp(alphaBase * 2.0 + 0.02, specAlphaFloor, 0.45), confSpec);

            vec3 resolvedLinearDiff = mix(histDiff, spatialLinearDiff, alphaDiff);
            vec3 resolvedLinearSpec = mix(histSpec, spatialLinearSpec, alphaSpec);

            vec3 finalHDR = resolvedLinearDiff + resolvedLinearSpec;

            if (any(isnan(finalHDR)) || any(isinf(finalHDR))) {
                finalHDR = spatialLinearDiff + spatialLinearSpec;
            }
            finalHDR = clamp(finalHDR, vec3(0.0), vec3(65000.0));

            float prevAge = histNormSample.a;
            float newAge = rejectDiff ? 0.0 : min(prevAge + 1.0, 64.0);

            imageStore(uFinalOutput, outCoord, vec4(finalHDR, 1.0));
            imageStore(uOutHistoryDiff, outCoord, vec4(resolvedLinearDiff, centerDepth));
            imageStore(uOutHistorySpec, outCoord, vec4(resolvedLinearSpec, centerDepth));
            imageStore(uOutHistoryNormal, outCoord, vec4(N_curr_world, newAge));
        }
    }
}
