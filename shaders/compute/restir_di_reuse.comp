#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "wavefront_common.glsl"

layout(local_size_x = 16, local_size_y = 8) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 23, rgba16f) uniform readonly image2D uMotionVectorImage;
layout(binding = 24, rgba16f) uniform readonly image2D uNormalDepthImage;
layout(binding = 26, rgba16f) uniform readonly image2D uMlAlbedoRoughnessImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 33, rgba16f) uniform readonly image2D uPrevNormalDepthImage;
layout(binding = 41, rgba16f) uniform image2D uMlSpecAlbedoImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

layout(binding = 7) uniform sampler2D environmentMap;

#define RESTIR_INCLUDE_SAMPLER_HELPERS
#include "restir_common.glsl"
#include "wavefront_radiance_output.glsl"
#include "bsdf_standard.glsl"

layout(std430, binding = 32) buffer ReSTIRCurrentReservoirsBuffer {
    DiReservoir currentReservoirs[];
};

layout(std430, binding = 36) readonly buffer ReSTIRHistoryReservoirsBuffer {
    DiReservoir historyReservoirs[];
};

layout(std430, binding = 37) readonly buffer X1ContextsBuffer {
    X1Context x1Contexts[];
};

layout(push_constant) uniform PushConstants {
    WavefrontShadePC pc;
};

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    int bandH = imageSize(uMotionVectorImage).y;
    bool inRange = (px.x < int(pc.width) && px.y < bandH);
    ivec2 screenPx = ivec2(px.x, px.y + int(pc.pixelOffsetY));

    bool hasShadowRay = false;
    PackedShadowRay shadowCandidate;

    if (inRange) {
        uint pixelIndex = uint(px.y) * pc.width + uint(px.x);
        DiReservoir r = currentReservoirs[pixelIndex];

        float effEnvIntensity = (pc.hasEnvMap == 1u) ? pc.envMapIntensity : 0.0;
        bool envNeeOn = envNeeActive() && (effEnvIntensity > 0.0);
        if ((r.flags & DI_FLAG_ACTIVE) != 0u && (pc.numLights > 0u || envNeeOn)) {
            bool freshVis = ((r.flags & DI_FLAG_FRESH_VISIBLE) != 0u);
            bool needFreshVis = ((r.flags & DI_FLAG_NEED_FRESH_VIS) != 0u);
            bool diRestirMisActive = ((r.flags & DI_FLAG_DI_MIS_ACTIVE) != 0u);
            bool hasCont = ((r.flags & DI_FLAG_HAS_CONT) != 0u);
            bool mergeMatteSpec = ((r.flags & DI_FLAG_MERGE_MATTE_SPEC) != 0u);
            float diffTrans = float(r.flags & 0xFFu) * (1.0 / 255.0);

            r.flags &= (DI_FLAG_HISTORY_MASK & ~0xFFu);

            uint seed = uint(screenPx.x * 1973 + screenPx.y * 9277 + (pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex) * 26699) | 1u;
            bool enableTaa = (ubo.flags & (1u << 21)) != 0u;
            vec2 jitter = (enableTaa || pc.captureMlData != 0u) ? vec2(0.0) : (randVec2(seed) - vec2(0.5));
            vec2 uv = (vec2(screenPx) + vec2(0.5) + jitter) / vec2(float(pc.width), float(pc.height));
            vec2 ndc = uv * 2.0 - 1.0;
            vec4 target = ubo.projInverse * vec4(ndc.x, ndc.y, 1.0, 1.0);
            vec3 rayDir = normalize((ubo.viewInverse * vec4(normalize(target.xyz / target.w), 0.0)).xyz);
            float camZ = max(dot(rayDir, -ubo.viewInverse[2].xyz), 1e-4);
            vec4 mvFull = imageLoad(uMotionVectorImage, px);
            float linDepth = mvFull.w;
            float hitT = linDepth / camZ;
            vec3 hitPoint = ubo.position.xyz + rayDir * hitT;

            X1Context ctx = x1Contexts[pixelIndex];
            vec3 hitNormal = x1ContextNormal(ctx);
            vec3 baseCol = x1ContextBaseColor(ctx);
            float metallic = x1ContextMetallic(ctx);
            vec3 V = -rayDir;
            float f0Scalar = x1ContextF0(ctx);
            float roughness = x1ContextRoughness(ctx);
            float alphaRoughness = roughness * roughness;
            f16vec3 diffuseColor = f16vec3(baseCol * (1.0 - metallic));
            f16vec3 F0 = mix(f16vec3(f0Scalar), f16vec3(baseCol), float16_t(metallic));
            StdBsdf bsdf = makeStdBsdf(vec3(diffuseColor), vec3(F0), alphaRoughness, diffTrans,
                                       metallic, dot(hitNormal, V), STD_BSDF_FULL);

            DiSample sel;
            sel.lightIdx = restirGetLightIdx(r.idxM);
            sel.dir = vec3(0.0, 1.0, 0.0);
            sel.dist = 0.0;
            sel.emission = vec3(0.0);
            sel.selectPdf = -1.0;
            sel.cosLight = 1.0;
            sel.ndotL = 0.0;
            sel.target = restirDiGetTarget(r.targetCosBits);
            sel.luv = unpackUnorm2x16(r.lightUv16);
            sel.isTrans = ((r.flags >> 9u) & 1u) != 0u;
            bool selIsEnv = (sel.lightIdx == RESTIR_LIGHT_IDX_ENV) && envNeeOn;
            sel.has = restirIsValid(r.flags) && (sel.target > 0.0) && (r.wSum > 0.0) && (selIsEnv || sel.lightIdx < pc.numLights);

            uint effNumLights = restirEffectiveLightCount(pc.numLights);
            bool winnerVisVerified = false;
            bool winnerIsFresh = false;
            bool needReconnect = sel.has;
            if (effNumLights > 4u) {
                winnerVisVerified = true;
                if (needFreshVis && !freshVis) {
                    uint M = restirGetM(r.idxM);
                    r.wSum = 0.0;
                    r.targetCosBits = 0u;
                    r.idxM = restirPackIdxM(0u, M);
                    r.flags = restirPackFlags(0u, false, false, hitNormal);
                    sel.has = false;
                    sel.target = 0.0;
                    needReconnect = false;
                }
                winnerIsFresh = sel.has;
            }

            bool hasCamMotionRestir = false;
            bool isV4DiCapture = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
            bool isMlDenoiserDi = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
            bool enableShadows = (ubo.flags & (1u << 4)) != 0u;

            DiReservoir historyOut = r;

            if (ubo.frameIndex > 0u && (ubo.flags & (1u << 23)) == 0u) {
                uint restirSeed = seed ^ 0x9E3779B9u;
                pcg_hash(restirSeed);
                vec2 mvPx = mvFull.xy * vec2(float(pc.width), float(pc.height));
                bool hasCamMotion = dot(mvPx, mvPx) > 0.25;
                hasCamMotionRestir = hasCamMotion;
                float currViewZ = max(dot(hitPoint - ubo.position.xyz, -ubo.viewInverse[2].xyz), 1e-4);
                float expectedPrevDepth = max(currViewZ + mvFull.z, 1e-4);
                float expectedPrevHitT = hitT * (expectedPrevDepth / currViewZ);
                ivec2 prevCoord = ivec2(round(vec2(px) - mvPx));

                bool allowMultiLightStaticDi = (effNumLights > 4u);
                bool manyLightScene = (pc.numLights > 4096u);
                bool allowTemporalDiHistory = isV4DiCapture || hasCamMotion || allowMultiLightStaticDi;
                bool allowSpatialDi = (effNumLights > 1u || hasCamMotion) && !(metallic > 0.5 && roughness < 0.25) && !(isMlDenoiserDi && !hasCamMotion);

                uint globalPixelIdx = pixelIndex + pc.pixelOffsetY * pc.width;
                uint tapHash = (globalPixelIdx * 0x9E3779B9u) ^ (pc.frameIndex * 0x85EBCA6Bu);
                if (isV4DiCapture) {
                    tapHash ^= 0xA3C59AC3u;
                }
                pcg_hash(tapHash);
                uint rot = (tapHash >> 30u) & 3u;
                uint numSpatialTaps = 2u;
                uint tapOff = (tapHash >> 24u) % 24u;
                uint tempMCap = min(pc.restirMCap, hasCamMotion ? 6u : (isV4DiCapture ? 20u : (manyLightScene ? ((pc.captureMlData == 0u) ? 8u : 4u) : 4u)));
                uint spatMCap = isV4DiCapture
                    ? min(pc.restirMCap, hasCamMotion ? 6u : 12u)
                    : (hasCamMotion ? min(pc.restirMCap, 6u) : min(pc.restirMCap, manyLightScene ? ((pc.captureMlData == 0u) ? 12u : 8u) : 16u));
                float spatDiDepthGate = isV4DiCapture ? 0.06 : (manyLightScene ? 0.04 : RESTIR_TAP_DEPTH_REL_GATE);

                int startTap = allowTemporalDiHistory ? -1 : 0;
                int endTap = allowSpatialDi ? int(numSpatialTaps) : 0;
                [[dont_unroll]]
                for (int tapPass = startTap; tapPass < endTap; ++tapPass) {
                    bool isTemp = (tapPass < 0);
                    ivec2 tapCoord = prevCoord;
                    if (!isTemp) {
                        uint tap = uint(tapPass);
                        uint tapIdx = isV4DiCapture
                            ? (((tapHash >> 28u) & 2u) + tap)
                            : (hasCamMotion
                                ? (8u + ((tapOff + tap * 7u) % 24u))
                                : (manyLightScene
                                    ? (((tapHash >> 27u) + tap) & 7u)
                                    : (((tapHash >> 24u) + tap * 7u) & 31u)));
                        ivec2 base = RESTIR_TAP_OFFSETS[tapIdx];
                        if ((rot & 1u) != 0u) base = ivec2(-base.y, base.x);
                        if ((rot & 2u) != 0u) base = -base;
                        tapCoord += base;
                    }
                    if (tapCoord.x >= 0 && tapCoord.y >= 0 &&
                        tapCoord.x < int(pc.width) && tapCoord.y < bandH) {
                        float prevTapDepth = imageLoad(uPrevNormalDepthImage, tapCoord).w;
                        float relDepthDiff = abs(expectedPrevDepth - prevTapDepth) / max(max(expectedPrevDepth, prevTapDepth), 1e-4);
                        float depthGate = isTemp ? 0.06 : spatDiDepthGate;
                        if (relDepthDiff <= depthGate) {
                            DiReservoir src = historyReservoirs[uint(tapCoord.y) * pc.width + uint(tapCoord.x)];
                            uint ageNew = isTemp ? min(restirGetAge(src.flags) + 1u, RESTIR_MAX_AGE) : restirGetAge(src.flags);
                            uint tapMCap = isTemp ? tempMCap : spatMCap;
                            bool clampW = isTemp ? (hasCamMotion || manyLightScene) : true;
                            if (restirDiApplyTap(r, sel, src, pc.numLights, effEnvIntensity, hitPoint, hitNormal, hitT, expectedPrevHitT,
                                                 V, diffuseColor, F0, alphaRoughness, diffTrans,
                                                 tapMCap, ageNew, false, clampW, restirSeed)) {
                                winnerIsFresh = false;
                                needReconnect = false;
                            }
                        }
                    }
                    if (isTemp) {
                        historyOut = r;
                    }
                }
            }

            historyOut.flags &= DI_FLAG_HISTORY_MASK;
            currentReservoirs[pixelIndex] = historyOut;

            if (isV4DiCapture && ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) == 0u) && pc.sppSampleIndex == 0u) {
                float restirMNorm = float(min(restirGetM(r.idxM), 64u)) / 64.0;
                vec4 prevSa = imageLoad(uMlSpecAlbedoImage, px);
                imageStore(uMlSpecAlbedoImage, px, vec4(prevSa.rgb, restirMNorm));
            }

            if (sel.has && needReconnect) {
                vec3 rDir;
                float rDist;
                vec3 rEmit;
                float rCosL = 1.0;
                bool reconOk = (sel.lightIdx == RESTIR_LIGHT_IDX_ENV)
                    ? reconnectEnvDirectPath(sel.luv, effEnvIntensity, rDir, rDist, rEmit)
                    : reconnectDirectPath(hitPoint, lights[sel.lightIdx], sel.luv, rDir, rDist, rEmit, rCosL);
                if (reconOk) {
                    float rawNdotL = dot(hitNormal, rDir);
                    bool isTrans = (rawNdotL < 0.0 && diffTrans > 0.001);
                    sel.dir = rDir;
                    sel.dist = rDist;
                    sel.emission = rEmit;
                    sel.cosLight = rCosL;
                    sel.isTrans = isTrans;
                    sel.ndotL = isTrans ? -rawNdotL : clamp(rawNdotL, 0.0, 1.0);
                } else {
                    sel.has = false;
                }
            }

            if (sel.has && sel.target > 1e-6) {
                float neeBsdfPdf = 0.0;
                vec3 neeSpecFCos;
                vec3 neeFCos = stdBsdfEvalSplit(bsdf, hitNormal, V, sel.dir, neeBsdfPdf, neeSpecFCos);

                float misWeight = 1.0;
                bool winIsEnv = (sel.lightIdx == RESTIR_LIGHT_IDX_ENV);
                if (winIsEnv) {
                    float pEnv = (pc.numLights == 0u) ? 1.0 : envNeeSelectProb();
                    float envPdfEff = evalEnvMapPdf(sel.dir) * pEnv;
                    float diMisScale = diRestirMisActive ? restirDiMisLightScale(pc.numLights, pc.captureMlData) : 1.0;
                    misWeight = envNeeMisWeightScaled(envPdfEff, neeBsdfPdf, hasCont, diMisScale);
                } else {
                    Light selLight = lights[sel.lightIdx];
                    uint selType = uint(selLight.position.w);
                    if ((selType == 0u || selType == 3u) && lightUsesMis(sel.lightIdx)) {
                        float selPdf = misLightSelectPdf(sel.lightIdx, hitPoint, pc.numLights);
                        float effCos = max(sel.cosLight, 1e-4);
                        float effDist = max(sel.dist, 1e-4);
                        float lightPdfEff = ((effDist * effDist) / (selLight.emission.w * effCos)) * selPdf;
                        float diMisScale = diRestirMisActive ? restirDiMisLightScale(pc.numLights, pc.captureMlData) : 1.0;
                        misWeight = neeMisWeightScaled(sel.lightIdx, lightPdfEff, neeBsdfPdf, hasCont, diMisScale);
                    }
                }

                uint finalM = restirGetM(r.idxM);
                float risWeight = (finalM > 0u && sel.target > 1e-6) ? (r.wSum / (float(finalM) * sel.target)) : 0.0;
                if (pc.numLights <= 4096u) {
                    uint selLightType = winIsEnv ? 2u : uint(lights[sel.lightIdx].position.w);
                    float motionRisClamp = winIsEnv ? 40.0 : ((selLightType == 0u || selLightType == 3u) ? 40.0 : 100.0);
                    risWeight = clamp(risWeight, 0.0, hasCamMotionRestir ? motionRisClamp : 500.0);
                }

                float factor = misWeight * risWeight;
                vec3 neeScale = sel.emission * factor;
                f16vec3 diffBrdf = f16vec3(clamp((neeFCos - neeSpecFCos) * neeScale, vec3(0.0), vec3(65500.0)));
                f16vec3 specBrdf = f16vec3(clamp(neeSpecFCos * neeScale, vec3(0.0), vec3(65500.0)));
                f16vec3 secDirectL = diffBrdf + specBrdf;
                if (pc.numLights > 4096u) {
                    float maxDirectLum = (pc.captureMlData != 0u) ? 30.0 : 60.0;
                    float secLum = dot(vec3(secDirectL), vec3(0.2126, 0.7152, 0.0722));
                    if (secLum > maxDirectLum) {
                        float sc = maxDirectLum / secLum;
                        diffBrdf *= float16_t(sc);
                        specBrdf *= float16_t(sc);
                        secDirectL = diffBrdf + specBrdf;
                    }
                }

                float invSpp = (ubo.spp > 0u) ? (1.0 / float(ubo.spp)) : 1.0;
                f16vec3 unshadowed = secDirectL;

                if (length(vec3(unshadowed)) > 1e-5) {
                    if (!enableShadows || (winnerVisVerified && winnerIsFresh)) {
                        if (pc.captureMlData == 0u || (pc.captureMlData & ML_CAPTURE_KEEP_ACCUM_BIT) != 0u) {
                            vec4 prev = imageLoad(uAccumImage, px);
                            imageStore(uAccumImage, px, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed) * invSpp, seed), prev.a));
                        }
                        f16vec3 diffUnshadowed = mergeMatteSpec ? secDirectL : diffBrdf;
                        f16vec3 specUnshadowed = mergeMatteSpec ? f16vec3(0.0) : specBrdf;
                        if ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) != 0u) {
                            if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                                wfAddCompactMlIrradiance(px, vec3(diffUnshadowed) * invSpp, vec3(specUnshadowed) * invSpp);
                            }
                        } else {
                            wfAddSplitDirect(px, vec3(diffUnshadowed) * invSpp, vec3(specUnshadowed) * invSpp, pc.captureMlData, seed);
                            if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                                if (dot(vec3(diffUnshadowed), vec3(diffUnshadowed)) > 1e-10) {
                                    vec3 scaledDiff = vec3(diffUnshadowed) * invSpp;
                                    vec3 outDiff = isV4DiCapture
                                        ? demodulateMlSafe(scaledDiff, imageLoad(uMlAlbedoRoughnessImage, px).rgb)
                                        : scaledDiff;
                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, px);
                                    imageStore(uMlDiffuseImage, px, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                                }
                                if (dot(vec3(specUnshadowed), vec3(specUnshadowed)) > 1e-10) {
                                    vec3 scaledSpec = vec3(specUnshadowed) * invSpp;
                                    vec3 outSpec = isV4DiCapture
                                        ? demodulateMlSafe(scaledSpec, imageLoad(uMlSpecAlbedoImage, px).rgb)
                                        : scaledSpec;
                                    vec4 prevSpec = imageLoad(uMlSpecularImage, px);
                                    imageStore(uMlSpecularImage, px, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                                }
                            }
                        }
                    } else {
                        vec3 shadowOrigin = sel.isTrans ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                        float diffShadowLum = dot(vec3(diffBrdf), vec3(0.2126, 0.7152, 0.0722));
                        float specShadowLum = dot(vec3(specBrdf), vec3(0.2126, 0.7152, 0.0722));
                        float shadowSpecCode = mergeMatteSpec ? 0.0 : clamp(specShadowLum / max(diffShadowLum + specShadowLum, 1e-8), 0.0, 1.0);
                        hasShadowRay = true;
                        shadowCandidate.originDist = vec4(shadowOrigin, sel.dist);
                        shadowCandidate.dirPixelRad = uvec4(
                            packOct32(sel.dir),
                            pixelIndex,
                            packHalf2x16(vec2(unshadowed.rg)),
                            packHalf2x16(vec2(unshadowed.b, shadowSpecCode))
                        );
                    }
                }
            }
        }
    }

    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (shadowWaveCount > 0u) {
        if (subgroupElect()) {
            shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
        }
        shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);
    }

    if (hasShadowRay) {
        uint targetIdxShadow = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdxShadow < pc.maxQueueCapacity) {
            shadowRays[targetIdxShadow] = shadowCandidate;
        }
    }

    memoryBarrierBuffer();
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        uint numWgs = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        uint retired = atomicAdd(queueCounters.pad[0], 1u);
        if (retired == numWgs - 1u) {
            queueCounters.pad[0] = 0u;
            uint cnt = atomicExchange(queueCounters.shadowRayCount, 0u);
            queueCounters.currentShadowCount = cnt;
            indirect.commands[4u].x = (cnt + 31u) / 32u;
            indirect.commands[4u].y = 1u;
            indirect.commands[4u].z = 1u;
            indirect.commands[4u].pad = cnt;
        }
    }
}
