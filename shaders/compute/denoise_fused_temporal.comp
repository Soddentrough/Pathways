#version 460
#extension GL_KHR_shader_subgroup_arithmetic : enable

// =============================================================================
// PASS 1: Fused Edge-Aware Spatiotemporal Accumulator (E-SVGF)
// Reference: docs/design/adaptive_svgf_denoiser_proposal.md Section 4.2 / Pass 1
//
//  * 16x16 workgroup, 3-pixel G-buffer source apron (22x22 LDS load domain)
//  * In-LDS multi-channel Sobel (Albedo 0.5 / Depth 0.3 / Normal 0.2) with
//    analytical vector bounds 4*sqrt(6) (albedo) and 8*sqrt(2) (normals)
//  * Tile-local statistical thresholding:
//      T_tile = max(mu_tile + 1.2 * max(sigma_tile, sigmaMin), noiseFloor)
//    plus contrast floor delta_min rejection
//  * In-LDS 5x5 spatial edge density rho_spatial
//  * Dual-model reprojection validation (static 6-DOF affine depth test vs.
//    dynamic-object motion sample depth test w/ relaxed normal threshold)
//  * Specular VMV reprojection track with hit-distance consistency validation
//  * Conservative bilateral-gated 8-neighbor current-sample firefly
//    soft-clamping (strictly excluding center; emissive bypass)
//  * Pre-spatial history update + dual-channel edge density packing:
//      m_edgeDensity R = raw rho^t, G = effective rho_eff^t
// =============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "denoise_common.glsl"

// -----------------------------------------------------------------------------
// Camera matrices UBO (std140, 160 bytes)
// -----------------------------------------------------------------------------
layout(std140, set = 0, binding = 0) uniform CameraMatricesUBO {
    mat4 currViewToPrevView;        // 64 bytes (offset 0)
    mat3 prevViewToCurrViewRot;     // std140: 3 columns of vec4 = 48 bytes (offset 64)
    vec2 currCameraJitter;          // 8 bytes (offset 112), UV units
    vec2 prevCameraJitter;          // 8 bytes (offset 120), UV units
    float tanHalfFovY;              // 4 bytes (offset 128)
    float aspectRatio;              // 4 bytes (offset 132)
    float prevTanHalfFovY;          // 4 bytes (offset 136)
    float prevAspectRatio;          // 4 bytes (offset 140)
    vec4 _padTail;                  // 16 bytes (offset 144)
} uCamera;

layout(set = 0, binding = 1,  rgba16f) readonly uniform image2D uCurrentDiffuse;   // RGB radiance, A emissive flag
layout(set = 0, binding = 2,  rgba16f) readonly uniform image2D uCurrentSpecular;  // RGB radiance, A d_refl
layout(set = 0, binding = 3,  rgba16f) readonly uniform image2D uMotionVectors;    // 2.5D MV: RG = UV delta, B = PrevLinearZ - CurrLinearZ
layout(set = 0, binding = 4,  rgba16f) readonly uniform image2D uSpecularMotion;  // Reflection VMV (RG = uv delta, engine packs RG inside RGBA16F)
layout(set = 0, binding = 5,  rgba16f) readonly uniform image2D uNormalDepth;
layout(set = 0, binding = 6,  rgba16f) readonly uniform image2D uPrevNormalDepth;
layout(set = 0, binding = 7,  rgba16f) readonly uniform image2D uAlbedoRoughness;
layout(set = 0, binding = 8,  rgba16f) readonly uniform image2D uHistoryDiffuse;   // A = V^d
layout(set = 0, binding = 9,  rgba16f) readonly uniform image2D uHistorySpecular;  // A = V^s
layout(set = 0, binding = 10, rgba16f) readonly uniform image2D uHistoryMoments;   // M1d, M2d, M1s, M2s
layout(set = 0, binding = 11, rgba16f) readonly uniform image2D uHistoryLength;    // Ndiff, Nspec, d_prev_refl, dyn
layout(set = 0, binding = 12, rg8)     readonly uniform image2D uPrevEdgeDensity;  // R: raw rho^(t-1)

layout(set = 0, binding = 13, rgba16f) writeonly uniform image2D uOutDiffuse;      // -> m_historyDiffuse[currSlot]
layout(set = 0, binding = 14, rgba16f) writeonly uniform image2D uOutSpecular;     // -> m_historySpecular[currSlot]
layout(set = 0, binding = 15, rgba16f) writeonly uniform image2D uOutMoments;      // -> m_historyMoments[currSlot]
layout(set = 0, binding = 16, rgba16f) writeonly uniform image2D uOutHistoryLength;// -> m_historyLength[currSlot]
layout(set = 0, binding = 17, rg8)     writeonly uniform image2D uOutEdgeDensity;  // -> m_edgeDensity[currSlot]
layout(set = 0, binding = 18, rgba16f) writeonly uniform image2D uOutNormalDepth;  // -> m_historyNormalDepth[currSlot]
layout(set = 0, binding = 19, rgba16f) readonly uniform image2D uFfxDirectDiffuse;   // AMD FSR Ray Regeneration Signal 0
layout(set = 0, binding = 20, rgba16f) readonly uniform image2D uFfxDirectSpecular;  // AMD FSR Ray Regeneration Signal 1
layout(set = 0, binding = 21, rgba16f) readonly uniform image2D uFfxIndirectDiffuse; // AMD FSR Ray Regeneration Signal 2 (.a = hitT)
layout(set = 0, binding = 22, rgba16f) readonly uniform image2D uFfxIndirectSpecular;// AMD FSR Ray Regeneration Signal 3 (.a = hitT)

layout(push_constant) uniform PushConstants {
    uint  width;
    uint  height;
    uint  resetHistory;
    float maxHistoryLength;          // 32.0
    float weightAlbedo;              // 0.50
    float weightDepth;               // 0.30
    float weightNormal;              // 0.20
    float sigmaMultiplier;           // 1.20
    float noiseFloor;                // 0.05 (T_min)
    float contrastFloor;             // 0.02 (delta_min)
    float sigmaMin;                  // 0.02
    float temporalAlpha;             // 0.15 (alpha_rho)
    float normalThreshold;           // 0.85 static
    float normalThresholdDynamic;    // 0.50 dynamic
    float depthThreshold;            // 0.08 static
    float dynamicDepthThreshold;     // 0.15 dynamic
    float mvDiscrepancyThreshold;    // 2.0 px
    uint  isRayRegeneration;         // 1 = AMD FSR Ray Regeneration 4-Signal + HitT pipeline
    float _pad[2];
} pc;

// AMD FidelityFX Denoiser (Ray Regeneration 1.2.1) split-sum BRDF demodulation factor
vec3 ffxApproximateSpecBrdf(vec3 specAlbedo, float roughness, float NoV) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4( 1.0,  0.0425,  1.04, -0.04);
    vec4 r = roughness * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * clamp(NoV, 0.0, 1.0))) * r.x + r.y;
    vec2 AB = vec2(-1.04, 1.04) * a004 + r.zw;
    vec3 f0 = mix(vec3(0.04), clamp(specAlbedo, vec3(0.04), vec3(1.0)), 0.5);
    return max(f0 * AB.x + vec3(AB.y), vec3(0.05));
}

// -----------------------------------------------------------------------------
// LDS: Structure of Arrays (SoA) layout with odd stride 23 to eliminate
// 32-bank conflicts.
// -----------------------------------------------------------------------------
#define APRON      3
#define SRC_DIM    22   // 16 + 2*3 G-buffer source domain
#define SRC_STRIDE 23
#define SOBEL_DIM  20   // 16 + 2*2 Sobel / edge-mask domain
#define SOBEL_STRIDE 23

shared float s_albedoR[SRC_DIM][SRC_STRIDE];
shared float s_albedoG[SRC_DIM][SRC_STRIDE];
shared float s_albedoB[SRC_DIM][SRC_STRIDE];
shared float s_normalX[SRC_DIM][SRC_STRIDE];
shared float s_normalY[SRC_DIM][SRC_STRIDE];
shared float s_normalZ[SRC_DIM][SRC_STRIDE];
shared float s_linearDepth[SRC_DIM][SRC_STRIDE];
shared float s_localDiffuseLum[SRC_DIM][SRC_STRIDE];
shared float s_localSpecularLum[SRC_DIM][SRC_STRIDE];
shared float s_sobelGrad[SOBEL_DIM][SOBEL_STRIDE];   // 20x20 Sobel domain, then binary edge mask
shared vec2  s_reductionScratch[16];                 // Subgroup moments reduction scratch (<= 16 waves)
shared vec2  s_muThreshold;                          // Broadcast (mu_tile, T_tile)

// -----------------------------------------------------------------------------
// In-LDS Sobel gradient evaluation
// -----------------------------------------------------------------------------

vec3 sampleAlbedoLDS(ivec2 ldsPos) {
    return vec3(s_albedoR[ldsPos.y][ldsPos.x], s_albedoG[ldsPos.y][ldsPos.x], s_albedoB[ldsPos.y][ldsPos.x]);
}

vec3 sampleNormalLDS(ivec2 ldsPos) {
    return vec3(s_normalX[ldsPos.y][ldsPos.x], s_normalY[ldsPos.y][ldsPos.x], s_normalZ[ldsPos.y][ldsPos.x]);
}

vec2 computeAlbedoGradientLDS(ivec2 ldsCoord) {
    vec3 gX = -1.0 * sampleAlbedoLDS(ldsCoord + ivec2(-1, -1)) + 1.0 * sampleAlbedoLDS(ldsCoord + ivec2(1, -1))
              -2.0 * sampleAlbedoLDS(ldsCoord + ivec2(-1,  0)) + 2.0 * sampleAlbedoLDS(ldsCoord + ivec2(1,  0))
              -1.0 * sampleAlbedoLDS(ldsCoord + ivec2(-1,  1)) + 1.0 * sampleAlbedoLDS(ldsCoord + ivec2(1,  1));

    vec3 gY = -1.0 * sampleAlbedoLDS(ldsCoord + ivec2(-1, -1)) - 2.0 * sampleAlbedoLDS(ldsCoord + ivec2(0, -1)) - 1.0 * sampleAlbedoLDS(ldsCoord + ivec2(1, -1))
              +1.0 * sampleAlbedoLDS(ldsCoord + ivec2(-1,  1)) + 2.0 * sampleAlbedoLDS(ldsCoord + ivec2(0,  1)) + 1.0 * sampleAlbedoLDS(ldsCoord + ivec2(1,  1));

    return vec2(length(gX), length(gY));
}

// Metric plane-relative depth residual gradient (Section 8 FM1 mitigation).
// Precomputes linear view-plane projection coefficients so each 3x3 Sobel tap
// evaluates in 2 FMAs instead of a full 3D unprojection + dot product.
float computePlaneRelativeDepthGradientLDS(ivec2 ldsCenter, ivec2 tileOrigin, float tanHalfFovY, float aspectRatio, vec2 resolution) {
    float zP = s_linearDepth[ldsCenter.y][ldsCenter.x];
    if (zP >= 9999.0) {
        return 0.0;
    }
    vec3 nP = sampleNormalLDS(ldsCenter);
    // Convert GLM right-handed view normal (+Y up, -Z forward) to unprojectToView space (+Y down, +Z forward)
    vec3 nPView = vec3(nP.x, -nP.y, -nP.z);
    ivec2 imgMax = ivec2(int(pc.width) - 1, int(pc.height) - 1);
    ivec2 rawP = tileOrigin + ldsCenter - ivec2(APRON);
    ivec2 globalP = clamp(rawP, ivec2(0), imgMax);

    float kx = aspectRatio * tanHalfFovY * nPView.x;
    float ky = tanHalfFovY * nPView.y;
    float scaleX = (2.0 * kx) / resolution.x;
    float scaleY = (2.0 * ky) / resolution.y;
    float bias = nPView.z - kx - ky;

    float px = float(globalP.x) + 0.5;
    float py = float(globalP.y) + 0.5;
    float planeP = zP * (px * scaleX + py * scaleY + bias);
    float invFootprint = 1.0 / max(2.0 * zP * tanHalfFovY / resolution.y, zP * 0.0009765625);

    float r00, r01, r02, r10, r12, r20, r21, r22;
    {
        float x0 = ( float(clamp(rawP.x - 1, 0, imgMax.x)) + 0.5 ) * scaleX + bias;
        float x1 = px * scaleX + bias;
        float x2 = ( float(clamp(rawP.x + 1, 0, imgMax.x)) + 0.5 ) * scaleX + bias;
        float y0 = ( float(clamp(rawP.y - 1, 0, imgMax.y)) + 0.5 ) * scaleY;
        float y1 = py * scaleY;
        float y2 = ( float(clamp(rawP.y + 1, 0, imgMax.y)) + 0.5 ) * scaleY;

        int cy = ldsCenter.y;
        int cx = ldsCenter.x;
        r00 = abs(s_linearDepth[cy - 1][cx - 1] * (x0 + y0) - planeP) * invFootprint;
        r01 = abs(s_linearDepth[cy - 1][cx    ] * (x1 + y0) - planeP) * invFootprint;
        r02 = abs(s_linearDepth[cy - 1][cx + 1] * (x2 + y0) - planeP) * invFootprint;
        r10 = abs(s_linearDepth[cy    ][cx - 1] * (x0 + y1) - planeP) * invFootprint;
        r12 = abs(s_linearDepth[cy    ][cx + 1] * (x2 + y1) - planeP) * invFootprint;
        r20 = abs(s_linearDepth[cy + 1][cx - 1] * (x0 + y2) - planeP) * invFootprint;
        r21 = abs(s_linearDepth[cy + 1][cx    ] * (x1 + y2) - planeP) * invFootprint;
        r22 = abs(s_linearDepth[cy + 1][cx + 1] * (x2 + y2) - planeP) * invFootprint;
    }

    float gX = (r02 - r00) + 2.0 * (r12 - r10) + (r22 - r20);
    float gY = (r20 - r00) + 2.0 * (r21 - r01) + (r22 - r02);
    return length(vec2(gX, gY));
}

// Complete multi-channel in-LDS Sobel gradient evaluation (Pass 1, Step 2)
float evaluateSobelGradientLDS(ivec2 ldsCenter, ivec2 tileOrigin) {
    vec2 resolution = vec2(float(pc.width), float(pc.height));

    // 1. Albedo gradient (4*sqrt(6) analytical vector bound)
    vec2 gradAlbedo = computeAlbedoGradientLDS(ldsCenter);
    float gAlbedo = length(gradAlbedo) * (1.0 / (4.0 * sqrt(6.0)));

    // 2. Normal gradient (8*sqrt(2) analytical unit-sphere bound)
    vec3 nX =
        -1.0 * sampleNormalLDS(ldsCenter + ivec2(-1, -1)) + 1.0 * sampleNormalLDS(ldsCenter + ivec2(1, -1))
        -2.0 * sampleNormalLDS(ldsCenter + ivec2(-1,  0)) + 2.0 * sampleNormalLDS(ldsCenter + ivec2(1,  0))
        -1.0 * sampleNormalLDS(ldsCenter + ivec2(-1,  1)) + 1.0 * sampleNormalLDS(ldsCenter + ivec2(1,  1));
    vec3 nY =
        -1.0 * sampleNormalLDS(ldsCenter + ivec2(-1, -1)) - 2.0 * sampleNormalLDS(ldsCenter + ivec2(0, -1)) - 1.0 * sampleNormalLDS(ldsCenter + ivec2(1, -1))
        +1.0 * sampleNormalLDS(ldsCenter + ivec2(-1,  1)) + 2.0 * sampleNormalLDS(ldsCenter + ivec2(0,  1)) + 1.0 * sampleNormalLDS(ldsCenter + ivec2(1,  1));
    float gNormal = sqrt(dot(nX, nX) + dot(nY, nY)) * (1.0 / (8.0 * sqrt(2.0)));

    // 3. Plane-relative depth gradient residual
    float gDepth = computePlaneRelativeDepthGradientLDS(ldsCenter, tileOrigin, uCamera.tanHalfFovY, uCamera.aspectRatio, resolution);
    gDepth = clamp(gDepth * (1.0 / 8.0), 0.0, 1.0);

    // Multi-channel convex fusion (Albedo 0.50, Depth 0.30, Normal 0.20)
    return pc.weightAlbedo * clamp(gAlbedo, 0.0, 1.0)
         + pc.weightDepth   * clamp(gDepth, 0.0, 1.0)
         + pc.weightNormal  * clamp(gNormal, 0.0, 1.0);
}

// -----------------------------------------------------------------------------
// Fused bilateral neighbor statistics + firefly soft-clamping (Section 5.6)
// -----------------------------------------------------------------------------

// Single-pass 3x3 bilateral neighbor moment accumulation for BOTH diffuse and
// specular lobes simultaneously (strictly excluding center sample).
// Replaces 4 separate 3x3 LDS loops with 1 shared loop.
float computeBilateralNeighborMomentsBothLDS(
    ivec2 ldsCoord,
    vec3 centerNorm,
    float centerDepth,
    out float outMuDiff, out float outSigmaDiff,
    out float outMuSpec, out float outSigmaSpec)
{
    outMuDiff = 0.0;
    outSigmaDiff = 0.0;
    outMuSpec = 0.0;
    outSigmaSpec = 0.0;

    float m1D = 0.0, m2D = 0.0;
    float m1S = 0.0, m2S = 0.0;
    float validNeighbors = 0.0;
    float invCenterDepth = 1.0 / max(centerDepth, 1e-4);

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue; // STRICTLY EXCLUDE CENTER SAMPLE
            int ny = ldsCoord.y + dy;
            int nx = ldsCoord.x + dx;

            // Bilateral consistency: reject samples crossing silhouettes into background
            vec3 nbrNorm = sampleNormalLDS(ivec2(nx, ny));
            float nbrDepth = s_linearDepth[ny][nx];
            bool geomConsistent = (dot(centerNorm, nbrNorm) > 0.70) &&
                                  (abs(centerDepth - nbrDepth) * invCenterDepth < 0.10);
            if (!geomConsistent) continue;

            float lumD = s_localDiffuseLum[ny][nx];
            float lumS = s_localSpecularLum[ny][nx];
            m1D += lumD;
            m2D += lumD * lumD;
            m1S += lumS;
            m2S += lumS * lumS;
            validNeighbors += 1.0;
        }
    }

    if (validNeighbors > 0.0) {
        float invN = 1.0 / validNeighbors;
        outMuDiff = m1D * invN;
        outSigmaDiff = sqrt(max(0.0, (m2D * invN) - outMuDiff * outMuDiff));
        outMuSpec = m1S * invN;
        outSigmaSpec = sqrt(max(0.0, (m2S * invN) - outMuSpec * outMuSpec));
    }
    return validNeighbors;
}

vec3 suppressFirefliesWithMoments(vec3 rawCurrRadiance, float validNeighbors, float mu, float sigma, bool isDiffuseLobe, bool isEmissive) {
    if (isEmissive || validNeighbors < 3.0) {
        return rawCurrRadiance;
    }

    float minFireflyLum = isDiffuseLobe ? 4.0 : 8.0;
    float lumThreshold = max(mu + 3.0 * sigma, minFireflyLum);
    float currLum = denoiseLuminance(rawCurrRadiance);
    if (currLum > lumThreshold && currLum > 1e-4) {
        // Soft-clamp preserving chromaticity (smooth asymptotic rolloff)
        float clampedLum = lumThreshold + (currLum - lumThreshold) / (1.0 + (currLum - lumThreshold) / max(lumThreshold, 0.5));
        return rawCurrRadiance * (clampedLum / currLum);
    }
    return rawCurrRadiance;
}

// -----------------------------------------------------------------------------
// Dual-model camera-motion-compensated reprojection validation (Section 5.3)
// -----------------------------------------------------------------------------

bool validateReprojection(
    vec3 currNormal,
    vec3 prevNormal,
    float currDepth,
    float prevDepth,
    ivec2 prevCoord,
    ivec2 currCoord,
    vec2 prevUV,
    vec2 resolution,
    out bool isDynamicObject)
{
    isDynamicObject = false;

    // 1. Screen bounds check & sky-vs-geometry transition guard
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        return false;
    }
    bool currIsSky = (currDepth >= 9999.0);
    bool prevIsSky = (prevDepth >= 9999.0);
    if (currIsSky != prevIsSky) {
        return false;
    }
    if (currIsSky) {
        return true;
    }

    // 2. Pure camera rotation compensation for view normals
    vec3 prevNormalInCurrView = normalize(mat3(uCamera.prevViewToCurrViewRot) * prevNormal);
    float normalCloseness = dot(currNormal, prevNormalInCurrView);

    // 3. Unproject current pixel to metric 3D view space (unjittered pixel center)
    vec3 currViewPos = unprojectToView(currCoord, currDepth, uCamera.tanHalfFovY, uCamera.aspectRatio, resolution);

    // 4. Exact 6-DOF affine view-to-view transformation
    vec4 prevViewPos = uCamera.currViewToPrevView * vec4(currViewPos, 1.0);
    float zExpected = prevViewPos.z;

    // 5. Motion vector discrepancy test (dynamic object detection hint).
    //    Both uMotionVectors and unprojectToView operate in unjittered pixel-center
    //    coordinates, so expectedPrevUV and prevUV are directly comparable without jitter bias.
    float prevAspect = (uCamera.prevAspectRatio > 1e-4) ? uCamera.prevAspectRatio : uCamera.aspectRatio;
    float prevTanFov = (uCamera.prevTanHalfFovY > 1e-4) ? uCamera.prevTanHalfFovY : uCamera.tanHalfFovY;
    vec2 expectedNDC = prevViewPos.xy / (vec2(prevAspect, 1.0) * prevTanFov * max(zExpected, 1e-4));
    vec2 expectedPrevUV = expectedNDC * 0.5 + 0.5;
    vec2 discrepancyPixels = abs(prevUV - expectedPrevUV) * resolution;

    if (length(discrepancyPixels) > pc.mvDiscrepancyThreshold) {
        // Dynamic object branch: lazily fetch 2x2 neighborhood depth bounds only for dynamic pixels
        isDynamicObject = true;
        if (normalCloseness < pc.normalThresholdDynamic) {
            return false;
        }
        vec2 prevDepthMinMax = vec2(prevDepth, prevDepth);
        ivec2 maxPrevCoord = ivec2(int(pc.width) - 1, int(pc.height) - 1);
        for (int dy = 0; dy <= 1; ++dy) {
            for (int dx = 0; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0) continue;
                ivec2 nc = clamp(prevCoord + ivec2(dx, dy), ivec2(0), maxPrevCoord);
                float zPrev = imageLoad(uPrevNormalDepth, nc).w;
                prevDepthMinMax.x = min(prevDepthMinMax.x, zPrev);
                prevDepthMinMax.y = max(prevDepthMinMax.y, zPrev);
            }
        }
        float depthRelDiffDynamic = (currDepth < prevDepthMinMax.x || currDepth > prevDepthMinMax.y)
            ? abs(currDepth - prevDepth) / max(currDepth, 1e-4)
            : 0.0;
        return (depthRelDiffDynamic < pc.dynamicDepthThreshold);
    } else {
        // Static rigid geometry branch: affine predicted depth + grazing-angle-aware tolerance
        // (accounts for sub-pixel Halton camera jitter across steep slopes and curved surfaces)
        if (normalCloseness < (pc.normalThreshold - 0.03)) {
            return false;
        }
        if (zExpected <= 1e-4) {
            return false;
        }
        float grazingFactor = 1.0 + 1.5 * (1.0 - abs(currNormal.z));
        float depthRelDiffStatic = abs(zExpected - prevDepth) / max(zExpected, 1e-3);
        return (depthRelDiffStatic < pc.depthThreshold * grazingFactor);
    }
}

// -----------------------------------------------------------------------------
// Main: cooperative LDS load -> in-LDS Sobel -> tile reduction -> edge density
//        -> dual-model reprojection -> firefly clamp -> history + edge outputs
// -----------------------------------------------------------------------------

void main() {
    ivec2 tileOrigin = ivec2(gl_WorkGroupID.xy) * ivec2(16, 16);
    uint linearThreadIdx = gl_LocalInvocationIndex;
    uint tx = linearThreadIdx % 16u;
    uint ty = linearThreadIdx / 16u;
    ivec2 coord = tileOrigin + ivec2(tx, ty);

    vec2 resolution = vec2(float(pc.width), float(pc.height));
    ivec2 imgMax = ivec2(int(pc.width) - 1, int(pc.height) - 1);
    bool inBounds = (coord.x < int(pc.width)) && (coord.y < int(pc.height));

    // ------------------------------------------------------------------
    // 1. Register-cached center load + single-pass border apron load:
    //    Each thread loads its own (tx, ty) pixel into registers (reused in
    //    Step 5 with zero VRAM reloads) and populates the 16x16 LDS interior.
    //    Threads 0..227 load the 228 border apron texels in a single pass.
    // ------------------------------------------------------------------
    ivec2 clampedSelfCoord = clamp(coord, ivec2(0), imgMax);
    vec4 curAlbRough = imageLoad(uAlbedoRoughness, clampedSelfCoord);
    vec4 curND = imageLoad(uNormalDepth, clampedSelfCoord);
    vec3 curN = curND.xyz;
    float curZ = curND.w;
    vec3 curAlb = curAlbRough.rgb;
    float curRoughness = curAlbRough.a;
    vec3 demodAlb = denoiseDemodulationFactor(curAlb, curZ);

    vec4 curDiffTex = imageLoad(uCurrentDiffuse, clampedSelfCoord);
    vec4 curSpecTex = (curRoughness < 0.70 || pc.isRayRegeneration != 0u)
        ? imageLoad(uCurrentSpecular, clampedSelfCoord)
        : vec4(0.0);
    vec3 rawCurrDiff = curDiffTex.rgb / demodAlb;

    ivec2 ldsCoord = ivec2(int(tx) + APRON, int(ty) + APRON);
    s_albedoR[ldsCoord.y][ldsCoord.x] = curAlb.r;
    s_albedoG[ldsCoord.y][ldsCoord.x] = curAlb.g;
    s_albedoB[ldsCoord.y][ldsCoord.x] = curAlb.b;
    s_normalX[ldsCoord.y][ldsCoord.x] = curN.x;
    s_normalY[ldsCoord.y][ldsCoord.x] = curN.y;
    s_normalZ[ldsCoord.y][ldsCoord.x] = curN.z;
    s_linearDepth[ldsCoord.y][ldsCoord.x] = curZ;
    s_localDiffuseLum[ldsCoord.y][ldsCoord.x] = denoiseLuminance(rawCurrDiff);
    s_localSpecularLum[ldsCoord.y][ldsCoord.x] = denoiseLuminance(curSpecTex.rgb);

    if (linearThreadIdx < 228u) {
        int ldsX, ldsY;
        if (linearThreadIdx < 66u) {
            ldsY = int(linearThreadIdx / 22u);
            ldsX = int(linearThreadIdx % 22u);
        } else if (linearThreadIdx < 132u) {
            uint u = linearThreadIdx - 66u;
            ldsY = 19 + int(u / 22u);
            ldsX = int(u % 22u);
        } else {
            uint u = linearThreadIdx - 132u;
            ldsY = 3 + int(u / 6u);
            int c = int(u % 6u);
            ldsX = (c < 3) ? c : (16 + c);
        }
        ivec2 globalCoord = clamp(tileOrigin + ivec2(ldsX - APRON, ldsY - APRON), ivec2(0), imgMax);
        vec4 alb = imageLoad(uAlbedoRoughness, globalCoord);
        vec4 normDepth = imageLoad(uNormalDepth, globalCoord);

        s_albedoR[ldsY][ldsX] = alb.r;
        s_albedoG[ldsY][ldsX] = alb.g;
        s_albedoB[ldsY][ldsX] = alb.b;
        s_normalX[ldsY][ldsX] = normDepth.x;
        s_normalY[ldsY][ldsX] = normDepth.y;
        s_normalZ[ldsY][ldsX] = normDepth.z;
        s_linearDepth[ldsY][ldsX] = normDepth.w;

        // Only the 1-pixel border ring [2..19]x[2..19] is accessed by 3x3 bilateral neighbor moments
        if (ldsX >= 2 && ldsX <= 19 && ldsY >= 2 && ldsY <= 19) {
            vec3 bDemodAlb = denoiseDemodulationFactor(alb.rgb, normDepth.w);
            vec3 bDiff = imageLoad(uCurrentDiffuse, globalCoord).rgb / bDemodAlb;
            vec3 bSpec = (alb.a < 0.70 || pc.isRayRegeneration != 0u)
                ? imageLoad(uCurrentSpecular, globalCoord).rgb
                : vec3(0.0);
            s_localDiffuseLum[ldsY][ldsX] = denoiseLuminance(bDiff);
            s_localSpecularLum[ldsY][ldsX] = denoiseLuminance(bSpec);
        }
    }
    barrier();

    // ------------------------------------------------------------------
    // 2. Evaluate 20x20 Sobel gradients (400 samples) in LDS
    // ------------------------------------------------------------------
    for (uint i = linearThreadIdx; i < 400u; i += 256u) {
        int sy = int(i / 20u);
        int sx = int(i % 20u);
        ivec2 ldsCenter = ivec2(sx + 1, sy + 1); // [1, 20] in 22x22 domain
        s_sobelGrad[sy][sx] = evaluateSobelGradientLDS(ldsCenter, tileOrigin);
    }
    barrier();

    // ------------------------------------------------------------------
    // 3. Subgroup-accelerated reduction for tile moments (mu, sigma^2) over 400 samples
    // ------------------------------------------------------------------
    {
        float g1 = s_sobelGrad[linearThreadIdx / 20u][linearThreadIdx % 20u];
        vec2 localMoment = vec2(g1, g1 * g1);
        if (linearThreadIdx < 144u) {
            uint remIdx = 256u + linearThreadIdx;
            float g2 = s_sobelGrad[remIdx / 20u][remIdx % 20u];
            localMoment += vec2(g2, g2 * g2);
        }
        vec2 sgSum = subgroupAdd(localMoment);
        if (subgroupElect()) {
            s_reductionScratch[gl_SubgroupID] = sgSum;
        }
        barrier();

        if (linearThreadIdx == 0u) {
            vec2 waveSum = vec2(0.0);
            for (uint s = 0u; s < gl_NumSubgroups; ++s) {
                waveSum += s_reductionScratch[s];
            }
            float mu = waveSum.x * (1.0 / 400.0);
            float var = max(0.0, (waveSum.y * (1.0 / 400.0)) - mu * mu);
            float sigma = sqrt(var);
            // Statistical adaptive threshold with variance + noise floors
            float threshold = max(mu + pc.sigmaMultiplier * max(sigma, pc.sigmaMin), pc.noiseFloor);
            s_muThreshold = vec2(mu, threshold);
        }
        barrier();
    }

    float muTile = s_muThreshold.x;
    float thresholdTile = s_muThreshold.y;

    // ------------------------------------------------------------------
    // 4. Binary edge mask over the 20x20 Sobel domain (in-place)
    //    M_edge = 1 iff (M >= T_tile) AND (M - mu_tile >= delta_min)
    // ------------------------------------------------------------------
    for (uint i = linearThreadIdx; i < 400u; i += 256u) {
        int sy = int(i / 20u);
        int sx = int(i % 20u);
        float m = s_sobelGrad[sy][sx];
        s_sobelGrad[sy][sx] = (m >= thresholdTile && (m - muTile) >= pc.contrastFloor) ? 1.0 : 0.0;
    }
    barrier();

    // ------------------------------------------------------------------
    // 5. Per-pixel processing for the 16x16 output domain
    // ------------------------------------------------------------------
    if (!inBounds) {
        return; // All collective work complete; safe to exit
    }

    // 5x5 box filter spatial edge density (mask domain index = global - tileOrigin + 2)
    float rhoSpatial = 0.0;
    int maskCy = int(ty) + 2;
    int maskCx = int(tx) + 2;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            rhoSpatial += s_sobelGrad[maskCy + dy][maskCx + dx];
        }
    }
    rhoSpatial *= (1.0 / 25.0);

    vec4 specMotionTex = (curRoughness < 0.70) ? imageLoad(uSpecularMotion, coord) : vec4(0.0);
    bool isEmissive = curDiffTex.a > 0.5;
    // RTXPT DenoiseSpecHitT: 3x3 bilateral spatial filter on glossy specular Hit-T & VMV using LDS Normal/Depth
    // Skip on transmissive primary surfaces (marked with specMotionTex.z < 0.0)
    if (pc.resetHistory == 0u && specMotionTex.z >= 0.0 && curRoughness < 0.25 && curZ < 9999.0 &&
        (curRoughness > 0.015 || specMotionTex.a <= 1e-4) && specMotionTex.a < 999.0) {
        bool centerValid = (specMotionTex.a > 1e-4);
        vec4 smAccum = centerValid ? specMotionTex : vec4(0.0);
        float wSum = centerValid ? 1.0 : 0.0;
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0) continue;
                float qZ = s_linearDepth[ldsCoord.y + dy][ldsCoord.x + dx];
                if (qZ >= 9999.0) continue;
                vec3 qN = sampleNormalLDS(ldsCoord + ivec2(dx, dy));
                float relZ = abs(curZ - qZ) / max(max(curZ, qZ), 0.1);
                float nSim = max(dot(curN, qN), 0.0);
                float nSim2 = nSim * nSim;
                float nSim4 = nSim2 * nSim2;
                float w = exp(-relZ * 20.0) * (nSim4 * nSim4);
                if (w > 1e-3) {
                    ivec2 qp = clamp(coord + ivec2(dx, dy), ivec2(0), imgMax);
                    vec4 qSm = imageLoad(uSpecularMotion, qp);
                    if (qSm.a > 1e-4 && qSm.a < 999.0) {
                        smAccum += qSm * w;
                        wSum += w;
                    }
                }
            }
        }
        if (wSum > 1e-3) {
            specMotionTex = smAccum / wSum;
        }
    }
    float dRefl = specMotionTex.a;

    // ---------------- Primary reprojection ----------------
    vec2 uv = (vec2(coord) + 0.5) / resolution;
    vec2 mv = imageLoad(uMotionVectors, coord).xy;
    vec2 prevUV = uv - mv;
    ivec2 prevCoord = ivec2(floor(prevUV * resolution));

    bool valid = false;
    bool isDynamic = false;
    float prevNDiff = 1.0;
    vec4 prevND = vec4(0.0);
    vec4 prevHistLenPrimary = vec4(0.0);

    if (pc.resetHistory == 0u &&
        prevCoord.x >= 0 && prevCoord.y >= 0 &&
        prevCoord.x < int(pc.width) && prevCoord.y < int(pc.height)) {

        prevND = imageLoad(uPrevNormalDepth, prevCoord);
        valid = validateReprojection(curN, prevND.xyz, curZ, prevND.w, prevCoord,
                                     coord, prevUV, resolution, isDynamic);
    }

    // ---------------- Temporal edge density fusion ----------------
    // Channel R preserves the RAW temporal state rho^t (estimator integrity);
    // Channel G stores history-modulated rho_eff for downstream spatial passes.
    float rho = rhoSpatial;
    if (pc.resetHistory == 0u && valid) {
        float prevRho = imageLoad(uPrevEdgeDensity, prevCoord).r;
        rho = (1.0 - pc.temporalAlpha) * prevRho + pc.temporalAlpha * rhoSpatial;
    }

    // ---------------- Diffuse history length ----------------
    bool stationaryPixel = !isDynamic && (dot(mv * resolution, mv * resolution) <= 0.0025);
    float nDiff = 1.0;
    if (valid) {
        prevHistLenPrimary = imageLoad(uHistoryLength, prevCoord);
        prevNDiff = prevHistLenPrimary.r;
        float maxDiffHist = isDynamic ? 8.0 : (stationaryPixel ? 256.0 : pc.maxHistoryLength);
        nDiff = min(prevNDiff + 1.0, maxDiffHist);
    }

    // ---------------- Specular VMV reprojection track ----------------
    // When stochastic lobe selection did not spawn a specular bounce-1 ray at
    // this pixel in the current frame (dRefl <= 1e-4), fall back to primary mv.
    vec2 specMv = (dRefl > 1e-4) ? specMotionTex.rg : mv;
    vec2 prevUVSpec = uv - specMv;
    ivec2 prevCoordSpec = ivec2(floor(prevUVSpec * resolution));
    bool sameSpecCoord = (prevCoordSpec == prevCoord);

    bool validSpec = false;
    float nSpec = 1.0;
    float dOutRefl = dRefl;
    if (pc.resetHistory == 0u &&
        prevUVSpec.x >= 0.0 && prevUVSpec.x <= 1.0 &&
        prevUVSpec.y >= 0.0 && prevUVSpec.y <= 1.0 &&
        prevCoordSpec.x >= 0 && prevCoordSpec.y >= 0 &&
        prevCoordSpec.x < int(pc.width) && prevCoordSpec.y < int(pc.height)) {

        if (sameSpecCoord && valid && stationaryPixel && dRefl <= 1e-4) {
            // Fast path: stationary primary pixel with no VMV offset reuses already-validated primary history
            validSpec = true;
            nSpec = min(prevHistLenPrimary.g + 1.0, 128.0);
            dOutRefl = prevHistLenPrimary.b;
        } else {
            vec4 prevNDSpec = (sameSpecCoord && valid) ? prevND : imageLoad(uPrevNormalDepth, prevCoordSpec);
            bool currIsSky = (curZ >= 9999.0);
            bool prevSpecIsSky = (prevNDSpec.w >= 9999.0);

            if (currIsSky == prevSpecIsSky) {
                vec3 prevNormalSpecInCurr = normalize(mat3(uCamera.prevViewToCurrViewRot) * prevNDSpec.xyz);
                float normalClosenessSpec = dot(curN, prevNormalSpecInCurr);

                vec4 prevHistLenSpec = (sameSpecCoord && valid) ? prevHistLenPrimary : imageLoad(uHistoryLength, prevCoordSpec);
                float dPrevRefl = prevHistLenSpec.b;

                vec3 currViewPos = unprojectToView(coord, curZ, uCamera.tanHalfFovY, uCamera.aspectRatio, resolution);
                float zExpectedSurf = (uCamera.currViewToPrevView * vec4(currViewPos, 1.0)).z;
                float surfDepthRelDiff = currIsSky ? 0.0 : (abs(zExpectedSurf - prevNDSpec.w) / max(zExpectedSurf, 1e-3));
                bool reflectorDepthConsistent = currIsSky || (surfDepthRelDiff < 0.12) || (valid && sameSpecCoord);

                bool hasBothReflDist = (dRefl > 1e-4) && (dPrevRefl > 1e-4);
                bool stationaryMatch = valid && sameSpecCoord && stationaryPixel;
                bool hitDistConsistent = stationaryMatch ||
                    (hasBothReflDist
                        ? (abs(dRefl - dPrevRefl) / max(max(dRefl, dPrevRefl), 1e-3) < 0.20)
                        : valid);

                if ((currIsSky || normalClosenessSpec > 0.82) && reflectorDepthConsistent && hitDistConsistent) {
                    validSpec = true;
                    float maxSpecHist = isDynamic ? 8.0 : (stationaryMatch ? 128.0 : (pc.isRayRegeneration != 0u ? 24.0 : 16.0));
                    nSpec = min(prevHistLenSpec.g + 1.0, maxSpecHist);
                    if (dOutRefl <= 1e-4) {
                        dOutRefl = dPrevRefl;
                    }
                }
            }
        }
    }

    // ---------------- Fused bilateral moments & firefly suppression ----------------
    float muNDiff = 0.0, sigmaNDiff = 0.0;
    float muNSpec = 0.0, sigmaNSpec = 0.0;
    float validNeighbors = computeBilateralNeighborMomentsBothLDS(
        ldsCoord, curN, curZ, muNDiff, sigmaNDiff, muNSpec, sigmaNSpec);

    vec3 currDiff = suppressFirefliesWithMoments(rawCurrDiff, validNeighbors, muNDiff, sigmaNDiff, true, isEmissive);
    float mirrorBypass = 1.0 - smoothstep(0.02, 0.08, curRoughness);
    vec3 currSpec = mix(suppressFirefliesWithMoments(curSpecTex.rgb, validNeighbors, muNSpec, sigmaNSpec, false, isEmissive),
                        curSpecTex.rgb, mirrorBypass);

    float lumDiff = denoiseLuminance(currDiff);
    float lumSpec = denoiseLuminance(currSpec);

    // Center-inclusive spatial variance (SVGF Section 4.2)
    float centerDevDiff = lumDiff - muNDiff;
    float varSpatialDiff = (validNeighbors >= 3.0)
        ? (sigmaNDiff * sigmaNDiff + centerDevDiff * centerDevDiff)
        : 0.01;
    float centerDevSpec = lumSpec - muNSpec;
    float varSpatialSpec = (lumSpec <= 1e-5 && muNSpec <= 1e-5)
        ? 0.0
        : ((validNeighbors >= 3.0) ? (sigmaNSpec * sigmaNSpec + centerDevSpec * centerDevSpec) : 0.01);

    // Motion indicators (in pixel units)
    vec2 mvPx = mv * resolution;
    vec2 specMvPx = specMv * resolution;
    bool hasMotion = isDynamic || (dot(mvPx, mvPx) > 0.0025);
    bool hasSpecMotion = isDynamic || (dot(specMvPx, specMvPx) > 0.0025) || hasMotion;

    // ---------------- Temporal accumulation ----------------
    vec3 accDiff = currDiff;
    vec3 accSpec = currSpec;
    vec4 accMom;
    vec4 prevMomPrimary = vec4(0.0);
    float varDiff;
    float varSpec;

    if (valid) {
        vec4 prevDiffTex = imageLoad(uHistoryDiffuse, prevCoord);
        vec4 prevMom = imageLoad(uHistoryMoments, prevCoord);
        prevMomPrimary = prevMom;

        if (hasMotion && validNeighbors >= 3.0) {
            float prevLumD = denoiseLuminance(prevDiffTex.rgb);
            float tempSigmaD = sqrt(max(0.0, prevMom.y - prevMom.x * prevMom.x));
            float denomD = max(max(sigmaNDiff, tempSigmaD), 0.05 * max(prevLumD, muNDiff) + 0.01);
            float deltaLD = abs(prevLumD - muNDiff) / denomD;
            float threshD = 2.5;
            if (deltaLD > threshD) {
                float react = clamp((deltaLD - threshD) / 4.0, 0.0, 0.85);
                nDiff = mix(nDiff, 2.0, react);
            }
        }

        float minAlphaDiff = hasMotion ? 0.03 : (pc.isRayRegeneration != 0u ? 0.004 : 0.005);
        float alphaDiff = max(1.0 / nDiff, minAlphaDiff);
        accDiff = mix(prevDiffTex.rgb, currDiff, alphaDiff);

        accMom.x = mix(prevMom.x, lumDiff, alphaDiff);
        accMom.y = mix(prevMom.y, lumDiff * lumDiff, alphaDiff);
        varDiff = max(0.0, accMom.y - accMom.x * accMom.x);

        // SVGF Section 4.2: supplement noisy temporal moments with spatial variance when N < 4,
        // and decay variance by 1 / max(1, N * 0.25) as temporal history converges.
        float spatialBlendD = clamp(1.0 - (nDiff - 1.0) / 3.0, 0.0, 1.0);
        varDiff = mix(varDiff, max(varDiff, varSpatialDiff), spatialBlendD);
        varDiff = max(varDiff, varSpatialDiff * 0.25);
    } else {
        accMom.x = lumDiff;
        accMom.y = lumDiff * lumDiff + varSpatialDiff;
        varDiff = varSpatialDiff;
    }

    if (validSpec && stationaryPixel && curRoughness >= 0.70 && lumSpec <= 1e-5 && muNSpec <= 1e-5 && dRefl <= 1e-4) {
        accSpec = vec3(0.0);
        accMom.z = 0.0;
        accMom.w = 0.0;
        varSpec = 0.0;
    } else if (validSpec) {
        vec4 prevSpecTex = imageLoad(uHistorySpecular, prevCoordSpec);
        vec4 prevMom = (sameSpecCoord && valid) ? prevMomPrimary : imageLoad(uHistoryMoments, prevCoordSpec);

        if (hasSpecMotion && validNeighbors >= 3.0) {
            float prevLumS = denoiseLuminance(prevSpecTex.rgb);
            float tempSigmaS = sqrt(max(0.0, prevMom.w - prevMom.z * prevMom.z));
            float denomS = max(max(sigmaNSpec, tempSigmaS), 0.05 * max(prevLumS, muNSpec) + 0.01);
            float deltaLS = abs(prevLumS - muNSpec) / denomS;
            float threshS = 2.0;
            if (deltaLS > threshS) {
                float reactS = clamp((deltaLS - threshS) / 3.5, 0.0, 0.85);
                nSpec = mix(nSpec, 1.5, reactS);
            }
        }

        float minAlphaSpec = hasSpecMotion ? (pc.isRayRegeneration != 0u ? 0.05 : 0.08) : (pc.isRayRegeneration != 0u ? 0.008 : 0.01);
        float alphaSpec = max(1.0 / nSpec, minAlphaSpec);
        accSpec = mix(prevSpecTex.rgb, currSpec, alphaSpec);

        accMom.z = mix(prevMom.z, lumSpec, alphaSpec);
        accMom.w = mix(prevMom.w, lumSpec * lumSpec, alphaSpec);
        varSpec = max(0.0, accMom.w - accMom.z * accMom.z);

        float spatialBlendS = clamp(1.0 - (nSpec - 1.0) / 3.0, 0.0, 1.0);
        varSpec = mix(varSpec, max(varSpec, varSpatialSpec), spatialBlendS);
    } else {
        accMom.z = lumSpec;
        accMom.w = lumSpec * lumSpec + varSpatialSpec;
        varSpec = varSpatialSpec;
    }

    // ---------------- Dual-channel effective edge density ----------------
    float rhoEffective = rho * clamp(nDiff / 8.0, 0.25, 1.0);
    if (pc.isRayRegeneration != 0u) {
        float histFactor = clamp(nDiff / 12.0, 0.0, 1.0);
        varDiff *= mix(1.35, 0.90, histFactor);
        rhoEffective = rho * clamp(nDiff / 10.0, 0.20, 1.0);
    }

    // ---------------- Outputs (finite FP16 range clamp prevents Inf) ----------------
    vec3 outDiff = clamp(accDiff, 0.0, 65000.0);
    vec3 outSpec = clamp(accSpec, 0.0, 65000.0);
    float clampedVarDiff = clamp(varDiff, 0.0, 65000.0);
    float clampedVarSpec = clamp(varSpec, 0.0, 65000.0);
    bool hasSpecChannel = (curRoughness < 0.70 || denoiseLuminance(outSpec) > 1e-5 || clampedVarSpec > 1e-6);
    float packedVarDiff = hasSpecChannel ? -max(clampedVarDiff, 1e-5) : clampedVarDiff;

    imageStore(uOutDiffuse, coord, vec4(outDiff, packedVarDiff));
    if (hasSpecChannel) {
        imageStore(uOutSpecular, coord, vec4(outSpec, clampedVarSpec));
    }
    imageStore(uOutMoments, coord, clamp(accMom, 0.0, 65000.0));
    imageStore(uOutHistoryLength, coord, vec4(nDiff, nSpec, dOutRefl, isDynamic ? 1.0 : 0.0));
    imageStore(uOutNormalDepth, coord, curND);
    imageStore(uOutEdgeDensity, coord, vec4(clamp(rho, 0.0, 1.0), clamp(rhoEffective, 0.0, 1.0), 0.0, 0.0));
}
