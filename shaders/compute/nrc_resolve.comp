#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D uAccumImage;

layout(std430, set = 0, binding = 1) buffer AtomicAccumBuffer {
    uvec2 nrcAtomicPairs[];
};

layout(set = 0, binding = 2, rgba16f) uniform image2D uMlDiffuseImage;
layout(set = 0, binding = 3, rgba16f) uniform image2D uMlSpecularImage;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint captureMlData;
    uint pad;
} pc;

uint pcg_hash(inout uint seed) {
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return (word >> 22u) ^ word;
}

float randFloat(inout uint seed) {
    return float(pcg_hash(seed)) / 4294967296.0;
}

vec3 randVec3(inout uint seed) {
    return vec3(randFloat(seed), randFloat(seed), randFloat(seed));
}

vec3 addFp16Stochastic(vec3 accum, vec3 val, inout uint seed) {
    if (isnan(val.r) || isnan(val.g) || isnan(val.b) || isinf(val.r) || isinf(val.g) || isinf(val.b)) return accum;
    return accum + max(val, vec3(0.0));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) return;

    uint pixelIdx = uint(pixelCoord.y * int(pc.width) + pixelCoord.x);
    uint pairBase = pixelIdx * 3u;

    uvec2 p0 = nrcAtomicPairs[pairBase + 0u];
    uvec2 p1 = nrcAtomicPairs[pairBase + 1u];
    uvec2 p2 = nrcAtomicPairs[pairBase + 2u];
    uint diffR = p0.x;
    uint diffG = p0.y;
    uint diffB = p1.x;
    uint specR = p1.y;
    uint specG = p2.x;
    uint specB = p2.y;

    if ((diffR | diffG | diffB | specR | specG | specB) != 0u) {
        vec3 radDiff = vec3(float(diffR), float(diffG), float(diffB)) / 65536.0;
        vec3 radSpec = vec3(float(specR), float(specG), float(specB)) / 65536.0;
        vec3 radTotal = radDiff + radSpec;
        uint seed = uint(pixelIdx * 1973u) | 1u;
        if ((pc.captureMlData & 1u) == 0u || (pc.captureMlData & 2u) != 0u) {
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, radTotal, seed), prev.a));
        }

        if ((pc.captureMlData & 1u) != 0u) {
            if ((diffR | diffG | diffB) != 0u) {
                vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, radDiff, seed), prevDiff.a));
            }
            if ((specR | specG | specB) != 0u) {
                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, radSpec, seed), prevSpec.a));
            }
        }

        // Reset non-zero accumulator pairs back to zero for the next frame
        if ((p0.x | p0.y) != 0u) nrcAtomicPairs[pairBase + 0u] = uvec2(0u);
        if ((p1.x | p1.y) != 0u) nrcAtomicPairs[pairBase + 1u] = uvec2(0u);
        if ((p2.x | p2.y) != 0u) nrcAtomicPairs[pairBase + 2u] = uvec2(0u);
    }
}
