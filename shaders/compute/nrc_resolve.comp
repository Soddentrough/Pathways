#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define ML_CAPTURE_UPWAYS_V4_BIT 4u
#define ML_CAPTURE_SPLIT_4SIG_BIT 8u

layout(set = 0, binding = 0) uniform image2D uAccumImage;

layout(std430, set = 0, binding = 1) buffer AtomicAccumBuffer {
    uvec2 nrcAtomicPairs[];
};

layout(set = 0, binding = 2, rgba16f) uniform image2D uMlDiffuseImage;
layout(set = 0, binding = 3, rgba16f) uniform image2D uMlSpecularImage;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D uMlAlbedoRoughnessImage;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D uMlSpecAlbedoImage;
layout(set = 0, binding = 6, rgba16f) uniform image2D uIndirectDiffuseImage;
layout(set = 0, binding = 7, rgba16f) uniform image2D uIndirectSpecularImage;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint captureMlData;
    uint pad;
} pc;

uint pcg_hash(inout uint seed) {
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return (word >> 22u) ^ word;
}

float randFloat(inout uint seed) {
    return float(pcg_hash(seed)) / 4294967296.0;
}

vec3 randVec3(inout uint seed) {
    return vec3(randFloat(seed), randFloat(seed), randFloat(seed));
}

vec3 demodulateMlSafe(vec3 rad, vec3 demodFactor) {
    bool valid = any(greaterThan(demodFactor, vec3(1e-4)));
    vec3 safeDenom = valid ? max(demodFactor, vec3(0.02)) : vec3(1.0);
    return min(rad / safeDenom, vec3(65000.0));
}

vec3 addFp16Stochastic(vec3 accum, vec3 val, inout uint seed) {
    if (isnan(val.r) || isnan(val.g) || isnan(val.b) || isinf(val.r) || isinf(val.g) || isinf(val.b)) return accum;
    return accum + max(val, vec3(0.0));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) return;

    uint pixelIdx = uint(pixelCoord.y * int(pc.width) + pixelCoord.x);
    uint pairBase = pixelIdx * 3u;

    uvec2 p0 = nrcAtomicPairs[pairBase + 0u];
    uvec2 p1 = nrcAtomicPairs[pairBase + 1u];
    uvec2 p2 = nrcAtomicPairs[pairBase + 2u];
    uint diffR = p0.x;
    uint diffG = p0.y;
    uint diffB = p1.x;
    uint specR = p1.y;
    uint specG = p2.x;
    uint specB = p2.y;

    if ((diffR | diffG | diffB | specR | specG | specB) != 0u) {
        vec3 radDiff = vec3(float(diffR), float(diffG), float(diffB)) / 65536.0;
        vec3 radSpec = vec3(float(specR), float(specG), float(specB)) / 65536.0;
        vec3 radTotal = radDiff + radSpec;
        uint seed = uint(pixelIdx * 1973u) | 1u;
        if ((pc.captureMlData & 1u) == 0u || (pc.captureMlData & 2u) != 0u) {
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, radTotal, seed), prev.a));
        }

        const bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
        const bool isSplit4 = (pc.captureMlData & ML_CAPTURE_SPLIT_4SIG_BIT) != 0u;

        if ((pc.captureMlData & 1u) != 0u && (isV4 || !isSplit4)) {
            if ((diffR | diffG | diffB) != 0u) {
                vec3 contribDiff = isV4 ? demodulateMlSafe(radDiff, imageLoad(uMlAlbedoRoughnessImage, pixelCoord).rgb) : radDiff;
                vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, contribDiff, seed), prevDiff.a));
            }
            if ((specR | specG | specB) != 0u) {
                vec3 contribSpec = isV4 ? demodulateMlSafe(radSpec, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb) : radSpec;
                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, contribSpec, seed), prevSpec.a));
            }
        }

        if (isSplit4) {
            if ((diffR | diffG | diffB) != 0u) {
                vec4 prevIndDiff = imageLoad(uIndirectDiffuseImage, pixelCoord);
                imageStore(uIndirectDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevIndDiff.rgb, radDiff, seed), prevIndDiff.a));
            }
            if ((specR | specG | specB) != 0u) {
                vec4 prevIndSpec = imageLoad(uIndirectSpecularImage, pixelCoord);
                imageStore(uIndirectSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevIndSpec.rgb, radSpec, seed), prevIndSpec.a));
            }
        }

        // Reset non-zero accumulator pairs back to zero for the next frame
        if ((p0.x | p0.y) != 0u) nrcAtomicPairs[pairBase + 0u] = uvec2(0u);
        if ((p1.x | p1.y) != 0u) nrcAtomicPairs[pairBase + 1u] = uvec2(0u);
        if ((p2.x | p2.y) != 0u) nrcAtomicPairs[pairBase + 2u] = uvec2(0u);
    }
}
