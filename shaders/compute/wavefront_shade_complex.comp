#version 460
#ifndef IS_SECONDARY_BOUNCE
#define IS_SECONDARY_BOUNCE 0
#endif
#ifndef ENABLE_NRC
#define ENABLE_NRC 0
#endif
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_nonuniform_qualifier : enable

#include "wavefront_common.glsl"
#include "wavefront_radiance_output.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 23, rgba16f) uniform readonly image2D uMotionVectorImage;
layout(binding = 26, rgba16f) uniform readonly image2D uMlAlbedoRoughnessImage;
layout(binding = 27, rgba16f) uniform image2D uMlSpecularMotionImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 31, rgba16f) uniform readonly image2D uCausticImage;
layout(binding = 24, rgba16f) uniform readonly image2D uNormalDepthImage;
layout(binding = 33, rgba16f) uniform readonly image2D uPrevNormalDepthImage;
layout(binding = 40, rgba16f) uniform image2D uMlSkipImage;
layout(binding = 41, rgba16f) uniform image2D uMlSpecAlbedoImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
DECLARE_SCENE_TEXTURES_BINDING(8)

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 18) readonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(std430, binding = 19) writeonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

#if ENABLE_NRC
layout(std430, binding = 20) writeonly buffer OutNRCQueryQueue {
    NRCQuery nrcQueries[];
};

layout(std430, binding = 21) buffer InOutNRCTrainQueue {
    NRCTrainingRecord nrcTrainRecords[];
};

layout(std430, binding = 22) buffer InOutNRCCounters {
    NRCCountersBuffer nrcCounters;
};
#endif

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

#ifndef ENABLE_RESTIR_PT
#define ENABLE_RESTIR_PT 0
#endif

#define RESTIR_INCLUDE_SAMPLER_HELPERS
#include "restir_common.glsl"
#include "bsdf_standard.glsl"
#include "mis_common.glsl"

#if ENABLE_RESTIR_PT
#if !IS_SECONDARY_BOUNCE
layout(std430, binding = 32) buffer ReSTIRCurrentReservoirsBuffer {
    DiReservoir currentReservoirs[];
};

layout(std430, binding = 36) readonly buffer ReSTIRHistoryReservoirsBuffer {
    DiReservoir historyReservoirs[];
};
#endif

// ReSTIR GI (path-space) state — docs/RESTIR_PT_DESIGN.md. Complex primary
// surfaces invalidate X1/GI; complex secondary hits from diffuse X1 surfaces
// run GI reuse over the complementary domain in the IS_SECONDARY_BOUNCE variant.
layout(std430, binding = 37) buffer X1ContextsBuffer {
    X1Context x1Contexts[];
};

layout(std430, binding = 38) buffer GiCurrentReservoirsBuffer {
    uvec2 giCurrentData[];
};
#endif

#ifndef ENABLE_INLINE_SHADOWS
#if IS_SECONDARY_BOUNCE && !ENABLE_NRC
#define ENABLE_INLINE_SHADOWS 0
#else
#define ENABLE_INLINE_SHADOWS 1
#endif
#endif

#if ENABLE_INLINE_SHADOWS
#include "wavefront_shadow_inline.glsl"
#endif

#if IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
#define ENABLE_RESTIR_GI 1
#else
#define ENABLE_RESTIR_GI 0
#endif

layout(push_constant) uniform PushConstants {
    WavefrontShadePC pc;
};

#if ENABLE_NRC
#include "nrc_record_helper.glsl"
#endif
#if !IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
#include "restir_di_inline.glsl"
#endif

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint activeCount = queueCounters.currentMaterialCounts[1]; // Complex queue
    bool inRange = (idx < activeCount);
    bool survivesToNext = false;
    bool hasShadowRay = false;
    vec3 nextDirection = vec3(0.0);
    RayGeometry nextGeom;
    RayState nextState;
    PackedShadowRay shadowCandidate;
#if IS_SECONDARY_BOUNCE && ENABLE_NRC
    bool emitTransNrcQuery = false;
    vec3 transNrcPos = vec3(0.0);
    float transNrcRough = 1.0;
    vec3 transNrcNormal = vec3(0.0, 1.0, 0.0);
    float transNrcSpecFlag = 0.0;
    vec3 transNrcView = vec3(0.0, 0.0, 1.0);
    float transNrcSpecRatio = 0.0;
    vec3 transNrcThroughput = vec3(0.0);
    uint transNrcPixelIdx = 0u;
#endif

    if (inRange) {
        uint rayIdx = materialIndices[1u * pc.maxQueueCapacity + idx];
        RayGeometry geom = inGeoms[rayIdx];
        RayHit hit = inHits[rayIdx];
        RayState state = inStates[rayIdx];

        vec3 origin = geom.originPackedDir.xyz;
        vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        float hitT;
        uint matId, hitType;
        vec3 hitNormal, geomTan;
        vec2 hitUv;
        float tanSign;
        unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

        f16vec3 throughput;
        uint seed, pixelIndex;
        bool isSpecularPath, causticApplied;
        uint dispersionChannel = 0u;
        unpackRayState(state, throughput, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
        bool inNrcSkip = unpackRayNrcSkip(state);
        uint bounce = pc.currentBounce;
        bool sampledSpecularLobe = false;
        float invSpp = (ubo.spp > 0u) ? (1.0 / float(ubo.spp)) : 1.0;

#if ENABLE_RESTIR_PT
        // ReSTIR PT bookkeeping: complex primary surfaces stay in pure MC + DI;
        // complex secondary hits from diffuse X1 surfaces trigger GI reuse on
        // the complementary domain (M = 1, w_self = 0).
        bool enableRestirFlag = ((ubo.flags & (1u << 9)) != 0u);
#if IS_SECONDARY_BOUNCE
        uvec2 x1Nw = (enableRestirFlag && bounce == 1u) ? x1Contexts[pixelIndex].data.xw : uvec2(0u);
        uint x1FlagsB1 = x1Nw.y;
        uint giX1N1Oct32 = x1Nw.x;
        bool giHasCtx = (x1FlagsB1 & X1_FLAG_VALID) != 0u;
        bool giHasDiRestirMis = (x1FlagsB1 & X1_FLAG_DI_RESTIR_MIS) != 0u;
        bool giHasSelfCandidate = false;
        uint giSelfN2Oct = 0u;
        f16vec3 giL2 = f16vec3(0.0);
#endif
#endif

        if (hitType == 2u) {
#if ENABLE_RESTIR_PT && !IS_SECONDARY_BOUNCE
            if (enableRestirFlag && bounce == 0u && pc.sppSampleIndex == 0u) {
                giCurrentData[pixelIndex].y = 0u;
            }
#endif
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            uint skyPdfCode = unpackRayPdfCode(state);
            float skyMisW = 1.0;
            if (bounce > 0u && pc.hasEnvMap == 1u && envNeeActive() && pc.envMapIntensity > 0.0) {
                float skyLightScale = (bounce >= 2u)
                    ? restirSecondaryMisLightScale(bounce - 1u, pc.numLights, pc.captureMlData, pc.enableNrc)
                    : 1.0;
#if ENABLE_RESTIR_PT
#if IS_SECONDARY_BOUNCE
                if (enableRestirFlag && bounce == 1u && giHasDiRestirMis) {
                    skyLightScale = restirDiMisLightScale(pc.numLights, pc.captureMlData);
                }
#else
                if (enableRestirFlag && bounce == 1u && x1ContextHasDiRestirMis(x1Contexts[pixelIndex])) {
                    skyLightScale = restirDiMisLightScale(pc.numLights, pc.captureMlData);
                }
#endif
#endif
                skyMisW = envHitMisWeightScaled(rayDir, skyPdfCode, pc.numLights, skyLightScale);
            }
            vec3 skyContrib = vec3(throughput) * skyColor * skyMisW;
            if (bounce > 0u) {
                float effClamp = computeAdaptiveFireflyClamp(pc.indirectClamp, skyPdfCode);
                skyContrib = clampIndirectRadiance(skyContrib, effClamp);
            }
            skyContrib *= invSpp;
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), prev.a));
            }


            if (pc.captureMlData != 0u) {
                bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                bool isMlDenoiser = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
                if (isMlDenoiser && bounce == 0u) {
                    vec4 prevSkip = imageLoad(uMlSkipImage, pixelCoord);
                    imageStore(uMlSkipImage, pixelCoord, vec4(addFp16Stochastic(prevSkip.rgb, skyContrib, seed), prevSkip.a));
                } else {
                    if (bounce > 0u) {
                        wfAddSplitIndirect(pixelCoord,
                                           isSpecularPath ? vec3(0.0) : skyContrib,
                                           isSpecularPath ? skyContrib : vec3(0.0),
                                           pc.captureMlData, seed);
                    }
                    if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                        if (isSpecularPath) {
                            vec3 outSpec = isV4
                                ? demodulateMlSafe(skyContrib, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb)
                                : skyContrib;
                            vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                            imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                        } else {
                            vec3 outDiff = isV4
                                ? demodulateMlSafe(skyContrib, imageLoad(uMlAlbedoRoughnessImage, pixelCoord).rgb)
                                : skyContrib;
                            vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                            imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                        }
                    }
                }
            }
            RECORD_SPECULAR_VMV(pixelIndex, origin + rayDir * 1000.0, 10000.0, true);
            RECORD_DIFFUSE_HIT_DIST(pixelIndex, 10000.0, true);
#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
            if (giHasCtx) {
                giCurrentData[pixelIndex] = giPackEmptyMeta(restirPackOct16FromOct32(giX1N1Oct32), 1u);
            }
#endif
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            RECORD_SPECULAR_VMV(pixelIndex, hitPoint, hitT, false);
            RECORD_DIFFUSE_HIT_DIST(pixelIndex, hitT, false);
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            hitNormal = frontFace ? hitNormal : -hitNormal;
            vec3 geomFrontNormal = hitNormal;

#if !IS_SECONDARY_BOUNCE
            Material mat = materials[matId];
            uint matType = mat.type;
            uint matAlbedoTex = mat.albedoTex;
            uint matMrTex = mat.mrTex;
            uint matEmissiveTex = mat.emissiveTex;
            vec4 matAlbedo = mat.albedo;
            uint matAlphaMode = mat.alphaMode;
            float matAlphaCutoff = mat.alphaCutoff;
            bool hasSampledTex = ((mat.albedoTex | mat.normalTex | mat.mrTex | mat.emissiveTex |
                                   mat.transmissionTex | mat.thicknessTex | mat.clearcoatTex |
                                   mat.clearcoatRoughnessTex | mat.clearcoatNormalTex |
                                   mat.specularTex | mat.sheenTex | mat.diffuseTransmissionTex) != 0u);
#else
            ShadeMaterial sm = shadeMaterials[matId];
            uint matType = smGetTypeFlags(sm);
            uint matAlbedoTex = smGetAlbedoTex(sm);
            uint matMrTex = smGetMrTex(sm);
            uint matEmissiveTex = smGetEmissiveTex(sm);
            vec4 matAlbedo = sm.albedo;
            uint matAlphaMode = smGetAlphaMode(sm);
            float matAlphaCutoff = smGetAlphaCutoff(sm);
            bool hasSampledTex = ((matAlbedoTex | matEmissiveTex | matMrTex) != 0u);
#endif
            uint inPdfCode = unpackRayPdfCode(state);
            float rayConeBaseLod = hasSampledTex
                ? computeRayConeBaseLod(hit.hitData1.w >> 16u, hitT, rayDir, hitNormal,
                                        2.0 * abs(ubo.projInverse[1][1]) / float(max(pc.height, 1u)),
                                        bounce, inPdfCode)
                : -16.0;
#if !IS_SECONDARY_BOUNCE
            if (bounce == 0u && hitType == 0u && mat.normalTex > 0u && mat.normalTex <= 512u) {
                vec3 normalMap = SAMPLE_SCENE_TEXTURE_LOD(mat.normalTex, hitUv, rayConeBaseLod).rgb * 2.0 - 1.0;
                normalMap.xy *= mat.normalScale;
                normalMap = normalize(normalMap);

                geomTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
                vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                hitNormal = adjustShadingNormal(normalize(tbn * normalMap), -rayDir);
            }
#endif

            vec4 baseColorFull = matAlbedo;
            if (matAlbedoTex > 0u && matAlbedoTex <= 512u) {
                baseColorFull *= SAMPLE_SCENE_TEXTURE_LOD(matAlbedoTex, hitUv, rayConeBaseLod);
            }
            bool isCutout = (matAlphaMode == 1u && baseColorFull.a < matAlphaCutoff) ||
                            (matAlphaMode == 2u && randFloat(seed) > baseColorFull.a);
            if (isCutout) {
#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
                if (giHasCtx) {
                    giCurrentData[pixelIndex] = giPackEmptyMeta(restirPackOct16FromOct32(giX1N1Oct32), 1u);
                }
#endif
#if ENABLE_RESTIR_PT && !IS_SECONDARY_BOUNCE
                if (enableRestirFlag && bounce == 0u) {
                    x1Contexts[pixelIndex].data.w = 0u;
                    if (pc.sppSampleIndex == 0u) {
                        currentReservoirs[pixelIndex].flags = 0u;
                        giCurrentData[pixelIndex].y = 0u;
                    }
                }
#endif
                if (bounce + 1u < pc.maxBounces) {
                    survivesToNext = true;
                    nextDirection = rayDir;
                    vec3 nextOrigin = hitPoint + rayDir * 0.001;
                    nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                    nextState = packRayState(throughput, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel, inPdfCode, inNrcSkip);
                }
            } else {
            f16vec3 baseColor = f16vec3(baseColorFull.rgb);
            bool routeAllToSpec = (bounce > 0u) && isSpecularPath;
            bool pathTerminated = ((matType & MATERIAL_TYPE_MASK) == 3u);
#if !IS_SECONDARY_BOUNCE
            vec3 matEmissive = mat.emissive.rgb;
            float roughness = mat.roughness;
            float metallic = mat.metallic;
            float transmission = mat.transmission;
            uint matTransmissionTex = mat.transmissionTex;
            float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
            float specFactor = mat.specularFactor;
            uint matSpecularTex = mat.specularTex;
            float diffTrans = clamp(mat.diffuseTransmission, 0.0, 1.0);
            uint matDiffTransTex = mat.diffuseTransmissionTex;
            float clearcoat = clamp(mat.clearcoat, 0.0, 1.0);
            uint matClearcoatTex = mat.clearcoatTex;
            float clearcoatRoughness = mat.clearcoatRoughness;
            uint matClearcoatRoughnessTex = mat.clearcoatRoughnessTex;
            vec4 attenuationColor = mat.attenuationColor;
#else
            vec3 matEmissive = sm.emissive_spec.rgb;
            float roughness = sm.pbrParams.x;
            float metallic = sm.pbrParams.y;
            bool smTrans = smIsTransmissive(sm);
            bool smThin = smIsThin(sm);
            float transmission = smTrans ? materials[matId].transmission : 0.0;
            uint matTransmissionTex = smTrans ? materials[matId].transmissionTex : 0u;
            float iorVal = sm.pbrParams.z > 0.0 ? sm.pbrParams.z : 1.5;
            float specFactor = sm.emissive_spec.w;
            uint matSpecularTex = smGetSpecularTex(sm);
            float diffTrans = clamp(sm.pbrParams.w, 0.0, 1.0);
            uint matDiffTransTex = smGetDiffTransTex(sm);
            float clearcoat = clamp(materials[matId].clearcoat, 0.0, 1.0);
            uint matClearcoatTex = (clearcoat > 0.001) ? materials[matId].clearcoatTex : 0u;
            float clearcoatRoughness = (clearcoat > 0.001) ? materials[matId].clearcoatRoughness : 1.0;
            uint matClearcoatRoughnessTex = (clearcoat > 0.001) ? materials[matId].clearcoatRoughnessTex : 0u;
            vec4 attenuationColor = (!frontFace && !smThin) ? materials[matId].attenuationColor : vec4(0.0);
#endif
            float effEnvIntensity = (pc.hasEnvMap == 1u) ? pc.envMapIntensity : 0.0;
            bool envNeeOn = envNeeActive() && (effEnvIntensity > 0.0);
            bool hasAnyNEE = (pc.numLights > 0u) || envNeeOn;
#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
            bool giCaptureSelf = giHasCtx && !pathTerminated && ((ubo.flags & (1 << 0)) != 0) && hasAnyNEE &&
                                 !(((ubo.flags & (1 << 3)) != 0) && (transmission > 0.001 || (matType & MATERIAL_TYPE_MASK) == 2u));
            if (giCaptureSelf) {
                giHasSelfCandidate = true;
            }
#endif

            vec3 emissive = matEmissive;
            if (matEmissiveTex > 0u && matEmissiveTex <= 512u) {
                emissive *= SAMPLE_SCENE_TEXTURE_LOD(matEmissiveTex, hitUv, rayConeBaseLod).rgb;
            }
            // Emission found by the path: MIS-weighted against NEE at the
            // previous vertex (mis_common.glsl); camera rays count fully.
            float emitLightScale = (bounce >= 2u)
                ? restirSecondaryMisLightScale(bounce - 1u, pc.numLights, pc.captureMlData, pc.enableNrc)
                : 1.0;
#if ENABLE_RESTIR_PT
#if IS_SECONDARY_BOUNCE
            if (enableRestirFlag && bounce == 1u && giHasDiRestirMis) {
                emitLightScale = restirDiMisLightScale(pc.numLights, pc.captureMlData);
            }
#else
            if (enableRestirFlag && bounce == 1u && x1ContextHasDiRestirMis(x1Contexts[pixelIndex])) {
                emitLightScale = restirDiMisLightScale(pc.numLights, pc.captureMlData);
            }
#endif
#endif
            float emitMisW = shouldSuppressCausticEmitterHit(causticApplied, isSpecularPath, inPdfCode, bounce)
                ? 0.0
                : ((bounce == 0u) ? 1.0 : emitterHitMisWeightScaled(hitType, hit.hitData1.y, hit.hitData1.x, origin, rayDir, hitT, inPdfCode, pc.numLights, emitLightScale));
            bool isUnindexedTriEmitter = (hitType == 0u) && (triangles[hit.hitData1.y].padding0 == TRI_LIGHT_NONE);
#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
            if (giCaptureSelf && isUnindexedTriEmitter) {
                if (length(emissive) > 1e-3 && emitMisW > 0.0) {
                    giL2 += f16vec3(clampIndirectRadiance(emissive, pc.indirectClamp * 2.0));
                }
            } else
#endif
            if (length(emissive) > 1e-3 && emitMisW > 0.0) {
                vec3 emissiveContrib = vec3(throughput) * emissive * emitMisW;
                if (bounce > 0u) {
                    float effClamp = computeAdaptiveFireflyClamp(pc.indirectClamp, inPdfCode);
                    emissiveContrib = clampIndirectRadiance(emissiveContrib, effClamp);
                }
                emissiveContrib *= invSpp;
                ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                    vec4 prev = imageLoad(uAccumImage, pCoord);
                    imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, emissiveContrib, seed), prev.a));
                }
                if (pc.captureMlData != 0u) {
                    bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                    bool isMlDenoiser = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
                    if (isMlDenoiser && bounce == 0u) {
                        vec4 prevSkip = imageLoad(uMlSkipImage, pCoord);
                        imageStore(uMlSkipImage, pCoord, vec4(addFp16Stochastic(prevSkip.rgb, emissiveContrib, seed), prevSkip.a));
                    } else {
                        if (bounce > 0u) {
                            wfAddSplitIndirect(pCoord,
                                               routeAllToSpec ? vec3(0.0) : emissiveContrib,
                                               routeAllToSpec ? emissiveContrib : vec3(0.0),
                                               pc.captureMlData, seed);
                        }
                        if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                            if (routeAllToSpec) {
                                vec3 outSpec = isV4
                                    ? demodulateMlSafe(emissiveContrib, imageLoad(uMlSpecAlbedoImage, pCoord).rgb)
                                    : emissiveContrib;
                                vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                                imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                            } else {
                                vec3 outDiff = isV4
                                    ? demodulateMlSafe(emissiveContrib, imageLoad(uMlAlbedoRoughnessImage, pCoord).rgb)
                                    : emissiveContrib;
                                vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                                imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                            }
                        }
                    }
                }
            }

            if (matMrTex > 0u && matMrTex <= 512u) {
                vec4 mrSample = SAMPLE_SCENE_TEXTURE_LOD(matMrTex, hitUv, rayConeBaseLod);
                roughness *= mrSample.g;
                metallic *= mrSample.b;
            }
            roughness = clamp(roughness, 0.04, 1.0);
            metallic = clamp(metallic, 0.0, 1.0);
            float alphaRoughness = roughness * roughness;

            if (matTransmissionTex > 0u && matTransmissionTex <= 512u) {
                transmission *= SAMPLE_SCENE_TEXTURE_LOD(matTransmissionTex, hitUv, rayConeBaseLod).r;
            }

            float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
            if (matSpecularTex > 0u && matSpecularTex <= 512u) {
                specFactor *= SAMPLE_SCENE_TEXTURE_LOD(matSpecularTex, hitUv, rayConeBaseLod).a;
            }
            float giF0ScalarPre = clamp(f0Dielectric * specFactor, 0.0, 1.0);
            f16vec3 dielectricF0 = f16vec3(giF0ScalarPre);
            f16vec3 F0 = mix(dielectricF0, baseColor, float16_t(metallic));
            f16vec3 diffuseColor = baseColor * float16_t(1.0 - metallic);
#if !IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
            uint x1PreY = packHalf2x16(clamp(vec2(baseColor.rg), vec2(0.0), vec2(65000.0)));
            uint x1PreZ = packHalf2x16(vec2(clamp(float(baseColor.b), 0.0, 65000.0), metallic));
            uint x1PreRF0 = packX1PackedW(0u, giF0ScalarPre, roughness, 0.0) & 0x3FFFCu;
#endif
            vec3 V = -rayDir;

            if (matDiffTransTex > 0u && matDiffTransTex <= 512u) {
                diffTrans *= SAMPLE_SCENE_TEXTURE_LOD(matDiffTransTex, hitUv, rayConeBaseLod).r;
            }
            diffTrans = clamp(diffTrans, 0.0, 1.0);

            if (matClearcoatTex > 0u && matClearcoatTex <= 512u) {
                clearcoat *= SAMPLE_SCENE_TEXTURE_LOD(matClearcoatTex, hitUv, rayConeBaseLod).r;
            }
            if (matClearcoatRoughnessTex > 0u && matClearcoatRoughnessTex <= 512u) {
                clearcoatRoughness *= SAMPLE_SCENE_TEXTURE_LOD(matClearcoatRoughnessTex, hitUv, rayConeBaseLod).g;
            }
            clearcoatRoughness = clamp(clearcoatRoughness, 0.001, 1.0);
            float clearcoatAlpha = clearcoatRoughness * clearcoatRoughness;

            vec3 clearcoatNormal = hitNormal;
#if !IS_SECONDARY_BOUNCE
            vec3 surfTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
            vec3 surfBitan = cross(hitNormal, surfTan) * tanSign;
            if (clearcoat > 0.001) {
                if (mat.clearcoatNormalTex > 0u && mat.clearcoatNormalTex <= 512u) {
                    vec3 cNormMap = SAMPLE_SCENE_TEXTURE_LOD(mat.clearcoatNormalTex, hitUv, rayConeBaseLod).rgb * 2.0 - 1.0;
                    clearcoatNormal = adjustShadingNormal(normalize(mat3(surfTan, surfBitan, hitNormal) * cNormMap), -rayDir);
                }
            }

            // KHR_materials_sheen
            f16vec3 sheenColor = f16vec3(mat.sheenColor);
            if (mat.sheenTex > 0u && mat.sheenTex <= 512u) {
                sheenColor *= f16vec3(SAMPLE_SCENE_TEXTURE_LOD(mat.sheenTex, hitUv, rayConeBaseLod).rgb);
            }
            float sheenRoughness = clamp(mat.sheenRoughness, 0.01, 1.0);

            // KHR_materials_anisotropy & KHR_materials_iridescence
            float anisoStrength = clamp(mat.anisotropyStrength, 0.0, 1.0);
            vec2 anisoRot = vec2(cos(mat.anisotropyRotation), sin(mat.anisotropyRotation));
            vec2 anisoDir = anisoRot;
            if (anisoStrength > 0.001 && mat.anisotropyTex > 0u && mat.anisotropyTex <= 512u) {
                vec3 anisoSample = SAMPLE_SCENE_TEXTURE_LOD(mat.anisotropyTex, hitUv, rayConeBaseLod).rgb;
                vec2 texDir = anisoSample.xy * 2.0 - 1.0;
                float texLen = length(texDir);
                texDir = (texLen > 1e-4) ? (texDir / texLen) : vec2(1.0, 0.0);
                anisoDir = vec2(texDir.x * anisoRot.x - texDir.y * anisoRot.y,
                                texDir.x * anisoRot.y + texDir.y * anisoRot.x);
                anisoStrength *= anisoSample.b;
            }
            vec3 anisoT = normalize(surfTan * anisoDir.x + surfBitan * anisoDir.y);
            vec3 anisoB = normalize(cross(hitNormal, anisoT));
            float alphaX = mix(alphaRoughness, 1.0, anisoStrength * anisoStrength);
            float alphaY = alphaRoughness;
#else
            f16vec3 sheenColor = f16vec3(0.0);
            float sheenRoughness = 0.01;
#endif

            // Volumetric Beer-Lambert absorption (physical ray traversal distance)
            float mediumDist = !frontFace ? hitT : 0.0;
            if (attenuationColor.w > 0.0 && mediumDist > 0.0) {
                vec3 sigma_a = -log(max(attenuationColor.rgb, vec3(0.0001))) / attenuationColor.w;
                f16vec3 transmittance = f16vec3(exp(-sigma_a * mediumDist));
                throughput *= transmittance;
            }

            bool enableDirect = (ubo.flags & (1 << 0)) != 0;
            bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
            bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
            bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
            bool enableShadows = (ubo.flags & (1 << 4)) != 0;

            // Delta dielectric continuation (refraction/Fresnel reflection, see
            // "Indirect Bounce"). NEE is skipped exactly on these vertices and the
            // continuation carries pdfCode 0, so emitters it hits count fully.
            bool deltaBranch = enableRefraction && (transmission > 0.001 || (matType & MATERIAL_TYPE_MASK) == 2u);

            // Shared STANDARD BSDF + COMPLEX layers (bsdf_standard.glsl): the same
            // function and mixture pdf for NEE, MIS and the continuation.
            StdBsdf bsdf = makeStdBsdf(vec3(diffuseColor), vec3(F0), alphaRoughness, diffTrans, metallic,
                                       dot(hitNormal, V), STD_BSDF_FULL);
            stdBsdfSetLayers(bsdf, enableSpecular, clearcoatNormal, clearcoat, clearcoatAlpha,
                             vec3(sheenColor), sheenRoughness);
#if !IS_SECONDARY_BOUNCE
            stdBsdfSetAnisoIridescence(bsdf, anisoT, anisoB, alphaX, alphaY,
                                       mat.iridescence, mat.iridescenceIor, mat.iridescenceThickness);
#endif

            bool enableCaustics = (ubo.flags & (1u << 8)) != 0u && (pc.numLights > 0u);
            if (enableCaustics && transmission < 0.1 && (matType & MATERIAL_TYPE_MASK) != 2u && metallic < 0.2) {
                bool alreadyApplied = causticApplied;
                if (!alreadyApplied) {
                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    vec3 causticIrr = imageLoad(uCausticImage, pCoord).rgb;
                    if (dot(causticIrr, causticIrr) > 1e-8) {
                        vec3 causticRad = vec3(throughput) * (vec3(diffuseColor) * INV_PI) * causticIrr;
                        if (bounce > 0u) {
                            causticRad = clampIndirectRadiance(causticRad, pc.indirectClamp);
                        }
                        causticRad *= invSpp;
                        if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                            vec4 prev = imageLoad(uAccumImage, pCoord);
                            imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, causticRad, seed), prev.a));
                        }
                        causticApplied = true;
                        if (pc.captureMlData != 0u) {
                            wfAddSplitIndirect(pCoord,
                                               routeAllToSpec ? vec3(0.0) : causticRad,
                                               routeAllToSpec ? causticRad : vec3(0.0),
                                               pc.captureMlData, seed);
                            if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                                bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                                if (routeAllToSpec) {
                                    vec3 outSpec = isV4
                                        ? demodulateMlSafe(causticRad, imageLoad(uMlSpecAlbedoImage, pCoord).rgb)
                                        : causticRad;
                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                                    imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                                } else {
                                    vec3 outDiff = isV4
                                        ? demodulateMlSafe(causticRad, imageLoad(uMlAlbedoRoughnessImage, pCoord).rgb)
                                        : causticRad;
                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                                    imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                                }
                            }
                        }
                    }
                }
            }

            bool canContinueWavefront = (bounce + 1u < pc.maxBounces);
            f16vec3 secDirectL = f16vec3(0.0);
#if ENABLE_NRC
            bool nrcTrainThisPath = false;
            bool nrcQueryEmitted = false;
            float nrcRoughness = clamp(roughness, 0.04, 1.0);
#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
            uint effNrcBounce = giHasCtx ? max(pc.nrcBounce, 2u) : max(pc.nrcBounce, 1u);
#else
            uint effNrcBounce = max(pc.nrcBounce, 1u);
#endif
            bool nrcPrimaryTransmissive = ((pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u) &&
                (imageLoad(uMlSpecularMotionImage, ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width))).z < 0.0);
            bool isNrcMirror = (metallic >= 0.85 && roughness < 0.06);
            bool nrcKeepMirrorSharp = inNrcSkip && isNrcMirror && (bounce < 2u);
            bool nrcVertexActive = !pathTerminated && !deltaBranch && enableIndirect &&
                pc.enableNrc == 1u && !nrcPrimaryTransmissive &&
                transmission <= 0.001 && diffTrans <= 0.001 && (matType & MATERIAL_TYPE_MASK) != 2u &&
                bounce >= effNrcBounce &&
                (!inNrcSkip || bounce >= 2u || roughness >= 0.06) &&
                (!nrcKeepMirrorSharp || !canContinueWavefront);
#else
            const bool nrcTrainThisPath = false;
            const bool nrcQueryEmitted = false;
            const bool nrcVertexActive = false;
#endif

#if !IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
            bool diRestirMisActive = false;
#endif
#if IS_SECONDARY_BOUNCE
            // --- STREAMLINED SECONDARY DIRECT LIGHTING (1-Sample NEE + Base Lobe BRDF) ---
            if (!pathTerminated && enableDirect && !deltaBranch && hasAnyNEE) {
#if ENABLE_RESTIR_GI
                bool boostGiNee = giCaptureSelf;
#else
                bool boostGiNee = false;
#endif
                bool restirRuntimeActive = ((ubo.flags & (1u << 9)) != 0u) && ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u);
                uint effNumLights = restirEffectiveLightCount(pc.numLights);
                uint M = 1u;
                if (effNumLights > 1u) {
                    if (restirRuntimeActive) {
                        M = restirSecondaryFreshM(bounce, pc.numLights, isSpecularPath, pc.captureMlData);
                    } else if (bounce == 1u && (boostGiNee || (isSpecularPath && (inPdfCode == 0u || inPdfCode >= 1280u)))) {
                        M = min(effNumLights, (pc.numLights > 4096u) ? 2u : 4u);
                    }
                }
                float pEnv = envNeeOn ? ((pc.numLights == 0u) ? 1.0 : envNeeSelectProb()) : 0.0;
                uint chosenLightIdx = 0u;
                vec3 chosenLightDir = vec3(0.0, 1.0, 0.0);
                float chosenLightDist = 0.0;
                float chosenLightPdfEff = 1.0;
                vec3 chosenLightEmission = vec3(0.0);
                vec3 chosenNeeFCos = vec3(0.0);
                vec3 chosenSpecFCos = vec3(0.0);
                float chosenNeeBsdfPdf = 0.0;
                float chosenTargetPdf = 0.0;
                float weightSum = 0.0;
                bool chosenValid = false;

                for (uint m = 0u; m < M; ++m) {
                    bool pickEnv = (pc.numLights == 0u) || (pEnv > 0.0 && randFloat(seed) < pEnv);
                    uint candLightIdx = RESTIR_LIGHT_IDX_ENV;
                    float candSelectPdf = pEnv;
                    vec3 candDir = vec3(0.0, 1.0, 0.0);
                    float candDist = 0.0;
                    float candPdf = 1.0;
                    vec3 candEmission = vec3(0.0);
                    bool candValid = false;

                    if (pickEnv) {
                        vec2 envUv;
                        if (sampleEnvMapImportance(randVec3(seed), candDir, envUv, candPdf)) {
                            candEmission = textureLod(environmentMap, envUv, 0.0).rgb * effEnvIntensity;
                            candDist = 10000.0;
                            candValid = true;
                        }
                    } else {
                        if ((ubo.flags & (1 << 7)) != 0 && pc.numLights > 1u) {
                            SAMPLE_LIGHT_TREE(pc.numLights, hitPoint, hitNormal, seed, candLightIdx, candSelectPdf);
                        } else {
                            SAMPLE_LIGHT_ALIAS(pc.numLights, seed, candLightIdx, candSelectPdf);
                        }
                        candSelectPdf *= max(1.0 - pEnv, 1e-20);

                        Light candLight = lights[candLightIdx];
                        candEmission = candLight.emission.rgb;
                        uint candLightType = uint(candLight.position.w);
                        if (candLightType == 0u || candLightType == 3u /* AREA QUAD / TRIANGLE */) {
                            vec2 luv = (bounce == 1u && m == 0u &&
                                        (pc.captureMlData != 0u || pc.enableNrc != 0u))
                                ? sampleSobolOwen2D(pixelIndex, pc.width, pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex, 6u)
                                : randVec2(seed);
                            vec2 uv = luv;
                            if (candLightType == 3u) {
                                float r1 = sqrt(luv.x);
                                uv = vec2(1.0 - r1, luv.y * r1);
                            }
                            vec3 lightPoint = candLight.position.xyz + uv.x * candLight.u.xyz + uv.y * candLight.v.xyz;
                            vec3 toLight = lightPoint - hitPoint;
                            candDist = length(toLight);
                            candDir = toLight / max(candDist, 1e-4);
                            float cosLight = dot(-candDir, candLight.normal.xyz);
                            if (cosLight > 0.0) {
                                candPdf = (candDist * candDist) / (candLight.emission.w * cosLight);
                                candValid = true;
                            }
                        } else if (candLightType == 1u /* SPOT */) {
                            vec3 toLight = candLight.position.xyz - hitPoint;
                            candDist = length(toLight);
                            candDir = toLight / max(candDist, 1e-4);
                            float cosSpot = dot(-candDir, candLight.normal.xyz);
                            if (cosSpot >= candLight.v.w) {
                                float spotFactor = clamp((cosSpot - candLight.v.w) / max(candLight.u.w - candLight.v.w, 1e-4), 0.0, 1.0);
                                candEmission *= spotFactor / max(candDist * candDist, 1e-4);
                                candValid = true;
                            }
                        } else if (uint(candLight.position.w) == 2u /* DIRECTIONAL */) {
                            candDir = normalize(candLight.normal.xyz);
                            candDist = 10000.0;
                            candValid = true;
                        }
                    }

                    float candBsdfPdf = 0.0;
                    vec3 candSpecFCos = vec3(0.0);
                    vec3 candFCos = candValid ? stdBsdfEvalSplit(bsdf, hitNormal, V, candDir, candBsdfPdf, candSpecFCos) : vec3(0.0);
                    float candPdfEff = max(candPdf * candSelectPdf, 1e-20);
                    float targetPdf = candValid ? dot(candFCos * candEmission, vec3(0.2126, 0.7152, 0.0722)) : 0.0;
                    float risW = (targetPdf > 0.0) ? (targetPdf / candPdfEff) : 0.0;
                    weightSum += risW;

                    if (risW > 0.0 && (randFloat(seed) * weightSum <= risW || !chosenValid)) {
                        chosenLightIdx = candLightIdx;
                        chosenLightDir = candDir;
                        chosenLightDist = candDist;
                        chosenLightPdfEff = candPdfEff;
                        chosenLightEmission = candEmission;
                        chosenNeeFCos = candFCos;
                        chosenSpecFCos = candSpecFCos;
                        chosenNeeBsdfPdf = candBsdfPdf;
                        chosenTargetPdf = targetPdf;
                        chosenValid = true;
                    }
                }

                uint lightIdx = chosenLightIdx;
                bool chosenIsEnv = (lightIdx == RESTIR_LIGHT_IDX_ENV);
                vec3 lightDir = chosenLightDir;
                float lightDist = chosenLightDist;
                vec3 lightEmission = chosenLightEmission;
                bool validLight = chosenValid;
                float lightDirDotN = dot(hitNormal, lightDir);
                bool isTransmitted = (lightDirDotN < 0.0);
                float neeBsdfPdf = chosenNeeBsdfPdf;
                vec3 neeFCos = chosenNeeFCos;
                if (validLight && chosenTargetPdf > 0.0) {
                    {
                        float lightPdfEff = chosenLightPdfEff;
                        float risWeight = (weightSum / float(M)) / max(chosenTargetPdf, 1e-6);
                        float secMisScale = restirSecondaryMisLightScale(bounce, pc.numLights, pc.captureMlData, pc.enableNrc);
                        float misWeight = 1.0;
                        if (chosenIsEnv) {
                            misWeight = envNeeMisWeightScaled(lightPdfEff, neeBsdfPdf, (bounce + 1u < pc.maxBounces) || nrcVertexActive, secMisScale);
                        } else {
                            uint winLightType = uint(lights[lightIdx].position.w);
                            if (winLightType == 0u || winLightType == 3u) {
                                misWeight = neeMisWeightScaled(lightIdx, lightPdfEff, neeBsdfPdf, (bounce + 1u < pc.maxBounces) || nrcVertexActive, secMisScale);
                            }
                        }
                        vec3 secScale = lightEmission * (misWeight * risWeight);
                        f16vec3 secDiff = f16vec3(clamp((neeFCos - chosenSpecFCos) * secScale, vec3(0.0), vec3(65500.0)));
                        f16vec3 secSpec = f16vec3(clamp(chosenSpecFCos * secScale, vec3(0.0), vec3(65500.0)));
                        secDirectL = secDiff + secSpec;

#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
                        if (giCaptureSelf) {
                            float giDirectClampVal = (pc.captureMlData != 0u && ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u))
                                ? (pc.indirectClamp * 4.0)
                                : pc.indirectClamp;
                            vec3 giDirectClamped = (pc.indirectClamp > 0.0)
                                ? clampIndirectRadiance(vec3(secDirectL), giDirectClampVal)
                                : vec3(secDirectL);
                            float giRadMax = max(giDirectClamped.r, max(giDirectClamped.g, giDirectClamped.b));
                            if (giRadMax > 1e-5) {
                                if (enableShadows) {
                                    float giLum = float(max(vec3(throughput).r * giDirectClamped.r, max(vec3(throughput).g * giDirectClamped.g, vec3(throughput).b * giDirectClamped.b)));
                                    float giShadowProb = (!isSpecularPath && (pc.captureMlData == 0u)) ? clamp(giLum * 1.5, 0.20, 1.0) : 1.0;
                                    if (giShadowProb >= 1.0 || randFloat(seed) < giShadowProb) {
                                        giDirectClamped /= giShadowProb;
                                        vec3 giShadowOrigin = isTransmitted ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(giShadowOrigin, lightDist);
                                        shadowCandidate.dirPixelRad = uvec4(
                                            packOct32(lightDir),
                                            pixelIndex | 0x80000000u,
                                            packHalf2x16(vec2(giDirectClamped.rg)),
                                            packHalf2x16(vec2(giDirectClamped.b, routeAllToSpec ? 2.0 : 0.0))
                                        );
                                    }
                                } else {
                                    giL2 += f16vec3(giDirectClamped);
                                }
                            } else {
                                secDirectL = f16vec3(0.0);
                            }
                        } else
#endif
                        {
                            vec3 secShadowOrigin = isTransmitted ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                            float secClamp = (bounce >= 2u && (isSpecularPath || inNrcSkip)) ? min(pc.indirectClamp, 1.5) : pc.indirectClamp;
                            f16vec3 unshadowed = clampIndirectRadiance(throughput * secDirectL, secClamp);

                            if (length(vec3(unshadowed)) > 1e-5) {
                                bool keepShadow = true;
                                uint shadowRrMinBounce = (pc.captureMlData != 0u) ? 2u : 1u;
                                if (bounce >= shadowRrMinBounce && !isSpecularPath) {
                                    float lum = float(max(unshadowed.r, max(unshadowed.g, unshadowed.b)));
                                    float prob = clamp(lum * 1.5, 0.20, 1.0);
                                    if (randFloat(seed) < prob) {
                                        unshadowed /= float16_t(prob);
                                    } else {
                                        keepShadow = false;
                                    }
                                }
                                if (keepShadow) {
                                    if (enableShadows) {
                                        float dLum = dot(vec3(secDiff), vec3(0.2126, 0.7152, 0.0722));
                                        float sLum = dot(vec3(secSpec), vec3(0.2126, 0.7152, 0.0722));
                                        float secSpecCode = routeAllToSpec ? 2.0 : clamp(sLum / max(dLum + sLum, 1e-8), 0.0, 1.0);
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(secShadowOrigin, lightDist);
                                        shadowCandidate.dirPixelRad = uvec4(packOct32(lightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, secSpecCode)));
                                    } else {
                                        ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                        vec3 scaledUnshadowed = vec3(unshadowed) * invSpp;
                                        if (pc.captureMlData == 0u || (pc.captureMlData & ML_CAPTURE_KEEP_ACCUM_BIT) != 0u) {
                                            vec4 prev = imageLoad(uAccumImage, pCoord);
                                            imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, scaledUnshadowed, seed), prev.a));
                                        }
                                        wfAddSplitIndirect(pCoord,
                                                           (routeAllToSpec ? vec3(0.0) : vec3(clampIndirectRadiance(throughput * secDiff, secClamp))) * invSpp,
                                                           (routeAllToSpec ? vec3(unshadowed) : vec3(clampIndirectRadiance(throughput * secSpec, secClamp))) * invSpp,
                                                           pc.captureMlData, seed);
                                    }
                                }
                            }
                        }
                    }
                }
            }
#else
            // Direct Lighting (Decoupled ReSTIR DI handoff on Bounce-0 complex without extra lobes, Stochastic NEE otherwise)
            bool diWinnerVisVerified = false;
#if ENABLE_RESTIR_PT
            bool diRestirRan = false;
            bool diHasCamMotion = false;
            bool hasComplexDiLobes = !enableSpecular || (clearcoat > 0.001) || (anisoStrength > 0.001) ||
                                     (dot(vec3(sheenColor), vec3(1.0)) > 0.001) || (mat.iridescence > 0.001) ||
                                     (!frontFace && mat.attenuationColor.w > 0.0);
            bool enableRestirPT = enableRestirFlag && (roughness >= 0.20) && !hasComplexDiLobes;
            bool isV4DiCapture = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
            bool isMlDenoiserDi = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
#endif
            if (!pathTerminated && enableDirect && !deltaBranch && hasAnyNEE) {
                bool enableInlineShadows = ((ubo.flags & (1 << 6)) != 0) && (bounce == 0u);
                uint effNumLights = restirEffectiveLightCount(pc.numLights);
                uint M = (bounce == 0u && effNumLights > 1u) ? min(effNumLights, 4u) : 1u;
#if ENABLE_RESTIR_PT
                bool allowDiRestirMis = (pc.captureMlData != 0u) ? enableRestirFlag : enableRestirPT;
                diRestirMisActive = allowDiRestirMis && !isMlDenoiserDi && (bounce == 0u) && ((ubo.flags & (1u << 10)) == 0u);
                if (enableRestirFlag && !isMlDenoiserDi && (bounce == 0u) && effNumLights > 1u) {
                    M = restirDiFreshM(pc.numLights, pc.captureMlData);
                }
#endif

                DiReservoir r;
                DiSample sel;
                restirDiFreshStream(pc.numLights, effEnvIntensity, (ubo.flags & (1 << 7)) != 0,
                                    hitPoint, hitNormal, hitT,
                                    V, diffuseColor, F0, alphaRoughness,
                                    diffTrans, M, seed, r, sel);

                bool handoffRestirDi = false;
#if ENABLE_RESTIR_PT
                if (enableRestirPT && bounce == 0u) {
                    diRestirRan = true;
#if ENABLE_INLINE_SHADOWS
                    if (enableInlineShadows) {
                        uint effM = M;
                        restirDiRunInlineReuse(
                            pixelIndex, enableShadows, (effNumLights > 4u),
                            metallic, roughness, alphaRoughness, diffTrans,
                            hitPoint, hitNormal, hitT, V, diffuseColor, F0,
                            r, sel, seed, effM, diHasCamMotion, diWinnerVisVerified
                        );
                        M = effM;
                    } else
#endif
                    {
                        handoffRestirDi = true;
                        bool mergeMatteSpecShadow = (!routeAllToSpec && !isMlDenoiserDi && roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01);
                        bool canContOrNrc = canContinueWavefront || nrcVertexActive;
                        uint extraFlags = DI_FLAG_ACTIVE;
                        if (diRestirMisActive) extraFlags |= DI_FLAG_DI_MIS_ACTIVE;
                        if (canContOrNrc) extraFlags |= DI_FLAG_HAS_CONT;
                        if (mergeMatteSpecShadow) extraFlags |= DI_FLAG_MERGE_MATTE_SPEC;
                        if (effNumLights > 4u && enableShadows && sel.has && sel.target > 1e-6) {
                            extraFlags |= DI_FLAG_NEED_FRESH_VIS;
                            vec3 visOrigin = sel.isTrans ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                            hasShadowRay = true;
                            shadowCandidate.originDist = vec4(visOrigin, sel.dist);
                            shadowCandidate.dirPixelRad = uvec4(packOct32(sel.dir), pixelIndex | 0x40000000u, 0u, 0u);
                        } else if (!enableShadows) {
                            extraFlags |= DI_FLAG_FRESH_VISIBLE;
                        }
                        uint dt8 = uint(clamp(round(clamp(diffTrans, 0.0, 1.0) * 255.0), 0.0, 255.0));
                        r.flags = (r.flags & (DI_FLAG_HISTORY_MASK & ~0xFFu)) | dt8 | extraFlags;
                        currentReservoirs[pixelIndex] = r;
                    }
                } else if (bounce == 0u && enableRestirFlag && pc.sppSampleIndex == 0u) {
                    currentReservoirs[pixelIndex].flags = 0u;
                }
#endif
                if (!handoffRestirDi) {

                bool inlineShadowExecuted = false;
                bool inlineShadowVisible = true;
#if ENABLE_INLINE_SHADOWS
                if (diWinnerVisVerified) {
                    inlineShadowExecuted = true;
                    inlineShadowVisible = true;
                } else if (enableShadows && enableInlineShadows && sel.has && sel.target > 1e-6) {
                    inlineShadowExecuted = true;
                    vec3 rayOrigInline = sel.isTrans ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                    inlineShadowVisible = !traceShadowRayInline(rayOrigInline, sel.dir, sel.dist,
                                                                (ubo.flags & (1u << 5)) != 0u, pc.numOpaqueTriangles);
                }
#endif

                // Local aliases consumed by the finalization block below
                uint selectedLightIdx = sel.lightIdx;
                vec3 selectedLightDir = sel.dir;
                float selectedLightDist = sel.dist;
                vec3 selectedLightEmission = sel.emission;
                float selectedNdotL = sel.ndotL;
                bool selectedIsTrans = sel.isTrans;
                float selectedTarget = sel.target;
                float selectedCosLight = sel.cosLight;
                float selectedLightSelectPdf = sel.selectPdf;
                bool hasCandidate = sel.has;

                if (hasCandidate && selectedTarget > 1e-6) {
                    vec3 shadowOrigin = selectedIsTrans ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                    if (inlineShadowVisible) {
                        float neeBsdfPdf = 0.0;
                        vec3 neeSpecFCos;
                        vec3 neeFCos = stdBsdfEvalSplit(bsdf, hitNormal, V, selectedLightDir, neeBsdfPdf, neeSpecFCos);

                        // Balance-heuristic MIS weight vs. emission found by the
                        // continuation ray (mis_common.glsl). The RIS finalization
                        // g(x̂)·W is unbiased for ∫g for any target p̂, so weighting
                        // the winner makes NEE estimate ∫g·w_light while BSDF hits
                        // estimate ∫g·w_bsdf with the complementary weight.
                        float misWeight = 1.0;
                        bool selIsEnv = (selectedLightIdx == RESTIR_LIGHT_IDX_ENV);
                        if (selIsEnv) {
                            if (selectedLightSelectPdf < 0.0) {
                                selectedLightSelectPdf = (pc.numLights == 0u) ? 1.0 : envNeeSelectProb();
                            }
                            float envPdfEff = evalEnvMapPdf(selectedLightDir) * selectedLightSelectPdf;
                            float diMisScale = (bounce >= 1u)
                                ? restirSecondaryMisLightScale(bounce, pc.numLights, pc.captureMlData, pc.enableNrc)
                                : 1.0;
#if ENABLE_RESTIR_PT
                            if (diRestirMisActive) {
                                diMisScale = restirDiMisLightScale(pc.numLights, pc.captureMlData);
                            }
#endif
                            misWeight = envNeeMisWeightScaled(envPdfEff, neeBsdfPdf, (bounce + 1u < pc.maxBounces) || nrcVertexActive, diMisScale);
                        } else {
                            Light selLight = lights[selectedLightIdx];
                            uint selType = uint(selLight.position.w);
                            if ((selType == 0u || selType == 3u) && lightUsesMis(selectedLightIdx)) {
                                if (selectedLightSelectPdf < 0.0) {
                                    selectedLightSelectPdf = misLightSelectPdf(selectedLightIdx, hitPoint, pc.numLights);
                                }
                                float effCos = max(selectedCosLight, 1e-4);
                                float effDist = max(selectedLightDist, 1e-4);
                                float lightPdfEff = ((effDist * effDist) / (selLight.emission.w * effCos)) * selectedLightSelectPdf;
                                float diMisScale = (bounce >= 1u)
                                    ? restirSecondaryMisLightScale(bounce, pc.numLights, pc.captureMlData, pc.enableNrc)
                                    : 1.0;
#if ENABLE_RESTIR_PT
                                if (diRestirMisActive) {
                                    diMisScale = restirDiMisLightScale(pc.numLights, pc.captureMlData);
                                }
#endif
                                misWeight = neeMisWeightScaled(selectedLightIdx, lightPdfEff, neeBsdfPdf, (bounce + 1u < pc.maxBounces) || nrcVertexActive, diMisScale);
                            }
                        }

                        float risWeight = r.wSum / (float(M) * max(selectedTarget, 1e-6));
#if ENABLE_RESTIR_PT
                        if (diRestirRan && pc.numLights <= 4096u) {
                            uint selLightType = selIsEnv ? 2u : uint(lights[selectedLightIdx].position.w);
                            float motionRisClamp = selIsEnv ? 40.0 : ((selLightType == 0u || selLightType == 3u) ? 40.0 : 100.0);
                            risWeight = clamp(risWeight, 0.0, diHasCamMotion ? motionRisClamp : 500.0);
                        }
#endif

                        float factor = misWeight * risWeight;
                        vec3 neeScale = selectedLightEmission * factor;
                        f16vec3 diffBrdf = f16vec3(clamp((neeFCos - neeSpecFCos) * neeScale, vec3(0.0), vec3(65500.0)));
                        f16vec3 specBrdf = f16vec3(clamp(neeSpecFCos * neeScale, vec3(0.0), vec3(65500.0)));
                        vec3 directLightRadiance = vec3(1.0);
                        secDirectL = diffBrdf + specBrdf;
#if ENABLE_RESTIR_PT
                        if (diRestirRan && pc.numLights > 4096u) {
                            float maxDirectLum = (pc.captureMlData != 0u) ? 30.0 : 60.0;
                            float secLum = dot(vec3(secDirectL), vec3(0.2126, 0.7152, 0.0722));
                            if (secLum > maxDirectLum) {
                                float sc = maxDirectLum / secLum;
                                diffBrdf *= float16_t(sc);
                                specBrdf *= float16_t(sc);
                                secDirectL = diffBrdf + specBrdf;
                            }
                        }
#endif

                        f16vec3 unshadowed = throughput * secDirectL;
                        if (bounce > 0u) {
                            unshadowed = clampIndirectRadiance(unshadowed, pc.indirectClamp);
                        }

                        if (length(vec3(unshadowed)) > 1e-5) {
                            bool keepShadow = true;
                            uint shadowRrMinBounce = (pc.captureMlData != 0u) ? 2u : 1u;
                            if (bounce >= shadowRrMinBounce && !isSpecularPath) {
                                float lum = float(max(unshadowed.r, max(unshadowed.g, unshadowed.b)));
                                float prob = clamp(lum * 1.5, 0.20, 1.0);
                                if (randFloat(seed) < prob) {
                                    unshadowed /= float16_t(prob);
                                } else {
                                    keepShadow = false;
                                }
                            }
                            if (keepShadow) {
                                if (enableShadows) {
#if ENABLE_INLINE_SHADOWS
                                    if (inlineShadowExecuted) {
                                        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                        vec3 scaledUnshadowed = vec3(unshadowed) * invSpp;
                                        if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                            vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, scaledUnshadowed, seed), prev.a));
                                        }
                                        if (pc.captureMlData != 0u) {
                                            bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                                            bool isMlDenoiserOut = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
                                            bool mergeMatteSpec = (!routeAllToSpec && (bounce > 0u || (!isMlDenoiserOut && roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01)));
                                            f16vec3 diffUnshadowed = throughput * (mergeMatteSpec ? secDirectL : diffBrdf) * f16vec3(directLightRadiance);
                                            f16vec3 specUnshadowed = mergeMatteSpec ? f16vec3(0.0) : (throughput * specBrdf * f16vec3(directLightRadiance));
                                            if (bounce > 0u) {
                                                diffUnshadowed = clampIndirectRadiance(diffUnshadowed, pc.indirectClamp);
                                                specUnshadowed = clampIndirectRadiance(specUnshadowed, pc.indirectClamp);
                                            }
                                            vec3 splitDiffOut = (routeAllToSpec ? vec3(0.0) : vec3(diffUnshadowed)) * invSpp;
                                            vec3 splitSpecOut = (routeAllToSpec ? vec3(unshadowed) : vec3(specUnshadowed)) * invSpp;
                                            if (bounce == 0u) {
                                                wfAddSplitDirect(pixelCoord, splitDiffOut, splitSpecOut, pc.captureMlData, seed);
                                            } else {
                                                wfAddSplitIndirect(pixelCoord, splitDiffOut, splitSpecOut, pc.captureMlData, seed);
                                            }
                                            if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                                                if (routeAllToSpec) {
                                                    vec3 outSpec = isV4
                                                        ? demodulateMlSafe(scaledUnshadowed, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb)
                                                        : scaledUnshadowed;
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                                                } else {
                                                    if (dot(vec3(diffUnshadowed), vec3(diffUnshadowed)) > 1e-10) {
                                                        vec3 scaledDiff = vec3(diffUnshadowed) * invSpp;
                                                        vec3 outDiff = isV4
                                                            ? demodulateMlSafe(scaledDiff, imageLoad(uMlAlbedoRoughnessImage, pixelCoord).rgb)
                                                            : scaledDiff;
                                                        vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                                        imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                                                    }
                                                    if (dot(vec3(specUnshadowed), vec3(specUnshadowed)) > 1e-10) {
                                                        vec3 scaledSpec = vec3(specUnshadowed) * invSpp;
                                                        vec3 outSpec = isV4
                                                            ? demodulateMlSafe(scaledSpec, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb)
                                                            : scaledSpec;
                                                        vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                        imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                                                    }
                                                }
                                            }
                                        }
                                    } else
#endif
                                    {
                                        bool isMlDenoiserShadow = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
                                        bool mergeMatteSpecShadow = (!routeAllToSpec && (bounce > 0u || (!isMlDenoiserShadow && roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01)));
                                        float diffShadowLum = dot(vec3(diffBrdf), vec3(0.2126, 0.7152, 0.0722));
                                        float specShadowLum = dot(vec3(specBrdf), vec3(0.2126, 0.7152, 0.0722));
                                        float shadowSpecCode = routeAllToSpec ? 2.0 : (mergeMatteSpecShadow ? 0.0 : clamp(specShadowLum / max(diffShadowLum + specShadowLum, 1e-8), 0.0, 1.0));
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(shadowOrigin, selectedLightDist);
                                        shadowCandidate.dirPixelRad = uvec4(packOct32(selectedLightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, shadowSpecCode)));
                                    }
                                } else {
                                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                        vec4 prev = imageLoad(uAccumImage, pCoord);
                                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed) * invSpp, seed), prev.a));
                                    }
                                    bool isMlDenoiserUnsh = (pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u;
                                    bool mergeMatteUnsh = (!routeAllToSpec && (bounce > 0u || (!isMlDenoiserUnsh && roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01)));
                                    vec3 unshDiffOut = (routeAllToSpec ? vec3(0.0) : vec3(throughput * (mergeMatteUnsh ? secDirectL : diffBrdf))) * invSpp;
                                    vec3 unshSpecOut = (routeAllToSpec ? vec3(unshadowed) : (mergeMatteUnsh ? vec3(0.0) : vec3(throughput * specBrdf))) * invSpp;
                                    if (bounce == 0u) {
                                        wfAddSplitDirect(pCoord, unshDiffOut, unshSpecOut, pc.captureMlData, seed);
                                    } else {
                                        wfAddSplitIndirect(pCoord, unshDiffOut, unshSpecOut, pc.captureMlData, seed);
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
#if ENABLE_RESTIR_PT
            else {
                if (bounce == 0u && enableRestirFlag && pc.sppSampleIndex == 0u) {
                    currentReservoirs[pixelIndex].flags = 0u;
                }
            }
#endif

            // (No ambient skylight term: environment light is integrated by the
            //  path itself on sky misses; an extra ambient term double counts it.)

#endif

#if ENABLE_RESTIR_GI && IS_SECONDARY_BOUNCE
            if (giHasCtx) {
                uint giOctN1 = restirPackOct16FromOct32(giX1N1Oct32);
                if (giHasSelfCandidate && (hasShadowRay || dot(vec3(giL2), vec3(1.0)) > 0.0)) {
                    GiReservoir giOut = makeGiReservoirOct16(
                        true,
                        hitPoint,
                        hitNormal,
                        giOctN1,
                        0.0,
                        1u,
                        1.0,
                        vec3(giL2),
                        hitT,
                        clamp(dot(hitNormal, V), 0.0, 1.0),
                        0u
                    );
                    uint giCurrStride = giCurrentData.length() >> 2u;
                    giCurrentData[pixelIndex] = giPackMeta(giOut);
                    giCurrentData[giCurrStride + pixelIndex * 2u] = giPackPosN2_0(giOut);
                    giCurrentData[giCurrStride + pixelIndex * 2u + 1u] = giPackPosN2_1(giOut);
                    if (pc.captureMlData != 0u) {
                        giCurrentData[3u * giCurrStride + pixelIndex] = giPackWeights(giOut);
                    }
                } else {
                    giCurrentData[pixelIndex] = giPackEmptyMeta(giOctN1, 1u);
                }
            }
#endif

            // Indirect Bounce
            // NRC Indirect Continuation (Müller et al. 2021): emit NRCQuery for 100% of active
            // NRC vertices while running inline self-training on the doTrain subset.
#if ENABLE_NRC
            vec3 nrcExactRefl = vec3(0.0);
            float nrcSpecRatio = 0.0;
            if (nrcVertexActive && !pathTerminated) {
                uint waveSeed = subgroupBroadcastFirst(seed);
                float effTrainRatio = min(pc.nrcTrainRatio, 0.008);
                bool doTrain = (bounce == effNrcBounce) && (randFloat(waveSeed) < effTrainRatio);
                nrcSurfaceReflectance(vec3(diffuseColor), vec3(F0), roughness, clearcoat, clearcoatRoughness, dot(hitNormal, V),
                                      nrcExactRefl, nrcSpecRatio);
                vec3 nrcQueryTp = vec3(throughput) * nrcExactRefl;
                bool emitQuery = doTrain || (max(nrcQueryTp.r, max(nrcQueryTp.g, nrcQueryTp.b)) >= 1e-4);
                uvec4 qBallot = subgroupBallot(emitQuery);
                uint qWaveCount = subgroupBallotBitCount(qBallot);
                if (qWaveCount > 0u) {
                    uint qWaveBase = 0u;
                    uint maxQ = pc.width * pc.height;
                    if (subgroupElect()) {
                        qWaveBase = atomicAdd(nrcCounters.queryCount, qWaveCount);
                        if (qWaveBase < maxQ) {
                            uint endIdx = min(qWaveBase + qWaveCount - 1u, maxQ - 1u);
                            if ((qWaveBase & 63u) == 0u || (qWaveBase >> 6u) != (endIdx >> 6u)) {
                                atomicMax(nrcCounters.dispatchX, (endIdx >> 6u) + 1u);
                            }
                        }
                    }
                    qWaveBase = subgroupBroadcastFirst(qWaveBase);
                    uint qIdx = qWaveBase + subgroupBallotExclusiveBitCount(qBallot);
                    if (emitQuery && qIdx < maxQ) {
                        nrcQueries[qIdx].pos_roughness = vec4(hitPoint, nrcRoughness);
                        nrcQueries[qIdx].normal_flags = vec4(hitNormal, routeAllToSpec ? 1.0 : 0.0);
                        nrcQueries[qIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                        nrcQueries[qIdx].albedo_pad = vec4(nrcSpecRatio, 0.0, 0.0, 0.0);
                        nrcQueries[qIdx].throughput = vec4(nrcQueryTp * invSpp, 0.0);
                        nrcQueryEmitted = true;
                        if (!doTrain) {
                            pathTerminated = true;
                        }
                    }
                }
                if (!emitQuery) {
                    pathTerminated = true;
                }
                if (doTrain) {
                    nrcTrainThisPath = true;
                }
            }
#endif

#if !IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
            bool giSurfaceEligible = enableRestirFlag && (bounce == 0u) &&
                                     !pathTerminated && !deltaBranch && enableDirect && enableIndirect &&
                                     hasAnyNEE && (bounce + 1u < pc.maxBounces) &&
                                     (diffTrans <= 0.001) && (clearcoat <= 0.10) && (roughness >= 0.20) && (metallic < 0.50) &&
                                     (pc.enableNrc == 0u || pc.nrcBounce >= 2u);
            float giSampledBsdfPdf = 0.0;
#endif
            sampledSpecularLobe = false;
            nextDirection = vec3(0.0);
            vec3 nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
            uint nextPdfCode = 0u; // 0 = delta lobe / no NEE here: emitter hits get full weight
            bool validBounce = false;
            vec3 nrcBsdfWeight = vec3(0.0);

            if (pathTerminated || (!canContinueWavefront && !nrcTrainThisPath) || !enableIndirect) {
                pathTerminated = true;
            } else if (enableRefraction && (transmission > 0.001 || (matType & MATERIAL_TYPE_MASK) == 2u)) {
                sampledSpecularLobe = true;
                float eta = frontFace ? (1.0 / iorVal) : iorVal;
                float cosTheta = clamp(dot(V, hitNormal), 0.0, 1.0);
                float fresnel = fresnelDielectric(cosTheta, eta);

                if (randFloat(seed) < fresnel) {
                    // Specular reflection: achromatic Fresnel reflection
                    nextDirection = reflect(rayDir, hitNormal);
                    nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                } else {
                    vec3 refracted = refract(rayDir, hitNormal, eta);
                    if (length(refracted) > 1e-4) {
                        nextDirection = normalize(refracted);
                        nextOrigin = offsetRayOrigin(hitPoint, -hitNormal);
                        nrcBsdfWeight = vec3(baseColor);
                        throughput *= baseColor;
                    } else {
                        // Total Internal Reflection fallback
                        nextDirection = reflect(rayDir, hitNormal);
                        nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                    }
                }
                validBounce = true;
#if IS_SECONDARY_BOUNCE && ENABLE_NRC
                if (!pathTerminated && enableIndirect && pc.enableNrc == 1u &&
                    bounce >= effNrcBounce && !inNrcSkip && !nrcPrimaryTransmissive) {
                    bool hasNonOpaque = (ubo.flags & (1u << 5)) != 0u;
                    rayQueryEXT tRq;
                    rayQueryInitializeEXT(
                        tRq, topLevelAS,
                        gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        hasNonOpaque ? RAY_MASK_OPAQUE : RAY_MASK_ALL,
                        nextOrigin, EPSILON, nextDirection, 10000.0
                    );
                    rayQueryProceedEXT(tRq);
                    if (rayQueryGetIntersectionTypeEXT(tRq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
                        vec3 skyColor;
                        if (pc.hasEnvMap == 1u) {
                            vec2 envUv = directionToEquirectangular(nextDirection);
                            skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
                        } else {
                            float t = 0.5 * (nextDirection.y + 1.0);
                            skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
                        }
                        vec3 skyContrib = clampIndirectRadiance(vec3(throughput) * skyColor, pc.indirectClamp) * invSpp;
                        ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                        if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                            vec4 prev = imageLoad(uAccumImage, pCoord);
                            imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), prev.a));
                        }
                        if (pc.captureMlData != 0u) {
                            bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                            wfAddSplitIndirect(pCoord,
                                               routeAllToSpec ? vec3(0.0) : skyContrib,
                                               routeAllToSpec ? skyContrib : vec3(0.0),
                                               pc.captureMlData, seed);
                            if (isV4 || (pc.captureMlData & ML_CAPTURE_SPLIT_4SIG_BIT) == 0u) {
                                if (routeAllToSpec) {
                                    vec3 outSpec = isV4 ? demodulateMlSafe(skyContrib, imageLoad(uMlSpecAlbedoImage, pCoord).rgb) : skyContrib;
                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                                    imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                                } else {
                                    vec3 outDiff = isV4 ? demodulateMlSafe(skyContrib, imageLoad(uMlAlbedoRoughnessImage, pCoord).rgb) : skyContrib;
                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                                    imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                                }
                            }
                        }
                        pathTerminated = true;
                        validBounce = false;
                    } else {
                        float tBestT = rayQueryGetIntersectionTEXT(tRq, true);
                        uint tInstIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(tRq, true);
                        uint tGeomIdx = rayQueryGetIntersectionGeometryIndexEXT(tRq, true);
                        uint tPrimIdx = rayQueryGetIntersectionPrimitiveIndexEXT(tRq, true);
                        vec2 tBary = rayQueryGetIntersectionBarycentricsEXT(tRq, true);
                        mat4x3 tW2o = rayQueryGetIntersectionWorldToObjectEXT(tRq, true);

                        InstanceGPU tInst = instances[tInstIdx];
                        uint tTriIdx = tInst.firstTriangle + ((tGeomIdx == 0u) ? tPrimIdx : (tPrimIdx + tInst.numOpaqueTriangles));
                        Triangle tTri = triangles[tTriIdx];
                        uint tMatId = tTri.materialId + tInst.materialOffset;
                        if (tMatId < pc.numMaterials) {
                            ShadeMaterial tSm = shadeMaterials[tMatId];
                            uint tType = smGetTypeFlags(tSm);
                            if ((tType & MATERIAL_TYPE_MASK) != 2u && !smIsTransmissive(tSm)) {
                                vec3 tRawN = normalize(transpose(mat3(tW2o)) * getTriangleNormal(tTri, tBary));
                                bool tFront = dot(nextDirection, tRawN) < 0.0;
                                vec3 tN = tFront ? tRawN : -tRawN;
                                vec2 tUv = getTriangleUV(tTri, tBary);

                                vec3 tAlb = tSm.albedo.rgb;
                                uint tAlbTex = smGetAlbedoTex(tSm);
                                if (tAlbTex > 0u && tAlbTex <= 512u) {
                                    tAlb *= SAMPLE_SCENE_TEXTURE_LOD(tAlbTex, tUv, 4.0).rgb;
                                }
                                vec3 tEmit = tSm.emissive_spec.rgb;
                                uint tEmTex = smGetEmissiveTex(tSm);
                                if (tEmTex > 0u && tEmTex <= 512u && (tType & MATERIAL_FLAG_PROCEDURAL_HOLO) == 0u) {
                                    tEmit *= SAMPLE_SCENE_TEXTURE_LOD(tEmTex, tUv, 4.0).rgb;
                                }
                                bool emitVis = (tTri.padding0 == TRI_LIGHT_NONE) || (tFront && tTri.padding0 != TRI_LIGHT_NEE_ONLY);
                                if (emitVis && length(tEmit) > 1e-3) {
                                    vec3 emitContrib = clampIndirectRadiance(vec3(throughput) * tEmit, pc.indirectClamp) * invSpp;
                                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                        vec4 prev = imageLoad(uAccumImage, pCoord);
                                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, emitContrib, seed), prev.a));
                                    }
                                    if (pc.captureMlData != 0u) {
                                        bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                                        wfAddSplitIndirect(pCoord,
                                                           routeAllToSpec ? vec3(0.0) : emitContrib,
                                                           routeAllToSpec ? emitContrib : vec3(0.0),
                                                           pc.captureMlData, seed);
                                        if (isV4 || (pc.captureMlData & ML_CAPTURE_SPLIT_4SIG_BIT) == 0u) {
                                            if (routeAllToSpec) {
                                                vec3 outSpec = isV4 ? demodulateMlSafe(emitContrib, imageLoad(uMlSpecAlbedoImage, pCoord).rgb) : emitContrib;
                                                vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                                                imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                                            } else {
                                                vec3 outDiff = isV4 ? demodulateMlSafe(emitContrib, imageLoad(uMlAlbedoRoughnessImage, pCoord).rgb) : emitContrib;
                                                vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                                                imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                                            }
                                        }
                                    }
                                }
                                if ((tType & MATERIAL_TYPE_MASK) == 3u) {
                                    pathTerminated = true;
                                    validBounce = false;
                                } else {
                                    float tRough = clamp(tSm.pbrParams.x, 0.04, 1.0);
                                    float tMet = clamp(tSm.pbrParams.y, 0.0, 1.0);
                                    if ((tType & 0xFFu) == 1u) {
                                        tMet = max(tMet, 1.0);
                                    }
                                    float tIor = tSm.pbrParams.z > 0.0 ? tSm.pbrParams.z : 1.5;
                                    float tF0Dielec = pow((tIor - 1.0) / (tIor + 1.0), 2.0);
                                    vec3 tDiff = tAlb * (1.0 - tMet);
                                    vec3 tF0 = mix(vec3(clamp(tF0Dielec * tSm.emissive_spec.w, 0.0, 1.0)), tAlb, tMet);
                                    vec3 tRefl;
                                    float tSpecRatio;
                                    nrcSurfaceReflectance(tDiff, tF0, tRough, 0.0, 1.0, clamp(dot(tN, -nextDirection), 0.0, 1.0),
                                                          tRefl, tSpecRatio);
                                    emitTransNrcQuery = true;
                                    transNrcPos = nextOrigin + tBestT * nextDirection;
                                    transNrcRough = tRough;
                                    transNrcNormal = tN;
                                    transNrcSpecFlag = routeAllToSpec ? 1.0 : 0.0;
                                    transNrcView = -nextDirection;
                                    transNrcSpecRatio = tSpecRatio;
                                    transNrcThroughput = vec3(throughput) * tRefl * invSpp;
                                    transNrcPixelIdx = pixelIndex;
                                    pathTerminated = true;
                                    validBounce = false;
                                }
                            }
                        }
                    }
                }
#endif
            } else {
                // One-sample mixture over the shared BSDF (bsdf_standard.glsl):
                // clearcoat (prob ccProb), else base spec (specProb), else cosine
                // (transmitted with prob diffTrans). weight = f·|cos| / pdf_mixture.
#if !IS_SECONDARY_BOUNCE
                    bool useRestirNonV4Sobol = (pc.captureMlData != 0u) && ((ubo.flags & (1u << 9)) != 0u) && ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u);
                    bool useBounce0Sobol = (bounce == 0u) && (pc.captureMlData != 0u || useRestirNonV4Sobol || pc.secondarySortMode < 2u);
                    uint sobolSampleIdx = pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex;
                    float lobeSelect = useBounce0Sobol
                        ? sampleSobolOwen1D(pixelIndex, pc.width, sobolSampleIdx, 0u)
                        : randFloat(seed);
#else
                    float lobeSelect = randFloat(seed);
#endif
                    bool pickSpec = false;
                    bool isClearcoatSample = false;
                    bool isTrans = false;
                    bool validSample = true;
                    if (lobeSelect < bsdf.ccProb) {
                        pickSpec = true;
                        isClearcoatSample = true;
                        // V below the coat normal: the coat lobe has no valid
                        // samples (its pdf term is 0 there) -> discard.
                        if (dot(bsdf.Nc, V) > 0.0) {
#if !IS_SECONDARY_BOUNCE
                            vec2 uCc = useBounce0Sobol
                                ? sampleSobolOwen2D(pixelIndex, pc.width, sobolSampleIdx, 1u)
                                : randVec2(seed);
                            vec3 H_cc = sampleGgxVndfHalfVectorVec2(bsdf.Nc, V, bsdf.ccAlpha, uCc);
#else
                            vec3 H_cc = sampleGgxVndfHalfVector(bsdf.Nc, V, bsdf.ccAlpha, seed);
#endif
                            nextDirection = reflect(-V, H_cc);
                        } else {
                            validSample = false;
                        }
                    } else {
                        float u = (lobeSelect - bsdf.ccProb) / max(1.0 - bsdf.ccProb, 1e-6);
                        if (u < bsdf.specProb) {
                            pickSpec = true;
#if !IS_SECONDARY_BOUNCE
                            vec2 uSpec = useBounce0Sobol
                                ? sampleSobolOwen2D(pixelIndex, pc.width, sobolSampleIdx, 1u)
                                : randVec2(seed);
                            vec3 H_spec = sampleStdGgxVndfHalfVectorVec2(bsdf, hitNormal, V, uSpec);
#else
                            vec3 H_spec = sampleStdGgxVndfHalfVector(bsdf, hitNormal, V, seed);
#endif
                            nextDirection = reflect(-V, H_spec);
                        } else {
                            uint clusterK = (pc.secondarySortMode == 3u) ? 8u : 4u;
                            uint frameRot = pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex;
                            isTrans = (bsdf.diffTrans > 0.0 && randFloat(seed) < bsdf.diffTrans);
                            vec3 lobeN = isTrans ? -hitNormal : hitNormal;
#if !IS_SECONDARY_BOUNCE
                            nextDirection = useBounce0Sobol
                                ? sampleCosineHemisphereVec2(lobeN, sampleSobolOwen2D(pixelIndex, pc.width, sobolSampleIdx, 2u))
                                : (((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u)
                                    ? sampleCosineHemisphereCoherent(lobeN, seed, clusterK, frameRot)
                                    : sampleCosineHemisphere(lobeN, seed));
#else
                            bool useBounce1Sobol = (bounce == 1u) &&
                                ((pc.captureMlData != 0u) && ((ubo.flags & (1u << 9)) != 0u) && ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u));
                            nextDirection = useBounce1Sobol
                                ? sampleCosineHemisphereVec2(lobeN, sampleSobolOwen2D(pixelIndex, pc.width, frameRot, 8u))
                                : ((pc.secondarySortMode >= 2u && ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u))
                                    ? sampleCosineHemisphereCoherent(lobeN, seed, clusterK, frameRot)
                                    : sampleCosineHemisphere(lobeN, seed));
#endif
                        }
                    }
                    // Reflection samples below the shading horizon are discarded
                    // (the mixture pdf there only contains the transmission lobe).
                    if (validSample && pickSpec && dot(hitNormal, nextDirection) <= 0.0) {
                        validSample = false;
                    }
                    if (validSample) {
                        float bsdfPdf = 0.0;
                        vec3 specFCos = vec3(0.0);
                        vec3 fCos = stdBsdfEvalSplit(bsdf, hitNormal, V, nextDirection, bsdfPdf, specFCos);
#if !IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
                        giSampledBsdfPdf = bsdfPdf;
#endif
                        bool mergeMatteIndirectSpec = ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u) && (roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01);
                        if (bsdfPdf > 0.0 && dot(fCos, vec3(1.0)) > 0.0) {
                            if (pc.captureMlData != 0u && bounce == 0u && !mergeMatteIndirectSpec && bsdf.specProb > 0.0 && bsdf.specProb < 1.0) {
                                float NdotL = abs(dot(hitNormal, nextDirection));
                                float diffFactor = isTrans ? bsdf.diffTrans : (1.0 - bsdf.diffTrans);
                                float diffSelPdf = (1.0 - bsdf.ccProb) * (1.0 - bsdf.specProb) * diffFactor * NdotL * INV_PI;
                                float specSelPdf = max(bsdfPdf - diffSelPdf, 0.0);
                                vec3 lobeFCos = pickSpec ? specFCos : max(fCos - specFCos, vec3(0.0));
                                float lobePdf = pickSpec ? specSelPdf : diffSelPdf;
                                if (lobePdf > 1e-7 && dot(lobeFCos, vec3(1.0)) > 0.0) {
                                    vec3 wLobe = min(lobeFCos / lobePdf, vec3(65000.0));
                                    nrcBsdfWeight = wLobe;
                                    throughput *= f16vec3(wLobe);
                                    nextPdfCode = encodeBsdfPdf(bsdfPdf);
                                    nextOrigin = offsetRayOrigin(hitPoint, isTrans ? -hitNormal : hitNormal);
                                    sampledSpecularLobe = pickSpec;
                                    validBounce = true;
                                } else {
                                    validSample = false;
                                }
                            } else {
                                vec3 wStd = min(fCos / bsdfPdf, vec3(65000.0));
                                nrcBsdfWeight = wStd;
                                throughput *= f16vec3(wStd);
                                nextPdfCode = encodeBsdfPdf(bsdfPdf);
                                nextOrigin = offsetRayOrigin(hitPoint, isTrans ? -hitNormal : hitNormal);
                                sampledSpecularLobe = pickSpec;
                                validBounce = true;
                            }
                        } else {
                            validSample = false;
                        }
                    }
                    if (!validSample) {
                        pathTerminated = true;
                    }
            }

#if ENABLE_NRC
            if (nrcTrainThisPath) {
                nrcEmitSelfTrainingRecord(
                    hitPoint, hitNormal, V, pixelIndex,
                    nrcExactRefl, nrcSpecRatio, nrcRoughness,
                    validBounce, nextOrigin, nextDirection, nrcBsdfWeight, nextPdfCode, seed
                );
            }
#endif
            if (!canContinueWavefront || (nrcTrainThisPath && nrcQueryEmitted)) {
                pathTerminated = true;
            }

            // Adaptive Russian roulette (only for paths that actually continue)
            if (!pathTerminated) {
                float maxThresh = float(max(throughput.r, max(throughput.g, throughput.b)));
                pathTerminated = applyRussianRoulette16(throughput, maxThresh, bounce, seed);
            }

            if (!pathTerminated) {
                survivesToNext = true;
                nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                bool matteNrcSpec = ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u) && (roughness >= 0.70 && metallic < 0.05 && clearcoat <= 0.01);
                bool mergeMatteIndirectSpec = (pc.captureMlData != 0u) && matteNrcSpec;
                bool outIsSpecularPath = (bounce == 0u) ? (sampledSpecularLobe && !mergeMatteIndirectSpec) : isSpecularPath;
                bool outNrcSkip = (bounce == 0u) ? (sampledSpecularLobe && metallic >= 0.85 && roughness < 0.06) : (inNrcSkip && bounce < 2u);
                nextState = packRayState(throughput, seed, pixelIndex, outIsSpecularPath, causticApplied, dispersionChannel, nextPdfCode, outNrcSkip);
            }
#if !IS_SECONDARY_BOUNCE && ENABLE_RESTIR_PT
            bool tagDiMis = diRestirMisActive && survivesToNext && (nextPdfCode != 0u);
            bool hasValidGiCtx = giSurfaceEligible && survivesToNext;
            if (hasValidGiCtx || diRestirRan) {
                uint x1Flags = (hasValidGiCtx ? X1_FLAG_VALID : 0u) | (tagDiMis ? X1_FLAG_DI_RESTIR_MIS : 0u);
                x1Contexts[pixelIndex] = makePrepackedX1Context(hitNormal, x1PreY, x1PreZ, x1PreRF0, max(giSampledBsdfPdf, 1e-8), x1Flags);
            } else {
                if (tagDiMis) {
                    x1Contexts[pixelIndex] = makeDiMisOnlyX1Context();
                } else if (enableRestirFlag && bounce == 0u) {
                    x1Contexts[pixelIndex].data.w = 0u;
                }
            }
            if (!hasValidGiCtx && enableRestirFlag && bounce == 0u && pc.sppSampleIndex == 0u) {
                giCurrentData[pixelIndex].y = 0u;
            }
#endif
            }
        }
    }

#if IS_SECONDARY_BOUNCE && ENABLE_NRC
    uvec4 transQBallot = subgroupBallot(emitTransNrcQuery);
    uint transQWaveCount = subgroupBallotBitCount(transQBallot);
    uint transQWaveBase = 0u;
    if (transQWaveCount > 0u) {
        uint maxQ = pc.width * pc.height;
        if (subgroupElect()) {
            transQWaveBase = atomicAdd(nrcCounters.queryCount, transQWaveCount);
            if (transQWaveBase < maxQ) {
                uint endIdx = min(transQWaveBase + transQWaveCount - 1u, maxQ - 1u);
                if ((transQWaveBase & 63u) == 0u || (transQWaveBase >> 6u) != (endIdx >> 6u)) {
                    atomicMax(nrcCounters.dispatchX, (endIdx >> 6u) + 1u);
                }
            }
        }
        transQWaveBase = subgroupBroadcastFirst(transQWaveBase);
        uint qIdx = transQWaveBase + subgroupBallotExclusiveBitCount(transQBallot);
        if (emitTransNrcQuery && qIdx < maxQ) {
            nrcQueries[qIdx].pos_roughness = vec4(transNrcPos, transNrcRough);
            nrcQueries[qIdx].normal_flags = vec4(transNrcNormal, transNrcSpecFlag);
            nrcQueries[qIdx].dir_pixelIndex = vec4(transNrcView, uintBitsToFloat(transNrcPixelIdx));
            nrcQueries[qIdx].albedo_pad = vec4(transNrcSpecRatio, 0.0, 0.0, 0.0);
            nrcQueries[qIdx].throughput = vec4(transNrcThroughput, 0.0);
        }
    }
#endif

    // Standard single-queue linear compaction for ray geometry and state
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (waveActiveCount > 0u) {
        if (subgroupElect()) {
            waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);
    }

    uint targetIdx = waveGlobalOffset + laneSlot;
    if (survivesToNext) {
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    if (pc.secondarySortMode == 1u) {
        // Producer-Side Binning: Record compacted ray indices into 8 directional octant queues
        uint oct = survivesToNext ? getDirectionalOctant(nextDirection) : 0u;
        uvec4 activeBallot = subgroupBallot(survivesToNext);
        while (subgroupBallotBitCount(activeBallot) > 0u) {
            uint leaderLane = subgroupBallotFindLSB(activeBallot);
            uint k = subgroupBroadcast(oct, leaderLane);
            bool isOct = survivesToNext && (oct == k);
            uvec4 octBallot = subgroupBallot(isOct);
            uint octCount = subgroupBallotBitCount(octBallot);
            uint octSlot = subgroupBallotExclusiveBitCount(octBallot);
            uint octBase = 0u;
            if (gl_SubgroupInvocationID == leaderLane) {
                octBase = atomicAdd(queueCounters.octantCounts[k], octCount);
            }
            octBase = subgroupBroadcast(octBase, leaderLane);
            if (isOct) {
                uint dest = k * pc.maxQueueCapacity + (octBase + octSlot);
                if (octBase + octSlot < pc.maxQueueCapacity) {
                    secondaryIndices[dest] = targetIdx;
                }
            }
            activeBallot.x &= ~octBallot.x;
            activeBallot.y &= ~octBallot.y;
            activeBallot.z &= ~octBallot.z;
            activeBallot.w &= ~octBallot.w;
        }
    }

    // Subgroup Wave Ballot Compaction for Shadow Rays
    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (shadowWaveCount > 0u) {
        if (subgroupElect()) {
            shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
        }
        shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);
    }

    if (hasShadowRay) {
        uint targetIdxShadow = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdxShadow < pc.maxQueueCapacity) {
            shadowRays[targetIdxShadow] = shadowCandidate;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == queueCounters.totalShadeWorkgroups - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.commands[b * 16u + 6u].x = shadowGroups;
            indirect.commands[b * 16u + 6u].y = 1u;
            indirect.commands[b * 16u + 6u].z = 1u;
            indirect.commands[b * 16u + 6u].pad = shadowCount;

            dgcStream.commands[b * 16u + 6u].pipelineIndex = 3u; // Shadow pipeline
            dgcStream.commands[b * 16u + 6u].x = shadowGroups;
            dgcStream.commands[b * 16u + 6u].y = 1u;
            dgcStream.commands[b * 16u + 6u].z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            bool skipNextBounce = (b > 0u && pc.minRayThreshold > 0u && nextCount <= pc.minRayThreshold);
            uint intersectGroups = skipNextBounce ? 0u : ((nextCount + 31u) / 32u);

            // Slot 7: Standard monolithic / Option 2 intersect dispatch
            indirect.commands[b * 16u + 7u].x = intersectGroups;
            indirect.commands[b * 16u + 7u].y = 1u;
            indirect.commands[b * 16u + 7u].z = 1u;
            indirect.commands[b * 16u + 7u].pad = nextCount;

            dgcStream.commands[b * 16u + 7u].pipelineIndex = 1u; // Intersect pipeline
            dgcStream.commands[b * 16u + 7u].x = intersectGroups;
            dgcStream.commands[b * 16u + 7u].y = 1u;
            dgcStream.commands[b * 16u + 7u].z = 1u;

            // Slots 8..15: Producer-Side Binning Directional DGC intersect dispatches
            uint totalIntersectWgs = 0u;
            uint totalOctantRays = 0u;
            if (pc.secondarySortMode == 1u) {
                for (uint k = 0u; k < 8u; ++k) {
                    uint octCnt = queueCounters.octantCounts[k];
                    queueCounters.currentOctantCounts[k] = octCnt;
                    uint octGroups = skipNextBounce ? 0u : ((octCnt + 31u) / 32u);
                    totalIntersectWgs += octGroups;
                    totalOctantRays += octCnt;

                    indirect.commands[b * 16u + 8u + k].x = octGroups;
                    indirect.commands[b * 16u + 8u + k].y = 1u;
                    indirect.commands[b * 16u + 8u + k].z = 1u;
                    indirect.commands[b * 16u + 8u + k].pad = octCnt;

                    dgcStream.commands[b * 16u + 8u + k].pipelineIndex = 1u;
                    dgcStream.commands[b * 16u + 8u + k].x = octGroups;
                    dgcStream.commands[b * 16u + 8u + k].y = 1u;
                    dgcStream.commands[b * 16u + 8u + k].z = 1u;

                    queueCounters.octantCounts[k] = 0u;
                }
            } else {
                totalIntersectWgs = intersectGroups;
                totalOctantRays = nextCount;
            }
            queueCounters.totalIntersectWorkgroups = totalIntersectWgs;
            queueCounters.secondaryRayCount = totalOctantRays;

            if (pc.secondarySortMode == 2u) {
                indirect.commands[b * 16u + 8u].x = intersectGroups;
                indirect.commands[b * 16u + 8u].y = 1u;
                indirect.commands[b * 16u + 8u].z = 1u;
                indirect.commands[b * 16u + 8u].pad = nextCount;
            }

            if (skipNextBounce && b + 1u < pc.maxBounces) {
                uint nextB = b + 1u;
                for (uint c = 0u; c < 8u; ++c) {
                    indirect.commands[nextB * 16u + c].x = 0u;
                }
                for (uint k = 0u; k < 8u; ++k) {
                    indirect.commands[nextB * 16u + 8u + k].x = 0u;
                }
                for (uint c = 0u; c < 4u; ++c) {
                    dgcStream.commands[nextB * 16u + c].x = 0u;
                }
                queueCounters.activeMaterialSequenceCount = 0u;
                queueCounters.totalShadeWorkgroups = 0u;
            }

            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces && !skipNextBounce) ? totalOctantRays : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
