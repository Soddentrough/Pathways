#version 460
#ifndef IS_SECONDARY_BOUNCE
#define IS_SECONDARY_BOUNCE 0
#endif
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_nonuniform_qualifier : enable

#define WF_ENABLE_FFX_SIGNALS 1
#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 23, rgba16f) uniform readonly image2D uMotionVectorImage;
layout(binding = 27, rgba16f) uniform image2D uMlSpecularMotionImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 31, rgba16f) uniform readonly image2D uCausticImage;
layout(binding = 24, rgba16f) uniform readonly image2D uNormalDepthImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[512];

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 12) writeonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 17) readonly buffer InRayHitQueue {
    RayHit inHits[];
};

layout(std430, binding = 18) readonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(std430, binding = 19) writeonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(std430, binding = 20) writeonly buffer OutNRCQueryQueue {
    NRCQuery nrcQueries[];
};

layout(std430, binding = 21) buffer InOutNRCTrainQueue {
    NRCTrainingRecord nrcTrainRecords[];
};

layout(std430, binding = 22) buffer InOutNRCCounters {
    NRCCountersBuffer nrcCounters;
};

layout(std430, binding = 25) readonly buffer LightTreeBuffer {
    LightTreeNode lightNodes[];
};

#define RESTIR_INCLUDE_SAMPLER_HELPERS
#include "restir_common.glsl"
#include "bsdf_standard.glsl"
#include "mis_common.glsl"

layout(std430, binding = 32) buffer ReSTIRCurrentReservoirsBuffer {
    DiReservoir currentReservoirs[];
};

layout(std430, binding = 36) readonly buffer ReSTIRHistoryReservoirsBuffer {
    DiReservoir historyReservoirs[];
};

// ReSTIR GI (path-space) state — docs/RESTIR_PT_DESIGN.md. Complex materials
// only participate as X1 context producers (diffuse-lobe continuations);
// their bounce-1 GI slot is always invalidated (x2 on a complex surface is
// out of the GI scope for now).
layout(std430, binding = 37) buffer X1ContextsBuffer {
    X1Context x1Contexts[];
};

layout(std430, binding = 38) buffer GiCurrentReservoirsBuffer {
    GiReservoir giReservoirs[];
};

layout(std430, binding = 39) readonly buffer GiHistoryReservoirsBuffer {
    GiReservoir giHistoryReservoirs[];
};

#ifndef ENABLE_INLINE_SHADOWS
#if IS_SECONDARY_BOUNCE
#define ENABLE_INLINE_SHADOWS 0
#else
#define ENABLE_INLINE_SHADOWS 1
#endif
#endif

#if ENABLE_INLINE_SHADOWS
#include "wavefront_shadow_inline.glsl"
#endif

layout(push_constant) uniform PushConstants {
    WavefrontShadePC pc;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint activeCount = queueCounters.currentMaterialCounts[1]; // Complex queue
    bool inRange = (idx < activeCount);
    bool survivesToNext = false;
    bool hasShadowRay = false;
    vec3 nextDirection = vec3(0.0);
    RayGeometry nextGeom;
    RayState nextState;
    PackedShadowRay shadowCandidate;

    if (inRange) {
        uint rayIdx = materialIndices[1u * pc.maxQueueCapacity + idx];
        RayGeometry geom = inGeoms[rayIdx];
        RayHit hit = inHits[rayIdx];
        RayState state = inStates[rayIdx];

        vec3 origin = geom.originPackedDir.xyz;
        vec3 rayDir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        float hitT;
        uint matId, hitType;
        vec3 hitNormal, geomTan;
        vec2 hitUv;
        float tanSign;
        unpackRayHit(hit, hitT, matId, hitType, hitNormal, hitUv, geomTan, tanSign);

        f16vec3 throughput;
        uint seed, pixelIndex;
        bool isSpecularPath, causticApplied;
        uint dispersionChannel = 0u;
        unpackRayState(state, throughput, seed, pixelIndex, isSpecularPath, causticApplied, dispersionChannel);
        uint bounce = pc.currentBounce;
        bool sampledSpecularLobe = false;

        // ReSTIR GI bookkeeping for complex-material pixels.
        bool giCtxEligible = false;
        if ((ubo.flags & (1u << 9)) != 0u) {
            if (bounce == 0u) {
                // Invalid by default; valid only where a diffuse cosine
                // reflection lobe emits the bounce-1 ray (below).
                x1Contexts[pixelIndex] = invalidX1Context();
            } else if (bounce == 1u) {
                // Complex x2: no GI candidate; keep the grid free of stale data.
                giReservoirs[pixelIndex] = invalidGiReservoir();
            }
        }

        if (hitType == 2u) {
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(rayDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (rayDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            vec3 skyContrib = vec3(throughput) * skyColor;
            if (bounce > 0u) {
                float effClamp = computeAdaptiveFireflyClamp(pc.indirectClamp, unpackRayPdfCode(state));
                skyContrib = clampIndirectRadiance(skyContrib, effClamp);
            }
            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
            if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, skyContrib, seed), prev.a));
            }
            bool enableRestirPT = ((ubo.flags & (1 << 9)) != 0);
            if (enableRestirPT && bounce == 0u) {
                currentReservoirs[pixelIndex] = invalidDiReservoir();
            }


            if (pc.captureMlData != 0u) {
                if (isSpecularPath) {
                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, skyContrib, seed), prevSpec.a));
                } else {
                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, skyContrib, seed), prevDiff.a));
                }
                accumFfxSignal(pixelCoord, skyContrib, isSpecularPath, bounce == 0u, seed);
            }
            RECORD_SPECULAR_VMV(pixelIndex, origin + rayDir * 1000.0, 10000.0, true);
        } else {
            vec3 hitPoint = origin + hitT * rayDir;
            RECORD_SPECULAR_VMV(pixelIndex, hitPoint, hitT, false);
            bool frontFace = dot(rayDir, hitNormal) < 0.0;
            hitNormal = frontFace ? hitNormal : -hitNormal;

            Material mat = materials[matId];
            uint inPdfCode = unpackRayPdfCode(state);
#if IS_SECONDARY_BOUNCE
            bool hasSampledTex = ((mat.albedoTex | mat.emissiveTex | mat.mrTex) != 0u);
#else
            bool hasSampledTex = ((mat.albedoTex | mat.normalTex | mat.mrTex | mat.emissiveTex |
                                   mat.transmissionTex | mat.thicknessTex | mat.clearcoatTex |
                                   mat.clearcoatRoughnessTex | mat.clearcoatNormalTex |
                                   mat.specularTex | mat.sheenTex | mat.diffuseTransmissionTex) != 0u);
#endif
            float rayConeBaseLod = hasSampledTex
                ? computeRayConeBaseLod(hit.hitData1.w >> 16u, hitT, rayDir, hitNormal,
                                        2.0 * abs(ubo.projInverse[1][1]) / float(max(pc.height, 1u)),
                                        bounce, inPdfCode)
                : -16.0;
#if !IS_SECONDARY_BOUNCE
            if (bounce == 0u && hitType == 0u && mat.normalTex > 0u && mat.normalTex <= 512u) {
                vec3 normalMap = SAMPLE_SCENE_TEXTURE_LOD(mat.normalTex, hitUv, rayConeBaseLod).rgb * 2.0 - 1.0;
                normalMap.xy *= mat.normalScale;
                normalMap = normalize(normalMap);

                geomTan = normalize(geomTan - dot(geomTan, hitNormal) * hitNormal);
                vec3 geomBitangent = cross(hitNormal, geomTan) * tanSign;
                mat3 tbn = mat3(geomTan, geomBitangent, hitNormal);
                hitNormal = adjustShadingNormal(normalize(tbn * normalMap), -rayDir);
            }
#endif

            f16vec3 baseColor = f16vec3(mat.albedo.rgb);
            if (mat.albedoTex > 0u && mat.albedoTex <= 512u) {
                baseColor *= f16vec3(SAMPLE_SCENE_TEXTURE_LOD(mat.albedoTex, hitUv, rayConeBaseLod).rgb);
            }

            vec3 emissive = mat.emissive.rgb;
            if (mat.emissiveTex > 0u && mat.emissiveTex <= 512u) {
                emissive *= SAMPLE_SCENE_TEXTURE_LOD(mat.emissiveTex, hitUv, rayConeBaseLod).rgb;
            }
            // Emission found by the path: MIS-weighted against NEE at the
            // previous vertex (mis_common.glsl); camera rays count fully.
            float emitMisW = (bounce == 0u) ? 1.0
                : emitterHitMisWeight(hitType, hit.hitData1.y, origin, rayDir, hitT, inPdfCode, pc.numLights);
            if (length(emissive) > 1e-3 && emitMisW > 0.0) {
                vec3 emissiveContrib = vec3(throughput) * emissive * emitMisW;
                if (bounce > 0u) {
                    float effClamp = computeAdaptiveFireflyClamp(pc.indirectClamp, inPdfCode);
                    emissiveContrib = clampIndirectRadiance(emissiveContrib, effClamp);
                }
                ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                    vec4 prev = imageLoad(uAccumImage, pCoord);
                    imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, emissiveContrib, seed), prev.a));
                }
                if (pc.captureMlData != 0u) {
                    if (isSpecularPath) {
                        vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                        imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, emissiveContrib, seed), prevSpec.a));
                    } else {
                        vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                        imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, emissiveContrib, seed), prevDiff.a));
                    }
                    accumFfxSignal(pCoord, emissiveContrib, isSpecularPath, bounce == 0u, seed);
                }
                bool enableRestirPT = ((ubo.flags & (1 << 9)) != 0);
                if (enableRestirPT && bounce == 0u) {
                    currentReservoirs[pixelIndex] = invalidDiReservoir();
                }
            }

            bool pathTerminated = false;
            float roughness = mat.roughness;
            float metallic = mat.metallic;
            if (mat.mrTex > 0u && mat.mrTex <= 512u) {
                vec4 mrSample = SAMPLE_SCENE_TEXTURE_LOD(mat.mrTex, hitUv, rayConeBaseLod);
                roughness *= mrSample.g;
                metallic *= mrSample.b;
            }
            roughness = clamp(roughness, 0.04, 1.0);
            metallic = clamp(metallic, 0.0, 1.0);
            float alphaRoughness = roughness * roughness;

            float transmission = mat.transmission;
            if (mat.transmissionTex > 0u && mat.transmissionTex <= 512u) {
                transmission *= SAMPLE_SCENE_TEXTURE_LOD(mat.transmissionTex, hitUv, rayConeBaseLod).r;
            }

            float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
            float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
            float specFactor = mat.specularFactor;
            if (mat.specularTex > 0u && mat.specularTex <= 512u) {
                specFactor *= SAMPLE_SCENE_TEXTURE_LOD(mat.specularTex, hitUv, rayConeBaseLod).a;
            }
            f16vec3 dielectricF0 = f16vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0));
            f16vec3 F0 = mix(dielectricF0, baseColor, float16_t(metallic));
            f16vec3 diffuseColor = baseColor * float16_t(1.0 - metallic);
            vec3 V = -rayDir;

            float diffTrans = clamp(mat.diffuseTransmission, 0.0, 1.0);
            if (mat.diffuseTransmissionTex > 0u && mat.diffuseTransmissionTex <= 512u) {
                diffTrans *= SAMPLE_SCENE_TEXTURE_LOD(mat.diffuseTransmissionTex, hitUv, rayConeBaseLod).r;
            }
            diffTrans = clamp(diffTrans, 0.0, 1.0);

            float clearcoat = clamp(mat.clearcoat, 0.0, 1.0);
            if (mat.clearcoatTex > 0u && mat.clearcoatTex <= 512u) {
                clearcoat *= SAMPLE_SCENE_TEXTURE_LOD(mat.clearcoatTex, hitUv, rayConeBaseLod).r;
            }
            float clearcoatRoughness = mat.clearcoatRoughness;
            if (mat.clearcoatRoughnessTex > 0u && mat.clearcoatRoughnessTex <= 512u) {
                clearcoatRoughness *= SAMPLE_SCENE_TEXTURE_LOD(mat.clearcoatRoughnessTex, hitUv, rayConeBaseLod).g;
            }
            clearcoatRoughness = clamp(clearcoatRoughness, 0.001, 1.0);
            float clearcoatAlpha = clearcoatRoughness * clearcoatRoughness;

            vec3 clearcoatNormal = hitNormal;
#if !IS_SECONDARY_BOUNCE
            if (clearcoat > 0.001) {
                if (mat.clearcoatNormalTex > 0u && mat.clearcoatNormalTex <= 512u) {
                    vec3 up = abs(hitNormal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
                    vec3 cTan = normalize(cross(up, hitNormal));
                    vec3 cBitan = cross(hitNormal, cTan);
                    vec3 cNormMap = SAMPLE_SCENE_TEXTURE_LOD(mat.clearcoatNormalTex, hitUv, rayConeBaseLod).rgb * 2.0 - 1.0;
                    clearcoatNormal = normalize(mat3(cTan, cBitan, hitNormal) * cNormMap);
                }
            }

            // KHR_materials_sheen
            f16vec3 sheenColor = f16vec3(mat.sheenColor);
            if (mat.sheenTex > 0u && mat.sheenTex <= 512u) {
                sheenColor *= f16vec3(SAMPLE_SCENE_TEXTURE_LOD(mat.sheenTex, hitUv, rayConeBaseLod).rgb);
            }
            float sheenRoughness = clamp(mat.sheenRoughness, 0.01, 1.0);
#else
            f16vec3 sheenColor = f16vec3(0.0);
            float sheenRoughness = 0.01;
#endif

            // Volumetric Beer-Lambert absorption (physical ray traversal distance)
            float mediumDist = !frontFace ? hitT : 0.0;
            if (mat.attenuationColor.w > 0.0 && mediumDist > 0.0) {
                vec3 sigma_a = -log(max(mat.attenuationColor.rgb, vec3(0.0001))) / mat.attenuationColor.w;
                f16vec3 transmittance = f16vec3(exp(-sigma_a * mediumDist));
                throughput *= transmittance;
            }

            bool enableDirect = (ubo.flags & (1 << 0)) != 0;
            bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
            bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
            bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
            bool enableShadows = (ubo.flags & (1 << 4)) != 0;

            // Delta dielectric continuation (refraction/Fresnel reflection, see
            // "Indirect Bounce"). NEE is skipped exactly on these vertices and the
            // continuation carries pdfCode 0, so emitters it hits count fully.
            bool deltaBranch = enableRefraction && (transmission > 0.001 || (mat.type & MATERIAL_TYPE_MASK) == 2u);

            // Shared STANDARD BSDF + COMPLEX layers (bsdf_standard.glsl): the same
            // function and mixture pdf for NEE, MIS and the continuation.
            StdBsdf bsdf = makeStdBsdf(vec3(diffuseColor), vec3(F0), alphaRoughness, diffTrans, metallic,
                                       dot(hitNormal, V), STD_BSDF_FULL);
            stdBsdfSetLayers(bsdf, enableSpecular, clearcoatNormal, clearcoat, clearcoatAlpha,
                             vec3(sheenColor), sheenRoughness);

            bool enableCaustics = (ubo.flags & (1u << 8)) != 0u && (pc.numLights > 0u);
            if (enableCaustics && transmission < 0.1 && (mat.type & MATERIAL_TYPE_MASK) != 2u && metallic < 0.2) {
                bool alreadyApplied = causticApplied;
                if (!alreadyApplied) {
                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    vec3 causticIrr = imageLoad(uCausticImage, pCoord).rgb;
                    if (dot(causticIrr, causticIrr) > 1e-8) {
                        vec3 causticRad = vec3(throughput) * (vec3(diffuseColor) * INV_PI) * causticIrr;
                        if (bounce > 0u) {
                            causticRad = clampIndirectRadiance(causticRad, pc.indirectClamp);
                        }
                        vec4 prev = imageLoad(uAccumImage, pCoord);
                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, causticRad, seed), prev.a));
                        causticApplied = true;
                        if (pc.captureMlData != 0u) {
                            if (isSpecularPath) {
                                vec4 prevSpec = imageLoad(uMlSpecularImage, pCoord);
                                imageStore(uMlSpecularImage, pCoord, vec4(addFp16Stochastic(prevSpec.rgb, causticRad, seed), prevSpec.a));
                            } else {
                                vec4 prevDiff = imageLoad(uMlDiffuseImage, pCoord);
                                imageStore(uMlDiffuseImage, pCoord, vec4(addFp16Stochastic(prevDiff.rgb, causticRad, seed), prevDiff.a));
                            }
                            accumFfxSignal(pCoord, causticRad, isSpecularPath, false, seed);
                        }
                    }
                }
            }

#if IS_SECONDARY_BOUNCE
            // --- STREAMLINED SECONDARY DIRECT LIGHTING (1-Sample NEE + Base Lobe BRDF) ---
            f16vec3 secDirectL = f16vec3(0.0);
            if (enableDirect && !deltaBranch && pc.numLights > 0u) {
                uint M = (bounce == 1u && isSpecularPath && (inPdfCode == 0u || inPdfCode >= 1280u)) ? 4u : 1u;
                uint chosenLightIdx = 0u;
                vec3 chosenLightDir = vec3(0.0, 1.0, 0.0);
                float chosenLightDist = 0.0;
                float chosenLightPdfEff = 1.0;
                vec3 chosenLightEmission = vec3(0.0);
                vec3 chosenNeeFCos = vec3(0.0);
                float chosenNeeBsdfPdf = 0.0;
                float chosenTargetPdf = 0.0;
                float weightSum = 0.0;
                bool chosenValid = false;

                for (uint m = 0u; m < M; ++m) {
                    uint candLightIdx = 0u;
                    float candSelectPdf = 1.0;
                    if ((ubo.flags & (1 << 7)) != 0 && pc.numLights > 1u) {
                        SAMPLE_LIGHT_TREE(pc.numLights, hitPoint, hitNormal, seed, candLightIdx, candSelectPdf);
                    } else {
                        SAMPLE_LIGHT_ALIAS(pc.numLights, seed, candLightIdx, candSelectPdf);
                    }

                    Light candLight = lights[candLightIdx];
                    vec3 candDir = vec3(0.0, 1.0, 0.0);
                    float candDist = 0.0;
                    float candPdf = 1.0;
                    vec3 candEmission = candLight.emission.rgb;
                    bool candValid = false;

                    if (uint(candLight.position.w) == 0u /* AREA QUAD */) {
                        vec2 luv = randVec2(seed);
                        vec3 lightPoint = candLight.position.xyz + luv.x * candLight.u.xyz + luv.y * candLight.v.xyz;
                        vec3 toLight = lightPoint - hitPoint;
                        candDist = length(toLight);
                        candDir = toLight / max(candDist, 1e-4);
                        float cosLight = dot(-candDir, candLight.normal.xyz);
                        if (cosLight > 0.0) {
                            candPdf = (candDist * candDist) / (candLight.emission.w * cosLight);
                            candValid = true;
                        }
                    } else if (uint(candLight.position.w) == 1u /* SPOT */) {
                        vec3 toLight = candLight.position.xyz - hitPoint;
                        candDist = length(toLight);
                        candDir = toLight / max(candDist, 1e-4);
                        float cosSpot = dot(-candDir, candLight.normal.xyz);
                        if (cosSpot >= candLight.v.w) {
                            float spotFactor = clamp((cosSpot - candLight.v.w) / max(candLight.u.w - candLight.v.w, 1e-4), 0.0, 1.0);
                            candEmission *= spotFactor / max(candDist * candDist, 1e-4);
                            candValid = true;
                        }
                    } else if (uint(candLight.position.w) == 2u /* DIRECTIONAL */) {
                        candDir = normalize(candLight.normal.xyz);
                        candDist = 10000.0;
                        candValid = true;
                    }

                    float candBsdfPdf = 0.0;
                    vec3 candFCos = candValid ? stdBsdfEval(bsdf, hitNormal, V, candDir, candBsdfPdf) : vec3(0.0);
                    float candPdfEff = max(candPdf * candSelectPdf, 1e-6);
                    float targetPdf = candValid ? dot(candFCos * candEmission, vec3(0.2126, 0.7152, 0.0722)) : 0.0;
                    float risW = (targetPdf > 0.0) ? (targetPdf / candPdfEff) : 0.0;
                    weightSum += risW;

                    if (risW > 0.0 && (randFloat(seed) * weightSum <= risW || !chosenValid)) {
                        chosenLightIdx = candLightIdx;
                        chosenLightDir = candDir;
                        chosenLightDist = candDist;
                        chosenLightPdfEff = candPdfEff;
                        chosenLightEmission = candEmission;
                        chosenNeeFCos = candFCos;
                        chosenNeeBsdfPdf = candBsdfPdf;
                        chosenTargetPdf = targetPdf;
                        chosenValid = true;
                    }
                }

                uint lightIdx = chosenLightIdx;
                Light light = lights[lightIdx];
                vec3 lightDir = chosenLightDir;
                float lightDist = chosenLightDist;
                vec3 lightEmission = chosenLightEmission;
                bool validLight = chosenValid;
                float lightDirDotN = dot(hitNormal, lightDir);
                bool isTransmitted = (lightDirDotN < 0.0);
                float neeBsdfPdf = chosenNeeBsdfPdf;
                vec3 neeFCos = chosenNeeFCos;
                if (validLight && chosenTargetPdf > 0.0) {
                    {
                        float lightPdfEff = chosenLightPdfEff;
                        float risWeight = (weightSum / float(M)) / max(chosenTargetPdf, 1e-6);
                        float misWeight = (uint(light.position.w) == 0u) ? neeMisWeight(lightIdx, lightPdfEff, neeBsdfPdf, bounce + 1u < pc.maxBounces) : 1.0;
                        secDirectL = f16vec3(clamp(neeFCos * lightEmission * (misWeight * risWeight), vec3(0.0), vec3(65500.0)));
                        f16vec3 unshadowed = clampIndirectRadiance(throughput * secDirectL, pc.indirectClamp);

                        if (length(unshadowed) > float16_t(1e-5)) {
                            bool keepShadow = true;
                            if (bounce >= 1u && !isSpecularPath) {
                                float lum = float(max(unshadowed.r, max(unshadowed.g, unshadowed.b)));
                                float prob = clamp(lum * 1.5, 0.20, 1.0);
                                if (randFloat(seed) < prob) {
                                    unshadowed /= float16_t(prob);
                                } else {
                                    keepShadow = false;
                                }
                            }
                            if (keepShadow) {
                                if (enableShadows) {
                                    vec3 shadowOrigin = isTransmitted ? (hitPoint - hitNormal * EPSILON) : (hitPoint + hitNormal * EPSILON);
#if ENABLE_INLINE_SHADOWS
                                    bool enableInlineShadows = ((ubo.flags & (1 << 6)) != 0) && (bounce == 0u);
                                    if (enableInlineShadows && pc.useHardwareRT == 1u) {
                                        bool occluded = traceShadowRayInline(shadowOrigin, lightDir, lightDist,
                                                                             (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                        if (!occluded) {
                                            ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                            vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                            if (pc.captureMlData != 0u) {
                                                if (isSpecularPath) {
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(unshadowed), seed), prevSpec.a));
                                                } else {
                                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, vec3(unshadowed), seed), prevDiff.a));
                                                }
                                                accumFfxSignal(pixelCoord, vec3(unshadowed), isSpecularPath, bounce == 0u, seed);
                                            }
                                        } else {
                                            secDirectL = f16vec3(0.0);
                                        }
                                    } else
#endif
                                    {
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(shadowOrigin, lightDist);
                                        shadowCandidate.dirPixelRad = uvec4(packOct32(lightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, isSpecularPath ? 1.0 : 0.0)));
                                    }
                                } else {
                                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    vec4 prev = imageLoad(uAccumImage, pCoord);
                                    imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                }
                            }
                        }
                    }
                }
            }
#else
            // Direct Lighting (Unified ReSTIR PT Inline Path Resampling & Stochastic NEE)
            f16vec3 secDirectL = f16vec3(0.0);
            bool enableRestirPT = ((ubo.flags & (1 << 9)) != 0) && (roughness >= 0.10);
            if (enableDirect && !deltaBranch && pc.numLights > 0u) {
                bool enableInlineShadows = ((ubo.flags & (1 << 6)) != 0) && (bounce == 0u);
                uint M = (bounce == 0u && pc.numLights > 1u) ? min(pc.numLights, 4u) : 1u;

                f16vec3 proxyLumWeight = max(diffuseColor + F0, f16vec3(0.04)) * f16vec3(0.2126, 0.7152, 0.0722);

                DiReservoir r;
                DiSample sel;
                restirDiFreshStream(pc.numLights, (ubo.flags & (1 << 7)) != 0,
                                    hitPoint, hitNormal, hitT, proxyLumWeight,
                                    diffTrans, M, seed, r, sel);

                if (enableRestirPT && bounce == 0u && ubo.frameIndex > 0u &&
                    (ubo.flags & (1 << 23)) == 0u) {
                    // 1. Temporal reuse (tap 0): center tap reprojected with motion vectors
                    ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                    vec2 mv = imageLoad(uMotionVectorImage, pixelCoord).xy;
                    ivec2 prevCoord = ivec2(round(vec2(pixelCoord) - mv * vec2(pc.width, pc.height)));

                    if (prevCoord.x >= 0 && prevCoord.y >= 0 &&
                        prevCoord.x < int(pc.width) && prevCoord.y < int(pc.height)) {
                        DiReservoir src = historyReservoirs[uint(prevCoord.y) * pc.width + uint(prevCoord.x)];
                        uint ageNew = min(restirGetAge(src.flags) + 1u, RESTIR_MAX_AGE);
                        uint tempMCap = min(pc.restirMCap, clamp(pc.numLights * 6u, 6u, 24u));
                        restirDiApplyTap(r, sel, src, pc.numLights, hitPoint, hitNormal, hitT,
                                         proxyLumWeight, diffTrans, tempMCap, ageNew, false, seed);
                    }

                    // Save the pure TEMPORAL reservoir to history.
                    // Spatial reuse must NEVER be fed back into temporal history (prevents positive correlation runaway).
                    currentReservoirs[pixelIndex] = r;

                    // 2. Spatial reuse (taps 1..4): gathers neighbors into a separate shading reservoir
                    DiReservoir shadeR = r;
                    DiSample shadeSel = sel;

                    uint tapHash = (pixelIndex * 0x9E3779B9u) ^ (pc.frameIndex * 0x85EBCA6Bu);
                    uint rot = (tapHash >> 30u) & 3u;

                    for (uint tap = 1u; tap <= 4u; ++tap) {
                        ivec2 base = RESTIR_TAP_OFFSETS[tap - 1u];
                        for (uint rr = 0u; rr < rot; ++rr) {
                            base = ivec2(-base.y, base.x);
                        }
                        ivec2 tapCoord = prevCoord + base;
                        if (tapCoord.x < 0 || tapCoord.y < 0 ||
                            tapCoord.x >= int(pc.width) || tapCoord.y >= int(pc.height)) {
                            continue;
                        }
                        DiReservoir src = historyReservoirs[uint(tapCoord.y) * pc.width + uint(tapCoord.x)];
                        uint mCap = min(pc.restirMCap, 8u);
                        uint ageNew = restirGetAge(src.flags);

                        // Post-selection LATE_WRS_MIS inline shadow ray at finalization handles visibility
                        // without 4 per-tap divergent rayQueryEXT traversals inside the spatial loop.
                        restirDiApplyTap(shadeR, shadeSel, src, pc.numLights, hitPoint, hitNormal, hitT,
                                         proxyLumWeight, diffTrans, mCap, ageNew, false, seed);
                    }

                    r = shadeR;
                    sel = shadeSel;
                } else if (bounce == 0u && ((ubo.flags & (1 << 9)) != 0)) {
                    currentReservoirs[pixelIndex] = enableRestirPT ? r : invalidDiReservoir();
                }

                // Local aliases consumed by the finalization block below
                uint selectedLightIdx = sel.lightIdx;
                vec3 selectedLightDir = sel.dir;
                float selectedLightDist = sel.dist;
                vec3 selectedLightEmission = sel.emission;
                float selectedNdotL = sel.ndotL;
                bool selectedIsTrans = sel.isTrans;
                float selectedTarget = sel.target;
                float selectedCosLight = sel.cosLight;
                float selectedLightSelectPdf = sel.selectPdf;
                bool hasCandidate = sel.has;

                if (hasCandidate && selectedTarget > 1e-6) {
                    vec3 shadowOrigin = selectedIsTrans ? offsetRayOrigin(hitPoint, -hitNormal) : offsetRayOrigin(hitPoint, hitNormal);
                    bool inlineShadowExecuted = false;
                    bool inlineShadowVisible = true;
#if ENABLE_INLINE_SHADOWS
                    if (enableShadows && enableInlineShadows && pc.useHardwareRT == 1u) {
                        // RTXPT LATE_WRS_MIS: Trace inline shadow visibility first so occluded candidates
                        // skip stdBsdfEvalSplit, Light buffer fetch, and LightTree MIS PDF traversal.
                        inlineShadowExecuted = true;
                        inlineShadowVisible = !traceShadowRayInline(shadowOrigin, selectedLightDir, selectedLightDist,
                                                                    (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                    }
#endif
                    if (inlineShadowVisible) {
                        float neeBsdfPdf = 0.0;
                        vec3 neeSpecFCos;
                        vec3 neeFCos = stdBsdfEvalSplit(bsdf, hitNormal, V, selectedLightDir, neeBsdfPdf, neeSpecFCos);

                        // Balance-heuristic MIS weight vs. emission found by the
                        // continuation ray (mis_common.glsl). The RIS finalization
                        // g(x̂)·W is unbiased for ∫g for any target p̂, so weighting
                        // the winner makes NEE estimate ∫g·w_light while BSDF hits
                        // estimate ∫g·w_bsdf with the complementary weight.
                        float misWeight = 1.0;
                        {
                            Light selLight = lights[selectedLightIdx];
                            if (uint(selLight.position.w) == 0u) {
                                float effCos = max(selectedCosLight, 1e-4);
                                float effDist = max(selectedLightDist, 1e-4);
                                float lightPdfEff = ((effDist * effDist) / (selLight.emission.w * effCos)) * selectedLightSelectPdf;
                                misWeight = neeMisWeight(selectedLightIdx, lightPdfEff, neeBsdfPdf, bounce + 1u < pc.maxBounces);
                            }
                        }

                        float risWeight = 1.0;
                        if (enableRestirPT && bounce == 0u) {
                            uint finalM = restirGetM(r.idxM);
                            risWeight = (finalM > 0u && selectedTarget > 1e-6) ? (r.wSum / (float(finalM) * selectedTarget)) : 0.0;
                            risWeight = clamp(risWeight, 0.0, 500.0);
                        } else {
                            risWeight = r.wSum / (float(M) * max(selectedTarget, 1e-6));
                        }

                        float factor = misWeight * risWeight;
                        vec3 neeScale = selectedLightEmission * factor;
                        f16vec3 diffBrdf = f16vec3(clamp((neeFCos - neeSpecFCos) * neeScale, vec3(0.0), vec3(65500.0)));
                        f16vec3 specBrdf = f16vec3(clamp(neeSpecFCos * neeScale, vec3(0.0), vec3(65500.0)));
                        vec3 directLightRadiance = vec3(1.0);
                        secDirectL = diffBrdf + specBrdf;
                        f16vec3 unshadowed = throughput * secDirectL;
                        if (bounce > 0u) {
                            unshadowed = clampIndirectRadiance(unshadowed, pc.indirectClamp);
                        }

                        if (length(unshadowed) > float16_t(1e-5)) {
                            bool keepShadow = true;
                            if (bounce >= 1u && !isSpecularPath) {
                                float lum = float(max(unshadowed.r, max(unshadowed.g, unshadowed.b)));
                                float prob = clamp(lum * 1.5, 0.20, 1.0);
                                if (randFloat(seed) < prob) {
                                    unshadowed /= float16_t(prob);
                                } else {
                                    keepShadow = false;
                                }
                            }
                            if (keepShadow) {
                                if (enableShadows) {
#if ENABLE_INLINE_SHADOWS
                                    if (inlineShadowExecuted) {
                                        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                        if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                            vec4 prev = imageLoad(uAccumImage, pixelCoord);
                                            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                        }
                                        if (pc.captureMlData != 0u) {
                                            f16vec3 diffUnshadowed = throughput * diffBrdf * f16vec3(directLightRadiance);
                                            f16vec3 specUnshadowed = throughput * specBrdf * f16vec3(directLightRadiance);
                                            if (bounce > 0u) {
                                                diffUnshadowed = clampIndirectRadiance(diffUnshadowed, pc.indirectClamp);
                                                specUnshadowed = clampIndirectRadiance(specUnshadowed, pc.indirectClamp);
                                            }
                                            if (isSpecularPath) {
                                                vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(unshadowed), seed), prevSpec.a));
                                                accumFfxSignal(pixelCoord, vec3(unshadowed), true, bounce == 0u, seed);
                                            } else {
                                                if (dot(vec3(diffUnshadowed), vec3(diffUnshadowed)) > 1e-10) {
                                                    vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                                                    imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, vec3(diffUnshadowed), seed), prevDiff.a));
                                                    accumFfxSignal(pixelCoord, vec3(diffUnshadowed), false, bounce == 0u, seed);
                                                }
                                                if (dot(vec3(specUnshadowed), vec3(specUnshadowed)) > 1e-10) {
                                                    vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                                                    imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, vec3(specUnshadowed), seed), prevSpec.a));
                                                    accumFfxSignal(pixelCoord, vec3(specUnshadowed), true, bounce == 0u, seed);
                                                }
                                            }
                                        }
                                    } else
#endif
                                    {
                                        hasShadowRay = true;
                                        shadowCandidate.originDist = vec4(shadowOrigin, selectedLightDist);
                                        shadowCandidate.dirPixelRad = uvec4(packOct32(selectedLightDir), pixelIndex, packHalf2x16(vec2(unshadowed.rg)), packHalf2x16(vec2(unshadowed.b, isSpecularPath ? 1.0 : 0.0)));
                                    }
                                } else {
                                    ivec2 pCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
                                    if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                                        vec4 prev = imageLoad(uAccumImage, pCoord);
                                        imageStore(uAccumImage, pCoord, vec4(addFp16Stochastic(prev.rgb, vec3(unshadowed), seed), prev.a));
                                    }
                                }
                            }
                        }
                    }
                }

            } else {
                if (bounce == 0u && ((ubo.flags & (1 << 9)) != 0)) {
                    currentReservoirs[pixelIndex] = invalidDiReservoir();
                }
            }

            // (No ambient skylight term: environment light is integrated by the
            //  path itself on sky misses; an extra ambient term double counts it.)

#endif

            // Indirect Bounce
            bool sampledSpecularLobe = false;
            nextDirection = vec3(0.0);
            vec3 nextOrigin;
            uint nextPdfCode = 0u; // 0 = delta lobe / no NEE here: emitter hits get full weight

            if (bounce + 1u >= pc.maxBounces || !enableIndirect) {
                pathTerminated = true;
            } else if (enableRefraction && (transmission > 0.001 || (mat.type & MATERIAL_TYPE_MASK) == 2u)) {
                sampledSpecularLobe = true;
                float eta = frontFace ? (1.0 / iorVal) : iorVal;
                float cosTheta = clamp(dot(V, hitNormal), 0.0, 1.0);
                float fresnel = fresnelDielectric(cosTheta, eta);

                if (randFloat(seed) < fresnel) {
                    // Specular reflection: achromatic Fresnel reflection
                    nextDirection = reflect(rayDir, hitNormal);
                    nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                } else {
                    vec3 refracted = refract(rayDir, hitNormal, eta);
                    if (length(refracted) > 1e-4) {
                        nextDirection = normalize(refracted);
                        nextOrigin = offsetRayOrigin(hitPoint, -hitNormal);
                        throughput *= baseColor;
                    } else {
                        // Total Internal Reflection fallback
                        nextDirection = reflect(rayDir, hitNormal);
                        nextOrigin = offsetRayOrigin(hitPoint, hitNormal);
                    }
                }
            } else {
                // Check if NRC should evaluate this rough diffuse surface
                if (pc.enableNrc == 1u && bounce >= pc.nrcBounce && roughness >= 0.20 && metallic < 0.9 && hitT > 0.05) {
                    vec3 surfReflectance = max(vec3(diffuseColor) + vec3(F0), vec3(0.05));
                    float nrcRoughness = max(roughness, 0.20);
                    bool isTrain = (randFloat(seed) < pc.nrcTrainRatio);
                    if (isTrain) {
                        uint trainIdx = atomicAdd(nrcCounters.trainCount, 1u);
                        if (trainIdx < pc.maxQueueCapacity) {
                            vec3 targetRad = vec3(secDirectL);
#if !IS_SECONDARY_BOUNCE && ENABLE_INLINE_SHADOWS
                            if (hasShadowRay && pc.useHardwareRT == 1u && length(targetRad) > 1e-4) {
                                vec3 sOrigin = shadowCandidate.originDist.xyz;
                                float sDist = shadowCandidate.originDist.w;
                                vec3 sDir = unpackOct32(shadowCandidate.dirPixelRad.x);
                                bool occluded = traceShadowRayInline(sOrigin, sDir, sDist,
                                                                     (ubo.flags & (1u << 5)) != 0u, pc.numSpheres, pc.numOpaqueTriangles);
                                if (occluded) {
                                    targetRad = vec3(0.0);
                                }
                            }
#endif
                            nrcTrainRecords[trainIdx].pos_roughness = vec4(hitPoint, nrcRoughness);
                            nrcTrainRecords[trainIdx].normal_flags = vec4(hitNormal, 1.0);
                            nrcTrainRecords[trainIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                            nrcTrainRecords[trainIdx].albedo_pad = vec4(vec3(baseColor), 0.0);
                            nrcTrainRecords[trainIdx].throughput = vec4(vec3(throughput) * surfReflectance, 0.0);
                            nrcTrainRecords[trainIdx].targetRadiance = vec4(targetRad / surfReflectance, 0.0);
                        }
                    } else {
                        uint qIdx = atomicAdd(nrcCounters.queryCount, 1u);
                        if (qIdx < pc.maxQueueCapacity) {
                            if ((qIdx & 15u) == 0u) {
                                atomicMax(nrcCounters.dispatchX, (qIdx >> 4u) + 1u);
                            }
                            nrcQueries[qIdx].pos_roughness = vec4(hitPoint, nrcRoughness);
                            nrcQueries[qIdx].normal_flags = vec4(hitNormal, 0.0);
                            nrcQueries[qIdx].dir_pixelIndex = vec4(V, uintBitsToFloat(pixelIndex));
                            nrcQueries[qIdx].albedo_pad = vec4(vec3(baseColor), 0.0);
                            nrcQueries[qIdx].throughput = vec4(vec3(throughput) * surfReflectance, 0.0);
                            pathTerminated = true;
                        } else {
                            // Queue capacity exceeded: do NOT drop ray silently (CRIT-04). Continue standard bounce.
                            pathTerminated = false;
                        }
                    }
                }

                if (!pathTerminated) {
                    // One-sample mixture over the shared BSDF (bsdf_standard.glsl):
                    // clearcoat (prob ccProb), else base spec (specProb), else cosine
                    // (transmitted with prob diffTrans). weight = f·|cos| / pdf_mixture.
#if !IS_SECONDARY_BOUNCE
                    bool useBounce0Sobol = (pc.captureMlData != 0u || pc.secondarySortMode < 2u);
                    uint sobolSampleIdx = pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex;
                    float lobeSelect = useBounce0Sobol
                        ? sampleSobolOwen1D(pixelIndex, pc.width, sobolSampleIdx, 0u)
                        : randFloat(seed);
#else
                    float lobeSelect = randFloat(seed);
#endif
                    bool pickSpec = false;
                    bool isClearcoatSample = false;
                    bool isTrans = false;
                    bool validSample = true;
                    if (lobeSelect < bsdf.ccProb) {
                        pickSpec = true;
                        isClearcoatSample = true;
                        // V below the coat normal: the coat lobe has no valid
                        // samples (its pdf term is 0 there) -> discard.
                        if (dot(bsdf.Nc, V) > 0.0) {
#if !IS_SECONDARY_BOUNCE
                            vec2 uCc = useBounce0Sobol
                                ? sampleSobolOwen2D(pixelIndex, pc.width, sobolSampleIdx, 1u)
                                : randVec2(seed);
                            vec3 H_cc = sampleGgxVndfHalfVectorVec2(bsdf.Nc, V, bsdf.ccAlpha, uCc);
#else
                            vec3 H_cc = sampleGgxVndfHalfVector(bsdf.Nc, V, bsdf.ccAlpha, seed);
#endif
                            nextDirection = reflect(-V, H_cc);
                        } else {
                            validSample = false;
                        }
                    } else {
                        float u = (lobeSelect - bsdf.ccProb) / max(1.0 - bsdf.ccProb, 1e-6);
                        if (u < bsdf.specProb) {
                            pickSpec = true;
#if !IS_SECONDARY_BOUNCE
                            vec2 uSpec = useBounce0Sobol
                                ? sampleSobolOwen2D(pixelIndex, pc.width, sobolSampleIdx, 1u)
                                : randVec2(seed);
                            vec3 H_spec = sampleGgxVndfHalfVectorVec2(hitNormal, V, bsdf.alpha, uSpec);
#else
                            vec3 H_spec = sampleGgxVndfHalfVector(hitNormal, V, bsdf.alpha, seed);
#endif
                            nextDirection = reflect(-V, H_spec);
                        } else {
                            uint clusterK = (pc.secondarySortMode == 3u) ? 8u : 4u;
                            uint frameRot = pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex;
                            isTrans = (bsdf.diffTrans > 0.0 && randFloat(seed) < bsdf.diffTrans);
                            vec3 lobeN = isTrans ? -hitNormal : hitNormal;
#if !IS_SECONDARY_BOUNCE
                            nextDirection = useBounce0Sobol
                                ? sampleCosineHemisphereVec2(lobeN, sampleSobolOwen2D(pixelIndex, pc.width, sobolSampleIdx, 2u))
                                : sampleCosineHemisphereCoherent(lobeN, seed, clusterK, frameRot);
#else
                            nextDirection = (pc.secondarySortMode >= 2u)
                                ? sampleCosineHemisphereCoherent(lobeN, seed, clusterK, frameRot)
                                : sampleCosineHemisphere(lobeN, seed);
#endif
                        }
                    }
                    // Reflection samples below the shading horizon are discarded
                    // (the mixture pdf there only contains the transmission lobe).
                    if (validSample && pickSpec && dot(hitNormal, nextDirection) <= 0.0) {
                        validSample = false;
                    }
                    if (validSample) {
                        float bsdfPdf = 0.0;
                        vec3 fCos = stdBsdfEval(bsdf, hitNormal, V, nextDirection, bsdfPdf);
                        if (bsdfPdf > 0.0 && dot(fCos, vec3(1.0)) > 0.0) {
                            throughput *= f16vec3(min(fCos / bsdfPdf, vec3(65000.0)));
                            nextPdfCode = encodeBsdfPdf(bsdfPdf);
                            nextOrigin = offsetRayOrigin(hitPoint, isTrans ? -hitNormal : hitNormal);
                            sampledSpecularLobe = pickSpec;
                        } else {
                            validSample = false;
                        }
                    }
                    if (!validSample) {
                        pathTerminated = true;
                    }
                    // ReSTIR GI context: diffuse cosine REFLECTION lobe only.
                    // Specular mirrors (roughness < 0.10) are strictly partitioned out.
                    giCtxEligible = validSample && !pickSpec && !isTrans && (roughness >= 0.10);
                }
            }

            // Adaptive Russian roulette (only for paths that actually continue)
            if (!pathTerminated) {
                float maxThresh = float(max(throughput.r, max(throughput.g, throughput.b))) * float(max(ubo.spp, 1u));
                pathTerminated = applyRussianRoulette16(throughput, maxThresh, bounce, seed);
            }

            if (!pathTerminated) {
                survivesToNext = true;
                nextGeom.originPackedDir = vec4(nextOrigin, uintBitsToFloat(packOct32(nextDirection)));
                nextState = packRayState(throughput, seed, pixelIndex, isSpecularPath || sampledSpecularLobe, causticApplied, dispersionChannel, nextPdfCode);
                if (bounce == 0u && (ubo.flags & (1u << 9)) != 0u) {
                    if (giCtxEligible) {
                        x1Contexts[pixelIndex] = makeX1Context(hitNormal, vec3(diffuseColor), V, dot(vec3(F0), vec3(0.3333333)), roughness);
                    } else {
                        x1Contexts[pixelIndex] = invalidX1Context();
                    }
                }
            } else {
                if (bounce == 0u && (ubo.flags & (1u << 9)) != 0u) {
                    x1Contexts[pixelIndex] = invalidX1Context();
                }
            }
        }
    }

    // Standard single-queue linear compaction for ray geometry and state
    uvec4 ballot = subgroupBallot(survivesToNext);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (waveActiveCount > 0u) {
        if (subgroupElect()) {
            waveGlobalOffset = atomicAdd(queueCounters.nextActiveCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);
    }

    uint targetIdx = waveGlobalOffset + laneSlot;
    if (survivesToNext) {
        if (targetIdx < pc.maxQueueCapacity) {
            outGeoms[targetIdx] = nextGeom;
            outStates[targetIdx] = nextState;
        }
    }

    if (pc.secondarySortMode == 1u) {
        // Producer-Side Binning: Record compacted ray indices into 8 directional octant queues
        uint oct = survivesToNext ? getDirectionalOctant(nextDirection) : 0u;
        uvec4 activeBallot = subgroupBallot(survivesToNext);
        while (subgroupBallotBitCount(activeBallot) > 0u) {
            uint leaderLane = subgroupBallotFindLSB(activeBallot);
            uint k = subgroupBroadcast(oct, leaderLane);
            bool isOct = survivesToNext && (oct == k);
            uvec4 octBallot = subgroupBallot(isOct);
            uint octCount = subgroupBallotBitCount(octBallot);
            uint octSlot = subgroupBallotExclusiveBitCount(octBallot);
            uint octBase = 0u;
            if (gl_SubgroupInvocationID == leaderLane) {
                octBase = atomicAdd(queueCounters.octantCounts[k], octCount);
            }
            octBase = subgroupBroadcast(octBase, leaderLane);
            if (isOct) {
                uint dest = k * pc.maxQueueCapacity + (octBase + octSlot);
                if (octBase + octSlot < pc.maxQueueCapacity) {
                    secondaryIndices[dest] = targetIdx;
                }
            }
            activeBallot.x &= ~octBallot.x;
            activeBallot.y &= ~octBallot.y;
            activeBallot.z &= ~octBallot.z;
            activeBallot.w &= ~octBallot.w;
        }
    }

    // Subgroup Wave Ballot Compaction for Shadow Rays
    uvec4 shadowBallot = subgroupBallot(hasShadowRay);
    uint shadowLaneSlot = subgroupBallotExclusiveBitCount(shadowBallot);
    uint shadowWaveCount = subgroupBallotBitCount(shadowBallot);

    uint shadowGlobalOffset = 0u;
    if (shadowWaveCount > 0u) {
        if (subgroupElect()) {
            shadowGlobalOffset = atomicAdd(queueCounters.shadowRayCount, shadowWaveCount);
        }
        shadowGlobalOffset = subgroupBroadcastFirst(shadowGlobalOffset);
    }

    if (hasShadowRay) {
        uint targetIdxShadow = shadowGlobalOffset + shadowLaneSlot;
        if (targetIdxShadow < pc.maxQueueCapacity) {
            shadowRays[targetIdxShadow] = shadowCandidate;
        }
    }

    // Atomic workgroup retirement to prepare downstream dispatches directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == queueCounters.totalShadeWorkgroups - 1u) {
            uint shadowCount = queueCounters.shadowRayCount;
            uint shadowGroups = (shadowCount + 31u) / 32u;
            uint b = pc.currentBounce;

            indirect.commands[b * 16u + 6u].x = shadowGroups;
            indirect.commands[b * 16u + 6u].y = 1u;
            indirect.commands[b * 16u + 6u].z = 1u;
            indirect.commands[b * 16u + 6u].pad = shadowCount;

            dgcStream.commands[b * 16u + 6u].pipelineIndex = 3u; // Shadow pipeline
            dgcStream.commands[b * 16u + 6u].x = shadowGroups;
            dgcStream.commands[b * 16u + 6u].y = 1u;
            dgcStream.commands[b * 16u + 6u].z = 1u;

            uint nextCount = queueCounters.nextActiveCount;
            bool skipNextBounce = (b > 0u && pc.minRayThreshold > 0u && nextCount <= pc.minRayThreshold);
            uint intersectGroups = skipNextBounce ? 0u : ((nextCount + 31u) / 32u);

            // Slot 7: Standard monolithic / Option 2 intersect dispatch
            indirect.commands[b * 16u + 7u].x = intersectGroups;
            indirect.commands[b * 16u + 7u].y = 1u;
            indirect.commands[b * 16u + 7u].z = 1u;
            indirect.commands[b * 16u + 7u].pad = nextCount;

            dgcStream.commands[b * 16u + 7u].pipelineIndex = 1u; // Intersect pipeline
            dgcStream.commands[b * 16u + 7u].x = intersectGroups;
            dgcStream.commands[b * 16u + 7u].y = 1u;
            dgcStream.commands[b * 16u + 7u].z = 1u;

            // Slots 8..15: Producer-Side Binning Directional DGC intersect dispatches
            uint totalIntersectWgs = 0u;
            uint totalOctantRays = 0u;
            if (pc.secondarySortMode == 1u) {
                for (uint k = 0u; k < 8u; ++k) {
                    uint octCnt = queueCounters.octantCounts[k];
                    queueCounters.currentOctantCounts[k] = octCnt;
                    uint octGroups = skipNextBounce ? 0u : ((octCnt + 31u) / 32u);
                    totalIntersectWgs += octGroups;
                    totalOctantRays += octCnt;

                    indirect.commands[b * 16u + 8u + k].x = octGroups;
                    indirect.commands[b * 16u + 8u + k].y = 1u;
                    indirect.commands[b * 16u + 8u + k].z = 1u;
                    indirect.commands[b * 16u + 8u + k].pad = octCnt;

                    dgcStream.commands[b * 16u + 8u + k].pipelineIndex = 1u;
                    dgcStream.commands[b * 16u + 8u + k].x = octGroups;
                    dgcStream.commands[b * 16u + 8u + k].y = 1u;
                    dgcStream.commands[b * 16u + 8u + k].z = 1u;

                    queueCounters.octantCounts[k] = 0u;
                }
            } else {
                totalIntersectWgs = intersectGroups;
                totalOctantRays = nextCount;
            }
            queueCounters.totalIntersectWorkgroups = totalIntersectWgs;
            queueCounters.secondaryRayCount = totalOctantRays;

            if (pc.secondarySortMode == 2u) {
                indirect.commands[b * 16u + 8u].x = intersectGroups;
                indirect.commands[b * 16u + 8u].y = 1u;
                indirect.commands[b * 16u + 8u].z = 1u;
                indirect.commands[b * 16u + 8u].pad = nextCount;
            }

            if (skipNextBounce && b + 1u < pc.maxBounces) {
                uint nextB = b + 1u;
                for (uint c = 0u; c < 8u; ++c) {
                    indirect.commands[nextB * 16u + c].x = 0u;
                }
                for (uint k = 0u; k < 8u; ++k) {
                    indirect.commands[nextB * 16u + 8u + k].x = 0u;
                }
                for (uint c = 0u; c < 4u; ++c) {
                    dgcStream.commands[nextB * 16u + c].x = 0u;
                }
                queueCounters.activeMaterialSequenceCount = 0u;
                queueCounters.totalShadeWorkgroups = 0u;
            }

            queueCounters.currentShadowCount = shadowCount;
            queueCounters.activeRayCount = (b + 1u < pc.maxBounces && !skipNextBounce) ? totalOctantRays : 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
