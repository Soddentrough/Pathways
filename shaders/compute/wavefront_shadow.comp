#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_expect_assume : enable

#ifndef SIMPLE_OPAQUE_SHADOW
#define SIMPLE_OPAQUE_SHADOW 1
#endif

#include "wavefront_common.glsl"
#include "wavefront_radiance_output.glsl"
#include "restir_common.glsl"

layout(local_size_x = 32) in;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 26, rgba16f) uniform readonly image2D uMlAlbedoRoughnessImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 41, rgba16f) uniform readonly image2D uMlSpecAlbedoImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

#if !SIMPLE_OPAQUE_SHADOW
layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};
#endif

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
#if !SIMPLE_OPAQUE_SHADOW
DECLARE_SCENE_TEXTURES_BINDING(8)
#endif

layout(std430, binding = 12) readonly buffer ShadowRayQueue {
    PackedShadowRay shadowRays[];
};

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 32) buffer ReSTIRCurrentReservoirsBuffer {
    DiReservoir currentReservoirs[];
};

layout(std430, binding = 38) buffer GiCurrentReservoirsBuffer {
    uvec2 giCurrentData[];
};

layout(std430, binding = 53) readonly buffer CoherenceSortMetaRO {
    uvec4 indirectCmd;
    uint activeCount;
    uint activeFlag;
} cohMeta;

layout(std430, binding = 55) readonly buffer CoherenceSortedIndicesRO {
    uint indices[];
} cohSortedIndices;

layout(push_constant) uniform PushConstants {
    WavefrontShadowPC pc;
};

void main() {
    uint tid = gl_GlobalInvocationID.x;
    if (expectEXT(tid >= queueCounters.currentShadowCount, false)) return;

    uint idx = (pc.useCoherenceSort != 0u && cohMeta.activeFlag != 0u) ? cohSortedIndices.indices[tid] : tid;
    PackedShadowRay sRay = shadowRays[idx];
    vec3 origin = sRay.originDist.xyz;
    float maxDist = sRay.originDist.w;
    vec3 dir = unpackOct32(sRay.dirPixelRad.x);
    uint pixelIndex = sRay.dirPixelRad.y;
    vec2 radRG = unpackHalf2x16(sRay.dirPixelRad.z);
    vec2 radB_pad = unpackHalf2x16(sRay.dirPixelRad.w);
    vec3 radiance = vec3(radRG, radB_pad.x);
    float isSpecular = radB_pad.y;

    bool isDiVisTest = (pixelIndex & 0x40000000u) != 0u;
    if (!isDiVisTest && length(radiance) <= 1e-5) return;

    bool hasNonOpaque = (ubo.flags & (1u << 5)) != 0u;
    bool enableCaustics = (ubo.flags & (1u << 8)) != 0u && (pc.numLights > 0u);
    bool hasAlphaShadow = (ubo.flags & (1u << 27)) != 0u;
    bool occluded = false;

    bool isSpecularPath = (isSpecular >= 1.5);
    float specFrac = isSpecularPath ? 1.0 : clamp(isSpecular, 0.0, 1.0);
    // UBO bit 26 (--transparent-shadows, biased fast mode): dielectrics and emissives
    // do not occlude NEE. Default (unbiased): every surface occludes except alpha
    // cutouts, consistent with BSDF-sampled paths, which refract through/terminate on them.
    bool transparentShadows = (ubo.flags & (1u << 26)) != 0u;

    // Fast path: no alpha cutout/blend shadows. In the default mode all geometry occludes, so
    // the whole TLAS is traversed with gl_RayFlagsOpaqueEXT (no candidate loop). In the
    // transparent-shadow mode, dielectric instances are culled via RAY_MASK_OPAQUE (0x01)
    // when caustics are off or the ray is on a specular transmission path.
    // Fast path: opaque-only shadow traversal (zero candidate loop, zero triangle/texture VGPRs)
#if SIMPLE_OPAQUE_SHADOW
    {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                              (transparentShadows && hasNonOpaque) ? RAY_MASK_OPAQUE : RAY_MASK_ALL,
                              origin, EPSILON, dir, maxDist - EPSILON * 2.0);
        rayQueryProceedEXT(rq);
        occluded = (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    }
#else
    if (!hasAlphaShadow && (!transparentShadows || !enableCaustics || isSpecularPath)) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                              (transparentShadows && hasNonOpaque) ? RAY_MASK_OPAQUE : RAY_MASK_ALL,
                              origin, EPSILON, dir, maxDist - EPSILON * 2.0);
        rayQueryProceedEXT(rq);
        occluded = (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    } else {
        rayQueryEXT rq;
        uint rqFlags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT
                     | (transparentShadows ? gl_RayFlagsNoOpaqueEXT : 0u);
        rayQueryInitializeEXT(rq, topLevelAS, rqFlags,
                              RAY_MASK_ALL, origin, EPSILON, dir, maxDist - EPSILON * 2.0);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint instIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false);
                uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, false);
                uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
                InstanceGPU inst = instances[instIdx];
                uint triIdx = inst.firstTriangle + ((geomIdx == 0u) ? primIdx : (primIdx + inst.numOpaqueTriangles));
                uint matId = triangles[triIdx].materialId + inst.materialOffset;
                uint arch = materialArchetypes[matId];
                ShadeMaterial sm = shadeMaterials[matId];
                if (transparentShadows) {
                    if (arch == 3u || (!enableCaustics && arch == 2u) || (isSpecularPath && arch == 2u)) {
                        continue;
                    }
                    if (enableCaustics && arch == 2u) {
                        if (smIsThin(sm)) {
                            continue;
                        }
                    }
                }

                uint alphaMode = smGetAlphaMode(sm);
                if (alphaMode != 0u /* ALPHA_MODE_OPAQUE */) {
                    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                    float cw = 1.0 - bary.x - bary.y;
                    vec2 cuv = cw * vec2(triangles[triIdx].uv0x, triangles[triIdx].uv0y)
                             + bary.x * vec2(triangles[triIdx].uv1x, triangles[triIdx].uv1y)
                             + bary.y * vec2(triangles[triIdx].uv2x, triangles[triIdx].uv2y);
                    float calpha = sm.albedo.a;
                    uint albTex = smGetAlbedoTex(sm);
                    if (albTex > 0u && albTex <= 512u) {
                        calpha *= SAMPLE_SCENE_TEXTURE(albTex, cuv).a;
                    }
                    float cutoff = (alphaMode == 1u) ? smGetAlphaCutoff(sm) : 0.5;
                    if (calpha < cutoff) {
                        continue;
                    }
                }
                rayQueryConfirmIntersectionEXT(rq);
                rayQueryTerminateEXT(rq);
            }
        }
        occluded = (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT);
    }
#endif

    if (!occluded) {
        if (isDiVisTest) {
            atomicOr(currentReservoirs[pixelIndex & 0x3FFFFFFFu].flags, DI_FLAG_FRESH_VISIBLE);
            return;
        }
        if ((pixelIndex & 0x80000000u) != 0u) {
            uint giPix = pixelIndex & 0x7FFFFFFFu;
            vec3 prevL2 = restirUnpackRgb9e5(giCurrentData[giPix].x);
            giCurrentData[giPix].x = restirPackRgb9e5(prevL2 + radiance);
            return;
        }
        ivec2 pixelCoord = ivec2(int(pixelIndex % pc.width), int(pixelIndex / pc.width));
        uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + (pc.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex) * 26699) | 1u;
        float invSpp = (ubo.spp > 0u) ? (1.0 / float(ubo.spp)) : 1.0;
        vec3 scaledRadiance = radiance * invSpp;
        if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, vec4(addFp16Stochastic(prev.rgb, scaledRadiance, seed), prev.a));
        }

        if (pc.captureMlData != 0u) {
            vec3 diffRadRaw = radiance * (1.0 - specFrac);
            vec3 specRadRaw = radiance * specFrac;
            vec3 diffRad = diffRadRaw * invSpp;
            vec3 specRad = specRadRaw * invSpp;
            if ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) != 0u) {
                if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                    wfAddCompactMlIrradiance(pixelCoord, diffRad, specRad);
                }
            } else {
                if (pc.currentBounce == 0u) {
                    wfAddSplitDirect(pixelCoord, diffRad, specRad, pc.captureMlData, seed);
                } else {
                    wfAddSplitIndirect(pixelCoord, diffRad, specRad, pc.captureMlData, seed);
                }
                bool isV4 = (pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u;
                if ((pc.captureMlData & ML_CAPTURE_ENABLED_BIT) != 0u) {
                    if (dot(diffRad, diffRad) > 1e-12) {
                        vec3 outDiff = isV4
                            ? demodulateMlSafe(diffRad, imageLoad(uMlAlbedoRoughnessImage, pixelCoord).rgb)
                            : diffRad;
                        vec4 prevDiff = imageLoad(uMlDiffuseImage, pixelCoord);
                        imageStore(uMlDiffuseImage, pixelCoord, vec4(addFp16Stochastic(prevDiff.rgb, outDiff, seed), prevDiff.a));
                    }
                    if (dot(specRad, specRad) > 1e-12) {
                        vec3 outSpec = isV4
                            ? demodulateMlSafe(specRad, imageLoad(uMlSpecAlbedoImage, pixelCoord).rgb)
                            : specRad;
                        vec4 prevSpec = imageLoad(uMlSpecularImage, pixelCoord);
                        imageStore(uMlSpecularImage, pixelCoord, vec4(addFp16Stochastic(prevSpec.rgb, outSpec, seed), prevSpec.a));
                    }
                }
            }
        }
    }
}
