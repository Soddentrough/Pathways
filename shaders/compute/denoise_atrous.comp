#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "denoise_common.glsl"

layout(binding = 0, rgba16f) readonly uniform image2D uInDiffuse;
layout(binding = 1, rgba16f) readonly uniform image2D uInSpecular;
layout(binding = 2, rgba16f) readonly uniform image2D uNormalDepth;

layout(binding = 3, rgba16f) writeonly uniform image2D uOutDiffuse;
layout(binding = 4, rgba16f) writeonly uniform image2D uOutSpecular;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    int stepSize;
    float phiNormal;
    float phiDepth;
    float phiLuminance;
    uint iteration;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;

    vec4 centerDiff = imageLoad(uInDiffuse, coord);
    vec4 centerSpec = imageLoad(uInSpecular, coord);
    vec4 centerND = imageLoad(uNormalDepth, coord);
    vec3 centerN = centerND.xyz;
    float centerZ = centerND.w;

    float lumCenterDiff = denoiseLuminance(centerDiff.rgb);
    float lumCenterSpec = denoiseLuminance(centerSpec.rgb);
    float varCenterDiff = centerDiff.a;
    float varCenterSpec = centerSpec.a;

    vec3 sumDiff = vec3(0.0);
    vec3 sumSpec = vec3(0.0);
    float sumVarDiff = 0.0;
    float sumVarSpec = 0.0;
    float sumWDiff = 0.0;
    float sumWSpec = 0.0;

    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            ivec2 tapCoord = coord + ivec2(x, y) * pc.stepSize;
            if (tapCoord.x < 0 || tapCoord.y < 0 || tapCoord.x >= int(pc.width) || tapCoord.y >= int(pc.height)) continue;

            float kernelW = ATROUS_KERNEL_1D[x + 2] * ATROUS_KERNEL_1D[y + 2];

            vec4 tapND = imageLoad(uNormalDepth, tapCoord);
            float wN = denoiseNormalWeight(centerN, tapND.xyz, pc.phiNormal);
            float wZ = denoiseDepthWeight(centerZ, tapND.w, pc.phiDepth);

            vec4 tapDiff = imageLoad(uInDiffuse, tapCoord);
            vec4 tapSpec = imageLoad(uInSpecular, tapCoord);

            float lumTapDiff = denoiseLuminance(tapDiff.rgb);
            float lumTapSpec = denoiseLuminance(tapSpec.rgb);

            float wLDiff = denoiseLuminanceWeight(lumCenterDiff, lumTapDiff, varCenterDiff, pc.phiLuminance);
            float wLSpec = denoiseLuminanceWeight(lumCenterSpec, lumTapSpec, varCenterSpec, pc.phiLuminance);

            float totalWDiff = kernelW * wN * wZ * wLDiff;
            float totalWSpec = kernelW * wN * wZ * wLSpec;

            sumDiff += tapDiff.rgb * totalWDiff;
            sumVarDiff += tapDiff.a * (totalWDiff * totalWDiff);
            sumWDiff += totalWDiff;

            sumSpec += tapSpec.rgb * totalWSpec;
            sumVarSpec += tapSpec.a * (totalWSpec * totalWSpec);
            sumWSpec += totalWSpec;
        }
    }

    vec3 outDiff = (sumWDiff > 1e-4) ? (sumDiff / sumWDiff) : centerDiff.rgb;
    float outVarDiff = (sumWDiff > 1e-4) ? (sumVarDiff / (sumWDiff * sumWDiff)) : varCenterDiff;

    vec3 outSpec = (sumWSpec > 1e-4) ? (sumSpec / sumWSpec) : centerSpec.rgb;
    float outVarSpec = (sumWSpec > 1e-4) ? (sumVarSpec / (sumWSpec * sumWSpec)) : varCenterSpec;

    imageStore(uOutDiffuse, coord, vec4(outDiff, outVarDiff));
    imageStore(uOutSpecular, coord, vec4(outSpec, outVarSpec));
}
