#version 460
#extension GL_EXT_shader_image_load_formatted : require

// =============================================================================
// FidelityFX SDK Input Preparation Pass
// Converts Pathways render-resolution radiance, linear depth, and motion vectors
// into sanitized RGBA16F color, R32F inverted device depth [nearZ / zView], and
// RG16F motion vectors consumed by AMD FidelityFX SDK Upscaler (FSR 3.1+ / 4.x).
// =============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uRenderColor;
layout(binding = 1) readonly uniform image2D uMotionVectors;
layout(binding = 2) readonly uniform image2D uNormalDepth;
layout(binding = 3) writeonly uniform image2D uSdkColorOut;
layout(binding = 4) writeonly uniform image2D uSdkDepthOut;
layout(binding = 5) writeonly uniform image2D uSdkMotionOut;

layout(push_constant) uniform PushConstants {
    uint renderWidth;
    uint renderHeight;
    float sampleScale;
    float nearZ;
} pc;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.renderWidth) || pixelCoord.y >= int(pc.renderHeight)) {
        return;
    }

    vec3 sRgb = imageLoad(uRenderColor, pixelCoord).rgb * pc.sampleScale;
    sRgb = max(sRgb, vec3(0.0));
    if (any(isnan(sRgb)) || any(isinf(sRgb))) {
        sRgb = vec3(0.0);
    }

    float zView = imageLoad(uNormalDepth, pixelCoord).w;
    float safeNear = max(pc.nearZ, 1e-4);
    float devDepth = (zView > 1e-3 && zView < 5000.0 && !isnan(zView) && !isinf(zView))
        ? clamp(safeNear / max(zView, safeNear), 0.0, 1.0)
        : 0.0;

    vec2 mv = imageLoad(uMotionVectors, pixelCoord).xy;
    if (any(isnan(mv)) || any(isinf(mv))) {
        mv = vec2(0.0);
    }

    imageStore(uSdkColorOut, pixelCoord, vec4(sRgb, 1.0));
    imageStore(uSdkDepthOut, pixelCoord, vec4(devDepth, 0.0, 0.0, 0.0));
    imageStore(uSdkMotionOut, pixelCoord, vec4(mv.x, mv.y, 0.0, 0.0));
}
