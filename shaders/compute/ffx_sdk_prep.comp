#version 460
#extension GL_EXT_shader_image_load_formatted : require

// =============================================================================
// FidelityFX SDK Input Preparation Pass
// Converts Pathways render-resolution radiance, linear depth, and motion vectors
// into sanitized RGBA16F color, R32F inverted device depth [nearZ / zView], and
// RG16F motion vectors consumed by AMD FidelityFX SDK Upscaler (FSR 3.1+ / 4.x).
//
// During camera motion with DenoiserMode::None, maintains a self-contained
// linear HDR motion-reprojected pre-integrator (jitter-cancelled, normal+depth
// gated, up to MAX_PRE_SAMPLES = 16) so sparse 1-SPP MC frames do not collapse
// under FSR's internal Karis luminance compression & neighborhood clamping.
// Stationary progressive accumulation passes through bit-identically once
// totalSamples catches up to the pre-integrated sample count.
// =============================================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uRenderColor;
layout(binding = 1) readonly uniform image2D uMotionVectors;
layout(binding = 2) readonly uniform image2D uNormalDepth;
layout(binding = 3) writeonly uniform image2D uSdkColorOut;
layout(binding = 4) writeonly uniform image2D uSdkDepthOut;
layout(binding = 5) writeonly uniform image2D uSdkMotionOut;
layout(binding = 6) readonly uniform image2D uRawColor;
layout(binding = 7, rgba16f) readonly uniform image2D uPrevLinearColor;
layout(binding = 8, rgba16f) readonly uniform image2D uPrevLinearGuide;
layout(binding = 9, rgba16f) writeonly uniform image2D uCurrLinearColor;
layout(binding = 10, rgba16f) writeonly uniform image2D uCurrLinearGuide;

layout(push_constant) uniform PushConstants {
    uint renderWidth;
    uint renderHeight;
    float sampleScale;
    float rawSampleScale;
    float nearZ;
    float jitterDeltaX;
    float jitterDeltaY;
    uint totalSamples;
    uint flags; // bit 0: resetHistory, bit 1: cameraMoved, bit 2: inputIsDenoised, bit 3: hasSeparateRaw
} pc;

vec3 sanitizeHdr(vec3 c) {
    if (any(isnan(c)) || any(isinf(c))) {
        return vec3(0.0);
    }
    return clamp(c, vec3(0.0), vec3(65000.0));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.renderWidth) || pixelCoord.y >= int(pc.renderHeight)) {
        return;
    }

    vec4 nd = imageLoad(uNormalDepth, pixelCoord);
    float nLen = length(nd.xyz);
    vec3 currN = (nLen > 1e-4) ? (nd.xyz / nLen) : vec3(0.0, 0.0, 1.0);
    float zView = nd.w;
    bool currIsSky = !(zView > 1e-3 && zView < 5000.0) || isnan(zView) || isinf(zView);

    float safeNear = max(pc.nearZ, 1e-4);
    float devDepth = !currIsSky ? clamp(safeNear / max(zView, safeNear), 0.0, 1.0) : 0.0;

    vec4 mvFull = imageLoad(uMotionVectors, pixelCoord);
    vec2 mv = (any(isnan(mvFull.xy)) || any(isinf(mvFull.xy))) ? vec2(0.0) : mvFull.xy;

    bool resetHistory = (pc.flags & 1u) != 0u;
    bool cameraMoved = (pc.flags & 2u) != 0u;
    bool inputIsDenoised = (pc.flags & 4u) != 0u;
    bool hasSeparateRaw = (pc.flags & 8u) != 0u;

    // During camera motion with DenoiserMode::None, feed the single-frame jittered radiance
    // matching dispatchUpscale.jitterOffset, then accumulate a surface-matched linear history
    // across recent moving frames before linear 3x3 stabilization. Stationary accumulation
    // always reads the converged progressive uRenderColor directly (even when upscaling).
    bool useRaw = !inputIsDenoised && hasSeparateRaw && (cameraMoved || pc.totalSamples <= 1u);
    vec3 currLinear = useRaw
        ? sanitizeHdr(imageLoad(uRawColor, pixelCoord).rgb * pc.rawSampleScale)
        : sanitizeHdr(imageLoad(uRenderColor, pixelCoord).rgb * pc.sampleScale);

    vec3 temporalLinear = currLinear;
    float newCount = 1.0;
    if (!inputIsDenoised && cameraMoved && !resetHistory && !currIsSky) {
        float mvZ = (isnan(mvFull.z) || isinf(mvFull.z)) ? 0.0 : mvFull.z;
        float expectedPrevZ = max(zView + mvZ, 1e-3);
        vec2 prevUv = (vec2(pixelCoord) + 0.5) / vec2(float(pc.renderWidth), float(pc.renderHeight)) - mv;
        if (prevUv.x >= 0.0 && prevUv.x <= 1.0 && prevUv.y >= 0.0 && prevUv.y <= 1.0) {
            vec2 prevSub = (vec2(pixelCoord) + 0.5) - mv * vec2(float(pc.renderWidth), float(pc.renderHeight)) - 0.5;
            ivec2 p00 = ivec2(floor(prevSub));
            vec2 f = prevSub - vec2(p00);
            ivec2 maxPx = ivec2(int(pc.renderWidth) - 1, int(pc.renderHeight) - 1);
            float relZTol = 0.06 + 0.12 * (1.0 - abs(currN.z));

            vec3 prevColAcc = vec3(0.0);
            float prevCountAcc = 0.0;
            float bwSum = 0.0;
            for (int dy = 0; dy <= 1; ++dy) {
                for (int dx = 0; dx <= 1; ++dx) {
                    ivec2 tc = clamp(p00 + ivec2(dx, dy), ivec2(0), maxPx);
                    float wx = (dx == 0) ? (1.0 - f.x) : f.x;
                    float wy = (dy == 0) ? (1.0 - f.y) : f.y;
                    float bw = wx * wy;
                    if (bw <= 1e-4) continue;
                    vec4 prevGuide = imageLoad(uPrevLinearGuide, tc);
                    float prevZ = prevGuide.w;
                    if (prevZ > 1e-3 && prevZ < 5000.0 && !isnan(prevZ) && !isinf(prevZ)) {
                        float relZ = abs(expectedPrevZ - prevZ) / expectedPrevZ;
                        if (dot(currN, prevGuide.xyz) >= 0.85 && relZ <= relZTol) {
                            vec4 prevColCount = imageLoad(uPrevLinearColor, tc);
                            float tcCount = clamp(prevColCount.a, 0.0, 12.0);
                            if (tcCount >= 0.5 && !isnan(tcCount) && !isinf(tcCount)) {
                                prevColAcc += sanitizeHdr(prevColCount.rgb) * bw;
                                prevCountAcc += tcCount * bw;
                                bwSum += bw;
                            }
                        }
                    }
                }
            }
            if (bwSum > 1e-4) {
                float avgPrevCount = clamp(prevCountAcc / bwSum, 0.0, 12.0);
                if (avgPrevCount >= 0.5) {
                    newCount = min(avgPrevCount + 1.0, 12.0);
                    temporalLinear = mix(prevColAcc / bwSum, currLinear, 1.0 / newCount);
                }
            }
        }
    }

    temporalLinear = clamp(temporalLinear, vec3(0.0), vec3(65000.0));
    imageStore(uCurrLinearColor, pixelCoord, vec4(temporalLinear, newCount));
    imageStore(uCurrLinearGuide, pixelCoord, vec4(currN, currIsSky ? 10000.0 : zView));

    // Single-pass coplanar 3x3 linear variance stabilizer on raw/early frames without any
    // non-linear luminance clipping, preserving mean linear radiance for FSR's Karis/Reinhard weighting.
    vec3 outLinear = temporalLinear;
    if (!inputIsDenoised && !currIsSky && (cameraMoved || pc.totalSamples <= 4u)) {
        vec3 nbSum = vec3(0.0);
        float wSum = 0.0;
        float spatialRelZTol = 0.04 + 0.08 * (1.0 - abs(currN.z));
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0) continue;
                ivec2 spPx = pixelCoord + ivec2(dx, dy);
                if (spPx.x < 0 || spPx.y < 0 ||
                    spPx.x >= int(pc.renderWidth) || spPx.y >= int(pc.renderHeight)) {
                    continue;
                }
                vec4 tapNd = imageLoad(uNormalDepth, spPx);
                float tapZ = tapNd.w;
                if (!(tapZ > 1e-3 && tapZ < 5000.0) || isnan(tapZ) || isinf(tapZ)) {
                    continue;
                }
                float tapNLen = length(tapNd.xyz);
                vec3 tapN = (tapNLen > 1e-4) ? (tapNd.xyz / tapNLen) : vec3(0.0, 0.0, 1.0);
                float relZ = abs(zView - tapZ) / max(zView, 1e-3);
                if (dot(currN, tapN) < 0.90 || relZ > spatialRelZTol) {
                    continue;
                }
                vec3 tapCol = useRaw
                    ? sanitizeHdr(imageLoad(uRawColor, spPx).rgb * pc.rawSampleScale)
                    : sanitizeHdr(imageLoad(uRenderColor, spPx).rgb * pc.sampleScale);
                float tapLum = dot(tapCol, vec3(0.2126, 0.7152, 0.0722));
                vec3 tapSafe = (tapLum > 60.0) ? (tapCol * (60.0 / tapLum)) : tapCol;
                nbSum += tapSafe;
                wSum += 1.0;
            }
        }
        if (wSum >= 2.0) {
            float blendAlpha = cameraMoved
                ? clamp(0.45 * (1.0 - (newCount - 1.0) / 8.0), 0.12, 0.45)
                : ((pc.totalSamples <= 1u) ? 0.35 : 0.15);
            outLinear = mix(temporalLinear, nbSum / wSum, blendAlpha);
        }
    }

    outLinear = clamp(outLinear, vec3(0.0), vec3(65000.0));

    imageStore(uSdkColorOut, pixelCoord, vec4(outLinear, 1.0));
    imageStore(uSdkDepthOut, pixelCoord, vec4(devDepth, 0.0, 0.0, 0.0));
    imageStore(uSdkMotionOut, pixelCoord, vec4(mv.x, mv.y, 0.0, 0.0));
}
