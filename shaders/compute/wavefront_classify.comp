#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require
#extension GL_EXT_nonuniform_qualifier : enable

#define WF_IN_QUEUE_IDX  0u
#define WF_OUT_QUEUE_IDX 0u
#include "wavefront_common.glsl"
#include "wavefront_radiance_output.glsl"
#include "restir_common.glsl"

layout(std430, binding = 32) writeonly buffer ReSTIRCurrentReservoirsBuffer {
    DiReservoir currentReservoirs[];
};
layout(std430, binding = 37) writeonly buffer X1ContextsBuffer {
    X1Context x1Contexts[];
};
layout(std430, binding = 38) writeonly buffer GiCurrentReservoirsBuffer {
    uvec2 giCurrentData[];
};

layout(local_size_x = 8, local_size_y = 4) in;

layout(binding = 0) uniform image2D uAccumImage;
DECLARE_SCENE_TEXTURES_BINDING(8)
layout(binding = 23, rgba16f) uniform image2D uMotionVectorImage;
layout(binding = 24, rgba16f) uniform image2D uNormalDepthImage;
layout(binding = 26, rgba16f) uniform image2D uMlAlbedoRoughnessImage;
layout(binding = 27, rgba16f) uniform image2D uMlSpecularMotionImage;
layout(binding = 28, rgba16f) uniform image2D uMlDiffuseImage;
layout(binding = 29, rgba16f) uniform image2D uMlSpecularImage;
layout(binding = 40, rgba16f) uniform image2D uMlSkipImage;
layout(binding = 41, rgba16f) uniform image2D uMlSpecAlbedoImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
layout(binding = 7) uniform sampler2D environmentMap;

#include "shading_core.glsl"

WAVEFRONT_QUEUE_COUNTERS_BINDING(11);

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 17) writeonly buffer OutRayHitQueue {
    RayHit outHits[];
};

layout(std430, binding = 18) writeonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(push_constant) uniform PushConstants {
    WavefrontClassifyPC pc;
};

void main() {
    uint fw = (pc.fullWidth > 0u) ? pc.fullWidth : pc.width;
    uint fh = (pc.fullHeight > 0u) ? pc.fullHeight : pc.height;
    ivec2 globalID = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pixelCoord;
    ivec2 storeCoord;
    uint storeWidth;
    bool inBounds = false;

    if (pc.tileOffsetX == 1u) {
        if (pc.width < fw) {
            // Multi-GPU Checkerboard Tiling: Half-screen packed even tiles (Primary GPU traces strictly 50% rays)
            uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
            ivec2 packedCoord = (pc.useMorton != 0u) ? getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height) : globalID;
            uint tileSize = (pc.tileOffsetY == 0u) ? 64u : pc.tileOffsetY;
            uint ty = uint(packedCoord.y) / tileSize;
            uint tx_half = uint(packedCoord.x) / tileSize;
            uint localX = uint(packedCoord.x) % tileSize;
            uint tx = tx_half * 2u + (ty & 1u);
            pixelCoord = ivec2(int(tx * tileSize + localX), packedCoord.y);
            storeCoord = pixelCoord;
            storeWidth = fw;
            inBounds = (packedCoord.x < int(pc.width) && packedCoord.y < int(pc.height) &&
                        pixelCoord.x < int(fw) && pixelCoord.y < int(fh));
        } else {
            // Multi-GPU Checkerboard Tiling: Full-screen primary RayGen to populate 100% G-buffers for FSR3/ML
            uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
            if (pc.useMorton != 0u) {
                pixelCoord = getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height);
            } else {
                pixelCoord = globalID;
            }
            storeCoord = pixelCoord;
            storeWidth = fw;
            inBounds = (pixelCoord.x < int(fw) && pixelCoord.y < int(fh));
        }
    } else if (pc.tileOffsetX == 2u) {
        // Multi-GPU Checkerboard Tiling: Secondary GPU operates on packed odd tiles
        uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
        ivec2 packedCoord = (pc.useMorton != 0u) ? getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height) : globalID;
        uint tileSize = (pc.tileOffsetY == 0u) ? 64u : pc.tileOffsetY;
        uint ty = uint(packedCoord.y) / tileSize;
        uint tx_half = uint(packedCoord.x) / tileSize;
        uint localX = uint(packedCoord.x) % tileSize;
        uint tx = tx_half * 2u + (1u - (ty & 1u));
        pixelCoord = ivec2(int(tx * tileSize + localX), packedCoord.y);
        storeCoord = packedCoord;
        storeWidth = pc.width;
        inBounds = (packedCoord.x < int(pc.width) && packedCoord.y < int(pc.height) &&
                    pixelCoord.x < int(fw) && pixelCoord.y < int(fh));
    } else if (pc.tileOffsetX == 3u) {
        // Horizontal Band-Parallel Dispatch: band Y start = pc.tileOffsetY, full width = fw
        uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
        ivec2 localCoord = (pc.useMorton != 0u) ? getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height) : globalID;
        pixelCoord = ivec2(localCoord.x, localCoord.y + int(pc.tileOffsetY));
        storeCoord = localCoord;
        storeWidth = pc.width;
        inBounds = (localCoord.x < int(pc.width) && localCoord.y < int(pc.height) &&
                    pixelCoord.x < int(fw) && pixelCoord.y < int(fh));
    } else if (pc.tileSizeX > 0u && pc.tileSizeY > 0u) {
        uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
        ivec2 localCoord;
        if (pc.useMorton != 0u) {
            uint tilePixels = pc.tileSizeX * pc.tileSizeY;
            uint pixelIdx = (tilePixels > 0u) ? (linearIdx % tilePixels) : linearIdx;
            localCoord = getPixelCoordsMorton8x4(pixelIdx, pc.tileSizeX, pc.tileSizeY);
        } else {
            localCoord = globalID;
        }
        pixelCoord = localCoord + ivec2(pc.tileOffsetX, pc.tileOffsetY);
        storeCoord = pixelCoord;
        storeWidth = fw;
        inBounds = (localCoord.x < int(pc.tileSizeX) && localCoord.y < int(pc.tileSizeY) &&
                    pixelCoord.x < int(fw) && pixelCoord.y < int(fh));
    } else {
        uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
        if (pc.useMorton != 0u) {
            uint totalPixels = pc.width * pc.height;
            uint pixelIdx = (totalPixels > 0u) ? (linearIdx % totalPixels) : linearIdx;
            pixelCoord = getPixelCoordsMorton8x4(pixelIdx, pc.width, pc.height);
        } else {
            pixelCoord = globalID;
        }
        storeCoord = pixelCoord;
        storeWidth = fw;
        inBounds = (pixelCoord.x < int(fw) && pixelCoord.y < int(fh));
    }
    bool isActive = false;
    uint archetype = MATERIAL_ARCHETYPE_DIFFUSE;
    RayGeometry geom;
    RayHit hit;
    RayState state;
    vec2 hitUv = vec2(0.0);
    uint matId = 0u;
    uint pixelIndex = uint(storeCoord.x + storeCoord.y * int(storeWidth));

    if (inBounds) {
        uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + (ubo.frameIndex * max(ubo.spp, 1u) + pc.sppSampleIndex) * 26699) | 1u;
        bool enableTaa = (ubo.flags & (1u << 21)) != 0u;
        vec2 jitter = (enableTaa || pc.captureMlData != 0u) ? vec2(0.0) : (randVec2(seed) - vec2(0.5));
        vec2 uv = (vec2(pixelCoord) + vec2(0.5) + jitter) / vec2(float(fw), float(fh));
        vec2 d = uv * 2.0 - 1.0;

        vec4 target = ubo.projInverse * vec4(d.x, d.y, 1.0, 1.0);
        vec4 rayDirWorld = ubo.viewInverse * vec4(normalize(target.xyz / target.w), 0.0);

        vec3 origin = ubo.position.xyz;
        vec3 direction = normalize(rayDirWorld.xyz);

        float closestT = 1e4;
        int closestTri = -1;
        vec2 closestBary = vec2(0.0);
        mat4x3 hitW2o = mat4x3(1.0);
        mat4x3 hitO2w = mat4x3(1.0);
        uint hitInstMatOffset = 0u;
        uint hitInstIdx = 0u;

        traceClosestSceneHit(
            origin, direction, EPSILON, closestT,
            closestT, closestTri, closestBary,
            hitInstIdx, hitInstMatOffset, hitO2w, hitW2o
        );

        float invSpp = (ubo.spp > 0u) ? (1.0 / float(ubo.spp)) : 1.0;
        pixelIndex = uint(storeCoord.x + storeCoord.y * int(storeWidth));
        vec3 hitNormal = vec3(0.0, 1.0, 0.0);

        bool isLocalTile = true;
        if (pc.tileOffsetX == 1u) {
            if (pc.width >= fw) {
                uint tileSize = (pc.tileOffsetY == 0u) ? 64u : pc.tileOffsetY;
                uint tx = uint(pixelCoord.x) / tileSize;
                uint ty = uint(pixelCoord.y) / tileSize;
                isLocalTile = (((tx + ty) & 1u) == 0u);
            }
        }

        if (closestTri < 0) {
            // Miss: Sky / ambient radiance (only store for local tiles)
            if (isLocalTile) {
                vec3 skyColor;
                if (pc.hasEnvMap == 1u) {
                    vec2 envUv = directionToEquirectangular(direction);
                    skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
                } else {
                    float t = 0.5 * (direction.y + 1.0);
                    skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
                }
                skyColor *= invSpp;

                if (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u) {
                    vec4 prev = imageLoad(uAccumImage, storeCoord);
                    float outAlpha = ((pc.pad0 & 8u) != 0u && pc.sppSampleIndex == 0u) ? 10000.0 : prev.a;
                    imageStore(uAccumImage, storeCoord, vec4(addFp16Stochastic(prev.rgb, skyColor, seed), outAlpha));
                }
                if (pc.captureMlData != 0u) {
                    if ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) != 0u) {
                        if (pc.sppSampleIndex == 0u) {
                            wfStoreCompactMlSkip(storeCoord, skyColor);
                        } else {
                            wfAddCompactMlSkip(storeCoord, skyColor);
                        }
                    } else if ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u) {
                        if (pc.sppSampleIndex == 0u) {
                            imageStore(uMlSkipImage, storeCoord, vec4(skyColor, 0.0));
                        } else {
                            vec4 prevSkip = imageLoad(uMlSkipImage, storeCoord);
                            imageStore(uMlSkipImage, storeCoord, vec4(addFp16Stochastic(prevSkip.rgb, skyColor, seed), 0.0));
                        }
                    } else {
                        if (pc.sppSampleIndex == 0u) {
                            imageStore(uMlDiffuseImage, storeCoord, vec4(skyColor, 0.0));
                            // uMlSpecularImage is already zero-cleared by vkCmdClearColorImage
                        } else {
                            vec4 prevDiff = imageLoad(uMlDiffuseImage, storeCoord);
                            imageStore(uMlDiffuseImage, storeCoord, vec4(addFp16Stochastic(prevDiff.rgb, skyColor, seed), 0.0));
                        }
                    }
                }
                if ((ubo.flags & (1u << 9)) != 0u && pc.sppSampleIndex == 0u) {
                    currentReservoirs[pixelIndex].flags = 0u;
                    giCurrentData[pixelIndex].y = 0u;
                }
            }
        } else {
            // Hit! Setup SoA state: only enqueue into secondary bounce ray queues if this is a local tile!
            isActive = isLocalTile;

            geom.originPackedDir = vec4(origin, uintBitsToFloat(packOct32(direction)));

            archetype = MATERIAL_ARCHETYPE_DIFFUSE;

            Triangle tri = triangles[closestTri];
            matId = tri.materialId + hitInstMatOffset;
            archetype = (matId < pc.numMaterials) ? materialArchetypes[matId] : MATERIAL_ARCHETYPE_DIFFUSE;

            hit = packRayHitGeom(closestT, hitInstIdx, uint(closestTri), closestBary);

            bool hasValidMat = (matId < pc.numMaterials);
            ShadeMaterial smHit;
            if (hasValidMat) {
                smHit = shadeMaterials[matId];
            }
            bool isSpecular = (archetype == MATERIAL_ARCHETYPE_DIELECTRIC);
            bool isPrimaryTrans = (archetype == MATERIAL_ARCHETYPE_DIELECTRIC);
            if (hasValidMat) {
                uint smType = smGetTypeFlags(smHit) & MATERIAL_TYPE_MASK;
                if (!isSpecular) {
                    float met0 = smHit.pbrParams.y;
                    if (smType == 1u /* MATERIAL_METALLIC */ && smGetMrTex(smHit) == 0u) {
                        met0 = max(met0, 1.0);
                    }
                    isSpecular = (met0 > 0.5) && (smHit.pbrParams.x < 0.05) && (smGetAlbedoTex(smHit) == 0u) && (smGetMrTex(smHit) == 0u);
                }
                if (!isPrimaryTrans) {
                    if (smType == 2u /* MATERIAL_DIELECTRIC */) {
                        isPrimaryTrans = true;
                    } else if (smIsTransmissive(smHit)) {
                        isPrimaryTrans = (materials[matId].transmission >= 0.5);
                    }
                }
            }
            state = packRayState(f16vec3(1.0), seed, pixelIndex, isSpecular, false, 0u, 0u, isSpecular, isPrimaryTrans);

            if (pc.sppSampleIndex == 0u) {
                const bool compactMlOnly = ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) != 0u);
                bool needNormals = (pc.pad0 == 0u) || ((pc.pad0 & 1u) != 0u) || (pc.captureMlData != 0u);
                bool needNdStore = (pc.pad0 == 0u) || ((pc.pad0 & 2u) != 0u) || ((pc.captureMlData != 0u) && !compactMlOnly);
                bool needMvStore = (pc.pad0 == 0u) || ((pc.pad0 & 4u) != 0u) || ((pc.captureMlData != 0u) && !compactMlOnly);
                bool packDepthInAlpha = ((pc.pad0 & 8u) != 0u);
                bool isCenterPixel = (pixelCoord.x == int(fw / 2u) && pixelCoord.y == int(fh / 2u));
                bool needDepth = needNdStore || needMvStore || packDepthInAlpha || (pc.captureMlData != 0u) || isCenterPixel;

                vec2 vSurface = vec2(0.0);
                float vLinearDepthDelta = 0.0;
                vec3 primaryNormal = vec3(0.0, 0.0, 1.0);
                float primaryDepth = 10000.0;
                vec3 albedoVal = vec3(0.0);
                vec3 emissiveVal = vec3(0.0);
                float roughnessVal = 1.0;
                float metallicVal = 0.0;
                float transmissionVal = 0.0;

                vec3 primaryHitPoint = origin + direction * closestT;
                if (needMvStore || pc.captureMlData != 0u) {
                    vec3 localHitPos = hitW2o * vec4(primaryHitPoint, 1.0);
                    vec3 prevHitPoint = (instances[hitInstIdx].invTransform * vec4(localHitPos, 1.0)).xyz;
                    vec4 currClip = ubo.unjitteredViewProj * vec4(primaryHitPoint, 1.0);
                    vec4 prevClip = ubo.prevViewProj * vec4(prevHitPoint, 1.0);
                    if (currClip.w > 1e-4) {
                        if (prevClip.w > 1e-2) {
                            vSurface = clamp((currClip.xy / currClip.w - prevClip.xy / prevClip.w) * 0.5, vec2(-2.0), vec2(2.0));
                            vLinearDepthDelta = prevClip.w - currClip.w;
                        } else {
                            vSurface = vec2(2.0);
                        }
                    }
                }
                if (needDepth) {
                    vec3 camForward = -ubo.viewInverse[2].xyz;
                    primaryDepth = max(dot(primaryHitPoint - ubo.position.xyz, camForward), 0.0);
                }
                if (packDepthInAlpha && isLocalTile && (pc.captureMlData == 0u || (pc.captureMlData & 2u) != 0u)) {
                    imageStore(uAccumImage, storeCoord, vec4(0.0, 0.0, 0.0, -min(primaryDepth, 65000.0)));
                }

                if (needNormals || needNdStore || isCenterPixel || pc.captureMlData != 0u) {
                    hitNormal = normalize(transpose(mat3(hitW2o)) * getTriangleNormal(tri, closestBary));
                }
                vec2 quantUv = vec2(0.0);
                float rayConeBaseLod = -16.0;
                if (needNormals || pc.captureMlData != 0u) {
                    hitUv = getTriangleUV(tri, closestBary);
                    quantUv = hitUv;
                    if (closestTri >= 0) {
                        rayConeBaseLod = computeRayConeBaseLod(tri.tanSigns >> 16u, closestT, direction, hitNormal,
                                                               2.0 * abs(ubo.projInverse[1][1]) / float(max(fh, 1u)),
                                                               0u, 0u);
                    }
                }

                vec3 shadingNormal = (dot(direction, hitNormal) < 0.0) ? hitNormal : -hitNormal;
                if (needNormals) {
                    if (hasValidMat) {
                        uint nTex = smGetNormalTex(smHit);
                        if (nTex > 0u && nTex <= 512u) {
                            vec3 normalMap = SAMPLE_SCENE_TEXTURE_LOD(nTex, quantUv, rayConeBaseLod).rgb * 2.0 - 1.0;
                            normalMap.xy *= smGetNormalScale(smHit);
                            normalMap = normalize(normalMap);
                            vec3 tanDir = normalize(mat3(hitO2w) * getTriangleTangent(tri, closestBary));
                            float tanSign = getTriangleTangentSign(tri);
                            vec3 orthoTan = tanDir - dot(tanDir, shadingNormal) * shadingNormal;
                            float tanLenSq = dot(orthoTan, orthoTan);
                            vec3 gTan = (tanLenSq > 1e-6) ? (orthoTan * inversesqrt(tanLenSq)) : vec3(1.0, 0.0, 0.0);
                            vec3 gBitan = cross(shadingNormal, gTan) * tanSign;
                            shadingNormal = adjustShadingNormal(normalize(mat3(gTan, gBitan, shadingNormal) * normalMap), -direction);
                        }
                    }
                    primaryNormal = normalize(transpose(mat3(ubo.viewInverse)) * shadingNormal);
                }

                if (needNdStore || isCenterPixel) {
                    imageStore(uNormalDepthImage, storeCoord, vec4(primaryNormal, primaryDepth));
                }
                if (needMvStore) {
                    imageStore(uMotionVectorImage, storeCoord, vec4(vSurface, vLinearDepthDelta, primaryDepth));
                }

                if (pc.captureMlData != 0u) {
                    float clearcoatVal = 0.0;
                    float clearcoatRoughnessVal = 0.0;
                    float reactiveInit = 0.0;
                    if (matId < pc.numMaterials) {
                        Material mat = materials[matId];
                        reactiveInit = computeDynamicReactiveMask(mat, ubo.flags);
                        bool needPrimaryGuidesForEmissive = ((pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) == 0u) ||
                                                            (archetype != MATERIAL_ARCHETYPE_EMISSIVE);
                        vec4 baseColor = mat.albedo;
                        if (mat.albedoTex > 0u && mat.albedoTex <= 512u &&
                            (needPrimaryGuidesForEmissive || mat.alphaMode != 0u)) {
                            baseColor *= SAMPLE_SCENE_TEXTURE_LOD(mat.albedoTex, quantUv, rayConeBaseLod);
                        }
                        if (mat.alphaMode == 1u) {
                            albedoVal = (baseColor.a < mat.alphaCutoff) ? vec3(1.0) : baseColor.rgb;
                        } else if (mat.alphaMode == 2u) {
                            albedoVal = (baseColor.a < 0.99) ? vec3(1.0) : baseColor.rgb;
                        } else {
                            albedoVal = baseColor.rgb;
                        }
                        if ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) == 0u &&
                            archetype != MATERIAL_ARCHETYPE_EMISSIVE) {
                            emissiveVal = mat.emissive.rgb;
                            if (mat.emissiveTex > 0u && mat.emissiveTex <= 512u) {
                                emissiveVal *= SAMPLE_SCENE_TEXTURE_LOD(mat.emissiveTex, quantUv, rayConeBaseLod).rgb;
                            }
                            if (mat.emissiveTex > 0u) {
                                albedoVal = clamp(albedoVal + emissiveVal, vec3(0.0), vec3(1.0));
                            }
                        }
                        roughnessVal = mat.roughness;
                        metallicVal = mat.metallic;
                        transmissionVal = mat.transmission;
                        if (mat.mrTex > 0u && mat.mrTex <= 512u) {
                            vec4 mrSample = SAMPLE_SCENE_TEXTURE_LOD(mat.mrTex, quantUv, rayConeBaseLod);
                            roughnessVal *= mrSample.g;
                            metallicVal *= mrSample.b;
                        }
                        if ((mat.type & MATERIAL_TYPE_MASK) == 1u /* MATERIAL_METALLIC */ && mat.mrTex == 0u) {
                            metallicVal = max(metallicVal, 1.0);
                        }
                        if ((mat.type & MATERIAL_TYPE_MASK) == 2u /* MATERIAL_DIELECTRIC */) {
                            transmissionVal = max(transmissionVal, 1.0);
                        }
                        clearcoatVal = clamp(mat.clearcoat, 0.0, 1.0);
                        if (mat.clearcoatTex > 0u && mat.clearcoatTex <= 512u) {
                            clearcoatVal *= SAMPLE_SCENE_TEXTURE_LOD(mat.clearcoatTex, quantUv, rayConeBaseLod).r;
                        }
                        clearcoatRoughnessVal = clamp(mat.clearcoatRoughness, 0.0, 1.0);
                        if (mat.clearcoatRoughnessTex > 0u && mat.clearcoatRoughnessTex <= 512u) {
                            clearcoatRoughnessVal *= SAMPLE_SCENE_TEXTURE_LOD(mat.clearcoatRoughnessTex, quantUv, rayConeBaseLod).g;
                        }
                    }
                    float dSpec = 1.0 / (1.0 + max(primaryDepth, 0.0));
                    float isPrimaryEmissive = (archetype == MATERIAL_ARCHETYPE_EMISSIVE) ? 1.0 : 0.0;
                    float clampedMet = clamp(metallicVal, 0.0, 1.0);
                    float clampedTrans = clamp(transmissionVal, 0.0, 1.0);
                    float physicalRoughness = clamp(mix(roughnessVal, clearcoatRoughnessVal, clearcoatVal), 0.0, 1.0);
                    // Pack bounce-0 signed curvature term into uMlSpecVmvImage.x (.y == 0u preserves fallback when no bounce-1 specular ray runs)
                    float instScale = (length(hitO2w[0]) + length(hitO2w[1]) + length(hitO2w[2])) * (1.0 / 3.0);
                    float kappaWorld = uintBitsToFloat(tri.reserved0) / max(instScale, 1e-4);
                    if (dot(direction, hitNormal) > 0.0) kappaWorld = -kappaWorld;
                    float curvTerm = clamp(2.0 * kappaWorld / max(dot(shadingNormal, -direction), 0.1), -100.0, 100.0);
                    imageStore(uMlSpecVmvImage, storeCoord, uvec4(packHalf2x16(vec2(curvTerm, 0.0)), 0u, 0u, 0u));
                    if ((pc.captureMlData & ML_CAPTURE_UPWAYS_V4_BIT) != 0u) {
                        vec3 demodDiff = vec3(0.0);
                        vec3 demodSpec = vec3(0.0);
                        if (isPrimaryEmissive == 0.0) {
                            float rawDiffFactor = 1.0 - clampedMet;
                            demodDiff = max(albedoVal * rawDiffFactor, vec3(0.04));
                            vec3 rawF0 = mix(vec3(0.04), clamp(albedoVal, vec3(0.0), vec3(1.0)), clampedMet);
                            vec3 approxSpec = ffxApproximateBRDF(rawF0, physicalRoughness, shadingNormal, -direction);
                            demodSpec = max(clamp(approxSpec, vec3(0.0), vec3(1.0)), vec3(0.02));
                        }
                        if ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) != 0u) {
                            uint depthHalf = packHalf2x16(vec2(min(primaryDepth, 65504.0), 0.0)) & 0xFFFFu;
                            uint transBit = (clampedTrans >= 0.5 || archetype == MATERIAL_ARCHETYPE_DIELECTRIC) ? (1u << 16u) : 0u;
                            uint react8 = uint(clamp(round(reactiveInit * 255.0), 0.0, 255.0));
                            imageStore(uMlPrimaryGuideImage, storeCoord, uvec4(
                                packOct32(primaryNormal),
                                depthHalf | transBit | (react8 << 24u),
                                packUnorm4x8(vec4(clamp(demodDiff, 0.0, 1.0), physicalRoughness)),
                                packUnorm4x8(vec4(clamp(demodSpec, 0.0, 1.0), clamp(float(archetype) / 3.0, 0.0, 1.0)))
                            ));
                            imageStore(uMlSurfaceMvImage, storeCoord, uvec4(packHalf2x16(vSurface), 0u, 0u, 0u));
                        } else {
                            float prevM = (pc.sppSampleIndex == 0u) ? 0.0 : imageLoad(uMlSpecAlbedoImage, storeCoord).a;
                            imageStore(uMlAlbedoRoughnessImage, storeCoord, vec4(demodDiff, physicalRoughness));
                            imageStore(uMlSpecAlbedoImage, storeCoord, vec4(demodSpec, prevM));
                            imageStore(uMlSpecularMotionImage, storeCoord, vec4(vSurface, (clampedTrans >= 0.5) ? -dSpec : dSpec, 0.0));
                            if (pc.sppSampleIndex == 0u) {
                                imageStore(uMlSkipImage, storeCoord, vec4(0.0, 0.0, 0.0, float(archetype) / 3.0));
                            }
                            if (reactiveInit > 0.0) {
                                imageStore(uMlSpecularImage, storeCoord, vec4(0.0, 0.0, 0.0, reactiveInit));
                            }
                        }
                    } else if ((pc.captureMlData & ML_CAPTURE_SPLIT_4SIG_BIT) != 0u) {
                        float rawDiffFactor = 1.0 - clampedMet;
                        vec3 diffAlbedo = (isPrimaryEmissive > 0.0) ? vec3(0.0) : clamp(albedoVal, vec3(0.0), vec3(1.0)) * rawDiffFactor;
                        vec3 rawF0 = mix(vec3(0.04), clamp(albedoVal, vec3(0.0), vec3(1.0)), clampedMet);
                        vec3 approxSpec = ffxApproximateBRDF(rawF0, physicalRoughness, shadingNormal, -direction);
                        vec3 specAlbedo = (isPrimaryEmissive > 0.0) ? vec3(0.0) : clamp(approxSpec, vec3(0.0), vec3(1.0));
                        imageStore(uMlAlbedoRoughnessImage, storeCoord, vec4(diffAlbedo, physicalRoughness));
                        imageStore(uMlSpecAlbedoImage, storeCoord, vec4(specAlbedo, 0.0));
                        imageStore(uMlSpecularMotionImage, storeCoord, vec4(vSurface, (clampedTrans >= 0.5) ? -dSpec : dSpec, 0.0));
                        if (pc.sppSampleIndex == 0u) {
                            imageStore(uMlSkipImage, storeCoord, vec4(0.0, 0.0, 0.0, float(archetype) / 3.0));
                        }
                    } else {
                        vec3 mlAlbedo = (isPrimaryEmissive > 0.0) ? vec3(0.0) : max(albedoVal, vec3(0.004));
                        imageStore(uMlAlbedoRoughnessImage, storeCoord, vec4(mlAlbedo, physicalRoughness));
                        imageStore(uMlSpecularMotionImage, storeCoord, vec4(vSurface, (transmissionVal >= 0.5) ? -dSpec : dSpec, 0.0));
                        if (isPrimaryEmissive > 0.0) imageStore(uMlDiffuseImage, storeCoord, vec4(0.0, 0.0, 0.0, isPrimaryEmissive));
                        if (clampedMet > 0.0) imageStore(uMlSpecularImage, storeCoord, vec4(0.0, 0.0, 0.0, clampedMet));
                    }
                }
            }
        }
        if (pc.sppSampleIndex == 0u && closestTri < 0) {
            const bool compactFallback = ((pc.captureMlData & ML_CAPTURE_COMPACT_LIVE_BIT) != 0u);
            bool needNdStore = (pc.pad0 == 0u) || ((pc.pad0 & 2u) != 0u) || ((pc.captureMlData != 0u) && !compactFallback);
            bool needMvStore = (pc.pad0 == 0u) || ((pc.pad0 & 4u) != 0u) || ((pc.captureMlData != 0u) && !compactFallback);
            bool isCenterSky = (pixelCoord.x == int(fw / 2u) && pixelCoord.y == int(fh / 2u));
            vec2 vSurface = vec2(0.0);
            if (needMvStore || compactFallback) {
                vec3 skyDirPt = origin + direction * 1000.0;
                vec4 currClip = ubo.unjitteredViewProj * vec4(skyDirPt, 1.0);
                vec4 prevClip = ubo.prevViewProj * vec4(skyDirPt, 1.0);
                if (currClip.w > 1e-4) {
                    if (prevClip.w > 1e-2) {
                        vSurface = clamp((currClip.xy / currClip.w - prevClip.xy / prevClip.w) * 0.5, vec2(-2.0), vec2(2.0));
                    } else {
                        vSurface = vec2(2.0);
                    }
                }
            }
            float primaryDepth = 10000.0;
            vec3 primaryNormal = vec3(0.0, 0.0, 1.0);
            if (needNdStore || isCenterSky) {
                imageStore(uNormalDepthImage, storeCoord, vec4(primaryNormal, primaryDepth));
            }
            if (needMvStore) {
                imageStore(uMotionVectorImage, storeCoord, vec4(vSurface, 0.0, primaryDepth));
            }
            if (pc.captureMlData != 0u) {
                if (compactFallback) {
                    imageStore(uMlPrimaryGuideImage, storeCoord, uvec4(
                        packOct32(primaryNormal),
                        packHalf2x16(vec2(10000.0, 0.0)) & 0xFFFFu,
                        0u,
                        0u
                    ));
                    imageStore(uMlSurfaceMvImage, storeCoord, uvec4(packHalf2x16(vSurface), 0u, 0u, 0u));
                } else {
                    imageStore(uMlAlbedoRoughnessImage, storeCoord, vec4(0.0, 0.0, 0.0, 1.0));
                    imageStore(uMlSpecularMotionImage, storeCoord, vec4(vSurface, 0.0, 0.0));
                    if ((pc.captureMlData & ML_CAPTURE_ML_DENOISER_MASK) != 0u) {
                        imageStore(uMlSpecAlbedoImage, storeCoord, vec4(0.0));
                    }
                }
            }
        }
    }

    // Stream Compaction of all active primary rays into contiguous queues
    uvec4 ballot = subgroupBallot(isActive);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (waveActiveCount > 0u) {
        uint leader = subgroupBallotFindLSB(ballot);
        if (gl_SubgroupInvocationID == leader) {
            waveGlobalOffset = atomicAdd(queueCounters.activeRayCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupShuffle(waveGlobalOffset, leader);
    }

    uint rayIdx = 0u;
    if (isActive) {
        rayIdx = waveGlobalOffset + laneSlot;
        if (rayIdx < pc.maxQueueCapacity) {
            outGeoms[rayIdx] = geom;
            outHits[rayIdx]  = hit;
            outStates[rayIdx] = state;
        }
    }

    if (pc.sortMode > 0u) {
        uvec4 activeBallot = subgroupBallot(isActive);
        uint activeCountInWave = subgroupBallotBitCount(activeBallot);
        uint firstActiveLane = (activeCountInWave > 0u) ? subgroupBallotFindLSB(activeBallot) : 0u;
        uint leaderArchetype = subgroupShuffle(archetype, firstActiveLane);
        uvec4 matchLeaderBallot = subgroupBallot(isActive && archetype == leaderArchetype);
        bool isUniformWave = (activeCountInWave == 0u) || (subgroupBallotBitCount(matchLeaderBallot) == activeCountInWave);

        if (isUniformWave && activeCountInWave > 0u) {
            // Fast-path: All active lanes in the wave hit the same material archetype
            uint matLaneSlot = subgroupBallotExclusiveBitCount(activeBallot);
            uint waveQueueBase = 0u;
            if (gl_SubgroupInvocationID == firstActiveLane) {
                if (leaderArchetype == 0u) waveQueueBase = atomicAdd(queueCounters.diffuseCount, activeCountInWave);
                else if (leaderArchetype == 1u) waveQueueBase = atomicAdd(queueCounters.complexCount, activeCountInWave);
                else if (leaderArchetype == 2u) waveQueueBase = atomicAdd(queueCounters.dielectricCount, activeCountInWave);
                else if (leaderArchetype == 3u) waveQueueBase = atomicAdd(queueCounters.emissiveCount, activeCountInWave);
            }
            waveQueueBase = subgroupShuffle(waveQueueBase, firstActiveLane);

            if (isActive) {
                uint slot = waveQueueBase + matLaneSlot;
                if (slot < pc.maxQueueCapacity) {
                    materialIndices[leaderArchetype * pc.maxQueueCapacity + slot] = rayIdx;
                }
            }
        } else if (!isUniformWave) {
            // Material Index Queue Partitioning (4-byte indirection)
            for (uint k = 0u; k < 4u; ++k) {
                bool isMatch = (isActive && archetype == k);
                uvec4 matBallot = subgroupBallot(isMatch);
                uint matchCount = subgroupBallotBitCount(matBallot);

                if (matchCount > 0u) {
                    uint matLaneSlot = subgroupBallotExclusiveBitCount(matBallot);
                    uint leader = subgroupBallotFindLSB(matBallot);
                    uint waveQueueBase = 0u;
                    if (gl_SubgroupInvocationID == leader) {
                        if (k == 0u) waveQueueBase = atomicAdd(queueCounters.diffuseCount, matchCount);
                        else if (k == 1u) waveQueueBase = atomicAdd(queueCounters.complexCount, matchCount);
                        else if (k == 2u) waveQueueBase = atomicAdd(queueCounters.dielectricCount, matchCount);
                        else if (k == 3u) waveQueueBase = atomicAdd(queueCounters.emissiveCount, matchCount);
                    }
                    waveQueueBase = subgroupShuffle(waveQueueBase, leader);

                    if (isMatch) {
                        uint slot = waveQueueBase + matLaneSlot;
                        if (slot < pc.maxQueueCapacity) {
                            materialIndices[k * pc.maxQueueCapacity + slot] = rayIdx;
                        }
                    }
                }
            }
        }
    }

    // Atomic workgroup retirement to prepare Bounce 0 Shade dispatch directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint totalWgs = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == totalWgs - 1u) {
            if (pc.sortMode > 0u) {
                uint stdCnt  = atomicExchange(queueCounters.diffuseCount, 0u);
                uint compCnt = atomicExchange(queueCounters.complexCount, 0u);
                uint dielCnt = atomicExchange(queueCounters.dielectricCount, 0u);
                uint emisCnt = atomicExchange(queueCounters.emissiveCount, 0u);

                queueCounters.currentMaterialCounts[0] = stdCnt;
                queueCounters.currentMaterialCounts[1] = compCnt;
                queueCounters.currentMaterialCounts[2] = dielCnt;
                queueCounters.currentMaterialCounts[3] = emisCnt;

                uint stdGroups  = (stdCnt + 31u) / 32u;
                uint compGroups = (compCnt + 31u) / 32u;
                uint dielGroups = (dielCnt + 31u) / 32u;
                uint emisGroups = (emisCnt + 31u) / 32u;

                // Bounce 0 Shading Commands (Sequence 0..3)
                indirect.commands[0].x = stdGroups;
                indirect.commands[0].y = 1u;
                indirect.commands[0].z = 1u;
                indirect.commands[0].pad = stdCnt;

                indirect.commands[1].x = compGroups;
                indirect.commands[1].y = 1u;
                indirect.commands[1].z = 1u;
                indirect.commands[1].pad = compCnt;

                indirect.commands[2].x = dielGroups;
                indirect.commands[2].y = 1u;
                indirect.commands[2].z = 1u;
                indirect.commands[2].pad = dielCnt;

                indirect.commands[3].x = emisGroups;
                indirect.commands[3].y = 1u;
                indirect.commands[3].z = 1u;
                indirect.commands[3].pad = emisCnt;

                indirect.commands[4].x = 0u;
                indirect.commands[5].x = 0u;

                uint activeSeq = 0u;
                if (stdGroups > 0u) {
                    dgcStream.commands[activeSeq].pipelineIndex = 0u; // Standard
                    dgcStream.commands[activeSeq].x = stdGroups;
                    dgcStream.commands[activeSeq].y = 1u;
                    dgcStream.commands[activeSeq].z = 1u;
                    activeSeq++;
                }

                if (compGroups > 0u) {
                    dgcStream.commands[activeSeq].pipelineIndex = 1u; // Complex
                    dgcStream.commands[activeSeq].x = compGroups;
                    dgcStream.commands[activeSeq].y = 1u;
                    dgcStream.commands[activeSeq].z = 1u;
                    activeSeq++;
                }

                if (dielGroups > 0u) {
                    dgcStream.commands[activeSeq].pipelineIndex = 2u; // Dielectric
                    dgcStream.commands[activeSeq].x = dielGroups;
                    dgcStream.commands[activeSeq].y = 1u;
                    dgcStream.commands[activeSeq].z = 1u;
                    activeSeq++;
                }

                if (emisGroups > 0u) {
                    dgcStream.commands[activeSeq].pipelineIndex = 3u; // Emissive
                    dgcStream.commands[activeSeq].x = emisGroups;
                    dgcStream.commands[activeSeq].y = 1u;
                    dgcStream.commands[activeSeq].z = 1u;
                    activeSeq++;
                }

                for (uint c = activeSeq; c < 4u; ++c) {
                    dgcStream.commands[c].pipelineIndex = 0u;
                    dgcStream.commands[c].x = 0u;
                    dgcStream.commands[c].y = 1u;
                    dgcStream.commands[c].z = 1u;
                }

                uint totalShadeWgs = stdGroups + compGroups + dielGroups + emisGroups;
                queueCounters.totalShadeWorkgroups = totalShadeWgs;
                queueCounters.activeMaterialSequenceCount = activeSeq;

                if (totalShadeWgs == 0u) {
                    indirect.commands[6].x = 0u;
                    indirect.commands[7].x = 0u;
                    for (uint c = 0u; c < 4u; ++c) {
                        dgcStream.commands[c].x = 0u;
                    }
                }
            } else {
                uint activeCount = atomicAdd(queueCounters.activeRayCount, 0u);
                uint shadeGroups = (activeCount + 31u) / 32u;
                indirect.commands[0].x = shadeGroups;
                indirect.commands[0].y = 1u;
                indirect.commands[0].z = 1u;
                indirect.commands[0].pad = activeCount;

                dgcStream.commands[0].pipelineIndex = 2u; // Shade pipeline
                dgcStream.commands[0].x = shadeGroups;
                dgcStream.commands[0].y = 1u;
                dgcStream.commands[0].z = 1u;
            }

            queueCounters.currentShadowCount = 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
            queueCounters.pad[0] = 0u;
        }
    }
}
