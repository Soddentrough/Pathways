#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_shader_image_load_formatted : require

#include "wavefront_common.glsl"

layout(local_size_x = 8, local_size_y = 4) in;

layout(binding = 0) uniform image2D uAccumImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
layout(binding = 7) uniform sampler2D environmentMap;

layout(std430, binding = 10) writeonly buffer OutRayStateQueue {
    RayState outStates[];
};

layout(std430, binding = 11) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint diffuseCount;
    uint dielectricCount;
    uint conductorCount;
    uint complexCount;
    uint nextDiffuseCount;
    uint nextDielectricCount;
    uint nextConductorCount;
    uint nextComplexCount;
    uint currentMaterialCounts[4];
    uint totalShadeWorkgroups;
    uint pad[13];
} queueCounters;

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 16) writeonly buffer OutRayGeomQueue {
    RayGeometry outGeoms[];
};

layout(std430, binding = 17) writeonly buffer OutRayHitQueue {
    RayHit outHits[];
};

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint useMorton;
    uint hasEnvMap;
    float envMapIntensity;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint useHardwareRT;
    uint tileOffsetX;
    uint tileOffsetY;
    uint tileSizeX;
    uint tileSizeY;
    uint sortMode;
} pc;

void main() {
    ivec2 pixelCoord;
    bool inBounds = false;
    uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;

    if (pc.tileSizeX > 0u && pc.tileSizeY > 0u) {
        ivec2 localCoord;
        if (pc.useMorton != 0u) {
            localCoord = getPixelCoordsMorton8x4(linearIdx, pc.tileSizeX, pc.tileSizeY);
        } else {
            localCoord = ivec2(gl_GlobalInvocationID.xy);
        }
        pixelCoord = localCoord + ivec2(pc.tileOffsetX, pc.tileOffsetY);
        inBounds = (localCoord.x < int(pc.tileSizeX) && localCoord.y < int(pc.tileSizeY) &&
                    pixelCoord.x < int(pc.width) && pixelCoord.y < int(pc.height));
    } else {
        if (pc.useMorton != 0u) {
            pixelCoord = getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height);
        } else {
            pixelCoord = ivec2(gl_GlobalInvocationID.xy);
        }
        inBounds = (pixelCoord.x < int(pc.width) && pixelCoord.y < int(pc.height));
    }
    bool isActive = false;
    RayGeometry geom;
    RayHit hit;
    RayState state;

    if (inBounds) {
        uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + (ubo.frameIndex + pc.sppSampleIndex) * 26699) | 1u;
        vec2 jitter = randVec2(seed) - vec2(0.5);
        vec2 uv = (vec2(pixelCoord) + jitter) / vec2(float(pc.width), float(pc.height));
        vec2 d = uv * 2.0 - 1.0;

        vec4 target = ubo.projInverse * vec4(d.x, d.y, 1.0, 1.0);
        vec4 rayDirWorld = ubo.viewInverse * vec4(normalize(target.xyz / target.w), 0.0);

        vec3 origin = ubo.position.xyz;
        vec3 direction = normalize(rayDirWorld.xyz);

        float closestT = 1e4;
        int closestTri = -1;
        vec2 closestBary = vec2(0.0);
        int closestSphere = -1;

        // Hardware BVH Traversal with 100% fixed-function opaque traversal
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, EPSILON, direction, closestT);
        rayQueryProceedEXT(rq);

        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            closestT = rayQueryGetIntersectionTEXT(rq, true);
            closestTri = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
            closestBary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        }

        // Test procedural spheres
        if (pc.numSpheres > 0u) {
            for (uint i = 0; i < pc.numSpheres; ++i) {
                float spT;
                vec3 spNorm;
                if (intersectSphere(origin, direction, spheres[i], EPSILON, closestT, spT, spNorm)) {
                    closestT = spT;
                    closestSphere = int(i);
                    closestTri = -1;
                }
            }
        }

        float invSpp = (ubo.spp > 0u) ? (1.0 / float(ubo.spp)) : 1.0;

        if (closestTri < 0 && closestSphere < 0) {
            // Miss: Sky / ambient radiance
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(direction);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (direction.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            skyColor *= invSpp;

            vec4 prev = imageLoad(uAccumImage, pixelCoord);
            imageStore(uAccumImage, pixelCoord, prev + vec4(skyColor, 0.0));
        } else {
            // Hit! Setup SoA state
            isActive = true;
            uint pixelIndex = uint(pixelCoord.x + pixelCoord.y * int(pc.width));

            geom.originAndTMin = vec4(origin, EPSILON);
            geom.dirAndTMax = vec4(direction, closestT);

            uint archetype = MATERIAL_ARCHETYPE_DIFFUSE;
            if (closestTri >= 0) {
                hit.hitData = vec4(closestT,
                                   uintBitsToFloat(uint(closestTri)),
                                   uintBitsToFloat(packHalf2x16(closestBary)),
                                   uintBitsToFloat(0u)); // 0: triangle
                uint matId = triangles[closestTri].materialId;
                if (matId < pc.numMaterials) {
                    archetype = getMaterialArchetype(materials[matId]);
                }
            } else {
                hit.hitData = vec4(closestT,
                                   uintBitsToFloat(uint(closestSphere)),
                                   uintBitsToFloat(0u),
                                   uintBitsToFloat(1u)); // 1: sphere
                uint matId = spheres[closestSphere].materialId;
                if (matId < pc.numMaterials) {
                    archetype = getMaterialArchetype(materials[matId]);
                }
            }

            state.throughputSeed = vec4(vec3(invSpp), uintBitsToFloat(seed));
            state.radiancePixel = vec4(0.0, 0.0, 0.0, uintBitsToFloat(pixelIndex));

            if (pc.sortMode > 0u) {
                // Technique B: Subgroup Ballot Multi-Queue Partitioning (Zero-Sort)
                for (uint k = 0u; k < 4u; ++k) {
                    bool isMatch = (archetype == k);
                    uvec4 matBallot = subgroupBallot(isMatch);
                    uint matchCount = subgroupBallotBitCount(matBallot);

                    if (matchCount > 0u) {
                        uint laneSlot = subgroupBallotExclusiveBitCount(matBallot);
                        uint waveQueueBase = 0u;
                        if (subgroupElect()) {
                            if (k == 0u) waveQueueBase = atomicAdd(queueCounters.diffuseCount, matchCount);
                            else if (k == 1u) waveQueueBase = atomicAdd(queueCounters.dielectricCount, matchCount);
                            else if (k == 2u) waveQueueBase = atomicAdd(queueCounters.conductorCount, matchCount);
                            else if (k == 3u) waveQueueBase = atomicAdd(queueCounters.complexCount, matchCount);
                        }
                        waveQueueBase = subgroupBroadcastFirst(waveQueueBase);

                        if (isMatch) {
                            uint targetIdx = k * pc.maxQueueCapacity + (waveQueueBase + laneSlot);
                            if (waveQueueBase + laneSlot < pc.maxQueueCapacity) {
                                outGeoms[targetIdx] = geom;
                                outHits[targetIdx]  = hit;
                                outStates[targetIdx] = state;
                            }
                        }
                    }
                }
            }
        }
    }

    if (pc.sortMode == 0u) {
        // Monolithic Stream Compaction via Subgroup Ballots
        uvec4 ballot = subgroupBallot(isActive);
        uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
        uint waveActiveCount = subgroupBallotBitCount(ballot);

        uint waveGlobalOffset = 0u;
        if (subgroupElect()) {
            waveGlobalOffset = atomicAdd(queueCounters.activeRayCount, waveActiveCount);
        }
        waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);

        if (isActive) {
            uint targetIdx = waveGlobalOffset + laneSlot;
            if (targetIdx < pc.maxQueueCapacity) {
                outGeoms[targetIdx] = geom;
                outHits[targetIdx]  = hit;
                outStates[targetIdx] = state;
            }
        }
    }

    // Atomic workgroup retirement to prepare Bounce 0 Shade dispatch directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint totalWgs = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == totalWgs - 1u) {
            if (pc.sortMode > 0u) {
                uint diffCnt = queueCounters.diffuseCount;
                uint dielCnt = queueCounters.dielectricCount;
                uint condCnt = queueCounters.conductorCount;
                uint compCnt = queueCounters.complexCount;

                queueCounters.currentMaterialCounts[0] = diffCnt;
                queueCounters.currentMaterialCounts[1] = dielCnt;
                queueCounters.currentMaterialCounts[2] = condCnt;
                queueCounters.currentMaterialCounts[3] = compCnt;

                uint diffGroups = (diffCnt + 31u) / 32u;
                uint dielGroups = (dielCnt + 31u) / 32u;
                uint condGroups = (condCnt + 31u) / 32u;
                uint compGroups = (compCnt + 31u) / 32u;

                // Bounce 0 Shading Commands (Sequence 0..3)
                indirect.commands[0].x = diffGroups;
                indirect.commands[0].y = 1u;
                indirect.commands[0].z = 1u;
                indirect.commands[0].pad = diffCnt;

                indirect.commands[1].x = dielGroups;
                indirect.commands[1].y = 1u;
                indirect.commands[1].z = 1u;
                indirect.commands[1].pad = dielCnt;

                indirect.commands[2].x = condGroups;
                indirect.commands[2].y = 1u;
                indirect.commands[2].z = 1u;
                indirect.commands[2].pad = condCnt;

                indirect.commands[3].x = compGroups;
                indirect.commands[3].y = 1u;
                indirect.commands[3].z = 1u;
                indirect.commands[3].pad = compCnt;

                dgcStream.commands[0].pipelineIndex = 0u; // Diffuse
                dgcStream.commands[0].x = diffGroups;
                dgcStream.commands[0].y = 1u;
                dgcStream.commands[0].z = 1u;

                dgcStream.commands[1].pipelineIndex = 1u; // Dielectric
                dgcStream.commands[1].x = dielGroups;
                dgcStream.commands[1].y = 1u;
                dgcStream.commands[1].z = 1u;

                dgcStream.commands[2].pipelineIndex = 2u; // Conductor
                dgcStream.commands[2].x = condGroups;
                dgcStream.commands[2].y = 1u;
                dgcStream.commands[2].z = 1u;

                dgcStream.commands[3].pipelineIndex = 3u; // Complex
                dgcStream.commands[3].x = compGroups;
                dgcStream.commands[3].y = 1u;
                dgcStream.commands[3].z = 1u;

                uint totalShadeWgs = diffGroups + dielGroups + condGroups + compGroups;
                queueCounters.totalShadeWorkgroups = totalShadeWgs;

                if (totalShadeWgs == 0u) {
                    indirect.commands[4].x = 0u;
                    indirect.commands[5].x = 0u;
                }

                queueCounters.diffuseCount = 0u;
                queueCounters.dielectricCount = 0u;
                queueCounters.conductorCount = 0u;
                queueCounters.complexCount = 0u;
            } else {
                uint activeCount = queueCounters.activeRayCount;
                uint shadeGroups = (activeCount + 31u) / 32u;
                indirect.commands[0].x = shadeGroups;
                indirect.commands[0].y = 1u;
                indirect.commands[0].z = 1u;
                indirect.commands[0].pad = activeCount;

                dgcStream.commands[0].pipelineIndex = 2u; // Shade pipeline
                dgcStream.commands[0].x = shadeGroups;
                dgcStream.commands[0].y = 1u;
                dgcStream.commands[0].z = 1u;
            }

            queueCounters.currentShadowCount = 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
