#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_EXT_shader_image_load_formatted : require

#include "wavefront_common.glsl"

layout(local_size_x = 8, local_size_y = 4) in;

layout(binding = 0) uniform image2D uAccumImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
} ubo;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[64];

layout(std430, binding = 9) writeonly buffer OutRayQueue {
    RayPayload outRays[];
};

layout(std430, binding = 10) buffer QueueCounters {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint padding;
} queueCounters;

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint useMorton;
    uint hasEnvMap;
    float envMapIntensity;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint useHardwareRT;
} pc;

void main() {
    ivec2 pixelCoord;
    uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;

    if (pc.useMorton != 0u) {
        pixelCoord = getPixelCoordsMorton8x4(linearIdx, pc.width, pc.height);
    } else {
        pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    }

    bool inBounds = (pixelCoord.x < int(pc.width) && pixelCoord.y < int(pc.height));
    bool isActive = false;
    RayPayload payload;

    if (inBounds) {
        uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + (ubo.frameIndex + pc.sppSampleIndex) * 26699) | 1u;
        vec2 jitter = randVec2(seed) - vec2(0.5);
        vec2 uv = (vec2(pixelCoord) + jitter) / vec2(float(pc.width), float(pc.height));
        vec2 d = uv * 2.0 - 1.0;

        vec4 target = ubo.projInverse * vec4(d.x, d.y, 1.0, 1.0);
        vec4 rayDirWorld = ubo.viewInverse * vec4(normalize(target.xyz / target.w), 0.0);

        vec3 origin = ubo.position.xyz;
        vec3 direction = normalize(rayDirWorld.xyz);

        float closestT = 1e4;
        int closestTri = -1;
        vec2 closestBary = vec2(0.0);
        int closestSphere = -1;
        vec3 sphereNormal = vec3(0.0);

        // Hardware BVH Traversal with Any-Hit Alpha Mask cutout testing
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsNoneEXT, 0xFF, origin, EPSILON, direction, closestT);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                uint triIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
                Material candMat = materials[triangles[triIdx].materialId];
                if (candMat.alphaMode == 1u /* MASK */) {
                    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                    float cu = bary.x, cv = bary.y, cw = 1.0 - cu - cv;
                    Triangle ctri = triangles[triIdx];
                    vec2 cuv = cw * vec2(ctri.v0.position.w, ctri.v0.normal.w) +
                               cu * vec2(ctri.v1.position.w, ctri.v1.normal.w) +
                               cv * vec2(ctri.v2.position.w, ctri.v2.normal.w);
                    float calpha = candMat.albedo.a;
                    if (candMat.albedoTex > 0u && candMat.albedoTex <= 64u) {
                        calpha *= texture(sceneTextures[candMat.albedoTex - 1u], cuv).a;
                    }
                    if (calpha < candMat.alphaCutoff) {
                        continue; // Pass through alpha cutout
                    }
                }
                rayQueryConfirmIntersectionEXT(rq);
            }
        }

        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            closestT = rayQueryGetIntersectionTEXT(rq, true);
            closestTri = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
            closestBary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        }

        // Test procedural spheres
        for (uint i = 0; i < pc.numSpheres; ++i) {
            float spT;
            vec3 spNorm;
            if (intersectSphere(origin, direction, spheres[i], EPSILON, closestT, spT, spNorm)) {
                closestT = spT;
                closestSphere = int(i);
                closestTri = -1;
                sphereNormal = spNorm;
            }
        }

        if (closestTri < 0 && closestSphere < 0) {
            // Miss: Sky / ambient radiance
            vec3 skyColor;
            if (pc.hasEnvMap == 1u) {
                vec2 envUv = directionToEquirectangular(direction);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (direction.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }

            if (ubo.frameIndex == 0u && pc.sppSampleIndex == 0u) {
                imageStore(uAccumImage, pixelCoord, vec4(skyColor, 1.0));
            } else {
                vec4 prev = imageLoad(uAccumImage, pixelCoord);
                imageStore(uAccumImage, pixelCoord, prev + vec4(skyColor, 1.0));
            }
        } else {
            // Hit! Extract geometry info
            vec3 hitPoint = origin + closestT * direction;
            vec3 normal = vec3(0.0, 1.0, 0.0);
            vec2 hitUv = vec2(0.0);
            uint matId = 0;
            bool frontFace = true;

            if (closestTri >= 0) {
                Triangle tri = triangles[closestTri];
                float u = closestBary.x;
                float v = closestBary.y;
                float w = 1.0 - u - v;

                vec3 n0 = tri.v0.normal.xyz;
                vec3 n1 = tri.v1.normal.xyz;
                vec3 n2 = tri.v2.normal.xyz;
                normal = normalize(w * n0 + u * n1 + v * n2);

                vec2 uv0 = vec2(tri.v0.position.w, tri.v0.normal.w);
                vec2 uv1 = vec2(tri.v1.position.w, tri.v1.normal.w);
                vec2 uv2 = vec2(tri.v2.position.w, tri.v2.normal.w);
                hitUv = w * uv0 + u * uv1 + v * uv2;
                matId = tri.materialId;

                frontFace = dot(direction, normal) < 0.0;
                normal = frontFace ? normal : -normal;

                Material mat = materials[matId];

                // Tangent frame & Normal mapping
                if (mat.normalTex > 0u && mat.normalTex <= 64u) {
                    vec4 tan0 = tri.v0.tangent;
                    vec4 tan1 = tri.v1.tangent;
                    vec4 tan2 = tri.v2.tangent;
                    vec3 geomTan = normalize(w * tan0.xyz + u * tan1.xyz + v * tan2.xyz);
                    float tanSign = tan0.w != 0.0 ? tan0.w : 1.0;

                    vec3 normalMap = texture(sceneTextures[mat.normalTex - 1u], hitUv).rgb * 2.0 - 1.0;
                    normalMap.xy *= mat.normalScale;
                    normalMap = normalize(normalMap);

                    geomTan = normalize(geomTan - dot(geomTan, normal) * normal);
                    vec3 geomBitangent = cross(normal, geomTan) * tanSign;
                    mat3 tbn = mat3(geomTan, geomBitangent, normal);
                    normal = normalize(tbn * normalMap);
                }
            } else if (closestSphere >= 0) {
                normal = sphereNormal;
                matId = spheres[closestSphere].materialId;
                frontFace = dot(direction, normal) < 0.0;
                normal = frontFace ? normal : -normal;
            }

            Material mat = materials[matId];

            vec3 emissiveRad = mat.emissive.rgb;
            if (mat.emissiveTex > 0u && mat.emissiveTex <= 64u) {
                emissiveRad *= texture(sceneTextures[mat.emissiveTex - 1u], hitUv).rgb;
            }

            // If pure emissive light source, add radiance directly and terminate path early
            if (mat.type == 3u /* MATERIAL_EMISSIVE */) {
                if (ubo.frameIndex == 0u && pc.sppSampleIndex == 0u) {
                    imageStore(uAccumImage, pixelCoord, vec4(emissiveRad, 1.0));
                } else {
                    vec4 prev = imageLoad(uAccumImage, pixelCoord);
                    imageStore(uAccumImage, pixelCoord, prev + vec4(emissiveRad, 1.0));
                }
            } else {
                // Active path for shading micro-kernel (with initial emission if present)
                isActive = true;
                uint pixelIndex = uint(pixelCoord.x + pixelCoord.y * int(pc.width));

                payload.origin = vec4(hitPoint, uintBitsToFloat(1u));
                payload.direction = vec4(direction, uintBitsToFloat(0u)); // bounce 0
                payload.throughput = vec4(1.0, 1.0, 1.0, uintBitsToFloat(seed));
                payload.radiance = vec4(emissiveRad, uintBitsToFloat(pixelIndex));
                payload.hitNormal = vec4(normal, uintBitsToFloat(matId));
                payload.hitExtra = vec4(hitUv, closestT, uintBitsToFloat(frontFace ? 1u : 0u));
            }
        }
    }

    // High-performance Wavefront Stream Compaction via Subgroup Ballots
    uvec4 ballot = subgroupBallot(isActive);
    uint laneSlot = subgroupBallotExclusiveBitCount(ballot);
    uint waveActiveCount = subgroupBallotBitCount(ballot);

    uint waveGlobalOffset = 0u;
    if (subgroupElect()) {
        waveGlobalOffset = atomicAdd(queueCounters.activeRayCount, waveActiveCount);
    }
    waveGlobalOffset = subgroupBroadcastFirst(waveGlobalOffset);

    if (isActive) {
        uint targetIdx = waveGlobalOffset + laneSlot;
        if (targetIdx < pc.maxQueueCapacity) {
            outRays[targetIdx] = payload;
        }
    }
}
