#version 450
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly uniform image2D uCurrentFrame;   // Per-frame FP16 radiance
layout(binding = 1) uniform image2D uHistoryAccum;            // Persistent FP32 history buffer
layout(binding = 2) writeonly uniform image2D uOutputImage;   // Tonemapped output (10-bit UNORM / 16-bit Float)

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint sampleCount;    // Current accumulated frame count N (>= 1)
    float invSpp;        // 1.0 / activeSpp
    float exposure;      // Exposure compensation factor
    uint applyACES;      // 1 = Filmic ACES, 0 = Reinhard
    uint displayMode;    // 0 = SDR (sRGB 2.2), 1 = HDR scRGB Linear, 2 = HDR10 PQ
    float peakNits;      // Peak display luminance in nits
    float paperWhiteNits;// Reference paper white luminance in nits
    uint pad;            // 40-byte alignment
} pc;

// ACES Filmic Tone Mapping Curve (Narkowicz / Stephen Hill fit)
vec3 ACESFilm(vec3 x) {
    float a = 2.51f;
    float b = 0.03f;
    float c = 2.43f;
    float d = 0.59f;
    float e = 0.14f;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Rec.709 to Rec.2020 Color Gamut Conversion Matrix
const mat3 REC709_TO_REC2020 = mat3(
    0.6274040, 0.0690970, 0.0163916,
    0.3292820, 0.9195400, 0.0880132,
    0.0433136, 0.0113612, 0.8955952
);

// SMPTE ST 2084 (PQ) Transfer Function
vec3 LinearToST2084(vec3 L) {
    L = max(L, vec3(0.0));
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;

    vec3 Lm1 = pow(L, vec3(m1));
    vec3 num = c1 + c2 * Lm1;
    vec3 den = vec3(1.0) + c3 * Lm1;
    return pow(num / den, vec3(m2));
}

// Filmic HDR S-Curve Luminance Mapping
float FilmicHdrLuminance(float x, float paperWhite, float peakNits) {
    if (x <= 1e-6) return 0.0;
    // Strength reduction: x^1.25 == x * (x^0.5)^0.5 = x * sqrt(sqrt(x)) for non-negative luminance
    float k = max((peakNits / max(paperWhite, 50.0)) - 1.0, 0.1);
    float xp = x * sqrt(sqrt(x));
    return peakNits * (xp / (xp + k));
}

vec3 TonemapHDR(vec3 color, float paperWhite, float peakNits) {
    float inLum = dot(color, vec3(0.2126, 0.7152, 0.0722));
    if (inLum <= 1e-6) return vec3(0.0);
    float outLumNits = FilmicHdrLuminance(inLum, paperWhite, peakNits);
    float outLumScRgb = outLumNits / 80.0;
    return color * (outLumScRgb / inLum);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) {
        return;
    }

    vec4 frameVal = imageLoad(uCurrentFrame, pixelCoord);
    vec3 frameColor = frameVal.rgb * pc.invSpp;

    // Fast vector NaN/Inf/Negative sanitization
    if (any(isnan(frameColor)) || any(isinf(frameColor))) {
        frameColor = vec3(0.0);
    }
    frameColor = max(frameColor, vec3(0.0));
    bool isDynamicVideo = (frameVal.a > 0.5);

    vec3 accumVal;
    if (pc.sampleCount <= 1u || isDynamicVideo) {
        accumVal = frameColor;
        imageStore(uHistoryAccum, pixelCoord, vec4(accumVal, 1.0));
    } else {
        vec4 histVal = imageLoad(uHistoryAccum, pixelCoord);
        vec3 history = histVal.rgb;
        if (any(isnan(history)) || any(isinf(history))) {
            history = vec3(0.0);
        }
        history = max(history, vec3(0.0));

        float alpha = 1.0 / float(pc.sampleCount);
        accumVal = mix(history, frameColor, alpha);
        imageStore(uHistoryAccum, pixelCoord, vec4(accumVal, 1.0));
    }

    // Direct in-register ACES tonemapping (zero VRAM re-read hazard)
    vec3 linearColor = accumVal * pc.exposure;
    if (any(isnan(linearColor)) || any(isinf(linearColor))) {
        linearColor = vec3(0.0);
    }
    linearColor = max(linearColor, vec3(0.0));

    vec3 finalColor;
    if (pc.displayMode == 0u) {
        // --- SDR Fallback (sRGB ~2.2 Gamma, [0.0, 1.0]) ---
        vec3 mapped = (pc.applyACES != 0u) ? ACESFilm(linearColor) : (linearColor / (linearColor + vec3(1.0)));
        finalColor = pow(mapped, vec3(1.0 / 2.2));
    } else if (pc.displayMode == 1u) {
        // --- HDR scRGB Linear (16-bit Float, 1.0 = 80 nits) ---
        if (pc.applyACES != 0u) {
            finalColor = TonemapHDR(linearColor, pc.paperWhiteNits, pc.peakNits);
        } else {
            float sWhite = pc.paperWhiteNits / 80.0;
            float sPeak = pc.peakNits / 80.0;
            finalColor = clamp(linearColor * sWhite, vec3(0.0), vec3(sPeak));
        }
    } else {
        // --- HDR10 (10-bit Rec.2020 SMPTE ST 2084 PQ) ---
        vec3 scRgbColor;
        if (pc.applyACES != 0u) {
            scRgbColor = TonemapHDR(linearColor, pc.paperWhiteNits, pc.peakNits);
        } else {
            float sWhite = pc.paperWhiteNits / 80.0;
            float sPeak = pc.peakNits / 80.0;
            scRgbColor = clamp(linearColor * sWhite, vec3(0.0), vec3(sPeak));
        }
        vec3 rec2020Linear = REC709_TO_REC2020 * scRgbColor;
        vec3 normalizedL = rec2020Linear / 125.0;
        finalColor = LinearToST2084(normalizedL);
    }

    imageStore(uOutputImage, pixelCoord, vec4(finalColor, 1.0));
}
