#version 460
#include "upways_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly  uniform image2D tCleanRadLr;
layout(set = 0, binding = 1, rgba16f) readonly  uniform image2D uNormalDepth;
layout(set = 0, binding = 2, rgba16f) readonly  uniform image2D uMotionVectors;
layout(set = 0, binding = 3, rgba16f) readonly  uniform image2D uMlSpecular;
layout(set = 0, binding = 4, rgba16f) readonly  uniform image2D uMlSkip;
layout(set = 0, binding = 5)          readonly  buffer  SrSubpixelBuf { uvec2 sub[]; } g_srSub;
layout(set = 0, binding = 6, rgba16f) readonly  uniform image2D uPrevColorHr;
layout(set = 0, binding = 7, rgba16f) writeonly uniform image2D uCurrColorHr;
layout(set = 0, binding = 8, rgba16f) writeonly uniform image2D uOutputColor;

vec4 fetchSubpixel(ivec2 sp, int lrW) {
    ivec2 lp = sp >> 1;
    uint corner = uint(((sp.y & 1) << 1) | (sp.x & 1));
    uvec2 pck = g_srSub.sub[uint(lp.y * lrW + lp.x) * 4u + corner];
    return vec4(unpackHalf2x16(pck.x), unpackHalf2x16(pck.y));
}

void main() {
    ivec2 hrPos = ivec2(gl_GlobalInvocationID.xy);
    int hrW = int(pc.hrWidth);
    int hrH = int(pc.hrHeight);
    if (hrPos.x >= hrW || hrPos.y >= hrH) {
        return;
    }

    int lrW = int(pc.lrWidth);
    int lrH = int(pc.lrHeight);
    vec2 hrSizeF = vec2(float(hrW), float(hrH));
    vec2 lrSizeF = vec2(float(lrW), float(lrH));

    vec2 currUV  = (vec2(hrPos) + vec2(0.5)) / hrSizeF;
    vec2 lrCoord = (vec2(hrPos) + vec2(0.5)) * lrSizeF / hrSizeF; // Unjittered continuous LR coordinate

    // Primary ray at LR texel (lx, ly) samples (lx + 0.5 + jitter.x, ly + 0.5 + jitter.y)
    ivec2 lrCenter = clamp(ivec2(floor(lrCoord - vec2(pc.jitterX, pc.jitterY) + vec2(1e-5))), ivec2(0), ivec2(lrW - 1, lrH - 1));

    vec4  cRadInfo       = imageLoad(tCleanRadLr, lrCenter);
    vec4  ndCenter       = imageLoad(uNormalDepth, lrCenter);
    vec3  cNrmR          = vec3(sanitizeFloat(ndCenter.r, 0.0), sanitizeFloat(ndCenter.g, 0.0), sanitizeFloat(ndCenter.b, 1.0));
    float cNLen          = length(cNrmR);
    vec3  centerNrm      = (cNLen > 1e-5) ? (cNrmR / cNLen) : vec3(0.0, 0.0, 1.0);
    float centerDepth    = clamp(sanitizeFloat(ndCenter.a, 10000.0), 0.0, 10000.0);
    float centerDiffConf = clamp(sanitizeFloat(cRadInfo.a, 0.0), 0.0, 1.0);
    float centerLogL     = safeLog1pF(upwaysLuma(sanitizeRgb(cRadInfo.rgb)));
    bool  isSky          = (centerDepth >= 9999.0);

    // 1. De-jittered 3x3 bilateral gather + 3x3 log1p moments + 3x3 closest-depth dilated MV
    vec3  radSum        = vec3(0.0);
    float wSum          = 0.0;
    vec3  logSum        = vec3(0.0);
    vec3  logSum2       = vec3(0.0);
    float momCount      = 0.0;
    float maxTapSpatial = 0.0;

    float minDepth  = 1e30;
    vec2  dilatedMv = vec2(0.0);

    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = clamp(lrCenter + ivec2(dx, dy), ivec2(0), ivec2(lrW - 1, lrH - 1));
            vec3  qRad  = sanitizeRgb(imageLoad(tCleanRadLr, q).rgb);
            vec4  qNd   = imageLoad(uNormalDepth, q);
            vec3  qNrmR = vec3(sanitizeFloat(qNd.r, 0.0), sanitizeFloat(qNd.g, 0.0), sanitizeFloat(qNd.b, 1.0));
            float qNL   = length(qNrmR);
            vec3  qNrm  = (qNL > 1e-5) ? (qNrmR / qNL) : vec3(0.0, 0.0, 1.0);
            float qD    = clamp(sanitizeFloat(qNd.a, 10000.0), 0.0, 10000.0);
            bool  qSky  = (qD >= 9999.0);

            // Closest-depth dilated MV
            if (qD < minDepth) {
                minDepth = qD;
                vec4 qMv = imageLoad(uMotionVectors, q);
                dilatedMv = vec2(sanitizeFloat(qMv.r, 0.0), sanitizeFloat(qMv.g, 0.0));
            }

            // Distance from LR sample position to HR target
            vec2  d        = lrCoord - (vec2(q) + vec2(0.5) + vec2(pc.jitterX, pc.jitterY));
            float wSpatial = exp(-5.5 * dot(d, d));
            float qLogL    = safeLog1pF(upwaysLuma(qRad));
            float lumaW    = (dx == 0 && dy == 0) ? 1.0 : exp(-3.5 * (qLogL - centerLogL) * (qLogL - centerLogL));
            float wBilat   = 0.0;
            if (qSky == isSky) {
                if (!isSky) {
                    float relD = (qD - centerDepth) / max(centerDepth, 1e-3);
                    float ndot = max(dot(centerNrm, qNrm), 0.0);
                    wBilat = exp(-16.0 * relD * relD) * (ndot * ndot * ndot * ndot) * lumaW;
                } else {
                    wBilat = lumaW;
                }
                if (wBilat > 0.05) {
                    maxTapSpatial = max(maxTapSpatial, wSpatial);
                }
            }
            float w = wSpatial * wBilat;
            if (dx == 0 && dy == 0) {
                w = max(w, 1e-4);
            }
            radSum += w * qRad;
            wSum   += w;

            if ((dx == 0 && dy == 0) || (qSky == isSky)) {
                vec3 lq = safeLog1p(qRad);
                logSum   += lq;
                logSum2  += lq * lq;
                momCount += 1.0;
            }
        }
    }

    vec3  iBase   = radSum / max(wSum, 1e-6);
    float invMom  = 1.0 / max(momCount, 1.0);
    vec3  logMu   = logSum * invMom;
    vec3  logStd  = sqrt(max(logSum2 * invMom - logMu * logMu, vec3(0.0)));

    // 2. Explicit 4-tap bilinear sampling of predicted 2x2 subpixel deltas & temporal weight logits
    bool zeroResidual = (pc.flags & UPWAYS_FLAG_ZERO_RESIDUAL_MODE) != 0u;
    vec3  srDelta = vec3(0.0);
    float wLogit  = 0.0;

    if (!zeroResidual && !isSky) {
        vec2 spCoord = currUV * vec2(float(lrW * 2), float(lrH * 2)) - vec2(0.5);
        BilinearTaps spt = computeBilinearTaps(spCoord, ivec2(lrW * 2, lrH * 2));
        vec4 sp = spt.w.x * fetchSubpixel(spt.i00, lrW)
                + spt.w.y * fetchSubpixel(spt.i10, lrW)
                + spt.w.z * fetchSubpixel(spt.i01, lrW)
                + spt.w.w * fetchSubpixel(spt.i11, lrW);
        srDelta = clamp(sp.xyz, vec3(-4.0), vec3(4.0));
        wLogit  = clamp(sp.w, -6.0, 6.0);
    }

    vec3 iSr = (zeroResidual || isSky) ? iBase : safeExpm1(safeLog1p(iBase) + srDelta);

    // 3. Explicit imageLoad warp of HR color history along dilatedMv (ring-free 12-tap Catmull-Rom when moving)
    bool reset    = (pc.flags & UPWAYS_FLAG_RESET_HISTORY) != 0u;
    vec2 prevUVHr = currUV - dilatedMv;
    bool inBndHr  = !reset
                 && all(greaterThanEqual(prevUVHr, vec2(0.0)))
                 && all(lessThan(prevUVHr, vec2(1.0)));

    vec3 hrOut = iSr;
    if (inBndHr) {
        vec2  hrCoord = prevUVHr * hrSizeF - vec2(0.5);
        vec2  fHr     = floor(hrCoord);
        vec2  tHr     = clamp(hrCoord - fHr, vec2(0.0), vec2(1.0));
        int   x0      = int(fHr.x);
        int   y0      = int(fHr.y);
        ivec2 hiHr    = ivec2(hrW - 1, hrH - 1);

        ivec2 i00  = ivec2(clamp(x0,     0, hiHr.x), clamp(y0,     0, hiHr.y));
        ivec2 i10  = ivec2(clamp(x0 + 1, 0, hiHr.x), clamp(y0,     0, hiHr.y));
        ivec2 i01  = ivec2(clamp(x0,     0, hiHr.x), clamp(y0 + 1, 0, hiHr.y));
        ivec2 i11  = ivec2(clamp(x0 + 1, 0, hiHr.x), clamp(y0 + 1, 0, hiHr.y));
        float bw00 = (1.0 - tHr.x) * (1.0 - tHr.y);
        float bw10 = tHr.x * (1.0 - tHr.y);
        float bw01 = (1.0 - tHr.x) * tHr.y;
        float bw11 = tHr.x * tHr.y;

        vec4 p00 = imageLoad(uPrevColorHr, i00);
        vec4 p10 = imageLoad(uPrevColorHr, i10);
        vec4 p01 = imageLoad(uPrevColorHr, i01);
        vec4 p11 = imageLoad(uPrevColorHr, i11);

        vec3 c00 = sanitizeRgb(p00.rgb);
        vec3 c10 = sanitizeRgb(p10.rgb);
        vec3 c01 = sanitizeRgb(p01.rgb);
        vec3 c11 = sanitizeRgb(p11.rgb);

        vec3  prevAcc  = vec3(0.0);
        float validSum = 0.0;
        if (p00.a > 0.5) { prevAcc += bw00 * c00; validSum += bw00; }
        if (p10.a > 0.5) { prevAcc += bw10 * c10; validSum += bw10; }
        if (p01.a > 0.5) { prevAcc += bw01 * c01; validSum += bw01; }
        if (p11.a > 0.5) { prevAcc += bw11 * c11; validSum += bw11; }

        if (validSum > 1e-4) {
            vec3  prevHr    = prevAcc / validSum;
            float hrMvPx    = length(dilatedMv * hrSizeF);
            float hrMotionT = clamp(hrMvPx * 0.5, 0.0, 1.0);

            bool inner4Valid  = (p00.a > 0.5) && (p10.a > 0.5) && (p01.a > 0.5) && (p11.a > 0.5);
            bool bicubicInBnd = (x0 >= 1) && (x0 + 2 < hrW) && (y0 >= 1) && (y0 + 2 < hrH);
            if (hrMvPx > 0.05 && inner4Valid && bicubicInBnd) {
                vec4 pm0 = imageLoad(uPrevColorHr, ivec2(x0,     y0 - 1));
                vec4 pm1 = imageLoad(uPrevColorHr, ivec2(x0 + 1, y0 - 1));
                vec4 pl0 = imageLoad(uPrevColorHr, ivec2(x0 - 1, y0));
                vec4 pr0 = imageLoad(uPrevColorHr, ivec2(x0 + 2, y0));
                vec4 pl1 = imageLoad(uPrevColorHr, ivec2(x0 - 1, y0 + 1));
                vec4 pr1 = imageLoad(uPrevColorHr, ivec2(x0 + 2, y0 + 1));
                vec4 pp0 = imageLoad(uPrevColorHr, ivec2(x0,     y0 + 2));
                vec4 pp1 = imageLoad(uPrevColorHr, ivec2(x0 + 1, y0 + 2));

                if (pm0.a > 0.5 && pm1.a > 0.5 && pl0.a > 0.5 && pr0.a > 0.5
                    && pl1.a > 0.5 && pr1.a > 0.5 && pp0.a > 0.5 && pp1.a > 0.5) {
                    float ux = tHr.x, ux2 = ux * ux, ux3 = ux2 * ux;
                    float uy = tHr.y, uy2 = uy * uy, uy3 = uy2 * uy;
                    float wx0 = -0.5 * ux + ux2 - 0.5 * ux3;
                    float wx1 =  1.0 - 2.5 * ux2 + 1.5 * ux3;
                    float wx2 =  0.5 * ux + 2.0 * ux2 - 1.5 * ux3;
                    float wx3 = -0.5 * ux2 + 0.5 * ux3;
                    float wy0 = -0.5 * uy + uy2 - 0.5 * uy3;
                    float wy1 =  1.0 - 2.5 * uy2 + 1.5 * uy3;
                    float wy2 =  0.5 * uy + 2.0 * uy2 - 1.5 * uy3;
                    float wy3 = -0.5 * uy2 + 0.5 * uy3;

                    float wSum12 = (wx1 + wx2) * (wy0 + wy3) + (wy1 + wy2);
                    vec3  rowM   = wx1 * sanitizeRgb(pm0.rgb) + wx2 * sanitizeRgb(pm1.rgb);
                    vec3  row0   = wx0 * sanitizeRgb(pl0.rgb) + wx1 * c00 + wx2 * c10 + wx3 * sanitizeRgb(pr0.rgb);
                    vec3  row1   = wx0 * sanitizeRgb(pl1.rgb) + wx1 * c01 + wx2 * c11 + wx3 * sanitizeRgb(pr1.rgb);
                    vec3  rowP   = wx1 * sanitizeRgb(pp0.rgb) + wx2 * sanitizeRgb(pp1.rgb);
                    vec3  bicubic = (wy0 * rowM + wy1 * row0 + wy2 * row1 + wy3 * rowP) / max(wSum12, 1e-6);

                    vec3 cMin4 = min(min(c00, c10), min(c01, c11));
                    vec3 cMax4 = max(max(c00, c10), max(c01, c11));
                    prevHr = clamp(bicubic, cMin4, cMax4);
                }
            }

            float sigmaBox    = mix(3.0, 1.6, hrMotionT) + 0.75 * (1.0 - maxTapSpatial) * (1.0 - hrMotionT);
            float padBox      = mix(0.08, 0.025, hrMotionT);
            vec3  boxMin      = logMu - sigmaBox * logStd - vec3(padBox);
            vec3  boxMax      = logMu + sigmaBox * logStd + vec3(padBox);
            vec3  prevClamped = safeExpm1(clamp(safeLog1p(prevHr), boxMin, boxMax));

            float sigW        = 1.0 / (1.0 + exp(-(1.5 + wLogit)));
            float confFactor  = isSky ? 1.0 : mix(0.65, 1.0, centerDiffConf);
            float maxAlphaHr  = mix(0.94, 0.72, hrMotionT);
            float baseAlpha   = sigW * confFactor;
            float sampleAlign = mix(0.28, 1.0, maxTapSpatial);
            float alphaRaw    = 1.0 - (1.0 - baseAlpha) * sampleAlign;
            float alphaHr     = clamp(alphaRaw * maxAlphaHr, 0.0, maxAlphaHr);
            hrOut = mix(iSr, prevClamped, alphaHr);
        }
    }

    vec3 hrStore = clampFp16Rgb(hrOut);
    imageStore(uCurrColorHr, hrPos, vec4(hrStore, 1.0));
    imageStore(uOutputColor, hrPos, vec4(hrStore, 1.0));
}
