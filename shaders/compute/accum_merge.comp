#version 460
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 16, local_size_y = 16) in;

// Output linear accumulation buffer on primary GPU
layout(binding = 0) uniform image2D uPrimaryAccum;

// Secondary GPU accumulated radiance data transferred via PCIe
// Binding 1: 16-bit half float packed (uvec2 = 8 bytes per pixel, 50% bandwidth)
layout(std430, binding = 1) readonly buffer SecondaryAccumBuffer16 {
    uvec2 secondaryRadiance16[];
};

// Binding 2: 32-bit full float (vec4 = 16 bytes per pixel)
layout(std430, binding = 2) readonly buffer SecondaryAccumBuffer32 {
    vec4 secondaryRadiance32[];
};

// Binding 3: Primary GPU Motion Vectors image (RGBA16F 2.5D)
layout(binding = 3) uniform image2D uPrimaryMotionVectors;

// Binding 4: Primary GPU Normal & Linear Depth image (RGBA16F)
layout(binding = 4) uniform image2D uPrimaryNormalDepth;

// Binding 5: Secondary GPU Motion Vectors buffer (RGBA16F packed as uvec2)
layout(std430, binding = 5) readonly buffer SecondaryMvBuffer {
    uvec2 secondaryMv16[];
};

// Binding 6: Secondary GPU Normal & Linear Depth buffer (RGBA16F packed as uvec2)
layout(std430, binding = 6) readonly buffer SecondaryNormDepthBuffer {
    uvec2 secondaryNormDepth16[];
};

// Binding 7: 32-bit packed float (uint = 4 bytes per pixel, 50% PCIe bandwidth vs FP16)
layout(std430, binding = 7) readonly buffer SecondaryAccumBufferPacked {
    uint secondaryRadiancePacked[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint secondarySpp;
    uint tileSize;             // Checkerboard tile size (16, 32, 64, or 128; defaults to 64 if 0)
    uint formatMode;           // 0 = RGBA16_SFLOAT (default), 1 = RGBA32_SFLOAT, 2 = R11G11B10_UFLOAT
    uint mergeMode;            // 0/1 = CheckerboardTile, 2 = SampleParallel
    uint primarySpp;
    uint secDispatchWidth;     // Secondary tile buffer pitch in pixels (0 = auto-derive from tile grid)
    uint mergeGbuffers;        // 1 = full G-buffer merge, 2 = MV+depth from SecondaryMvBuffer, 3 = reconstruct MV+depth from secVal.a
    uint cameraMoved;          // 1 = compute camera reprojection MV via reprojMat, 0 = zero MV
    float ndcJitterX;
    float ndcJitterY;
    mat4 reprojMat;            // prevViewProj * viewInverse * scale(projInv00, projInv11, -1, 1)
} pc;

vec3 unpackR11G11B10F(uint val) {
    uint rBits = val & 0x7FFu;
    uint gBits = (val >> 11u) & 0x7FFu;
    uint bBits = (val >> 22u) & 0x3FFu;

    uint rM = rBits & 0x3Fu;
    uint rE = (rBits >> 6u) & 0x1Fu;
    float r = (rE == 0u) ? ((rM == 0u) ? 0.0 : (float(rM) / 64.0) * (1.0 / 16384.0))
                         : uintBitsToFloat(((rE + 112u) << 23u) | (rM << 17u));

    uint gM = gBits & 0x3Fu;
    uint gE = (gBits >> 6u) & 0x1Fu;
    float g = (gE == 0u) ? ((gM == 0u) ? 0.0 : (float(gM) / 64.0) * (1.0 / 16384.0))
                         : uintBitsToFloat(((gE + 112u) << 23u) | (gM << 17u));

    uint bM = bBits & 0x1Fu;
    uint bE = (bBits >> 5u) & 0x1Fu;
    float b = (bE == 0u) ? ((bM == 0u) ? 0.0 : (float(bM) / 32.0) * (1.0 / 16384.0))
                         : uintBitsToFloat(((bE + 112u) << 23u) | (bM << 18u));

    return vec3(r, g, b);
}

void main() {
    if (pc.mergeMode <= 1u) {
        // --- Mode 0/1: Checkerboard Tiling (Spatial Interleaving) ---
        uint tileSize = (pc.tileSize == 0u) ? 64u : pc.tileSize;
        uint numTilesX = (pc.width + tileSize - 1u) / tileSize;
        uint secPitch = (pc.secDispatchWidth > 0u) ? pc.secDispatchWidth : (((numTilesX + 1u) / 2u) * tileSize);

        ivec2 pixelCoord;
        uint secX;
        if (pc.mergeMode == 1u && pc.secDispatchWidth > 0u) {
            secX = gl_GlobalInvocationID.x;
            uint pixelY = gl_GlobalInvocationID.y;
            if (secX >= secPitch || pixelY >= pc.height) {
                return;
            }
            uint tx_half = secX / tileSize;
            uint localX = secX % tileSize;
            uint tileY = pixelY / tileSize;
            uint tx = tx_half * 2u + (1u - (tileY & 1u));
            pixelCoord = ivec2(int(tx * tileSize + localX), int(pixelY));
            if (pixelCoord.x >= int(pc.width)) {
                return;
            }
        } else {
            uint workgroupsPerTile = max(1u, tileSize / 16u);
            uint tileX = gl_WorkGroupID.x / workgroupsPerTile;
            uint tileY = gl_WorkGroupID.y / workgroupsPerTile;

            uint wgParity = (tileX + tileY) & 1u;
            if (wgParity == 0u) return;

            pixelCoord = ivec2(gl_GlobalInvocationID.xy);
            if (pixelCoord.x >= int(pc.width) || pixelCoord.y >= int(pc.height)) {
                return;
            }

            uint tx = uint(pixelCoord.x) / tileSize;
            uint tx_half = tx / 2u;
            uint localX = uint(pixelCoord.x) % tileSize;
            secX = tx_half * tileSize + localX;
        }
        uint linearIndex = uint(pixelCoord.y) * secPitch + secX;

        vec4 secVal;
        if (pc.formatMode == 0u) {
            uvec2 raw = secondaryRadiance16[linearIndex];
            secVal = vec4(unpackHalf2x16(raw.x), unpackHalf2x16(raw.y));
        } else if (pc.formatMode == 1u) {
            secVal = secondaryRadiance32[linearIndex];
        } else {
            uint raw = secondaryRadiancePacked[linearIndex];
            secVal = vec4(unpackR11G11B10F(raw), 0.0);
        }

        imageStore(uPrimaryAccum, pixelCoord, vec4(secVal.rgb, (secVal.a > 0.5) ? secVal.a : 0.0));

        if (pc.mergeGbuffers == 3u) {
            float primaryDepth = (secVal.a < 0.0) ? (-secVal.a) : 10000.0;
            vec2 vSurface = vec2(0.0);
            float vLinearDepthDelta = 0.0;
            if (pc.cameraMoved != 0u) {
                vec2 uv = (vec2(pixelCoord) + vec2(0.5)) / vec2(float(pc.width), float(pc.height));
                vec2 currNdc = (uv * 2.0 - 1.0) + vec2(pc.ndcJitterX, pc.ndcJitterY);
                float zEff = (primaryDepth >= 9999.0) ? 1000.0 : primaryDepth;
                vec4 prevClip = pc.reprojMat * vec4(currNdc.x * zEff, currNdc.y * zEff, zEff, 1.0);
                if (prevClip.w > 1e-2) {
                    vSurface = clamp((currNdc - prevClip.xy / prevClip.w) * 0.5, vec2(-2.0), vec2(2.0));
                    if (primaryDepth < 9999.0) {
                        vLinearDepthDelta = prevClip.w - zEff;
                    }
                } else {
                    vSurface = vec2(2.0);
                }
            }
            imageStore(uPrimaryMotionVectors, pixelCoord, vec4(vSurface, vLinearDepthDelta, primaryDepth));
            imageStore(uPrimaryNormalDepth, pixelCoord, vec4(0.0, 0.0, 1.0, primaryDepth));
        } else if (pc.mergeGbuffers != 0u) {
            // Merge Motion Vectors (RGBA16F: rg = 2D UV motion, b = depth delta, a = primaryDepth)
            uvec2 rawMv = secondaryMv16[linearIndex];
            vec4 secMv = vec4(unpackHalf2x16(rawMv.x), unpackHalf2x16(rawMv.y));
            imageStore(uPrimaryMotionVectors, pixelCoord, secMv);

            if (pc.mergeGbuffers == 1u) {
                // Full Normal & Depth merge (RGBA16F)
                uvec2 rawNd = secondaryNormDepth16[linearIndex];
                vec4 secNd = vec4(unpackHalf2x16(rawNd.x), unpackHalf2x16(rawNd.y));
                imageStore(uPrimaryNormalDepth, pixelCoord, secNd);
            } else {
                // Fast Depth-only merge from secMv.w when normal vectors are not needed (e.g. Pure MC + FSR)
                imageStore(uPrimaryNormalDepth, pixelCoord, vec4(0.0, 0.0, 1.0, secMv.w));
            }
        }
    } else {
        // --- Mode 2: Sample Parallelism (Temporal Sample Accumulation) ---
        ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
        if (pixelCoord.x >= pc.width || pixelCoord.y >= pc.height) {
            return;
        }

        uint linearIndex = uint(pixelCoord.y) * pc.width + uint(pixelCoord.x);

        vec4 secVal;
        if (pc.formatMode == 0u) {
            uvec2 raw = secondaryRadiance16[linearIndex];
            secVal = vec4(unpackHalf2x16(raw.x), unpackHalf2x16(raw.y));
        } else if (pc.formatMode == 1u) {
            secVal = secondaryRadiance32[linearIndex];
        } else {
            uint raw = secondaryRadiancePacked[linearIndex];
            secVal = vec4(unpackR11G11B10F(raw), 0.0);
        }

        vec4 primVal = imageLoad(uPrimaryAccum, pixelCoord);
        vec3 combined = primVal.rgb + secVal.rgb;
        imageStore(uPrimaryAccum, pixelCoord, vec4(combined, primVal.a));
    }
}
