#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : enable

#include "nrc_common.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// 16 KB shared memory staging buffers:
// 4 buffers of 4096 bytes (32 lanes * 64 features * sizeof(float16_t))
// Completely eliminates thread-local array allocations and prevents 267 KB scratch spills.
shared float16_t s_act0[32 * 64];   // 4 KB: input features x
shared float16_t s_act1[32 * 64];   // 4 KB: hidden layer 0 activations h0
shared float16_t s_act2[32 * 64];   // 4 KB: hidden layer 1 activations h1 (reused for delta0)
shared float16_t s_delta[32 * 64];  // 4 KB: deltas (delta2 first 3 elements, then delta1)

layout(std430, set = 0, binding = 0) readonly buffer InTrainQueue {
    NRCTrainingRecord records[];
};

layout(std430, set = 0, binding = 1) buffer InOutHashTable {
    uint packedFeatures[];
};

layout(std430, set = 0, binding = 2) buffer InOutWeights {
    float16_t weights[];
};

layout(std430, set = 0, binding = 3) buffer InOutWeightMomentum {
    float weightM[NRC_TOTAL_WEIGHTS];
    float weightV[NRC_TOTAL_WEIGHTS];
};

layout(std430, set = 0, binding = 4) readonly buffer InCounters {
    NRCCountersBuffer counters;
};

layout(push_constant) uniform PushConstants {
    uint trainCount;
    uint batchSize;
    float learningRate;
    uint frameIndex;
    vec4 worldMin;
    vec4 invWorldExtent;
} pc;

const float BETA1 = 0.9;
const float BETA2 = 0.999;
const float EPSILON_ADAM = 1e-8;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationIndex;
    uint maxTrain = min(min(pc.trainCount, pc.batchSize), counters.trainCount);

    bool valid = (tid < maxTrain);
    NRCTrainingRecord rec = valid ? records[tid] : records[0];
    vec3 L_target = rec.targetRadiance.xyz;
    if (any(isnan(L_target)) || any(isinf(L_target))) valid = false;

    vec3 normPos = valid ? clamp((rec.pos_roughness.xyz - pc.worldMin.xyz) * pc.invWorldExtent.xyz, vec3(0.0), vec3(1.0)) : vec3(0.0);

    // 1. Feature Extraction (64 features written into s_act0 as float16_t)
    for (uint i = 0u; i < 64u; ++i) {
        s_act0[lane * 64u + i] = float16_t(0.0);
    }

    if (valid) {
        const float PI = 3.14159265359;
        for (uint axis = 0u; axis < 3u; ++axis) {
            float coord = normPos[axis];
            for (uint l = 0u; l < 4u; ++l) {
                float freq = float(1 << l) * PI;
                uint baseIdx = axis * 8u + l * 2u;
                s_act0[lane * 64u + baseIdx + 0u] = float16_t(sin(coord * freq));
                s_act0[lane * 64u + baseIdx + 1u] = float16_t(cos(coord * freq));
            }
        }

        s_act0[lane * 64u + 24u] = float16_t(rec.normal_flags.x);
        s_act0[lane * 64u + 25u] = float16_t(rec.normal_flags.y);
        s_act0[lane * 64u + 26u] = float16_t(rec.normal_flags.z);
        s_act0[lane * 64u + 27u] = float16_t(rec.dir_pixelIndex.x);
        s_act0[lane * 64u + 28u] = float16_t(rec.dir_pixelIndex.y);
        s_act0[lane * 64u + 29u] = float16_t(rec.dir_pixelIndex.z);
        s_act0[lane * 64u + 30u] = float16_t(rec.pos_roughness.w);
        s_act0[lane * 64u + 31u] = float16_t(rec.albedo_pad.x);
        s_act0[lane * 64u + 32u] = float16_t(rec.albedo_pad.y);
        s_act0[lane * 64u + 33u] = float16_t(rec.albedo_pad.z);
    }
    barrier();

    // 2. Forward Pass
    // Layer 0: 64 -> 64
    for (uint j = 0u; j < 64u; ++j) {
        float sum = float(weights[NRC_B0_OFFSET + j]);
        for (uint i = 0u; i < 64u; ++i) {
            sum += float(s_act0[lane * 64u + i]) * float(weights[NRC_W0_OFFSET + i * 64u + j]);
        }
        s_act1[lane * 64u + j] = float16_t((sum > 0.0) ? sum : (0.01 * sum));
    }
    barrier();

    // Layer 1: 64 -> 64
    for (uint j = 0u; j < 64u; ++j) {
        float sum = float(weights[NRC_B1_OFFSET + j]);
        for (uint i = 0u; i < 64u; ++i) {
            sum += float(s_act1[lane * 64u + i]) * float(weights[NRC_W1_OFFSET + i * 64u + j]);
        }
        s_act2[lane * 64u + j] = float16_t((sum > 0.0) ? sum : (0.01 * sum));
    }
    barrier();

    // Layer 2: 64 -> 16 (first 3 channels for loss)
    vec3 pred = vec3(float(weights[NRC_B2_OFFSET + 0u]),
                      float(weights[NRC_B2_OFFSET + 1u]),
                      float(weights[NRC_B2_OFFSET + 2u]));
    for (uint i = 0u; i < 64u; ++i) {
        float h1_val = float(s_act2[lane * 64u + i]);
        pred.x += h1_val * float(weights[NRC_W2_OFFSET + i * 16u + 0u]);
        pred.y += h1_val * float(weights[NRC_W2_OFFSET + i * 16u + 1u]);
        pred.z += h1_val * float(weights[NRC_W2_OFFSET + i * 16u + 2u]);
    }

    // 3. Loss & Output Gradient: Relative L1 Loss
    pred = max(vec3(0.0), pred);
    vec3 diff = pred - L_target;
    vec3 denom = pred + vec3(0.01);
    vec3 dL_dy = valid ? (sign(diff) / denom) : vec3(0.0);

    s_delta[lane * 64u + 0u] = float16_t(dL_dy.x);
    s_delta[lane * 64u + 1u] = float16_t(dL_dy.y);
    s_delta[lane * 64u + 2u] = float16_t(dL_dy.z);
    barrier();

    float lr = pc.learningRate;
    uint wgBase = gl_WorkGroupID.x * 32u;
    uint numSamples = (maxTrain > wgBase) ? min(32u, maxTrain - wgBase) : 0u;
    float invBatch = (numSamples > 0u) ? (1.0 / float(numSamples)) : 0.0;

    // --- LAYER 2 Weight Update ---
    // Threads 0..2 update biases and weights
    if (gl_WorkGroupID.x == 0u && lane < 3u && numSamples > 0u) {
        uint j = lane;
        float g_b = 0.0;
        for (uint s = 0u; s < numSamples; ++s) {
            g_b += float(s_delta[s * 64u + j]);
        }
        g_b = clamp(g_b * invBatch, -10.0, 10.0);
        uint bIdx = NRC_B2_OFFSET + j;
        float mb = BETA1 * weightM[bIdx] + (1.0 - BETA1) * g_b;
        float vb = BETA2 * weightV[bIdx] + (1.0 - BETA2) * g_b * g_b;
        weightM[bIdx] = mb;
        weightV[bIdx] = vb;
        float new_b = float(weights[bIdx]) - (lr / (sqrt(vb) + EPSILON_ADAM)) * mb;
        weights[bIdx] = float16_t(clamp(new_b, -65000.0, 65000.0));

        for (uint i = 0u; i < 64u; ++i) {
            float g_w = 0.0;
            for (uint s = 0u; s < numSamples; ++s) {
                g_w += float(s_delta[s * 64u + j]) * float(s_act2[s * 64u + i]);
            }
            g_w = clamp(g_w * invBatch, -10.0, 10.0);
            uint wIdx = NRC_W2_OFFSET + i * 16u + j;
            float mw = BETA1 * weightM[wIdx] + (1.0 - BETA1) * g_w;
            float vw = BETA2 * weightV[wIdx] + (1.0 - BETA2) * g_w * g_w;
            weightM[wIdx] = mw;
            weightV[wIdx] = vw;
            float new_w = float(weights[wIdx]) - (lr / (sqrt(vw) + EPSILON_ADAM)) * mw;
            weights[wIdx] = float16_t(clamp(new_w, -65000.0, 65000.0));
        }
    }
    barrier();

    // Now compute delta1 into s_delta (overwriting delta2)
    // Backprop to Layer 1: delta1 = (W2 * delta2) * LeakyReLU'(h1)
    for (uint i = 0u; i < 64u; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < 3u; ++j) {
            sum += float(s_delta[lane * 64u + j]) * float(weights[NRC_W2_OFFSET + i * 16u + j]);
        }
        float h1_val = float(s_act2[lane * 64u + i]);
        s_act2[lane * 64u + i] = float16_t((h1_val > 0.0) ? sum : (0.01 * sum));
    }
    barrier();

    // Copy delta1 from s_act2 into s_delta:
    for (uint i = 0u; i < 64u; ++i) {
        s_delta[lane * 64u + i] = s_act2[lane * 64u + i];
    }
    barrier();

    // Now compute delta0 into s_act2!
    // Backprop to Layer 0: delta0 = (W1 * delta1) * LeakyReLU'(h0)
    for (uint i = 0u; i < 64u; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < 64u; ++j) {
            sum += float(s_delta[lane * 64u + j]) * float(weights[NRC_W1_OFFSET + i * 64u + j]);
        }
        float h0_val = float(s_act1[lane * 64u + i]);
        s_act2[lane * 64u + i] = float16_t((h0_val > 0.0) ? sum : (0.01 * sum));
    }
    barrier();

    // --- LAYER 1 Weight Update ---
    if (gl_WorkGroupID.x == 0u && numSamples > 0u) {
        for (uint pass = 0u; pass < 2u; ++pass) {
            uint j = lane + pass * 32u;
            float g_b = 0.0;
            for (uint s = 0u; s < numSamples; ++s) {
                g_b += float(s_delta[s * 64u + j]);
            }
            g_b = clamp(g_b * invBatch, -10.0, 10.0);
            uint bIdx = NRC_B1_OFFSET + j;
            float mb = BETA1 * weightM[bIdx] + (1.0 - BETA1) * g_b;
            float vb = BETA2 * weightV[bIdx] + (1.0 - BETA2) * g_b * g_b;
            weightM[bIdx] = mb;
            weightV[bIdx] = vb;
            float new_b = float(weights[bIdx]) - (lr / (sqrt(vb) + EPSILON_ADAM)) * mb;
            weights[bIdx] = float16_t(clamp(new_b, -65000.0, 65000.0));

            for (uint i = 0u; i < 64u; ++i) {
                float g_w = 0.0;
                for (uint s = 0u; s < numSamples; ++s) {
                    g_w += float(s_delta[s * 64u + j]) * float(s_act1[s * 64u + i]);
                }
                g_w = clamp(g_w * invBatch, -10.0, 10.0);
                uint wIdx = NRC_W1_OFFSET + i * 64u + j;
                float mw = BETA1 * weightM[wIdx] + (1.0 - BETA1) * g_w;
                float vw = BETA2 * weightV[wIdx] + (1.0 - BETA2) * g_w * g_w;
                weightM[wIdx] = mw;
                weightV[wIdx] = vw;
                float new_w = float(weights[wIdx]) - (lr / (sqrt(vw) + EPSILON_ADAM)) * mw;
                weights[wIdx] = float16_t(clamp(new_w, -65000.0, 65000.0));
            }
        }
    }
    barrier();

    // --- LAYER 0 Weight Update ---
    if (gl_WorkGroupID.x == 0u && numSamples > 0u) {
        for (uint pass = 0u; pass < 2u; ++pass) {
            uint j = lane + pass * 32u;
            float g_b = 0.0;
            for (uint s = 0u; s < numSamples; ++s) {
                g_b += float(s_act2[s * 64u + j]);
            }
            g_b = clamp(g_b * invBatch, -10.0, 10.0);
            uint bIdx = NRC_B0_OFFSET + j;
            float mb = BETA1 * weightM[bIdx] + (1.0 - BETA1) * g_b;
            float vb = BETA2 * weightV[bIdx] + (1.0 - BETA2) * g_b * g_b;
            weightM[bIdx] = mb;
            weightV[bIdx] = vb;
            float new_b = float(weights[bIdx]) - (lr / (sqrt(vb) + EPSILON_ADAM)) * mb;
            weights[bIdx] = float16_t(clamp(new_b, -65000.0, 65000.0));

            for (uint i = 0u; i < 64u; ++i) {
                float g_w = 0.0;
                for (uint s = 0u; s < numSamples; ++s) {
                    g_w += float(s_act2[s * 64u + j]) * float(s_act0[s * 64u + i]);
                }
                g_w = clamp(g_w * invBatch, -10.0, 10.0);
                uint wIdx = NRC_W0_OFFSET + i * 64u + j;
                float mw = BETA1 * weightM[wIdx] + (1.0 - BETA1) * g_w;
                float vw = BETA2 * weightV[wIdx] + (1.0 - BETA2) * g_w * g_w;
                weightM[wIdx] = mw;
                weightV[wIdx] = vw;
                float new_w = float(weights[wIdx]) - (lr / (sqrt(vw) + EPSILON_ADAM)) * mw;
                weights[wIdx] = float16_t(clamp(new_w, -65000.0, 65000.0));
            }
        }
    }
}
