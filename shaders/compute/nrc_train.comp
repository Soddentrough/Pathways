#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_GOOGLE_include_directive : enable

#include "nrc_common.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

shared float s_delta[32 * 64];
shared float s_act[32 * 64];

layout(std430, set = 0, binding = 0) readonly buffer InTrainQueue {
    NRCTrainingRecord records[];
};

layout(std430, set = 0, binding = 1) buffer InOutHashTable {
    uint packedFeatures[];
};

layout(std430, set = 0, binding = 2) buffer InOutWeights {
    float16_t weights[];
};

layout(std430, set = 0, binding = 3) buffer InOutWeightMomentum {
    float weightM[NRC_TOTAL_WEIGHTS];
    float weightV[NRC_TOTAL_WEIGHTS];
};

layout(std430, set = 0, binding = 4) readonly buffer InCounters {
    NRCCountersBuffer counters;
};

layout(push_constant) uniform PushConstants {
    uint trainCount;
    uint batchSize;
    float learningRate;
    uint frameIndex;
    vec4 worldMin;
    vec4 invWorldExtent;
} pc;

const float BETA1 = 0.9;
const float BETA2 = 0.999;
const float EPSILON_ADAM = 1e-8;

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationIndex;
    uint maxTrain = min(min(pc.trainCount, pc.batchSize), counters.trainCount);

    bool valid = (tid < maxTrain);
    NRCTrainingRecord rec = valid ? records[tid] : records[0];
    vec3 L_target = rec.targetRadiance.xyz;
    if (any(isnan(L_target)) || any(isinf(L_target))) valid = false;

    vec3 normPos = valid ? clamp((rec.pos_roughness.xyz - pc.worldMin.xyz) * pc.invWorldExtent.xyz, vec3(0.0), vec3(1.0)) : vec3(0.0);

    // 1. Feature Extraction (64 features)
    float x[64];
    for (int i = 0; i < 64; ++i) x[i] = 0.0;

    if (valid) {
        // Independent axis sinusoidal spatial encoding (24 features, matching nrc_encode_infer.comp)
        const float PI = 3.14159265359;
        for (uint axis = 0u; axis < 3u; ++axis) {
            float coord = normPos[axis];
            for (uint l = 0u; l < 4u; ++l) {
                float freq = float(1 << l) * PI;
                uint baseIdx = axis * 8u + l * 2u;
                x[baseIdx + 0u] = sin(coord * freq);
                x[baseIdx + 1u] = cos(coord * freq);
            }
        }

        // Normal, ViewDir, Roughness, Albedo
        x[24] = rec.normal_flags.x;
        x[25] = rec.normal_flags.y;
        x[26] = rec.normal_flags.z;
        x[27] = rec.dir_pixelIndex.x;
        x[28] = rec.dir_pixelIndex.y;
        x[29] = rec.dir_pixelIndex.z;
        x[30] = rec.pos_roughness.w;
        x[31] = rec.albedo_pad.x;
        x[32] = rec.albedo_pad.y;
        x[33] = rec.albedo_pad.z;
    }

    // 2. Forward Pass
    // Layer 0: 64 -> 64
    float h0[64];
    for (uint j = 0u; j < 64u; ++j) {
        float sum = float(weights[NRC_B0_OFFSET + j]);
        for (uint i = 0u; i < 64u; ++i) {
            sum += x[i] * float(weights[NRC_W0_OFFSET + i * 64u + j]);
        }
        h0[j] = (sum > 0.0) ? sum : (0.01 * sum);
    }

    // Layer 1: 64 -> 64
    float h1[64];
    for (uint j = 0u; j < 64u; ++j) {
        float sum = float(weights[NRC_B1_OFFSET + j]);
        for (uint i = 0u; i < 64u; ++i) {
            sum += h0[i] * float(weights[NRC_W1_OFFSET + i * 64u + j]);
        }
        h1[j] = (sum > 0.0) ? sum : (0.01 * sum);
    }

    // Layer 2: 64 -> 16
    float y_out[16];
    for (uint j = 0u; j < 16u; ++j) {
        float sum = float(weights[NRC_B2_OFFSET + j]);
        for (uint i = 0u; i < 64u; ++i) {
            sum += h1[i] * float(weights[NRC_W2_OFFSET + i * 16u + j]);
        }
        y_out[j] = sum;
    }

    // 3. Loss & Output Gradient: Relative L1 Loss
    // dL/dy = sign(y - y_target) / (y + 0.01)
    vec3 pred = max(vec3(0.0), vec3(y_out[0], y_out[1], y_out[2]));
    vec3 diff = pred - L_target;
    vec3 denom = pred + vec3(0.01);
    vec3 dL_dy = valid ? (sign(diff) / denom) : vec3(0.0);

    float delta2[16];
    delta2[0] = dL_dy.x;
    delta2[1] = dL_dy.y;
    delta2[2] = dL_dy.z;
    for (int j = 3; j < 16; ++j) delta2[j] = 0.0;

    // 4. Backpropagation
    // Backprop to Layer 1: delta1 = (W2 * delta2) * LeakyReLU'(h1)
    float delta1[64];
    for (uint i = 0u; i < 64u; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < 16u; ++j) {
            sum += delta2[j] * float(weights[NRC_W2_OFFSET + i * 16u + j]);
        }
        delta1[i] = (h1[i] > 0.0) ? sum : (0.01 * sum);
    }

    // Backprop to Layer 0: delta0 = (W1 * delta1) * LeakyReLU'(h0)
    float delta0[64];
    for (uint i = 0u; i < 64u; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < 64u; ++j) {
            sum += delta1[j] * float(weights[NRC_W1_OFFSET + i * 64u + j]);
        }
        delta0[i] = (h0[i] > 0.0) ? sum : (0.01 * sum);
    }

    float lr = pc.learningRate;

    // Number of valid samples in this workgroup
    uint wgBase = gl_WorkGroupID.x * 32u;
    uint numSamples = (maxTrain > wgBase) ? min(32u, maxTrain - wgBase) : 0u;
    float invBatch = (numSamples > 0u) ? (1.0 / float(numSamples)) : 0.0;

    // =========================================================================
    // 5. Parallel Multi-Layer Adam Weight Updates
    // =========================================================================

    // --- LAYER 2 (64 hidden -> 16 output radiance) ---
    for (uint j = 0u; j < 16u; ++j) {
        s_delta[lane * 64u + j] = valid ? delta2[j] : 0.0;
    }
    for (uint i = 0u; i < 64u; ++i) {
        s_act[lane * 64u + i] = valid ? h1[i] : 0.0;
    }
    barrier();

    // Threads 0..15 each update neuron j's bias and 64 weights
    if (gl_WorkGroupID.x == 0u && lane < 16u && numSamples > 0u) {
        uint j = lane;
        // Bias B2[j]
        float g_b = 0.0;
        for (uint s = 0u; s < numSamples; ++s) {
            g_b += s_delta[s * 64u + j];
        }
        g_b = clamp(g_b * invBatch, -10.0, 10.0);
        uint bIdx = NRC_B2_OFFSET + j;
        float mb = BETA1 * weightM[bIdx] + (1.0 - BETA1) * g_b;
        float vb = BETA2 * weightV[bIdx] + (1.0 - BETA2) * g_b * g_b;
        weightM[bIdx] = mb;
        weightV[bIdx] = vb;
        float new_b = float(weights[bIdx]) - (lr / (sqrt(vb) + EPSILON_ADAM)) * mb;
        weights[bIdx] = float16_t(clamp(new_b, -65000.0, 65000.0));

        // Weights W2[i, j] for i in 0..63
        for (uint i = 0u; i < 64u; ++i) {
            float g_w = 0.0;
            for (uint s = 0u; s < numSamples; ++s) {
                g_w += s_delta[s * 64u + j] * s_act[s * 64u + i];
            }
            g_w = clamp(g_w * invBatch, -10.0, 10.0);
            uint wIdx = NRC_W2_OFFSET + i * 16u + j;
            float mw = BETA1 * weightM[wIdx] + (1.0 - BETA1) * g_w;
            float vw = BETA2 * weightV[wIdx] + (1.0 - BETA2) * g_w * g_w;
            weightM[wIdx] = mw;
            weightV[wIdx] = vw;
            float new_w = float(weights[wIdx]) - (lr / (sqrt(vw) + EPSILON_ADAM)) * mw;
            weights[wIdx] = float16_t(clamp(new_w, -65000.0, 65000.0));
        }
    }
    barrier();

    // --- LAYER 1 (64 hidden -> 64 hidden) ---
    for (uint j = 0u; j < 64u; ++j) {
        s_delta[lane * 64u + j] = valid ? delta1[j] : 0.0;
        s_act[lane * 64u + j] = valid ? h0[j] : 0.0;
    }
    barrier();

    // 32 threads each update 2 neurons: (lane) and (lane + 32)
    if (gl_WorkGroupID.x == 0u && numSamples > 0u) {
        for (uint pass = 0u; pass < 2u; ++pass) {
            uint j = lane + pass * 32u;
            // Bias B1[j]
            float g_b = 0.0;
            for (uint s = 0u; s < numSamples; ++s) {
                g_b += s_delta[s * 64u + j];
            }
            g_b = clamp(g_b * invBatch, -10.0, 10.0);
            uint bIdx = NRC_B1_OFFSET + j;
            float mb = BETA1 * weightM[bIdx] + (1.0 - BETA1) * g_b;
            float vb = BETA2 * weightV[bIdx] + (1.0 - BETA2) * g_b * g_b;
            weightM[bIdx] = mb;
            weightV[bIdx] = vb;
            float new_b = float(weights[bIdx]) - (lr / (sqrt(vb) + EPSILON_ADAM)) * mb;
            weights[bIdx] = float16_t(clamp(new_b, -65000.0, 65000.0));

            // Weights W1[i, j] for i in 0..63
            for (uint i = 0u; i < 64u; ++i) {
                float g_w = 0.0;
                for (uint s = 0u; s < numSamples; ++s) {
                    g_w += s_delta[s * 64u + j] * s_act[s * 64u + i];
                }
                g_w = clamp(g_w * invBatch, -10.0, 10.0);
                uint wIdx = NRC_W1_OFFSET + i * 64u + j;
                float mw = BETA1 * weightM[wIdx] + (1.0 - BETA1) * g_w;
                float vw = BETA2 * weightV[wIdx] + (1.0 - BETA2) * g_w * g_w;
                weightM[wIdx] = mw;
                weightV[wIdx] = vw;
                float new_w = float(weights[wIdx]) - (lr / (sqrt(vw) + EPSILON_ADAM)) * mw;
                weights[wIdx] = float16_t(clamp(new_w, -65000.0, 65000.0));
            }
        }
    }
    barrier();

    // --- LAYER 0 (64 input features -> 64 hidden neurons) ---
    for (uint j = 0u; j < 64u; ++j) {
        s_delta[lane * 64u + j] = valid ? delta0[j] : 0.0;
        s_act[lane * 64u + j] = valid ? x[j] : 0.0;
    }
    barrier();

    // 32 threads each update 2 neurons: (lane) and (lane + 32)
    if (gl_WorkGroupID.x == 0u && numSamples > 0u) {
        for (uint pass = 0u; pass < 2u; ++pass) {
            uint j = lane + pass * 32u;
            // Bias B0[j]
            float g_b = 0.0;
            for (uint s = 0u; s < numSamples; ++s) {
                g_b += s_delta[s * 64u + j];
            }
            g_b = clamp(g_b * invBatch, -10.0, 10.0);
            uint bIdx = NRC_B0_OFFSET + j;
            float mb = BETA1 * weightM[bIdx] + (1.0 - BETA1) * g_b;
            float vb = BETA2 * weightV[bIdx] + (1.0 - BETA2) * g_b * g_b;
            weightM[bIdx] = mb;
            weightV[bIdx] = vb;
            float new_b = float(weights[bIdx]) - (lr / (sqrt(vb) + EPSILON_ADAM)) * mb;
            weights[bIdx] = float16_t(clamp(new_b, -65000.0, 65000.0));

            // Weights W0[i, j] for i in 0..63
            for (uint i = 0u; i < 64u; ++i) {
                float g_w = 0.0;
                for (uint s = 0u; s < numSamples; ++s) {
                    g_w += s_delta[s * 64u + j] * s_act[s * 64u + i];
                }
                g_w = clamp(g_w * invBatch, -10.0, 10.0);
                uint wIdx = NRC_W0_OFFSET + i * 64u + j;
                float mw = BETA1 * weightM[wIdx] + (1.0 - BETA1) * g_w;
                float vw = BETA2 * weightV[wIdx] + (1.0 - BETA2) * g_w * g_w;
                weightM[wIdx] = mw;
                weightV[wIdx] = vw;
                float new_w = float(weights[wIdx]) - (lr / (sqrt(vw) + EPSILON_ADAM)) * mw;
                weights[wIdx] = float16_t(clamp(new_w, -65000.0, 65000.0));
            }
        }
    }
}
