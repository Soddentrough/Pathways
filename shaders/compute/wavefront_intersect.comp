#version 460
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(std430, binding = 9) readonly buffer InRayStateQueue {
    RayState inStates[];
};

layout(std430, binding = 10) writeonly buffer OutRayStateQueue {
    RayState outStates[];
};

layout(std430, binding = 11) buffer QueueCountersBuffer {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint diffuseCount;
    uint dielectricCount;
    uint conductorCount;
    uint complexCount;
    uint emissiveCount;
    uint alphamaskCount;
    uint nextDiffuseCount;
    uint nextDielectricCount;
    uint nextConductorCount;
    uint nextComplexCount;
    uint nextEmissiveCount;
    uint nextAlphamaskCount;
    uint currentMaterialCounts[6];
    uint totalShadeWorkgroups;
    uint octantCounts[8];
    uint currentOctantCounts[8];
    uint totalIntersectWorkgroups;
    uint secondaryRayCount;
    uint activeMaterialSequenceCount;
    uint pad[20];
} queueCounters;

layout(std430, binding = 13) buffer IndirectCommand {
    DispatchCommand commands[];
} indirect;

layout(std430, binding = 14) buffer DGCStream {
    DGCCommand commands[];
} dgcStream;

layout(std430, binding = 15) readonly buffer InRayGeomQueue {
    RayGeometry inGeom[];
};

layout(std430, binding = 16) writeonly buffer OutRayGeomQueue {
    RayGeometry outGeoms[];
};

layout(std430, binding = 17) writeonly buffer OutRayHitQueue {
    RayHit outHits[];
};

layout(std430, binding = 18) writeonly buffer MaterialIndexQueue {
    uint materialIndices[];
};

layout(std430, binding = 19) readonly buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint width;
    uint height;
    uint currentBounce;
    uint maxBounces;
    uint maxQueueCapacity;
    uint sppSampleIndex;
    uint hasEnvMap;
    float envMapIntensity;
    uint useHardwareRT;
    uint sortMode;
    uint numOpaqueTriangles;
    uint secondarySortMode;
    uint octantBin;
    float maxRayDistance;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint activeCount = (pc.secondarySortMode == 1u) ? queueCounters.currentOctantCounts[pc.octantBin] : queueCounters.activeRayCount;
    bool inRange = (idx < activeCount);

    uint rayIdx = idx;
    if (pc.secondarySortMode == 1u) {
        if (inRange) {
            rayIdx = secondaryIndices[pc.octantBin * pc.maxQueueCapacity + idx];
        }
    }

    RayGeometry geom;
    if (inRange) {
        geom = inGeom[rayIdx];
    } else {
        geom.originPackedDir = vec4(0.0);
    }

    vec3 origin = geom.originPackedDir.xyz;
    vec3 direction = unpackOct32(floatBitsToUint(geom.originPackedDir.w));

    float closestT = (pc.maxRayDistance > 0.0) ? pc.maxRayDistance : 10000.0;
    int closestTri = -1;
    vec2 closestBary = vec2(0.0);
    int closestSphere = -1;
    mat4x3 hitW2o = mat4x3(1.0);
    mat4x3 hitO2w = mat4x3(1.0);
    uint hitInstMatOffset = 0u;

    if (inRange) {
        // Fixed-function hardware BVH traversal with zero shader ALU interrupts
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, EPSILON, direction, closestT);
        rayQueryProceedEXT(rq);

        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            closestT = rayQueryGetIntersectionTEXT(rq, true);
            uint instIdx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
            uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
            uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
            InstanceGPU inst = instances[instIdx];
            closestTri = int(inst.firstTriangle + ((geomIdx == 0u) ? primIdx : (primIdx + inst.numOpaqueTriangles)));
            closestBary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
            hitW2o = rayQueryGetIntersectionWorldToObjectEXT(rq, true);
            hitO2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
            hitInstMatOffset = inst.materialOffset;
        }

        // Procedural Spheres intersection test
        if (pc.numSpheres > 0u) {
            for (uint i = 0; i < pc.numSpheres; ++i) {
                float spT;
                vec3 spNorm;
                if (intersectSphere(origin, direction, spheres[i], EPSILON, closestT, spT, spNorm)) {
                    closestT = spT;
                    closestSphere = int(i);
                    closestTri = -1;
                }
            }
        }
    }

    RayHit hit;
    uint archetype = MATERIAL_ARCHETYPE_DIFFUSE;
    if (inRange) {
        if (closestTri >= 0) {
            Triangle tri = triangles[closestTri];
            vec3 localNormal = getTriangleNormal(tri, closestBary);
            vec3 hitNormal = normalize(transpose(mat3(hitW2o)) * localNormal);
            vec2 hitUv = getTriangleUV(tri, closestBary);

            uint matId = tri.materialId + hitInstMatOffset;
            archetype = (matId < pc.numMaterials) ? materialArchetypes[matId] : MATERIAL_ARCHETYPE_DIFFUSE;

            vec3 tanDir = vec3(1.0, 0.0, 0.0);
            float tanSign = 1.0;
            if (archetype == MATERIAL_ARCHETYPE_COMPLEX || archetype == MATERIAL_ARCHETYPE_CONDUCTOR || archetype == MATERIAL_ARCHETYPE_DIELECTRIC) {
                tanDir = getTriangleTangent(tri, closestBary);
                tanDir = normalize(mat3(hitO2w) * tanDir);
                tanSign = getTriangleTangentSign(tri);
            }

            hit = packRayHit(closestT, matId, 0u, hitNormal, hitUv, tanDir, tanSign);
        } else if (closestSphere >= 0) {
            vec3 hitNormal = (origin + closestT * direction - spheres[closestSphere].centerRadius.xyz) / spheres[closestSphere].centerRadius.w;
            uint matId = spheres[closestSphere].materialId;
            hit = packRayHit(closestT, matId, 1u, hitNormal, vec2(0.0), vec3(1.0, 0.0, 0.0), 1.0);
            archetype = (matId < pc.numMaterials) ? materialArchetypes[matId] : MATERIAL_ARCHETYPE_DIFFUSE;
        } else {
            hit = packRayHit(closestT, 0u, 2u, vec3(0.0, 1.0, 0.0), vec2(0.0), vec3(1.0, 0.0, 0.0), 1.0);
            archetype = MATERIAL_ARCHETYPE_DIFFUSE; // Miss radiance evaluated in diffuse microkernel
        }
    }

    // Store hit data for this ray into outHits[rayIdx]
    if (inRange) {
        outHits[rayIdx] = hit;
    }

    uint sourceIdx = rayIdx;
    if (pc.sortMode > 0u) {
        if (pc.sortMode == 3u) {
            // Technique D: 3D Spatial-Morton + Material Dual-Binning via Intra-Wave Bitonic Sort
            uint mortonCode = 0u;
            uint hitType = (floatBitsToUint(hit.hitData0.w) >> 16u) & 0x3u;
            if (inRange && hitType != 2u) {
                vec3 hitP = origin + hit.hitData0.x * direction;
                vec3 pNorm = fract((hitP * 0.1) + 0.5);
                uvec3 qPos = uvec3(clamp(pNorm * 1024.0, vec3(0.0), vec3(1023.0)));
                mortonCode = morton3D_10bit(qPos) & 0x0FFFu;
            }
            uint sortKey = inRange ? ((archetype << 12u) | mortonCode) : 0xFFFFu;
            uint sortedLane = gl_SubgroupInvocationID;

            uint lane = gl_SubgroupInvocationID;
            [[unroll]]
            for (uint k = 2u; k <= 32u; k <<= 1u) {
                [[unroll]]
                for (uint j = k >> 1u; j > 0u; j >>= 1u) {
                    uint partnerLane = lane ^ j;
                    uint partnerKey = subgroupShuffle(sortKey, partnerLane);
                    uint partnerLaneId = subgroupShuffle(sortedLane, partnerLane);

                    bool dir_asc = ((lane & k) == 0u);
                    bool shouldTakeMin = (lane < partnerLane) == dir_asc;
                    bool swap = shouldTakeMin ? (sortKey > partnerKey) : (sortKey < partnerKey);
                    if (swap) {
                        sortKey = partnerKey;
                        sortedLane = partnerLaneId;
                    }
                }
            }
            inRange = (sortKey != 0xFFFFu);
            archetype = (sortKey >> 12u) & 0xFu;
            sourceIdx = subgroupShuffle(rayIdx, sortedLane);
        }

        // Subgroup Ballot Multi-Queue Partitioning into Material Index Queue (4-byte indirection)
        for (uint k = 0u; k < 6u; ++k) {
            bool isMatch = (inRange && archetype == k);
            uvec4 matBallot = subgroupBallot(isMatch);
            uint matchCount = subgroupBallotBitCount(matBallot);

            if (matchCount > 0u) {
                uint laneSlot = subgroupBallotExclusiveBitCount(matBallot);
                uint leader = subgroupBallotFindLSB(matBallot);
                uint waveQueueBase = 0u;
                if (gl_SubgroupInvocationID == leader) {
                    if (k == 0u) waveQueueBase = atomicAdd(queueCounters.diffuseCount, matchCount);
                    else if (k == 1u) waveQueueBase = atomicAdd(queueCounters.dielectricCount, matchCount);
                    else if (k == 2u) waveQueueBase = atomicAdd(queueCounters.conductorCount, matchCount);
                    else if (k == 3u) waveQueueBase = atomicAdd(queueCounters.complexCount, matchCount);
                    else if (k == 4u) waveQueueBase = atomicAdd(queueCounters.emissiveCount, matchCount);
                    else if (k == 5u) waveQueueBase = atomicAdd(queueCounters.alphamaskCount, matchCount);
                }
                waveQueueBase = subgroupBroadcast(waveQueueBase, leader);

                if (isMatch) {
                    uint targetIdx = k * pc.maxQueueCapacity + (waveQueueBase + laneSlot);
                    if (waveQueueBase + laneSlot < pc.maxQueueCapacity) {
                        materialIndices[targetIdx] = sourceIdx;
                    }
                }
            }
        }
    }

    // Atomic workgroup retirement to prepare Bounce b+1 Shade dispatch directly
    memoryBarrierBuffer();
    if (gl_LocalInvocationIndex == 0u) {
        uint totalWgs = (pc.secondarySortMode == 1u) ? queueCounters.totalIntersectWorkgroups : gl_NumWorkGroups.x;
        uint retired = atomicAdd(queueCounters.retiredWorkgroups, 1u);
        if (retired == totalWgs - 1u) {
            uint b = pc.currentBounce;
            uint nextB = b + 1u;
            if (pc.sortMode > 0u && nextB < pc.maxBounces) {
                uint diffCnt = atomicExchange(queueCounters.diffuseCount, 0u);
                uint dielCnt = atomicExchange(queueCounters.dielectricCount, 0u);
                uint condCnt = atomicExchange(queueCounters.conductorCount, 0u);
                uint compCnt = atomicExchange(queueCounters.complexCount, 0u);
                uint emisCnt = atomicExchange(queueCounters.emissiveCount, 0u);
                uint passCnt = atomicExchange(queueCounters.alphamaskCount, 0u);

                queueCounters.currentMaterialCounts[0] = diffCnt;
                queueCounters.currentMaterialCounts[1] = dielCnt;
                queueCounters.currentMaterialCounts[2] = condCnt;
                queueCounters.currentMaterialCounts[3] = compCnt;
                queueCounters.currentMaterialCounts[4] = emisCnt;
                queueCounters.currentMaterialCounts[5] = passCnt;

                uint diffGroups = (diffCnt + 31u) / 32u;
                uint dielGroups = (dielCnt + 31u) / 32u;
                uint condGroups = (condCnt + 31u) / 32u;
                uint compGroups = (compCnt + 31u) / 32u;
                uint emisGroups = (emisCnt + 31u) / 32u;
                uint passGroups = (passCnt + 31u) / 32u;

                // Bounce nextB Shading Commands (Sequence 0..5)
                indirect.commands[nextB * 16u + 0u].x = diffGroups;
                indirect.commands[nextB * 16u + 0u].y = 1u;
                indirect.commands[nextB * 16u + 0u].z = 1u;
                indirect.commands[nextB * 16u + 0u].pad = diffCnt;

                indirect.commands[nextB * 16u + 1u].x = dielGroups;
                indirect.commands[nextB * 16u + 1u].y = 1u;
                indirect.commands[nextB * 16u + 1u].z = 1u;
                indirect.commands[nextB * 16u + 1u].pad = dielCnt;

                indirect.commands[nextB * 16u + 2u].x = condGroups;
                indirect.commands[nextB * 16u + 2u].y = 1u;
                indirect.commands[nextB * 16u + 2u].z = 1u;
                indirect.commands[nextB * 16u + 2u].pad = condCnt;

                indirect.commands[nextB * 16u + 3u].x = compGroups;
                indirect.commands[nextB * 16u + 3u].y = 1u;
                indirect.commands[nextB * 16u + 3u].z = 1u;
                indirect.commands[nextB * 16u + 3u].pad = compCnt;

                indirect.commands[nextB * 16u + 4u].x = emisGroups;
                indirect.commands[nextB * 16u + 4u].y = 1u;
                indirect.commands[nextB * 16u + 4u].z = 1u;
                indirect.commands[nextB * 16u + 4u].pad = emisCnt;

                indirect.commands[nextB * 16u + 5u].x = passGroups;
                indirect.commands[nextB * 16u + 5u].y = 1u;
                indirect.commands[nextB * 16u + 5u].z = 1u;
                indirect.commands[nextB * 16u + 5u].pad = passCnt;

                dgcStream.commands[nextB * 16u + 0u].pipelineIndex = 0u; // Diffuse
                dgcStream.commands[nextB * 16u + 0u].x = diffGroups;
                dgcStream.commands[nextB * 16u + 0u].y = 1u;
                dgcStream.commands[nextB * 16u + 0u].z = 1u;

                dgcStream.commands[nextB * 16u + 1u].pipelineIndex = 1u; // Dielectric
                dgcStream.commands[nextB * 16u + 1u].x = dielGroups;
                dgcStream.commands[nextB * 16u + 1u].y = 1u;
                dgcStream.commands[nextB * 16u + 1u].z = 1u;

                dgcStream.commands[nextB * 16u + 2u].pipelineIndex = 2u; // Conductor
                dgcStream.commands[nextB * 16u + 2u].x = condGroups;
                dgcStream.commands[nextB * 16u + 2u].y = 1u;
                dgcStream.commands[nextB * 16u + 2u].z = 1u;

                dgcStream.commands[nextB * 16u + 3u].pipelineIndex = 3u; // Complex
                dgcStream.commands[nextB * 16u + 3u].x = compGroups;
                dgcStream.commands[nextB * 16u + 3u].y = 1u;
                dgcStream.commands[nextB * 16u + 3u].z = 1u;

                dgcStream.commands[nextB * 16u + 4u].pipelineIndex = 4u; // Emissive
                dgcStream.commands[nextB * 16u + 4u].x = emisGroups;
                dgcStream.commands[nextB * 16u + 4u].y = 1u;
                dgcStream.commands[nextB * 16u + 4u].z = 1u;

                dgcStream.commands[nextB * 16u + 5u].pipelineIndex = 5u; // AlphaMask
                dgcStream.commands[nextB * 16u + 5u].x = passGroups;
                dgcStream.commands[nextB * 16u + 5u].y = 1u;
                dgcStream.commands[nextB * 16u + 5u].z = 1u;

                uint totalShadeWgs = diffGroups + dielGroups + condGroups + compGroups + emisGroups + passGroups;
                queueCounters.totalShadeWorkgroups = totalShadeWgs;
                queueCounters.activeMaterialSequenceCount = (totalShadeWgs > 0u) ? 6u : 0u;

                if (totalShadeWgs == 0u) {
                    indirect.commands[nextB * 16u + 6u].x = 0u;
                    indirect.commands[nextB * 16u + 7u].x = 0u;
                    for (uint k = 0u; k < 8u; ++k) {
                        indirect.commands[nextB * 16u + 8u + k].x = 0u;
                    }
                    for (uint c = 0u; c < 6u; ++c) {
                        dgcStream.commands[nextB * 16u + c].x = 0u;
                    }
                }
            }

            queueCounters.currentShadowCount = 0u;
            queueCounters.nextActiveCount = 0u;
            queueCounters.shadowRayCount = 0u;
            queueCounters.retiredWorkgroups = 0u;
        }
    }
}
