#version 460 core

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : enable

#include "upways_common_v3.glsl"

// Workgroup: Exactly 32 threads = 1x Wave32 wavefront on AMD RDNA 4 (gfx1201)
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

const uint TILE_M = 16u; // 16 display pixels processed per Wave32 workgroup

// =========================================================================
// Descriptors: Pass 1 Latents & Display-Resolution Guides
// =========================================================================
layout(set = 0, binding = 0) uniform sampler2D uTemporalLatentDiff;
layout(set = 0, binding = 1) uniform sampler2D uTemporalLatentSpec;
layout(set = 0, binding = 2, r16f) uniform readonly image2D uReliabilityMap;

layout(set = 0, binding = 3, rgba16f) uniform readonly image2D uDisplayAlbedo;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D uOutputImage;

layout(set = 0, binding = 5, std430) readonly buffer WeightsBuffer {
    float16_t weights[];
} u_Weights;

// Push Constants: Exact 256-byte Uniforms Block
layout(push_constant) uniform Uniforms {
    mat4  u_CurrInvView;       // 0..63: View to World
    mat4  u_PrevViewProj;      // 64..127: World to Previous Clip
    mat4  u_InvProj;           // 128..191: Clip to View
    vec4  u_PrevViewZ;         // 192..207: Row 2 of PrevView for axial depth
    vec2  u_JitterOffset;      // 208..215: Subpixel camera jitter in render pixels
    uvec2 u_RenderRes;         // 216..223: Render resolution (e.g. 960, 540)
    uvec2 u_DisplayRes;        // 224..231: Display resolution (e.g. 1920, 1080)
    vec2  u_ScaleFactor;       // 232..239: DisplayRes / RenderRes (e.g. 2.0, 2.0)
    uint  u_ResetHistory;      // 240..243: History reset flag
    uint  u_FrameIndex;        // 244..247: Temporal frame index
    float u_InvTotalSamples;   // 248..251: 1.0 / totalSamples
    uint  u_TotalSamples;      // 252..255: SPP count
};

// =========================================================================
// Dual MLP Head Layer Offsets (Elements in weights[])
// Layout: Diffuse Head (FC1, FC2, FC3) -> Specular Head (FC1, FC2, FC3)
// =========================================================================
const uint DIFF_FC1_WEIGHT_ELEM = 0u;     // 16x64: 1024 elems
const uint DIFF_FC1_BIAS_ELEM   = 1024u;  // 64 elems
const uint DIFF_FC2_WEIGHT_ELEM = 1088u;  // 64x64: 4096 elems
const uint DIFF_FC2_BIAS_ELEM   = 5184u;  // 64 elems
const uint DIFF_FC3_WEIGHT_ELEM = 5248u;  // 64x16: 1024 elems
const uint DIFF_FC3_BIAS_ELEM   = 6272u;  // 16 elems

const uint SPEC_OFFSET_BASE     = 6288u;  // Specular head offset
const uint SPEC_FC1_WEIGHT_ELEM = SPEC_OFFSET_BASE + 0u;    // 16x64: 1024 elems
const uint SPEC_FC1_BIAS_ELEM   = SPEC_OFFSET_BASE + 1024u; // 64 elems
const uint SPEC_FC2_WEIGHT_ELEM = SPEC_OFFSET_BASE + 1088u; // 64x64: 4096 elems
const uint SPEC_FC2_BIAS_ELEM   = SPEC_OFFSET_BASE + 5184u; // 64 elems
const uint SPEC_FC3_WEIGHT_ELEM = SPEC_OFFSET_BASE + 5248u; // 64x16: 1024 elems
const uint SPEC_FC3_BIAS_ELEM   = SPEC_OFFSET_BASE + 6272u; // 16 elems

// =========================================================================
// SHARED MEMORY (LDS Footprint: 7,168 bytes <= 32 KB)
// =========================================================================
shared float16_t s_diff_in[16 * 16]; // 512 bytes
shared float16_t s_spec_in[16 * 16]; // 512 bytes
shared float16_t s_fc1_out[16 * 64]; // 2,048 bytes
shared float16_t s_fc2_out[16 * 64]; // 2,048 bytes
shared float     s_acc[16 * 16];     // 1,024 bytes
shared ivec2     s_pixelCoords[16];  // 128 bytes
shared vec3      s_dispAlbedo[16];   // 192 bytes
shared vec3      s_decodedDiff[16];  // 192 bytes

void main() {
    uint pixelBase = gl_WorkGroupID.x * TILE_M;
    uint totalPixels = u_DisplayRes.x * u_DisplayRes.y;
    if (pixelBase >= totalPixels) return;

    uint tid = gl_LocalInvocationIndex; // 0..31

    // Step 1: Ingest Subpixel Coordinates & Pass 1 Latents (16 Pixels per Tile)
    if (tid < 16u) {
        uint pIdx = pixelBase + tid;
        if (pIdx < totalPixels) {
            int outY = int(pIdx / u_DisplayRes.x);
            int outX = int(pIdx % u_DisplayRes.x);
            ivec2 outCoord = ivec2(outX, outY);
            s_pixelCoords[tid] = outCoord;

            // Continuous subpixel coordinate mapping
            vec2 uv = (vec2(outCoord) + vec2(0.5)) / vec2(u_DisplayRes);
            vec2 renderCoord = (vec2(outCoord) + vec2(0.5)) / u_ScaleFactor - vec2(0.5) - u_JitterOffset;
            vec2 renderUV = (renderCoord + vec2(0.5)) / vec2(u_RenderRes);

            // Bilinear sampling of Pass 1 latents
            vec4 diffLatent = texture(uTemporalLatentDiff, renderUV);
            vec4 specLatent = texture(uTemporalLatentSpec, renderUV);
            vec4 albedoSample = imageLoad(uDisplayAlbedo, outCoord);

            s_dispAlbedo[tid] = albedoSample.rgb;

            // FiLM scale modulation: predict gamma & beta from continuous scale factor
            float sx = u_ScaleFactor.x;
            float sy = u_ScaleFactor.y;
            float filmGamma = clamp((sx + sy) * 0.25 - 0.5, -0.5, 1.0);
            float filmBeta  = 0.0;

            // Stage 16 channels for Diffuse MLP
            for (uint c = 0u; c < 16u; ++c) {
                float val = (c < 4u) ? diffLatent[c] : 0.0;
                val = val * (1.0 + filmGamma) + filmBeta;
                s_diff_in[tid * 16u + c] = float16_t(val);
            }

            // Stage 16 channels for Specular MLP
            for (uint c = 0u; c < 16u; ++c) {
                float val = (c < 4u) ? specLatent[c] : 0.0;
                val = val * (1.0 + filmGamma) + filmBeta;
                s_spec_in[tid * 16u + c] = float16_t(val);
            }
        } else {
            s_pixelCoords[tid] = ivec2(-1);
            for (uint c = 0u; c < 16u; ++c) {
                s_diff_in[tid * 16u + c] = float16_t(0.0);
                s_spec_in[tid * 16u + c] = float16_t(0.0);
            }
        }
    }
    barrier();

    // =========================================================================
    // Step 2: Evaluate Diffuse MLP Head (16 -> 64 -> 64 -> 16)
    // =========================================================================
    // LAYER 1: FC1 (16 -> 64)
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matDiffIn;
    coopMatLoad(matDiffIn, s_diff_in, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);

    for (uint n = 0u; n < 4u; ++n) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
        acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> wTile;
        uint w_offset = DIFF_FC1_WEIGHT_ELEM + n * 256u;
        coopMatLoad(wTile, u_Weights.weights, w_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(matDiffIn, wTile, acc);

        coopMatStore(acc, s_acc, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        for (uint idx = tid; idx < 256u; idx += 32u) {
            uint r = idx / 16u;
            uint c = idx % 16u;
            float val = s_acc[idx] + float(u_Weights.weights[DIFF_FC1_BIAS_ELEM + n * 16u + c]);
            val = (val >= 0.0) ? val : (val * 0.1); // LeakyReLU(0.1)
            s_fc1_out[r * 64u + n * 16u + c] = float16_t(clamp(val, -65000.0, 65000.0));
        }
        barrier();
    }

    // LAYER 2: FC2 (64 -> 64)
    for (uint n = 0u; n < 4u; ++n) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
        acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        for (uint k = 0u; k < 4u; ++k) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> inTile;
            coopMatLoad(inTile, s_fc1_out, k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> wTile;
            uint w_offset = DIFF_FC2_WEIGHT_ELEM + (k * 4u + n) * 256u;
            coopMatLoad(wTile, u_Weights.weights, w_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(inTile, wTile, acc);
        }

        coopMatStore(acc, s_acc, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        for (uint idx = tid; idx < 256u; idx += 32u) {
            uint r = idx / 16u;
            uint c = idx % 16u;
            float val = s_acc[idx] + float(u_Weights.weights[DIFF_FC2_BIAS_ELEM + n * 16u + c]);
            val = (val >= 0.0) ? val : (val * 0.1); // LeakyReLU(0.1)
            s_fc2_out[r * 64u + n * 16u + c] = float16_t(clamp(val, -65000.0, 65000.0));
        }
        barrier();
    }

    // LAYER 3: FC3 (64 -> 16)
    {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
        acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        for (uint k = 0u; k < 4u; ++k) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> inTile;
            coopMatLoad(inTile, s_fc2_out, k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> wTile;
            uint w_offset = DIFF_FC3_WEIGHT_ELEM + k * 256u;
            coopMatLoad(wTile, u_Weights.weights, w_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(inTile, wTile, acc);
        }

        coopMatStore(acc, s_acc, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        if (tid < 16u) {
            float r = max(s_acc[tid * 16u + 0u] + float(u_Weights.weights[DIFF_FC3_BIAS_ELEM + 0u]), 0.0);
            float g = max(s_acc[tid * 16u + 1u] + float(u_Weights.weights[DIFF_FC3_BIAS_ELEM + 1u]), 0.0);
            float b = max(s_acc[tid * 16u + 2u] + float(u_Weights.weights[DIFF_FC3_BIAS_ELEM + 2u]), 0.0);
            s_decodedDiff[tid] = vec3(r, g, b);
        }
        barrier();
    }

    // =========================================================================
    // Step 3: Evaluate Specular MLP Head (16 -> 64 -> 64 -> 16)
    // =========================================================================
    // LAYER 1: FC1 (16 -> 64)
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matSpecIn;
    coopMatLoad(matSpecIn, s_spec_in, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);

    for (uint n = 0u; n < 4u; ++n) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
        acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> wTile;
        uint w_offset = SPEC_FC1_WEIGHT_ELEM + n * 256u;
        coopMatLoad(wTile, u_Weights.weights, w_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(matSpecIn, wTile, acc);

        coopMatStore(acc, s_acc, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        for (uint idx = tid; idx < 256u; idx += 32u) {
            uint r = idx / 16u;
            uint c = idx % 16u;
            float val = s_acc[idx] + float(u_Weights.weights[SPEC_FC1_BIAS_ELEM + n * 16u + c]);
            val = (val >= 0.0) ? val : (val * 0.1); // LeakyReLU(0.1)
            s_fc1_out[r * 64u + n * 16u + c] = float16_t(clamp(val, -65000.0, 65000.0));
        }
        barrier();
    }

    // LAYER 2: FC2 (64 -> 64)
    for (uint n = 0u; n < 4u; ++n) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
        acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        for (uint k = 0u; k < 4u; ++k) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> inTile;
            coopMatLoad(inTile, s_fc1_out, k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> wTile;
            uint w_offset = SPEC_FC2_WEIGHT_ELEM + (k * 4u + n) * 256u;
            coopMatLoad(wTile, u_Weights.weights, w_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(inTile, wTile, acc);
        }

        coopMatStore(acc, s_acc, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        for (uint idx = tid; idx < 256u; idx += 32u) {
            uint r = idx / 16u;
            uint c = idx % 16u;
            float val = s_acc[idx] + float(u_Weights.weights[SPEC_FC2_BIAS_ELEM + n * 16u + c]);
            val = (val >= 0.0) ? val : (val * 0.1); // LeakyReLU(0.1)
            s_fc2_out[r * 64u + n * 16u + c] = float16_t(clamp(val, -65000.0, 65000.0));
        }
        barrier();
    }

    // LAYER 3: FC3 (64 -> 16) & Native Albedo Re-modulation
    {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc;
        acc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

        for (uint k = 0u; k < 4u; ++k) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> inTile;
            coopMatLoad(inTile, s_fc2_out, k * 16u, 64u, gl_CooperativeMatrixLayoutRowMajor);

            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> wTile;
            uint w_offset = SPEC_FC3_WEIGHT_ELEM + k * 256u;
            coopMatLoad(wTile, u_Weights.weights, w_offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
            acc = coopMatMulAdd(inTile, wTile, acc);
        }

        coopMatStore(acc, s_acc, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        if (tid < 16u) {
            ivec2 outCoord = s_pixelCoords[tid];
            if (outCoord.x >= 0) {
                float specR = max(s_acc[tid * 16u + 0u] + float(u_Weights.weights[SPEC_FC3_BIAS_ELEM + 0u]), 0.0);
                float specG = max(s_acc[tid * 16u + 1u] + float(u_Weights.weights[SPEC_FC3_BIAS_ELEM + 1u]), 0.0);
                float specB = max(s_acc[tid * 16u + 2u] + float(u_Weights.weights[SPEC_FC3_BIAS_ELEM + 2u]), 0.0);
                vec3 decodedSpec = vec3(specR, specG, specB);

                vec3 decodedDiff = s_decodedDiff[tid];
                vec3 displayAlbedo = s_dispAlbedo[tid];

                // Native Albedo Re-modulation
                vec3 logComposite = decodedDiff * displayAlbedo + decodedSpec;

                // Clamped Inverse Log Transform yielding HDR Radiance
                vec3 finalHdr = upwaysInverseLogTransform(logComposite);

                imageStore(uOutputImage, outCoord, vec4(finalHdr, 1.0));
            }
        }
    }
}
