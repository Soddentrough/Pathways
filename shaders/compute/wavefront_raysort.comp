#version 460
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#include "wavefront_common.glsl"

layout(local_size_x = 32) in;

layout(std430, binding = 11) readonly buffer QueueCountersBuffer {
    uint activeRayCount;
    uint nextActiveCount;
    uint totalProcessed;
    uint shadowRayCount;
    uint retiredWorkgroups;
    uint currentShadowCount;
    uint diffuseCount;
    uint dielectricCount;
    uint conductorCount;
    uint complexCount;
    uint emissiveCount;
    uint alphamaskCount;
    uint nextDiffuseCount;
    uint nextDielectricCount;
    uint nextConductorCount;
    uint nextComplexCount;
    uint nextEmissiveCount;
    uint nextAlphamaskCount;
    uint currentMaterialCounts[6];
    uint totalShadeWorkgroups;
    uint octantCounts[8];
    uint currentOctantCounts[8];
    uint totalIntersectWorkgroups;
    uint secondaryRayCount;
    uint activeMaterialSequenceCount;
    uint pad[20];
} queueCounters;

layout(std430, binding = 15) readonly buffer InRayGeomQueue {
    RayGeometry inGeoms[];
};

layout(std430, binding = 19) buffer SecondaryIndexQueue {
    uint secondaryIndices[];
};

layout(push_constant) uniform PushConstants {
    vec4 boundsMin;    // xyz: scene min, w: pass (0 = histogram, 1 = prefix, 2 = scatter)
    vec4 boundsExtent; // xyz: scene extent (max - min), w: maxQueueCapacity
} pc;

uint computeRayBin(vec3 origin, vec3 dir) {
    vec3 extent = max(pc.boundsExtent.xyz, vec3(1e-4));
    vec3 p = clamp((origin - pc.boundsMin.xyz) / extent, vec3(0.0), vec3(0.9999));
    uvec3 cell = uvec3(p * 4.0); // 4x4x4 spatial grid = 64 cells
    uint spatialId = cell.x + (cell.y << 2u) + (cell.z << 4u); // 0..63
    uint octant = getDirectionalOctant(dir); // 0..7
    return (spatialId << 3u) | octant; // 0..511 (512 bins total)
}

void main() {
    uint passId = uint(round(pc.boundsMin.w));
    uint maxCap = uint(round(pc.boundsExtent.w));
    uint countBase = maxCap;
    uint curOffsetBase = maxCap + 512u;

    if (passId == 1u) {
        // Pass 1: Single Wave32 Prefix Sum over 512 bins (100% in registers, zero LDS, zero barriers)
        if (gl_WorkGroupID.x > 0u || queueCounters.activeRayCount == 0u) return;
        uint lane = gl_SubgroupInvocationID; // 0..31
        
        // Each lane handles 16 consecutive bins
        uint laneSum = 0u;
        [[unroll]]
        for (uint i = 0u; i < 16u; ++i) {
            laneSum += secondaryIndices[countBase + lane * 16u + i];
        }

        uint wavePrefix = subgroupExclusiveAdd(laneSum);

        uint running = wavePrefix;
        [[unroll]]
        for (uint i = 0u; i < 16u; ++i) {
            uint bIdx = lane * 16u + i;
            uint cnt = secondaryIndices[countBase + bIdx];
            secondaryIndices[curOffsetBase + bIdx] = running;
            secondaryIndices[countBase + bIdx] = 0u; // Reset histogram for next bounce
            running += cnt;
        }
        return;
    }

    // Pass 0 (Histogram) and Pass 2 (Scatter)
    uint count = queueCounters.activeRayCount;
    uint gIdx = gl_GlobalInvocationID.x;
    bool inRange = (gIdx < count);

    uint myBin = 0u;
    if (inRange) {
        RayGeometry geom = inGeoms[gIdx];
        vec3 origin = geom.originPackedDir.xyz;
        vec3 dir = unpackOct32(floatBitsToUint(geom.originPackedDir.w));
        myBin = computeRayBin(origin, dir);
    }

    // Subgroup ballot aggregation across the wave (Wave32 and Wave64 safe)
    uvec4 inRangeBallot = subgroupBallot(inRange);
    for (uint w = 0u; w < 2u; ++w) {
        uint activeLanes = (w == 0u) ? inRangeBallot.x : inRangeBallot.y;
        while (activeLanes != 0u) {
            uint leader = w * 32u + findLSB(activeLanes);
            uint targetBin = subgroupShuffle(myBin, leader);
            bool match = (inRange && myBin == targetBin);
            uvec4 matchBallot = subgroupBallot(match);
            uint waveCount = subgroupBallotBitCount(matchBallot);
            uint laneSlot = subgroupBallotExclusiveBitCount(matchBallot);

            if (passId == 0u) {
                // Pass 0: Add wave total to bin counter
                if (gl_SubgroupInvocationID == leader) {
                    atomicAdd(secondaryIndices[countBase + targetBin], waveCount);
                }
            } else {
                // Pass 2: Scatter ray index into compacted bin segment
                uint base = 0u;
                if (gl_SubgroupInvocationID == leader) {
                    base = atomicAdd(secondaryIndices[curOffsetBase + targetBin], waveCount);
                }
                base = subgroupShuffle(base, leader);
                if (match) {
                    uint dest = base + laneSlot;
                    secondaryIndices[dest] = gIdx;
                }
            }

            activeLanes &= ~((w == 0u) ? matchBallot.x : matchBallot.y);
        }
    }
}
