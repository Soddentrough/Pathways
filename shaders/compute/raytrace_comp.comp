#version 460
#extension GL_EXT_ray_query : enable
#extension GL_EXT_shader_image_load_formatted : require

layout(local_size_x = 8, local_size_y = 4) in;

// Output linear accumulation buffer
layout(binding = 0) uniform image2D uAccumImage;

// Uniform buffer for camera & rendering settings
layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    vec4 position;
    vec4 viewParams; // x: fov, y: aspect, z: near, w: far
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;      // bit 0: direct, 1: indirect, 2: specular, 3: refraction, 4: shadows
} ubo;

// Scene structures
struct Vertex {
    vec4 position; // xyz: pos, w: u
    vec4 normal;   // xyz: norm, w: v
    vec4 tangent;  // xyz: tangent, w: sign
};

struct Triangle {
    Vertex v0;
    Vertex v1;
    Vertex v2;
    uint materialId;
    uint padding[3];
};

struct Sphere {
    vec4 centerRadius; // xyz: center, w: radius
    uint materialId;
    uint padding[3];
};

struct Material {
    vec4 albedo;
    vec4 emissive;
    float roughness;
    float metallic;
    float ior;
    float transmission;
    uint type; // 0: diffuse, 1: metallic, 2: dielectric, 3: emissive
    uint albedoTex;
    uint normalTex;
    uint mrTex;
    uint emissiveTex;
    uint occlusionTex;
    uint transmissionTex;
    float alphaCutoff;
    uint alphaMode;
    float occlusionStrength;
    float normalScale;
    uint thicknessTex;

    // Extended glTF 2.0 PBR Properties (offsets 96-144)
    vec4 attenuationColor;
    float clearcoat;
    float clearcoatRoughness;
    uint clearcoatTex;
    uint clearcoatRoughnessTex;
    uint clearcoatNormalTex;
    float thickness;
    float specularFactor;
    uint specularTex;

    // Tier 2 glTF Extensions (offsets 144-192)
    float anisotropyStrength;
    float anisotropyRotation;
    uint anisotropyTex;
    float dispersion;
    vec3 sheenColor;
    float sheenRoughness;
    float iridescence;
    float iridescenceIor;
    float iridescenceThickness;
    uint sheenTex;
};

struct Light {
    vec4 position; // xyz: pos/corner, w: type (0: area, 1: spot)
    vec4 emission; // rgb: color, w: area
    vec4 u;        // xyz: edge1, w: spot inner cos
    vec4 v;        // xyz: edge2, w: spot outer cos
    vec4 normal;   // xyz: normal/dir, w: padding
    vec4 sampling; // x: q, y: aliasIdx, z: pdf, w: flux
};

layout(std430, binding = 2) readonly buffer TrianglesBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer SpheresBuffer {
    Sphere spheres[];
};

layout(std430, binding = 4) readonly buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 5) readonly buffer LightsBuffer {
    Light lights[];
};

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;
layout(binding = 7) uniform sampler2D environmentMap;
layout(binding = 8) uniform sampler2D sceneTextures[512];

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint tileOffsetX;
    uint tileOffsetY;
    uint tileWidth;
    uint tileHeight;
    uint useHardwareRT; // 1: hardware RT via VK_KHR_ray_query, 0: software/LDS
    uint hasEnvMap;
    float envMapIntensity;
    uint accumulateHistory; // 1: accumulate with history, 0: overwrite accum buffer (per-frame fresh)
    uint numOpaqueTriangles;
} pc;

#define PI 3.14159265358979323846
#define TWO_PI 6.28318530717958647692
#define INV_PI 0.31830988618379067154
#define EPSILON 0.0005

vec2 directionToEquirectangular(vec3 dir) {
    float phi = atan(dir.z, dir.x);
    float theta = acos(clamp(dir.y, -1.0, 1.0));
    return vec2((phi + PI) / TWO_PI, theta / PI);
}

// PCG Random Number Generator
uint pcg_hash(inout uint seed) {
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return (word >> 22u) ^ word;
}

float randFloat(inout uint seed) {
    return float(pcg_hash(seed)) / 4294967296.0;
}

vec2 randVec2(inout uint seed) {
    return vec2(randFloat(seed), randFloat(seed));
}

vec3 randVec3(inout uint seed) {
    return vec3(randFloat(seed), randFloat(seed), randFloat(seed));
}

vec3 addFp16Stochastic(vec3 accum, vec3 val, inout uint seed) {
    if (dot(val, val) < 1e-12) return accum;
    uvec3 bits = floatBitsToUint(max(accum, vec3(1e-4)));
    vec3 ulp = uintBitsToFloat((bits & 0x7F800000u) - (10u << 23));
    vec3 dither = (randVec3(seed) - vec3(0.5)) * ulp;
    return max(vec3(0.0), accum + val + dither);
}

// Ray structure
struct Ray {
    vec3 origin;
    vec3 direction;
};

struct HitInfo {
    bool hit;
    float t;
    vec3 point;
    vec3 normal;
    vec2 uv;
    uint materialId;
    bool frontFace;
};



// Fallback Global Memory Sphere Intersection
bool intersectSphere(Ray ray, Sphere sphere, float tMin, float tMax, out HitInfo hit) {
    vec3 oc = ray.origin - sphere.centerRadius.xyz;
    float radius = sphere.centerRadius.w;
    float a = dot(ray.direction, ray.direction);
    float halfB = dot(oc, ray.direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = halfB * halfB - a * c;

    if (discriminant < 0.0) return false;
    float sqrtd = sqrt(discriminant);

    float root = (-halfB - sqrtd) / a;
    if (root < tMin || root > tMax) {
        root = (-halfB + sqrtd) / a;
        if (root < tMin || root > tMax) return false;
    }

    hit.hit = true;
    hit.t = root;
    hit.point = ray.origin + root * ray.direction;
    vec3 outwardNormal = (hit.point - sphere.centerRadius.xyz) / radius;
    hit.frontFace = dot(ray.direction, outwardNormal) < 0.0;
    hit.normal = hit.frontFace ? outwardNormal : -outwardNormal;
    hit.materialId = sphere.materialId;
    hit.uv = vec2(0.0);

    return true;
}

// Scene ray traversal (closest hit) - Scalarly optimized for minimal VGPR register pressure
bool traceScene(Ray ray, float tMin, float tMax, out HitInfo closestHit) {
    closestHit.hit = false;
    closestHit.t = tMax;
    float closestT = tMax;
    int closestTri = -1;
    vec2 closestUv = vec2(0.0);
    int closestSphere = -1;

    // Hardware BVH Traversal on AMD RDNA4 Ray Accelerators with Alpha Mask Testing
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS,
                         gl_RayFlagsNoneEXT,
                         0xFF,
                         ray.origin,
                         tMin,
                         ray.direction,
                         closestT);

    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, false);
            uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            uint triIdx = (geomIdx == 0u) ? primIdx : (primIdx + pc.numOpaqueTriangles);
            Material candMat = materials[triangles[triIdx].materialId];
            if (candMat.alphaMode == 1u /* MASK */) {
                vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                float cu = bary.x, cv = bary.y, cw = 1.0 - cu - cv;
                Triangle ctri = triangles[triIdx];
                vec2 cuv = cw * vec2(ctri.v0.position.w, ctri.v0.normal.w) +
                           cu * vec2(ctri.v1.position.w, ctri.v1.normal.w) +
                           cv * vec2(ctri.v2.position.w, ctri.v2.normal.w);
                float calpha = candMat.albedo.a;
                if (candMat.albedoTex > 0u && candMat.albedoTex <= 512u) {
                    calpha *= texture(sceneTextures[candMat.albedoTex - 1u], cuv).a;
                }
                if (calpha < candMat.alphaCutoff) {
                    continue; // Skip transparent pixel
                }
            }
            rayQueryConfirmIntersectionEXT(rq);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        float t = rayQueryGetIntersectionTEXT(rq, true);
        uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
        uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        uint triIdx = (geomIdx == 0u) ? primIdx : (primIdx + pc.numOpaqueTriangles);
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);

        closestT = t;
        closestTri = int(triIdx);
        closestUv = bary;
    }

    // Test procedural spheres if any exist
    for (uint i = 0; i < pc.numSpheres; ++i) {
        HitInfo spHit;
        if (intersectSphere(ray, spheres[i], tMin, closestT, spHit)) {
            closestT = spHit.t;
            closestSphere = int(i);
            closestTri = -1;
        }
    }

    if (closestTri >= 0) {
        closestHit.hit = true;
        closestHit.t = closestT;
        closestHit.point = ray.origin + closestT * ray.direction;

        Triangle tri = triangles[closestTri];
        float u = closestUv.x;
        float v = closestUv.y;
        float w = 1.0 - u - v;

        vec3 n0 = tri.v0.normal.xyz;
        vec3 n1 = tri.v1.normal.xyz;
        vec3 n2 = tri.v2.normal.xyz;
        vec3 normal = normalize(w * n0 + u * n1 + v * n2);

        closestHit.frontFace = dot(ray.direction, normal) < 0.0;
        normal = closestHit.frontFace ? normal : -normal;

        vec2 uv0 = vec2(tri.v0.position.w, tri.v0.normal.w);
        vec2 uv1 = vec2(tri.v1.position.w, tri.v1.normal.w);
        vec2 uv2 = vec2(tri.v2.position.w, tri.v2.normal.w);
        closestHit.uv = w * uv0 + u * uv1 + v * uv2;
        closestHit.materialId = tri.materialId;

        Material hitMat = materials[tri.materialId];
        if (hitMat.normalTex > 0u && hitMat.normalTex <= 512u) {
            vec4 tan0 = tri.v0.tangent;
            vec4 tan1 = tri.v1.tangent;
            vec4 tan2 = tri.v2.tangent;
            vec3 geomTan = normalize(w * tan0.xyz + u * tan1.xyz + v * tan2.xyz);
            float tanSign = tan0.w != 0.0 ? tan0.w : 1.0;

            vec3 normalMap = texture(sceneTextures[hitMat.normalTex - 1u], closestHit.uv).rgb * 2.0 - 1.0;
            normalMap.xy *= hitMat.normalScale;
            normalMap = normalize(normalMap);

            geomTan = normalize(geomTan - dot(geomTan, normal) * normal);
            vec3 geomBitangent = cross(normal, geomTan) * tanSign;
            mat3 tbn = mat3(geomTan, geomBitangent, normal);
            normal = normalize(tbn * normalMap);
        }
        closestHit.normal = normal;
        return true;
    } else if (closestSphere >= 0) {
        closestHit.hit = true;
        closestHit.t = closestT;
        closestHit.point = ray.origin + closestT * ray.direction;
        vec4 cr = spheres[closestSphere].centerRadius;
        vec3 outwardNormal = (closestHit.point - cr.xyz) / cr.w;
        closestHit.frontFace = dot(ray.direction, outwardNormal) < 0.0;
        closestHit.normal = closestHit.frontFace ? outwardNormal : -outwardNormal;
        closestHit.uv = vec2(0.0);
        closestHit.materialId = spheres[closestSphere].materialId;
        return true;
    }
    return false;

    return closestHit.hit;
}

// Any-Hit Occlusion Shadow Ray Test (Early Exit on first non-emissive intersection)
bool isShadowOccluded(Ray ray, float tMin, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS,
                         gl_RayFlagsNoneEXT,
                         0xFF,
                         ray.origin,
                         tMin,
                         ray.direction,
                         tMax);

    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, false);
            uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            uint triIdx = (geomIdx == 0u) ? primIdx : (primIdx + pc.numOpaqueTriangles);
            Material mat = materials[triangles[triIdx].materialId];
            if (mat.type == 3 /* EMISSIVE */) {
                continue;
            }
            if (mat.alphaMode == 1u /* MASK */) {
                vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
                float u = bary.x, v = bary.y, w = 1.0 - u - v;
                Triangle tri = triangles[triIdx];
                vec2 uv = w * vec2(tri.v0.position.w, tri.v0.normal.w) +
                          u * vec2(tri.v1.position.w, tri.v1.normal.w) +
                          v * vec2(tri.v2.position.w, tri.v2.normal.w);
                float alpha = mat.albedo.a;
                if (mat.albedoTex > 0u && mat.albedoTex <= 512u) {
                    alpha *= texture(sceneTextures[mat.albedoTex - 1u], uv).a;
                }
                if (alpha < mat.alphaCutoff) {
                    continue; // Skip transparent pixel
                }
            }
            rayQueryConfirmIntersectionEXT(rq);
            rayQueryTerminateEXT(rq);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        uint geomIdx = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
        uint primIdx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        uint triIdx = (geomIdx == 0u) ? primIdx : (primIdx + pc.numOpaqueTriangles);
        if (materials[triangles[triIdx].materialId].type != 3) {
            return true;
        }
    }

    for (uint i = 0; i < pc.numSpheres; ++i) {
        if (materials[spheres[i].materialId].type == 3) continue;
        HitInfo tempHit;
        if (intersectSphere(ray, spheres[i], tMin, tMax, tempHit)) {
            return true;
        }
    }
    return false;
}

// Cosine-weighted hemisphere sampling
vec3 sampleCosineHemisphere(vec3 normal, inout uint seed) {
    vec2 r = randVec2(seed);
    float phi = TWO_PI * r.x;
    float cosTheta = sqrt(r.y);
    float sinTheta = sqrt(1.0 - r.y);

    vec3 tangent = abs(normal.x) > 0.1 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    tangent = normalize(cross(normal, tangent));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * (cos(phi) * sinTheta) +
                     bitangent * (sin(phi) * sinTheta) +
                     normal * cosTheta);
}

// Schlick's approximation for Fresnel reflectance
float fresnelSchlick(float cosTheta, float refIdx) {
    float r0 = (1.0 - refIdx) / (1.0 + refIdx);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// Fresnel-Schlick approximation with vector F0 (Cook-Torrance PBR)
vec3 fresnelSchlickVec(float cosTheta, vec3 F0) {
    return F0 + (vec3(1.0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// GGX / Trowbridge-Reitz Normal Distribution Function D
float distributionGGX(float NdotH, float alpha) {
    float a2 = max(alpha * alpha, 1e-6);
    float d = (NdotH * NdotH * (a2 - 1.0) + 1.0);
    return a2 / (PI * d * d);
}

// Smith Joint Correlated Visibility Function V = G / (4 * NdotL * NdotV)
float visibilitySmithGGXCorrelated(float NdotL, float NdotV, float alpha) {
    float a2 = max(alpha * alpha, 1e-6);
    float gv = NdotL * sqrt(NdotV * NdotV * (1.0 - a2) + a2);
    float gl = NdotV * sqrt(NdotL * NdotL * (1.0 - a2) + a2);
    return 0.5 / max(gv + gl, 1e-6);
}

// Importance sample GGX microfacet distribution for half-vector H in world space
vec3 sampleGGX(vec3 N, float alpha, inout uint seed) {
    vec2 xi = randVec2(seed);
    float a2 = max(alpha * alpha, 1e-6);
    float phi = TWO_PI * xi.x;
    float cosTheta = sqrt(clamp((1.0 - xi.y) / max(1.0 + (a2 - 1.0) * xi.y, 1e-7), 0.0, 1.0));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    vec3 H_local = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return normalize(tangent * H_local.x + bitangent * H_local.y + N * H_local.z);
}

// Evaluate combined BSDF PDF for Multiple Importance Sampling (MIS)
float evalBSDFPdf(vec3 V, vec3 L, vec3 N, vec3 Nc, float alphaRoughness, float clearcoatAlpha, float clearcoatProb, float baseSpecProb, float clearcoat) {
    float NdotL = dot(N, L);
    if (NdotL <= 0.0) return 0.0;

    vec3 H = normalize(V + L);
    float NdotH = clamp(dot(N, H), 0.0, 1.0);
    float VdotH = clamp(dot(V, H), 0.0, 1.0);

    float diffPdf = NdotL * INV_PI;

    float D = distributionGGX(NdotH, alphaRoughness);
    float specPdf = (D * NdotH) / max(4.0 * VdotH, 1e-4);

    float clearcoatPdf = 0.0;
    if (clearcoat > 0.001) {
        float NcDotL = dot(Nc, L);
        if (NcDotL > 0.0) {
            float NcDotH = clamp(dot(Nc, H), 0.0, 1.0);
            float VDotHc = clamp(dot(V, H), 0.0, 1.0);
            float Dc = distributionGGX(NcDotH, clearcoatAlpha);
            clearcoatPdf = (Dc * NcDotH) / max(4.0 * VDotHc, 1e-4);
        }
    }

    float diffProb = max(1.0 - clearcoatProb - baseSpecProb, 0.0);
    return diffProb * diffPdf + baseSpecProb * specPdf + clearcoatProb * clearcoatPdf;
}

// Path tracing integrator
vec3 tracePath(Ray primaryRay, inout uint seed) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    Ray currentRay = primaryRay;

    bool enableDirect = (ubo.flags & (1 << 0)) != 0;
    bool enableIndirect = (ubo.flags & (1 << 1)) != 0;
    bool enableSpecular = (ubo.flags & (1 << 2)) != 0;
    bool enableRefraction = (ubo.flags & (1 << 3)) != 0;
    bool enableShadows = (ubo.flags & (1 << 4)) != 0;

    float lastBsdfPdf = 0.0;
    bool isDelta = true;

    for (uint bounce = 0; bounce < ubo.maxBounces; ++bounce) {
        HitInfo hit;
        if (!traceScene(currentRay, EPSILON, 1e4, hit)) {
            // Miss: Sky / ambient radiance
            vec3 unitDir = normalize(currentRay.direction);
            vec3 skyColor;
            if (pc.hasEnvMap == 1) {
                vec2 envUv = directionToEquirectangular(unitDir);
                skyColor = texture(environmentMap, envUv).rgb * pc.envMapIntensity;
            } else {
                float t = 0.5 * (unitDir.y + 1.0);
                skyColor = mix(vec3(0.02, 0.02, 0.04), vec3(0.05, 0.07, 0.1), t);
            }
            radiance += throughput * skyColor;
            break;
        }

        Material mat = materials[hit.materialId];

        // 1. Sample Material Textures & Factors
        vec4 baseColor = mat.albedo;
        if (mat.albedoTex > 0 && mat.albedoTex <= 512) {
            baseColor *= texture(sceneTextures[mat.albedoTex - 1], hit.uv);
        }

        float roughness = mat.roughness;
        float metallic = mat.metallic;
        if (mat.mrTex > 0 && mat.mrTex <= 512) {
            vec4 mrSample = texture(sceneTextures[mat.mrTex - 1], hit.uv);
            roughness *= mrSample.g;
            metallic *= mrSample.b;
        }
        roughness = clamp(roughness, 0.04, 1.0);
        metallic = clamp(metallic, 0.0, 1.0);
        float alphaRoughness = roughness * roughness;

        float transmission = mat.transmission;
        if (mat.transmissionTex > 0 && mat.transmissionTex <= 512) {
            transmission *= texture(sceneTextures[mat.transmissionTex - 1], hit.uv).r;
        }

        vec3 emissive = mat.emissive.rgb;
        if (mat.emissiveTex > 0 && mat.emissiveTex <= 512) {
            emissive *= texture(sceneTextures[mat.emissiveTex - 1], hit.uv).rgb;
        }

        vec3 hitNormal = hit.normal;

        // 1. Emissive with MIS
        if (length(emissive) > 1e-3) {
            float misWeight = 1.0;
            if (!isDelta && pc.numLights > 0u && enableDirect) {
                float lightPdf = 0.0;
                for (uint l = 0; l < pc.numLights; ++l) {
                    Light light = lights[l];
                    if (uint(light.position.w) == 0u /* Area Light */) {
                        float cosLight = dot(-currentRay.direction, light.normal.xyz);
                        if (cosLight > 0.0) {
                            float area = light.emission.w;
                            if (area > 0.0 && (mat.type == 3u || dot(hitNormal, light.normal.xyz) > 0.9)) {
                                lightPdf = (hit.t * hit.t) / (area * cosLight);
                                break;
                            }
                        }
                    }
                }
                if (lightPdf > 0.0) {
                    misWeight = lastBsdfPdf / (lastBsdfPdf + lightPdf);
                }
            }
            if (bounce == 0 || enableIndirect) {
                radiance += throughput * emissive * misWeight;
            }
            if (mat.type == 3 /* Pure EMISSIVE light source */) {
                break;
            }
        } else if (mat.type == 3) {
            break;
        }

        float iorVal = mat.ior > 0.0 ? mat.ior : 1.5;
        float f0Dielectric = pow((iorVal - 1.0) / (iorVal + 1.0), 2.0);
        float specFactor = mat.specularFactor;
        if (mat.specularTex > 0 && mat.specularTex <= 512) {
            specFactor *= texture(sceneTextures[mat.specularTex - 1], hit.uv).a;
        }
        vec3 dielectricF0 = vec3(clamp(f0Dielectric * specFactor, 0.0, 1.0));
        vec3 F0 = mix(dielectricF0, baseColor.rgb, metallic);
        vec3 diffuseColor = baseColor.rgb * (1.0 - metallic);
        vec3 V = -currentRay.direction;

        // Clearcoat properties
        float clearcoat = mat.clearcoat;
        if (mat.clearcoatTex > 0 && mat.clearcoatTex <= 512) {
            clearcoat *= texture(sceneTextures[mat.clearcoatTex - 1], hit.uv).r;
        }
        float clearcoatRoughness = mat.clearcoatRoughness;
        if (mat.clearcoatRoughnessTex > 0 && mat.clearcoatRoughnessTex <= 512) {
            clearcoatRoughness *= texture(sceneTextures[mat.clearcoatRoughnessTex - 1], hit.uv).g;
        }
        clearcoatRoughness = clamp(clearcoatRoughness, 0.001, 1.0);
        float clearcoatAlpha = clearcoatRoughness * clearcoatRoughness;

        vec3 clearcoatNormal = hitNormal;
        if (mat.clearcoatNormalTex > 0 && mat.clearcoatNormalTex <= 512) {
            vec3 up = abs(hitNormal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
            vec3 cTan = normalize(cross(up, hitNormal));
            vec3 cBitan = cross(hitNormal, cTan);
            vec3 cNormMap = texture(sceneTextures[mat.clearcoatNormalTex - 1], hit.uv).rgb * 2.0 - 1.0;
            clearcoatNormal = normalize(mat3(cTan, cBitan, hitNormal) * cNormMap);
        }

        // Volumetric Beer-Lambert absorption (physical ray traversal distance)
        float mediumDist = !hit.frontFace ? hit.t : 0.0;
        if (mat.attenuationColor.w > 0.0 && mediumDist > 0.0) {
            vec3 sigma_a = -log(max(mat.attenuationColor.rgb, vec3(0.0001))) / mat.attenuationColor.w;
            vec3 transmittance = exp(-sigma_a * mediumDist);
            throughput *= transmittance;
        }

        float clearcoatProb = (clearcoat > 0.001 && enableSpecular) ? (clearcoat * 0.25) : 0.0;
        float baseSpecProb = enableSpecular ? clamp(mix(0.04, 1.0, metallic), 0.05, 0.95) * (1.0 - clearcoatProb) : 0.0;

        // 2. Next Event Estimation (Direct Lighting with Cook-Torrance GGX Microfacet Model + MIS)
        if (enableDirect && transmission < 0.1 && mat.type != 2) {
            for (uint l = 0; l < pc.numLights; ++l) {
                Light light = lights[l];
                vec3 lightPoint;
                vec3 lightDir;
                float lightDist;
                float lightPdf = 1.0;
                vec3 lightEmission = light.emission.rgb;

                if (uint(light.position.w) == 0 /* AREA QUAD */) {
                    vec2 uv = randVec2(seed);
                    lightPoint = light.position.xyz + uv.x * light.u.xyz + uv.y * light.v.xyz;
                    vec3 toLight = lightPoint - hit.point;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);

                    float cosLight = dot(-lightDir, light.normal.xyz);
                    if (cosLight <= 0.0) continue;

                    float area = light.emission.w;
                    lightPdf = (lightDist * lightDist) / (area * cosLight);
                } else if (uint(light.position.w) == 1 /* SPOT */) {
                    vec3 toLight = light.position.xyz - hit.point;
                    lightDist = length(toLight);
                    lightDir = toLight / max(lightDist, 1e-4);

                    float cosSpot = dot(-lightDir, light.normal.xyz);
                    float innerCos = light.u.w;
                    float outerCos = light.v.w;
                    if (cosSpot < outerCos) continue;

                    float spotFactor = clamp((cosSpot - outerCos) / max(innerCos - outerCos, 1e-4), 0.0, 1.0);
                    lightEmission *= spotFactor / max(lightDist * lightDist, 1e-4);
                    lightPdf = 1.0;
                } else if (uint(light.position.w) == 2 /* DIRECTIONAL */) {
                    lightDir = normalize(light.normal.xyz);
                    lightDist = 10000.0;
                    lightPdf = 1.0;
                } else {
                    continue;
                }

                float NdotL = dot(hitNormal, lightDir);
                if (NdotL > 0.0) {
                    bool inShadow = false;
                    if (enableShadows) {
                        Ray shadowRay;
                        shadowRay.origin = hit.point + hitNormal * EPSILON;
                        shadowRay.direction = lightDir;
                        inShadow = isShadowOccluded(shadowRay, EPSILON, lightDist - EPSILON);
                    }

                    if (!inShadow) {
                        vec3 H = normalize(V + lightDir);
                        float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);
                        float NdotH = clamp(dot(hitNormal, H), 0.0, 1.0);
                        float VdotH = clamp(dot(V, H), 0.0, 1.0);

                        float D = distributionGGX(NdotH, alphaRoughness);
                        float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                        vec3 F = fresnelSchlickVec(VdotH, F0);

                        vec3 specBRDF = enableSpecular ? (D * Vis * F) : vec3(0.0);
                        vec3 diffBRDF = (vec3(1.0) - F) * diffuseColor * INV_PI;

                        // Clearcoat layer evaluation
                        float Fc = 0.0;
                        vec3 clearcoatBRDF = vec3(0.0);
                        if (clearcoat > 0.001 && enableSpecular) {
                            vec3 Hc = normalize(V + lightDir);
                            float NcDotL = clamp(dot(clearcoatNormal, lightDir), 0.0, 1.0);
                            float NcDotV = clamp(dot(clearcoatNormal, V), 0.001, 1.0);
                            float NcDotH = clamp(dot(clearcoatNormal, Hc), 0.0, 1.0);
                            float VDotHc = clamp(dot(V, Hc), 0.0, 1.0);

                            Fc = fresnelSchlick(VDotHc, 1.5) * clearcoat;
                            float Dc = distributionGGX(NcDotH, clearcoatAlpha);
                            float VisC = visibilitySmithGGXCorrelated(NcDotL, NcDotV, clearcoatAlpha);
                            clearcoatBRDF = vec3(clearcoat * Dc * VisC * fresnelSchlick(VDotHc, 1.5));
                        }

                        vec3 brdf = (diffBRDF + specBRDF) * (1.0 - Fc) + clearcoatBRDF;

                        // Multiple Importance Sampling (MIS) balance heuristic for NEE
                        float misWeightLight = 1.0;
                        if (uint(light.position.w) == 0 /* AREA QUAD */) {
                            float bsdfPdf = evalBSDFPdf(V, lightDir, hitNormal, clearcoatNormal, alphaRoughness, clearcoatAlpha, clearcoatProb, baseSpecProb, clearcoat);
                            misWeightLight = lightPdf / (lightPdf + bsdfPdf);
                        }
                        radiance += throughput * lightEmission * brdf * NdotL * misWeightLight / max(lightPdf, 1e-4);
                    }
                }
            }
        }

        // Check if indirect lighting enabled for secondary bounces
        if (bounce > 0 && !enableIndirect) {
            break;
        }

        // 3. BSDF Sampling for Next Bounce
        vec3 nextDirection;

        if (transmission > 0.01 || mat.type == 2 /* DIELECTRIC / REFRACTION */) {
            if (!enableRefraction) {
                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                throughput *= baseColor.rgb;
            } else {
                float refractionRatio = hit.frontFace ? (1.0 / iorVal) : iorVal;
                vec3 unitDir = normalize(currentRay.direction);
                float cosTheta = min(dot(-unitDir, hitNormal), 1.0);
                float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

                bool cannotRefract = refractionRatio * sinTheta > 1.0;
                float reflectProb = fresnelSchlick(cosTheta, refractionRatio);

                if (cannotRefract || reflectProb > randFloat(seed)) {
                    nextDirection = reflect(unitDir, hitNormal);
                    currentRay.origin = hit.point + hitNormal * EPSILON;
                } else {
                    nextDirection = refract(unitDir, hitNormal, refractionRatio);
                    currentRay.origin = hit.point - hitNormal * EPSILON;
                }
                currentRay.direction = normalize(nextDirection);
                throughput *= baseColor.rgb;
                isDelta = true;
                lastBsdfPdf = 1.0;
                continue;
            }
        } else {
            // Clearcoat + Cook-Torrance GGX importance sampling
            float xi = randFloat(seed);

            if (xi < clearcoatProb) {
                // Clearcoat specular lobe: GGX microfacet sampling with clearcoatNormal
                vec3 Hc = sampleGGX(clearcoatNormal, clearcoatAlpha, seed);
                vec3 L = reflect(-V, Hc);
                float NcDotL = dot(clearcoatNormal, L);

                if (NcDotL > 0.0) {
                    float NcDotV = clamp(dot(clearcoatNormal, V), 0.001, 1.0);
                    float NcDotH = clamp(dot(clearcoatNormal, Hc), 0.001, 1.0);
                    float VDotHc = clamp(dot(V, Hc), 0.0, 1.0);

                    float VisC = visibilitySmithGGXCorrelated(NcDotL, NcDotV, clearcoatAlpha);
                    float Fc = fresnelSchlick(VDotHc, 1.5) * clearcoat;

                    vec3 specWeight = vec3((4.0 * VisC * Fc * NcDotL * VDotHc) / max(NcDotH * clearcoatProb, 1e-4));
                    throughput *= clamp(specWeight, vec3(0.0), vec3(10.0));
                    nextDirection = L;
                } else {
                    // Fallback to diffuse
                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                    vec3 H_diff = normalize(V + nextDirection);
                    vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                    throughput *= (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                }
            } else if (xi < clearcoatProb + baseSpecProb) {
                // Base Specular lobe: GGX microfacet sampling
                vec3 H = sampleGGX(hitNormal, alphaRoughness, seed);
                vec3 L = reflect(-V, H);
                float NdotL = dot(hitNormal, L);

                if (NdotL > 0.0) {
                    float NdotV = clamp(dot(hitNormal, V), 0.001, 1.0);
                    float NdotH = clamp(dot(hitNormal, H), 0.001, 1.0);
                    float VdotH = clamp(dot(V, H), 0.0, 1.0);

                    float Vis = visibilitySmithGGXCorrelated(NdotL, NdotV, alphaRoughness);
                    vec3 F = fresnelSchlickVec(VdotH, F0);
                    float Fc = fresnelSchlick(VdotH, 1.5) * clearcoat;

                    vec3 specWeight = (4.0 * Vis * F * NdotL * VdotH * (1.0 - Fc)) / max(NdotH * baseSpecProb, 1e-4);
                    throughput *= clamp(specWeight, vec3(0.0), vec3(10.0));
                    nextDirection = L;
                } else {
                    // Fallback to diffuse
                    nextDirection = sampleCosineHemisphere(hitNormal, seed);
                    vec3 H_diff = normalize(V + nextDirection);
                    vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                    float Fc = fresnelSchlick(clamp(dot(V, H_diff), 0.0, 1.0), 1.5) * clearcoat;
                    throughput *= (1.0 - Fc) * (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
                }
            } else {
                // Diffuse lobe: Cosine-weighted hemisphere sampling
                nextDirection = sampleCosineHemisphere(hitNormal, seed);
                vec3 H_diff = normalize(V + nextDirection);
                vec3 F_diff = fresnelSchlickVec(clamp(dot(V, H_diff), 0.0, 1.0), F0);
                float Fc = fresnelSchlick(clamp(dot(V, H_diff), 0.0, 1.0), 1.5) * clearcoat;
                throughput *= (1.0 - Fc) * (vec3(1.0) - F_diff) * diffuseColor / max(1.0 - clearcoatProb - baseSpecProb, 1e-4);
            }
        }

        currentRay.origin = hit.point + hitNormal * EPSILON;
        currentRay.direction = nextDirection;
        isDelta = false;
        lastBsdfPdf = evalBSDFPdf(V, nextDirection, hitNormal, clearcoatNormal, alphaRoughness, clearcoatAlpha, clearcoatProb, baseSpecProb, clearcoat);

        // 4. Russian Roulette Path Termination (after bounce 1)
        if (bounce >= 1) {
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (randFloat(seed) > p) {
                break;
            }
            throughput /= p;
        }
    }

    return radiance;
}

ivec2 getPixelCoordsMorton8x4(uint linearIdx, uint width, uint height) {
    uint tilesX = (width + 7u) / 8u;
    uint tileIdx = linearIdx / 32u;
    uint inTile = linearIdx % 32u;
    uint tileX = tileIdx % tilesX;
    uint tileY = tileIdx / tilesX;

    uint mx = ((inTile >> 0u) & 1u) | (((inTile >> 2u) & 1u) << 1u) | (((inTile >> 4u) & 1u) << 2u);
    uint my = ((inTile >> 1u) & 1u) | (((inTile >> 3u) & 1u) << 1u);

    return ivec2(int(tileX * 8u + mx), int(tileY * 4u + my));
}

void main() {
    ivec2 globalID = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = ivec2(pc.tileWidth > 0u ? pc.tileWidth : imageSize(uAccumImage).x,
                            pc.tileHeight > 0u ? pc.tileHeight : imageSize(uAccumImage).y);
    ivec2 pixelCoord;

    // Multi-GPU Checkerboard Tiling (tileOffsetX: 0 = full frame, 1 = even tiles, 2 = odd tiles)
    // tileOffsetY: Checkerboard tile size (16, 32, 64, or 128; defaults to 64 if 0)
    uint tileSize = (pc.tileOffsetY == 0u) ? 64u : pc.tileOffsetY;
    if (pc.tileOffsetX == 1u) {
        // GPU 0 (Primary): Even tiles
        uint ty = uint(globalID.y) / tileSize;
        uint tx_half = uint(globalID.x) / tileSize;
        uint localX = uint(globalID.x) % tileSize;
        uint tx = tx_half * 2u + (ty & 1u);
        pixelCoord = ivec2(int(tx * tileSize + localX), globalID.y);
    } else if (pc.tileOffsetX == 2u) {
        // GPU 1 (Secondary): Odd tiles
        uint ty = uint(globalID.y) / tileSize;
        uint tx_half = uint(globalID.x) / tileSize;
        uint localX = uint(globalID.x) % tileSize;
        uint tx = tx_half * 2u + (1u - (ty & 1u));
        pixelCoord = ivec2(int(tx * tileSize + localX), globalID.y);
    } else {
        uint linearIdx = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 32u + gl_LocalInvocationIndex;
        pixelCoord = getPixelCoordsMorton8x4(linearIdx, uint(imageSize.x), uint(imageSize.y));
    }

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }

    // Initialize per-pixel random seed
    uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + ubo.frameIndex * 26699) | 1u;

    vec3 pixelRadiance = vec3(0.0);

    for (uint s = 0; s < ubo.spp; ++s) {
        // Subpixel jitter for anti-aliasing
        vec2 jitter = randVec2(seed) - vec2(0.5);
        vec2 uv = (vec2(pixelCoord) + jitter) / vec2(imageSize);
        vec2 d = uv * 2.0 - 1.0;

        // Camera ray generation via inverse projection and view matrices
        vec4 target = ubo.projInverse * vec4(d.x, d.y, 1.0, 1.0);
        vec4 rayDirWorld = ubo.viewInverse * vec4(normalize(target.xyz / target.w), 0.0);

        Ray primaryRay;
        primaryRay.origin = ubo.position.xyz;
        primaryRay.direction = normalize(rayDirWorld.xyz);

        pixelRadiance += tracePath(primaryRay, seed);
    }

    // Load previous accumulated radiance
    ivec2 storeCoord = (pc.tileOffsetX == 2u) ? ivec2(gl_GlobalInvocationID.xy) : pixelCoord;

    vec4 newAccum;
    if (pc.accumulateHistory == 0u || ubo.frameIndex == 0u) {
        newAccum = vec4(pixelRadiance, float(ubo.spp));
    } else {
        vec4 prevAccum = imageLoad(uAccumImage, storeCoord);
        newAccum = vec4(addFp16Stochastic(prevAccum.rgb, pixelRadiance, seed), prevAccum.a + float(ubo.spp));
    }

    imageStore(uAccumImage, storeCoord, newAccum);
}
