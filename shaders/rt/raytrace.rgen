#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_image_load_formatted : require

struct HitPayload {
    vec3 diffuseRadiance;         // 12 bytes: direct diffuse
    uint packedThroughputRG;      //  4 bytes: packHalf2x16(throughputMod.rg)
    vec3 specularRadiance;        // 12 bytes: direct specular + emissive
    uint packedThroughputB_Flags; //  4 bytes: lower 16 bits = half(b), upper 16 bits = flags
    vec3 nextOrigin;              // 12 bytes: next ray origin
    uint packedNextDir;           //  4 bytes: octahedral 32-bit (oct32) unit direction
    float lastBsdfPdf;            //  4 bytes: BSDF PDF for next bounce MIS evaluation
    uint seed;                    //  4 bytes: PCG RNG state
    uint pad;                     //  4 bytes: 48-byte cache-line alignment
    uint packedAlbedoRG;          //  4 bytes: packHalf2x16(baseColor.rg)
    uint packedAlbedoB_Roughness; //  4 bytes: packHalf2x16(vec2(baseColor.b, roughness))
};

layout(location = 0) rayPayloadEXT HitPayload prd;

layout(binding = 0) uniform image2D uAccumImage;
layout(binding = 11, rgba16f) uniform image2D uDirectLightImage;
layout(binding = 12, rgba16f) uniform image2D uNormalDepthImage;
layout(binding = 13) uniform sampler2D uBlueNoiseTexture;
layout(binding = 14, rg16f) uniform image2D uMotionVectorImage;

layout(binding = 1) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec4 position;
    vec4 viewParams;
    uint frameIndex;
    uint spp;
    uint maxBounces;
    uint flags;
    mat4 unjitteredViewProj;
    vec4 jitterOffset;
} ubo;

layout(binding = 6) uniform accelerationStructureEXT topLevelAS;

layout(push_constant) uniform PushConstants {
    uint numTriangles;
    uint numSpheres;
    uint numMaterials;
    uint numLights;
    uint tileOffsetX;
    uint tileOffsetY;
    uint tileWidth;
    uint tileHeight;
    uint useHardwareRT;
    uint hasEnvMap;
    float envMapIntensity;
    uint accumulateHistory;
    float fractionalSpp;
    uint totalCompositeSpp;
    uint numOpaqueTriangles;
    uint pad2;
} pc;

uint pcg_hash(inout uint seed) {
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return (word >> 22u) ^ word;
}

float randFloat(inout uint seed) {
    return float(pcg_hash(seed)) / 4294967296.0;
}

vec2 randVec2(inout uint seed) {
    return vec2(randFloat(seed), randFloat(seed));
}

// 32-bit Octahedral Decoding (Cigolle et al.)
vec2 octSign(vec2 v) {
    return vec2((v.x >= 0.0) ? 1.0 : -1.0, (v.y >= 0.0) ? 1.0 : -1.0);
}

vec3 octDecode(vec2 f) {
    vec3 v = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    if (v.z < 0.0) {
        v.xy = (vec2(1.0) - abs(v.yx)) * octSign(v.xy);
    }
    return normalize(v);
}

vec3 unpackOct32(uint p) {
    return octDecode(unpackSnorm2x16(p));
}

void main() {
    ivec2 launchID = ivec2(gl_LaunchIDEXT.xy);
    ivec2 imageSize = ivec2(pc.tileWidth > 0u ? pc.tileWidth : gl_LaunchSizeEXT.x,
                            pc.tileHeight > 0u ? pc.tileHeight : gl_LaunchSizeEXT.y);
    ivec2 pixelCoord;

    // Multi-GPU Work Distribution
    // tileOffsetX: 0 = full frame (Single GPU / Sample Parallel)
    //              1 = Primary GPU (GPU 0 white tiles)
    //              2 = Secondary GPU (GPU 1 black tiles)
    // tileOffsetY: Checkerboard Tile size (16, 32, 64, or 128; defaults to 64 if 0)
    if (pc.tileOffsetX == 1u || pc.tileOffsetX == 2u) {
        uint tileSize = (pc.tileOffsetY == 0u) ? 64u : pc.tileOffsetY;
        uint ty = uint(launchID.y) / tileSize;
        uint tx_half = uint(launchID.x) / tileSize;
        uint localX = uint(launchID.x) % tileSize;
        if (pc.tileOffsetX == 1u) {
            uint tx = tx_half * 2u + (ty & 1u);
            pixelCoord = ivec2(int(tx * tileSize + localX), launchID.y);
        } else {
            uint tx = tx_half * 2u + (1u - (ty & 1u));
            pixelCoord = ivec2(int(tx * tileSize + localX), launchID.y);
        }
    } else {
        pixelCoord = launchID;
    }

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y) {
        return;
    }

    bool enableShadowDenoiser = (ubo.flags & (1u << 20)) != 0u;
    bool enableTaa = (ubo.flags & (1u << 21)) != 0u;
    if (enableShadowDenoiser) {
        imageStore(uDirectLightImage, pixelCoord, vec4(0.0, 0.0, 0.0, 1.0));
    }
    ivec2 ndStoreCoord = (pc.tileOffsetX == 2u) ? launchID : pixelCoord;
    imageStore(uNormalDepthImage, ndStoreCoord, vec4(0.0, 0.0, 0.0, 10000.0));

    // Spatiotemporal Blue Noise lookup (64x64 texture with wrapping)
    vec4 bn = texelFetch(uBlueNoiseTexture, ivec2(pixelCoord.x & 63, pixelCoord.y & 63), 0);
    const vec4 phi4 = vec4(0.7548776662, 0.5698402910, 0.4411124503, 0.3541421356);
    vec4 stNoise = fract(bn + float(ubo.frameIndex) * phi4);

    // Discrete integer sample count (100% SIMD lane coherence)
    uint pixelSpp = ubo.spp;

    uint seed = uint(pixelCoord.x * 1973 + pixelCoord.y * 9277 + ubo.frameIndex * 26699) | 1u;
    seed ^= uint(stNoise.b * 4294967295.0);
    vec3 pixelRadiance = vec3(0.0);

    for (uint s = 0; s < pixelSpp; ++s) {
        vec2 subpixelOffset;
        if (enableTaa) {
            subpixelOffset = (s == 0u) ? vec2(0.5) : (vec2(0.5) + fract(stNoise.xy + float(s) * phi4.xy) - vec2(0.5));
        } else {
            subpixelOffset = vec2(0.5) + fract(stNoise.xy + float(s) * phi4.xy) - vec2(0.5);
        }
        vec2 uv = (vec2(pixelCoord) + subpixelOffset) / vec2(imageSize);
        vec2 d = uv * 2.0 - 1.0;

        vec4 target = ubo.projInverse * vec4(d.x, d.y, 1.0, 1.0);
        vec4 rayDirWorld = ubo.viewInverse * vec4(normalize(target.xyz / target.w), 0.0);

        vec3 rayOrigin = ubo.position.xyz;
        vec3 rayDir = normalize(rayDirWorld.xyz);
        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);
        float lastBsdfPdf = 0.0;
        bool isDelta = true;

        vec3 primaryHitPoint = vec3(0.0);
        vec3 primarySpecDir = vec3(0.0);
        vec3 primaryAlbedo = vec3(0.0);
        float primaryRoughness = 0.0;
        float primaryDepth = 10000.0;
        bool primaryHit = false;
        bool primaryIsSpecular = false;
        vec2 vSurface = vec2(0.0);
        vec2 vSpecular = vec2(0.0);
        float specularHitDist = 1000.0;
        vec3 accumDiff = vec3(0.0);
        vec3 accumSpec = vec3(0.0);

        uint maxBounces = ((ubo.flags & (1u << 1)) != 0u) ? ubo.maxBounces : 1u;
        for (uint bounce = 0; bounce < maxBounces; ++bounce) {
            prd.diffuseRadiance = vec3(0.0);
            prd.specularRadiance = vec3(0.0);
            prd.packedThroughputRG = 0u;
            uint prdFlags = (isDelta ? 2u : 0u) | (bounce == 0u ? 4u : 0u);
            prd.packedThroughputB_Flags = prdFlags << 16u;
            prd.seed = seed;
            prd.lastBsdfPdf = lastBsdfPdf;
            prd.pad = uint(pixelCoord.y * int(pc.tileWidth) + pixelCoord.x);
            prd.packedAlbedoRG = 0u;
            prd.packedAlbedoB_Roughness = 0u;

            traceRayEXT(topLevelAS,
                        gl_RayFlagsOpaqueEXT,
                        0xFF,
                        0 /* sbtRecordOffset */,
                        0 /* sbtRecordStride */,
                        0 /* missIndex 0 */,
                        rayOrigin,
                        0.001,
                        rayDir,
                        10000.0,
                        0 /* payload location 0 */);

            seed = prd.seed;
            lastBsdfPdf = prd.lastBsdfPdf;

            uint flags = prd.packedThroughputB_Flags >> 16u;
            bool hit = (flags & 1u) != 0u;
            isDelta = (flags & 2u) != 0u;

            vec3 stepRadiance = prd.diffuseRadiance + prd.specularRadiance;
            if (bounce > 0u) {
                const float MAX_INDIRECT_LUMINANCE = 35.0;
                float stepLum = dot(stepRadiance, vec3(0.2126, 0.7152, 0.0722));
                if (stepLum > MAX_INDIRECT_LUMINANCE) {
                    stepRadiance *= (MAX_INDIRECT_LUMINANCE / stepLum);
                }
            }

            vec3 bounceContrib = throughput * stepRadiance;
            if (bounce > 0u) {
                const float MAX_INDIRECT_LUMINANCE = 35.0;
                float contribLum = dot(bounceContrib, vec3(0.2126, 0.7152, 0.0722));
                if (contribLum > MAX_INDIRECT_LUMINANCE) {
                    bounceContrib *= (MAX_INDIRECT_LUMINANCE / contribLum);
                }
            }

            radiance += bounceContrib;

            if (bounce == 0u) {
                primaryHit = hit;
                primaryIsSpecular = (flags & 8u) != 0u;
                primarySpecDir = unpackOct32(prd.packedNextDir);
                primaryHitPoint = prd.nextOrigin;
                accumDiff += prd.diffuseRadiance;
                accumSpec += prd.specularRadiance;

                vec2 albRG = unpackHalf2x16(prd.packedAlbedoRG);
                vec2 albB_r = unpackHalf2x16(prd.packedAlbedoB_Roughness);
                primaryAlbedo = vec3(albRG, albB_r.x);
                primaryRoughness = albB_r.y;

                if (hit) {
                    primaryDepth = length(primaryHitPoint - ubo.position.xyz);
                    vec4 currClip = ubo.unjitteredViewProj * vec4(primaryHitPoint, 1.0);
                    vec4 prevClip = ubo.prevViewProj * vec4(primaryHitPoint, 1.0);
                    if (currClip.w > 1e-4 && prevClip.w > 1e-4) {
                        vSurface = (currClip.xy / currClip.w - prevClip.xy / prevClip.w) * 0.5;
                    }
                    if (enableTaa && !enableShadowDenoiser) {
                        ivec2 ndStoreCoord = (pc.tileOffsetX == 2u) ? launchID : pixelCoord;
                        imageStore(uNormalDepthImage, ndStoreCoord, vec4(0.0, 0.0, 1.0, primaryDepth));
                    }
                } else {
                    vec3 skyDirPt = ubo.position.xyz + rayDir * 1000.0;
                    vec4 currClip = ubo.unjitteredViewProj * vec4(skyDirPt, 1.0);
                    vec4 prevClip = ubo.prevViewProj * vec4(skyDirPt, 1.0);
                    if (currClip.w > 1e-4 && prevClip.w > 1e-4) {
                        vSurface = (currClip.xy / currClip.w - prevClip.xy / prevClip.w) * 0.5;
                    }
                    if (enableTaa && !enableShadowDenoiser) {
                        ivec2 ndStoreCoord = (pc.tileOffsetX == 2u) ? launchID : pixelCoord;
                        imageStore(uNormalDepthImage, ndStoreCoord, vec4(0.0, 0.0, 1.0, 10000.0));
                    }
                }
                vSpecular = vSurface;
                if (s == 0u) {
                    ivec2 mvStoreCoord = (pc.tileOffsetX == 2u) ? launchID : pixelCoord;
                    imageStore(uMotionVectorImage, mvStoreCoord, vec4(vSurface, 0.0, 0.0));
                }
            } else if (bounce == 1u) {
                if (primaryIsSpecular && primaryHit) {
                    vec3 bounce1Hit = hit ? prd.nextOrigin : (primaryHitPoint + primarySpecDir * 1000.0);
                    specularHitDist = length(bounce1Hit - primaryHitPoint);
                    vec3 xVirt = primaryHitPoint + primarySpecDir * specularHitDist;
                    vec4 currClip = ubo.unjitteredViewProj * vec4(xVirt, 1.0);
                    vec4 prevClip = ubo.prevViewProj * vec4(xVirt, 1.0);
                    if (currClip.w > 1e-4 && prevClip.w > 1e-4) {
                        vSpecular = (currClip.xy / currClip.w - prevClip.xy / prevClip.w) * 0.5;
                    }
                }
                if (primaryIsSpecular) {
                    accumSpec += bounceContrib;
                } else {
                    accumDiff += bounceContrib;
                }
            } else {
                if (primaryIsSpecular) {
                    accumSpec += bounceContrib;
                } else {
                    accumDiff += bounceContrib;
                }
            }

            if (!hit) {
                break;
            }

            vec2 tpRG = unpackHalf2x16(prd.packedThroughputRG);
            float tpB = unpackHalf2x16(prd.packedThroughputB_Flags & 0xFFFFu).x;
            vec3 throughputMod = vec3(tpRG, tpB);
            throughput *= throughputMod;

            // Early-out if path has negligible remaining energy (< 0.1% luminance)
            float lum = dot(throughput, vec3(0.2126, 0.7152, 0.0722));
            if (lum < 0.001) {
                break;
            }

            // Luminance-weighted Russian Roulette
            if (bounce >= 1u) {
                float minP = (bounce >= 2u) ? 0.02 : 0.05;
                float p = clamp(lum, minP, 0.95);
                if (randFloat(seed) > p) {
                    break;
                }
                throughput /= p;
            }

            rayOrigin = prd.nextOrigin;
            rayDir = unpackOct32(prd.packedNextDir);
        }

        pixelRadiance += radiance;
    }

    uint compositeDivisor = (pc.totalCompositeSpp > 0u) ? pc.totalCompositeSpp : pixelSpp;
    if (compositeDivisor > 1u) {
        pixelRadiance /= float(compositeDivisor);
    }

    if (isnan(pixelRadiance.r) || isnan(pixelRadiance.g) || isnan(pixelRadiance.b) ||
        isinf(pixelRadiance.r) || isinf(pixelRadiance.g) || isinf(pixelRadiance.b)) {
        pixelRadiance = vec3(0.0);
    }
    pixelRadiance = clamp(pixelRadiance, vec3(0.0), vec3(65000.0));

    ivec2 storeCoord = (pc.tileOffsetX == 2u) ? launchID : pixelCoord;

    vec4 newAccum;
    if (pc.accumulateHistory == 0u || ubo.frameIndex == 0u) {
        newAccum = vec4(pixelRadiance, 1.0);
    } else {
        vec4 prevAccum = imageLoad(uAccumImage, storeCoord);
        newAccum = prevAccum + vec4(pixelRadiance, 1.0);
    }

    imageStore(uAccumImage, storeCoord, newAccum);
}
