// Pathways Path Tracer - Windows Resource Script
#include <windows.h>

IDI_ICON1 ICON "pathways.ico"

1 VERSIONINFO
FILEVERSION     1,11,0,0
PRODUCTVERSION  1,11,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Soddentrough\0"
            VALUE "FileDescription",  "Pathways: Real-Time Vulkan 1.4 Path Tracer\0"
            VALUE "FileVersion",      "1.15.0.0\0"
            VALUE "InternalName",     "pathways\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Soddentrough. MIT License.\0"
            VALUE "OriginalFilename", "pathways.exe\0"
            VALUE "ProductName",      "Pathways\0"
            VALUE "ProductVersion",   "1.15.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
